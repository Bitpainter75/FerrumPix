<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.PosterizePanel">
    <!-- Tontrennung: jeder Kanal faellt auf wenige Stufen. 0 ist aus, eine einzige Stufe gibt es
         nicht. Am Ende der Punktkette, damit das Zittern beim Runden die Flaechen nicht aufbricht. -->
    <Expander Header="Tontrennung" icons:ExpanderState.Key="posterize"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=posterize}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/stairs.svg"
                            Width="14" Height="14" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon-btn group-reset"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Command="{Binding DataContext.ResetPosterizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip.Tip="Tontrennung zurücksetzen">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                            Width="14" Height="14" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="2" Margin="0,8,0,0">
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Stufen" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                           ToolTip.Tip="Tonstufen je Farbkanal, 0 schaltet die Tontrennung aus" />
                <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="64" DefaultValue="0"
                                   Value="{Binding PosterizeLevels}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding PosterizeLevels, Mode=TwoWay}" Minimum="0" Maximum="64" />
            </Grid>
        </StackPanel>
    </Expander>
</UserControl>
