<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.ExtensionsPanel">
    <!-- Das Werkzeug "Erweiterungen": je geladener Erweiterung eine Gruppe mit ihren Reglern. Die
         Gruppen entstehen erst zur Laufzeit, der Baumdurchlauf der Uebersetzung erreicht sie also
         nicht: jeder feste Text kommt deshalb uebersetzt aus dem ViewModel, die Texte der
         Erweiterung bringt sie selbst in ihren Sprachen mit (ExtensionService.Localized). -->
    <StackPanel Spacing="7">
        <Border Classes="adjustment-group" IsVisible="{Binding HasMissingExtensions}">
            <TextBlock Text="{Binding MissingExtensionsText}" TextWrapping="Wrap" Margin="8"
                       Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}" />
        </Border>
        <ItemsControl ItemsSource="{Binding ExtensionPanels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="adjustment-group">
                        <!-- Auf- und Zuklappen wird gemerkt wie bei den eingebauten Gruppen; ohne
                             gemerkten Stand offen (ExpanderState, Standard aufgeklappt). -->
                        <Expander Header="{Binding Name}" icons:ExpanderState.Key="{Binding ExpanderKey}">
                            <Expander.HeaderTemplate>
                                <DataTemplate>
                                    <!-- Kopf wie bei den eingebauten Gruppen: Auge fuer den Vergleich,
                                         Zuruecksetzen der ganzen Gruppe. Die Gruppe selbst ist der
                                         DataContext des Aufklappers; der Vergleich laeuft ueber den
                                         Befehl des Editors mit ihrem Schluessel. -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/puzzle-piece.svg"
                                                           Width="18" Height="18" />
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="icon-btn group-compare"
                                                Classes.comparing="{Binding DataContext.IsComparing, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                Width="28" Height="28" Padding="0"
                                                Command="{Binding DataContext.ToggleAdjustmentGroupCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding DataContext.GroupKey, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                ToolTip.Tip="{Binding DataContext.CompareLabel, RelativeSource={RelativeSource AncestorType=Expander}}">
                                            <icons:SvgIcon Width="16" Height="16" />
                                        </Button>
                                        <Button Grid.Column="2"
                                                Classes="icon-btn group-reset"
                                                Width="28" Height="28" Padding="0"
                                                Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                ToolTip.Tip="{Binding DataContext.ResetLabel, RelativeSource={RelativeSource AncestorType=Expander}}">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-clockwise.svg"
                                                           Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </Expander.HeaderTemplate>
                            <StackPanel Spacing="2" Margin="0,8,0,0">
                                <CheckBox Content="{Binding EnabledLabel}" IsChecked="{Binding IsEnabled}"
                                          FontSize="{DynamicResource FP.Font.Small}" Margin="0,0,0,4" />
                                <!-- Voreinstellungen der Erweiterung: die Wahl uebernimmt den Wertesatz
                                     als einen Schritt, danach steht die Auswahl wieder leer. -->
                                <Grid ColumnDefinitions="92,*" VerticalAlignment="Center" Margin="0,0,0,6"
                                      IsVisible="{Binding HasPresets}">
                                    <TextBlock Text="{Binding PresetLabel}" Foreground="{DynamicResource FP.Text.Secondary}"
                                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding PresetNames}"
                                              SelectedItem="{Binding SelectedPresetName}"
                                              FontSize="{DynamicResource FP.Font.Small}" Margin="6,0,0,0"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                                <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding VersionNote}" IsVisible="{Binding HasVersionNote}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FP.Accent}" FontSize="{DynamicResource FP.Font.Small}"
                                           Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Controls}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Section}" IsVisible="{Binding HasSection}"
                                                           FontWeight="SemiBold" FontSize="{DynamicResource FP.Font.Small}"
                                                           Margin="0,8,0,2" />
                                                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center" IsVisible="{Binding IsSlider}">
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource FP.Text.Secondary}"
                                                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HintOrLabel}" />
                                                    <icons:RoundSlider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                       Value="{Binding Value}" DefaultValue="{Binding DefaultValue}"
                                                                       WheelIncrement="{Binding WheelIncrement}"
                                                                       ColorTrack="{Binding ColorTrack}" Margin="0,0" />
                                                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                                             Value="{Binding Value, Mode=TwoWay}"
                                                                             Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                             Increment="{Binding Increment}" FormatString="{Binding FormatString}" />
                                                </Grid>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsVisible="{Binding IsToggle}"
                                                          ToolTip.Tip="{Binding HintOrLabel}"
                                                          FontSize="{DynamicResource FP.Font.Small}" />
                                                <Grid ColumnDefinitions="92,*" VerticalAlignment="Center" IsVisible="{Binding IsChoice}">
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource FP.Text.Secondary}"
                                                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HintOrLabel}" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding OptionLabels}"
                                                              SelectedIndex="{Binding SelectedOptionIndex}"
                                                              FontSize="{DynamicResource FP.Font.Small}" Margin="6,0,0,0"
                                                              HorizontalAlignment="Stretch" />
                                                </Grid>
                                                <Grid ColumnDefinitions="92,*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsColor}">
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource FP.Text.Secondary}"
                                                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HintOrLabel}" />
                                                    <icons:ColorPickerButton Grid.Column="1"
                                                                             SelectedColor="{Binding ColorValue, Mode=TwoWay}" />
                                                    <Button Grid.Column="2" Classes="icon-btn group-reset" Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                                                            Command="{Binding ResetCommand}" ToolTip.Tip="{Binding ResetLabel}">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-clockwise.svg"
                                                                       Width="14" Height="14" />
                                                    </Button>
                                                </Grid>
                                                <StackPanel Spacing="2" IsVisible="{Binding IsCurve}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource FP.Text.Secondary}"
                                                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" ToolTip.Tip="{Binding HintOrLabel}" />
                                                        <Button Grid.Column="1" Classes="icon-btn group-reset" Width="24" Height="24" Padding="0"
                                                                Command="{Binding ResetCommand}" ToolTip.Tip="{Binding ResetLabel}">
                                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-clockwise.svg"
                                                                           Width="14" Height="14" />
                                                        </Button>
                                                    </Grid>
                                                    <icons:CurveEditor Height="160" Points="{Binding CurvePoints}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
