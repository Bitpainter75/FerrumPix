<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.NoisePanel">
    <!-- ALLES ZUM RAUSCHEN an einem Ort. "Rauschen" und "Farbrauschen" lagen vorher bei den
         Details, mitten zwischen Struktur, Klarheit und Staub - drei Regler zu einer Sache, verteilt
         auf zwei Gruppen. Das Weichzeichnen bleibt bewusst, wo es war: es ist ein Werkzeug fuer sich
         und nicht nur eine Rauschminderung. -->
    <Border Classes="adjustment-group"
            IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=rauschen}">
        <Expander Header="Rauschen" icons:ExpanderState.Key="rauschen">
            <Expander.HeaderTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/grain.svg"
                                Width="14" Height="14" />
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="icon-btn group-reset"
                                Width="28" Height="28" Padding="0"
                                Command="{Binding DataContext.ResetRauschenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip.Tip="Rauschen zurücksetzen">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                Width="14" Height="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </Expander.HeaderTemplate>
            <StackPanel Spacing="2" Margin="0,8,0,0">
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Rauschen" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                               ToolTip.Tip="Positiv fügt Rauschen hinzu, negativ reduziert es (gleichmäßiges Weichzeichnen)." />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       DefaultValue="0"
                                       Value="{Binding AddNoise}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AddNoise, Mode=TwoWay}" Minimum="-100" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Farbrauschen" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                               ToolTip.Tip="Negativ entfernt Farbrauschen: geglättet werden nur die Farbanteile (Chroma), Helligkeit und Details bleiben erhalten. Positiv fügt farbiges Rauschen hinzu." />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       DefaultValue="0"
                                       Value="{Binding ColorNoiseAmount}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding ColorNoiseAmount, Mode=TwoWay}" Minimum="-100" Maximum="100" />
                </Grid>

                <!-- Die dritte Stufe. Sie arbeitet auf MEHREREN Groessen und holt damit das, woran
                     die beiden darueber nicht herankommen: grosse Farbflecken aus hochgezogenen
                     Aufnahmen. Ein einstufiger Filter braeuchte dafuer einen Radius, der alles
                     andere gleich mitfrisst. -->
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Farbflecken" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                               ToolTip.Tip="Gegen große Farbflecken aus hochgezogenen Aufnahmen. Arbeitet auf mehreren Größen und lässt Kanten und feine Struktur stehen." />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       Value="{Binding FarbrauschGrob}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding FarbrauschGrob, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      IsEnabled="{Binding HasColorBlotches}">
                    <TextBlock Text="Fleckengröße" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                               ToolTip.Tip="Wie große Flecken noch erfasst werden. Höher greift weiter, kostet aber mehr Zeit." />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100" DefaultValue="50"
                                       Value="{Binding ColorNoiseCoarseScale}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding ColorNoiseCoarseScale, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>

                <!-- ENTRAUSCHEN MIT MODELL: kein Regler, sondern ein Zug in die Pixel - bei
                     mehreren Minuten Rechenzeit kann das nicht an einer Vorschau haengen.
                     Deshalb steht es abgesetzt unter den Reglern und nicht zwischen ihnen. -->
                <Separator Margin="0,6,0,4" Background="{DynamicResource FP.Border.Normal}" Height="1"/>
                <!-- Die Staerke steht UEBER den Knoepfen, weil sie fuer beide gilt und vor dem
                     Druck eingestellt wird - danach laeuft die Rechnung minutenlang. Sie wirkt nur
                     auf die Helligkeit; die Farbe kommt immer voll aus dem Modell. -->
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      IsEnabled="{Binding CanDenoiseWithAnyModel}">
                    <TextBlock Text="Stärke" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                               ToolTip.Tip="Wie stark die Helligkeit entrauscht wird. Niedriger lässt mehr feine Zeichnung stehen, höher nimmt mehr Korn. Die Farbe wird immer voll entrauscht, das kostet keine Zeichnung. Gilt für den nächsten Druck auf einen der beiden Knöpfe." />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="70"
                                       Value="{Binding DenoiseStrength}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding DenoiseStrength, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                        IsEnabled="{Binding CanDenoiseWithModel}"
                        Command="{Binding DenoiseWithModelCommand}"
                        ToolTip.Tip="{Binding DenoiseWithModelHint}" ToolTip.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/sparkles.svg"
                                       Width="16" Height="16" />
                        <TextBlock Text="Entrauschen: gründlich" FontSize="{DynamicResource FP.Font.Small}" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                        IsEnabled="{Binding CanDenoiseFast}"
                        Command="{Binding DenoiseFastCommand}"
                        ToolTip.Tip="{Binding DenoiseFastHint}" ToolTip.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/sparkles.svg"
                                       Width="16" Height="16" />
                        <TextBlock Text="Entrauschen: zügig" FontSize="{DynamicResource FP.Font.Small}" />
                    </StackPanel>
                </Button>
                <!-- Was an diesem Bild gespeichert ist. Ohne diese Zeile zeigt der Zuruecksetzer der
                     Gruppe auf etwas Unsichtbares: bei einem RAW steckt das Entrauschen NICHT in der
                     Datei, sondern nur als Vermerk daneben. -->
                <TextBlock IsVisible="{Binding HasStoredDenoise}"
                           Text="{Binding StoredDenoiseText}"
                           Margin="2,4,2,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}"
                           Classes="no-translate"
                           ToolTip.Tip="Wird beim Speichern in der Begleitdatei vermerkt und beim nächsten Öffnen angeboten. Das Zurücksetzen dieser Gruppe entfernt den Vermerk." />

            </StackPanel>
        </Expander>
    </Border>
</UserControl>
