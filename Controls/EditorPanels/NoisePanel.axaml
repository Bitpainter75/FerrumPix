<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.NoisePanel">
    <!-- ALLES ZUM RAUSCHEN an einem Ort, benannt und geordnet wie die Rauschreduzierung des
         Referenzprogramms: Luminanz (crs:LuminanceSmoothing) mit Details und eigener Methode, dann
         Farbe (crs:ColorNoiseReduction, nur noch 0 bis 100). Hier wird nur ENTFERNT. Die Luminanz
         stand frueher als "Glaetten" beim Weichzeichnen, obwohl sie mit ihm nichts teilt; Rauschen
         und Farbrauschen HINZUFUEGEN stehen jetzt bei der Koernung. Der fruehere negative Bereich von
         "Rauschen" (gleichmaessig weichzeichnen) und die Farbflecken samt Fleckengroesse sind aus dem
         Panel genommen; alte Rezepte mit diesen Werten rechnet die Pixelkette weiter wie
         gespeichert, das Zuruecksetzen der Gruppe nullt sie. -->
    <Border Classes="adjustment-group"
            IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=rauschen}">
        <Expander Header="Rauschreduzierung" icons:ExpanderState.Key="rauschen">
            <Expander.HeaderTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/phosphor/regular/dots-nine.svg"
                                Width="18" Height="18" />
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                        </StackPanel>
                        <!-- Gruppenvergleich, beschrieben in LightPanel.axaml -->
                        <Button Grid.Column="1"
                                Classes="icon-btn group-compare"
                                Classes.comparing="{Binding DataContext.ComparingAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InListConverter}, ConverterParameter=rauschen}"
                                IsVisible="{Binding DataContext.CanCompareAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Width="28" Height="28" Padding="0"
                                Command="{Binding DataContext.ToggleAdjustmentGroupCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="rauschen"
                                ToolTip.Tip="Gruppe vorübergehend ausblenden, um vorher und nachher zu vergleichen">
                            <icons:SvgIcon Width="16" Height="16" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="icon-btn group-reset"
                                Width="28" Height="28" Padding="0"
                                Command="{Binding DataContext.ResetRauschenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip.Tip="Rauschreduzierung zurücksetzen">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-clockwise.svg"
                                Width="16" Height="16" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </Expander.HeaderTemplate>
            <StackPanel Spacing="2" Margin="0,8,0,0">
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Luminanz" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                               ToolTip.Tip="Mindert Rauschen und lässt Kanten und Zeichnung stehen. Ein sauberes Foto verändert sich dabei kaum." />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       Value="{Binding NoiseReduction}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding NoiseReduction, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Details" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                               ToolTip.Tip="Schützt Kanten bei der Luminanz: höher = mehr Details bleiben erhalten." />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       Value="{Binding NoiseReductionDetail}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding NoiseReductionDetail, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*" VerticalAlignment="Center">
                    <TextBlock Text="Methode" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <ComboBox Name="NoiseReductionMethodComboBox"
                              Grid.Column="1"
                              ItemsSource="{Binding NoiseReductionMethodOptions}"
                              SelectedItem="{Binding NoiseReductionMethodLabel}"
                              FontSize="{DynamicResource FP.Font.Small}"
                              Margin="6,0,0,0"
                              HorizontalAlignment="Stretch"
                              DropDownOpened="OnMatchWidthDropDownOpened"
                              ToolTip.Tip="Adaptive: glättet so stark, wie das Bild bei der jeweiligen Helligkeit rauscht. Guided: glättet mit fester Schwelle nur flache Flächen. Gaussian: glättet gleichmäßig mit kleinem Radius. Median: kantenerhaltend, echte Rauschunterdrückung." />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="Farbe" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                               ToolTip.Tip="Entfernt Farbrauschen: geglättet werden nur die Farbanteile (Chroma), Helligkeit und Details bleiben erhalten." />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       Value="{Binding ColorNoiseReduction}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding ColorNoiseReduction, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>

                <!-- ENTRAUSCHEN MIT MODELL: nur fuer RAW-Dateien mit Bayer-Muster. Es rechnet in
                     der RAW-Stufe auf den Sensordaten, vor allem anderen, und steht deshalb
                     abgesetzt unter den Reglern. Fuer alles andere sagt eine Zeile, warum nicht. -->
                <StackPanel Spacing="6" IsVisible="{Binding IsModelDenoiseOffered}">
                    <!-- Misst das Rauschen und stellt nur den Regler darunter ein. Gerechnet wird
                         erst mit dem Knopf darunter: messen, nachstellen, rechnen. -->
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                            Margin="0,10,0,0"
                            Command="{Binding MeasureDenoiseStrengthCommand}"
                            ToolTip.ShowOnDisabled="True"
                            ToolTip.Tip="Misst das Rauschen im Bild und stellt die Stärke so ein, dass etwa so viel Korn bleibt wie bei einer sauberen Aufnahme mit niedrigem ISO. Entrauscht wird erst mit dem Knopf darunter.">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/magic-wand.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Stärke aus dem Bild messen" FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Button>
                    <TextBlock IsVisible="{Binding HasDenoiseMeasurement}"
                               Text="{Binding DenoiseMeasurementText}"
                               Margin="2,0,2,4" TextWrapping="Wrap"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               FontSize="{DynamicResource FP.Font.Small}"
                               Classes="no-translate" />
                    <!-- Die Staerke wirkt nur auf die Helligkeit; die Farbe kommt immer voll aus dem
                         Modell. Sie gilt beim naechsten Druck auf den Knopf. -->
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Stärke" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                                   ToolTip.Tip="Wie stark die Helligkeit entrauscht wird. Niedriger lässt mehr feine Zeichnung stehen, höher nimmt mehr Korn. Die Farbe wird immer voll entrauscht. Gilt beim nächsten Druck auf den Knopf darunter." />
                        <!-- Der Rueckfallwert des Doppelklicks ist der Startwert aus dem ViewModel
                             (DenoiseStrength). Wer den einen Wert aendert, aendert den anderen mit. -->
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="70"
                                           Value="{Binding DenoiseStrength}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding DenoiseStrength, Mode=TwoWay}" Minimum="0" Maximum="100" />
                    </Grid>
                    <!-- model-applied: das Symbol in Akzentfarbe, solange das Modell im Bild steckt. -->
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                            Classes.model-applied="{Binding IsModelDenoiseApplied}"
                            Command="{Binding DenoiseWithModelCommand}"
                            ToolTip.Tip="{Binding DenoiseWithModelHint}" ToolTip.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/sparkle.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Mit Modell entrauschen" FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Button>
                    <!-- Was im Rezept steht. Ohne diese Zeile zeigt der Zuruecksetzer der Gruppe auf
                         etwas Unsichtbares: das Entrauschen steckt NICHT in der Datei. -->
                    <TextBlock IsVisible="{Binding HasStoredDenoise}"
                               Text="{Binding StoredDenoiseText}"
                               Margin="2,4,2,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               FontSize="{DynamicResource FP.Font.Small}"
                               Classes="no-translate"
                               ToolTip.Tip="Steht im Rezept und wird beim Öffnen neu gerechnet. Das Zurücksetzen dieser Gruppe nimmt es heraus." />
                </StackPanel>
                <TextBlock IsVisible="{Binding ModelDenoiseUnavailableText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding ModelDenoiseUnavailableText}"
                           Margin="2,10,2,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}"
                           Classes="no-translate" />

            </StackPanel>
        </Expander>
    </Border>
</UserControl>
