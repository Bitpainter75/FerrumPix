<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.PathPanel">
    <Expander Header="Pfad" icons:ExpanderState.Key="path">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <icons:SvgIcon
                        Source="avares://FerrumPix/Assets/Icons/outline/vector-bezier.svg"
                        Width="14" Height="14" />
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                </StackPanel>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="8" Margin="0,8,0,0">

            <!-- WÄHREND DES ZEICHNENS. Der Hinweis steht hier und nicht im Tooltip: das Setzen von
                 Punkten ist die einzige Geste im Editor, die von sich aus nicht aufhört, und ohne
                 den Satz sucht man den Abschluss. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasPathDraft}">
                <TextBlock Text="Klicken setzt einen Eckpunkt. Klicken und ziehen krümmt. Ein Klick auf den ersten Punkt schließt den Pfad. Die RÜCKTASTE nimmt den letzten Punkt zurück, SHIFT hält den Winkel."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding FinishPathDraftCommand}"
                            ToolTip.Tip="Pfad offen abschließen (Eingabe oder Doppelklick)">
                        <TextBlock Text="Pfad abschließen" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding CancelPathDraftCommand}"
                            ToolTip.Tip="Entwurf verwerfen (ESC)">
                        <TextBlock Text="Verwerfen" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                </Grid>
            </StackPanel>

            <!-- OHNE ENTWURF UND OHNE MARKIERTEN PFAD: der Anfang. -->
            <StackPanel Spacing="6">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!HasPathDraft" />
                        <Binding Path="!CanEditPathNodes" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <TextBlock Text="Ins Bild klicken, um den ersten Punkt zu setzen. Ein fertiger Pfad zeichnet zunächst nichts ins Bild - er ist Geometrie: für eine Auswahl, eine Grundlinie für Text oder eine Form. Wer eine sichtbare Kurve will, zieht die Konturbreite hoch."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
            </StackPanel>

            <!-- MIT MARKIERTEM PFAD: die Punktarbeit. -->
            <StackPanel Spacing="8" IsVisible="{Binding CanEditPathNodes}">
                <TextBlock Text="Stützpunkte ziehen, um die Form zu ändern. Die runden Griffe krümmen den Abschnitt daneben; an einem glatten Punkt drehen sie gemeinsam, ALT löst sie voneinander. Ein Klick auf die Kurve setzt dort einen Punkt, ALT auf einem Punkt entfernt ihn, ein Doppelklick auf ein offenes Ende zeichnet weiter. Mit SHIFT sammelt man mehrere Punkte ein und bewegt oder entfernt sie zusammen."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding AddPathNodeCommand}"
                            ToolTip.Tip="Setzt einen Stützpunkt in die Mitte des längsten Abschnitts">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/plus.svg"
                                           Width="14" Height="14" />
                            <TextBlock Text="Punkt" FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding RemovePathNodeCommand}"
                            ToolTip.Tip="Entfernt den zuletzt angefassten Stützpunkt">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/minus.svg"
                                           Width="14" Height="14" />
                            <TextBlock Text="Punkt" FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding TogglePathNodeSmoothCommand}"
                            ToolTip.Tip="Den zuletzt angefassten Punkt glätten oder zur Ecke machen">
                        <TextBlock Text="Glätten / Ecke" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding ToggleSelectedPathClosedCommand}"
                            Classes.active="{Binding IsSelectedPathClosed}"
                            ToolTip.Tip="Pfad schließen oder wieder öffnen">
                        <TextBlock Text="Geschlossen" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                </Grid>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                        IsVisible="{Binding CanJoinPaths}"
                        Command="{Binding JoinPathsCommand}"
                        ToolTip.Tip="Macht aus zwei markierten offenen Pfaden einen. Verbunden werden die beiden Enden, die einander am nächsten liegen.">
                    <TextBlock Text="Pfade verbinden" HorizontalAlignment="Center"
                               FontSize="{DynamicResource FP.Font.Small}" />
                </Button>

                <!-- AUSWAHL AUS DEM PFAD: der Grund, aus dem es das Werkzeug gibt. Steht deshalb
                     VOR dem Text auf dem Pfad und mit Akzent - alles andere hier ist Zuarbeit. -->
                <Button Classes="accent" HorizontalAlignment="Stretch" Padding="8,5"
                        IsVisible="{Binding CanCreateSelectionFromPath}"
                        Command="{Binding CreateSelectionFromPathCommand}"
                        ToolTip.Tip="Macht aus der Kurve eine Auswahl. Wer den Freisteller später ändern will, zieht einen Stützpunkt und drückt noch einmal.">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/lasso.svg"
                                       Width="14" Height="14" />
                        <TextBlock Text="Auswahl aus dem Pfad" FontSize="{DynamicResource FP.Font.Small}" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                        IsVisible="{Binding CanCreateTextOnPath}"
                        Command="{Binding CreateTextOnPathCommand}"
                        ToolTip.Tip="Erzeugt ein Textobjekt, dessen Grundlinie die Punkte dieses Pfades übernimmt. Der Pfad selbst bleibt bestehen.">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/abc.svg"
                                       Width="14" Height="14" />
                        <TextBlock Text="Text auf dem Pfad" FontSize="{DynamicResource FP.Font.Small}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                    IsVisible="{Binding !HasPathDraft}"
                    Command="{Binding BeginNewPathCommand}"
                    ToolTip.Tip="Einen weiteren Pfad beginnen">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/vector-bezier.svg"
                                   Width="16" Height="16" />
                    <TextBlock Text="Neuer Pfad" FontSize="{DynamicResource FP.Font.Small}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Expander>
</UserControl>
