<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="FerrumPix.Controls.EditorPanels.FramePanel">
    <!-- Der Rahmen als Gruppe mit Haken "Aktiv" in der Kopfzeile (FrameGroupActive), wie Fuellung,
         Schatten und Gluehen: an legt ihn an bzw. blendet ihn ein, aus blendet ihn aus und behaelt
         alle Werte. Zu, solange er aus ist, auf, sobald er an ist (ExpanderState.ExpandWhen).

         Fuellung, Schatten und Gluehen des Rahmens stehen NICHT hier, sondern als eigene Gruppen
         darunter (EditorView): dieselben Panels wie im Textwerkzeug, die ueber den Rahmen-Kontext
         (IsFrameStyleContext) auf den Rahmen wirken - derselbe Mechanismus wie bei der Auswahl. -->
    <Expander Header="Rahmen" icons:ExpanderState.Key="frame"
              icons:ExpanderState.ExpandWhen="{Binding FrameGroupExpanded}"
              IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=frame}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <CheckBox VerticalAlignment="Center" MinWidth="0" Padding="0"
                                  ToolTip.Tip="{Binding $parent[Expander].DataContext.GroupActiveToolTip}"
                                  IsChecked="{Binding $parent[Expander].DataContext.FrameGroupActive}" />
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/phosphor/regular/frame-corners.svg"
                            Width="18" Height="18" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon-btn group-reset"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Command="{Binding DataContext.ResetFrameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip.Tip="Rahmen zurücksetzen">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-clockwise.svg"
                            Width="16" Height="16" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="2" Margin="0,8,0,0">
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Größe" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="25"
                                   Value="{Binding BorderSize}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding BorderSize, Mode=TwoWay}" Minimum="0" Maximum="25"
                                         Increment="0.1" FormatString="F1" />
            </Grid>
            <!-- Abstand zur Bildkante, wie die Groesse in Prozent der kuerzeren Bildseite. -->
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Randabstand" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="40" DefaultValue="0"
                                   Value="{Binding FrameMargin}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding FrameMargin, Mode=TwoWay}" Minimum="0" Maximum="40"
                                         Increment="0.1" FormatString="F1" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Rundung" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                   Value="{Binding BorderCornerRadius}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding BorderCornerRadius, Mode=TwoWay}" Minimum="0" Maximum="100" />
            </Grid>
            <Grid ColumnDefinitions="92,*" VerticalAlignment="Center">
                <TextBlock Text="Rahmenart" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding BorderEffectOptions}"
                          SelectedItem="{Binding BorderEffect}"
                          FontSize="{DynamicResource FP.Font.Small}"
                          Margin="6,0,0,0"
                          HorizontalAlignment="Stretch"
                          DropDownOpened="OnMatchWidthDropDownOpened">
                        <ComboBox.ItemTemplate>
                            <!-- Angezeigt wird uebersetzt, gespeichert bleibt der deutsche WERT: er
                                 steht im Rezept und in jedem Select Case. -->
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
            </Grid>
            <!-- Rahmen aus Symbolen: die Rahmenart oben bleibt der PFAD, auf dem sie sitzen -
                 gerade, wellig, gezackt oder in zwei Reihen. Die Groesse oben ist ihre Groesse. -->
            <Grid ColumnDefinitions="92,*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Symbol" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:SvgIcon Grid.Column="2" Source="{Binding FrameSymbolIconSource}"
                               Width="20" Height="20" Margin="6,0,0,0" VerticalAlignment="Center"
                               IsVisible="{Binding ShowFrameSymbolGallery}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding FrameSymbolOptions}"
                          SelectedItem="{Binding FrameSymbolLabel}"
                          FontSize="{DynamicResource FP.Font.Small}"
                          Margin="6,0,0,0"
                          HorizontalAlignment="Stretch"
                          DropDownOpened="OnMatchWidthDropDownOpened">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <!-- Die Sammlung ist DIESELBE Liste wie im Symbolfeld des Einfuegen-Werkzeugs, samt
                 Suche und Strichstaerke: einmal eingelesen, an beiden Stellen gezeigt. -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowFrameSymbolGallery}">
                <Grid>
                    <TextBox
                        Text="{Binding ShapeIconSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Symbol suchen…"
                        Padding="8,4,32,4"
                        FontSize="{DynamicResource FP.Font.Small}" />
                    <Button Classes="ghost"
                            Width="22"
                            Height="22"
                            Padding="0"
                            Margin="0,0,6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding ClearShapeIconSearchCommand}"
                            IsVisible="{Binding ShapeIconSearchText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                            ToolTip.Tip="Suche zurücksetzen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/x.svg"
                                       Width="18"
                                       Height="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.75"/>
                    </Button>
                </Grid>
                <WrapPanel ItemSpacing="4" LineSpacing="4">
                    <Button Classes="segmented" Classes.active="{Binding IsShapeIconWeightThin}"
                            Command="{Binding SetShapeIconWeightCommand}" CommandParameter="thin"
                            FontSize="{DynamicResource FP.Font.Small}" Padding="6,2">Dünn</Button>
                    <Button Classes="segmented" Classes.active="{Binding IsShapeIconWeightLight}"
                            Command="{Binding SetShapeIconWeightCommand}" CommandParameter="light"
                            FontSize="{DynamicResource FP.Font.Small}" Padding="6,2">Leicht</Button>
                    <Button Classes="segmented" Classes.active="{Binding IsShapeIconWeightRegular}"
                            Command="{Binding SetShapeIconWeightCommand}" CommandParameter="regular"
                            FontSize="{DynamicResource FP.Font.Small}" Padding="6,2">Normal</Button>
                    <Button Classes="segmented" Classes.active="{Binding IsShapeIconWeightBold}"
                            Command="{Binding SetShapeIconWeightCommand}" CommandParameter="bold"
                            FontSize="{DynamicResource FP.Font.Small}" Padding="6,2">Fett</Button>
                    <Button Classes="segmented" Classes.active="{Binding IsShapeIconWeightFill}"
                            Command="{Binding SetShapeIconWeightCommand}" CommandParameter="fill"
                            FontSize="{DynamicResource FP.Font.Small}" Padding="6,2">Gefüllt</Button>
                </WrapPanel>
                <TextBlock Text="Symbole werden geladen"
                           IsVisible="{Binding IsShapeIconsLoading}"
                           Margin="0,4"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding !IsShapeIconsLoading}">
                    <ItemsRepeater ItemsSource="{Binding FilteredShapeIcons}">
                        <ItemsRepeater.Layout>
                            <WrapLayout />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="ghost insert-option-btn compact"
                                        ToolTip.Tip="{Binding DisplayName}"
                                        Command="{Binding DataContext.SetFrameSymbolIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding IconPath}">
                                    <icons:SvgIcon Source="{Binding IconPath}" Width="18"
                                                   Height="18" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
            <StackPanel Spacing="2" IsVisible="{Binding ShowFrameSymbolControls}">
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Abstand" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="400" DefaultValue="50"
                                       Value="{Binding FrameSymbolSpacing}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding FrameSymbolSpacing, Mode=TwoWay}"
                                             Minimum="0" Maximum="400" Increment="5" FormatString="F0" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                    <TextBlock Text="Kontur" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="6">
                        <icons:ColorPickerButton
                            SelectedColor="{Binding FrameSymbolStrokeColorValue, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Konturbreite" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="20" DefaultValue="0"
                                       Value="{Binding FrameSymbolStrokeWidth}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding FrameSymbolStrokeWidth, Mode=TwoWay}"
                                             Minimum="0" Maximum="20" Increment="1" FormatString="F0" />
                </Grid>
                <!-- Aus: nur die Fuellung geht durch die Mischmethode, die Kontur bleibt normal
                     darueber. Ohne Mischmethode wirkungslos - dann ausgegraut, wie beim Objekt. -->
                <CheckBox Content="Kontur mitmischen"
                          IsChecked="{Binding FrameBlendIncludesStroke, Mode=TwoWay}"
                          IsEnabled="{Binding FrameUsesBlendMode}"
                          FontSize="{DynamicResource FP.Font.Small}"
                          ToolTip.Tip="Aus: nur die Füllung wird gemischt, die Kontur bleibt unverändert darüber" />
                <CheckBox Content="Symbole mitdrehen" IsChecked="{Binding FrameSymbolRotate}"
                          FontSize="{DynamicResource FP.Font.Small}"
                          ToolTip.Tip="Jedes Symbol dreht sich in die Laufrichtung des Rahmens. Aus: alle stehen aufrecht." />
            </StackPanel>

            <!-- Deckkraft, Mischen und Drehung stehen hier, nicht erst bei markierter Ebene. Sie
                 haengen an eigenen Frame*-Durchreichen und nicht an den Annotation*-Puffern: die
                 meinen nur im Rahmen-Kontext den Rahmen. -->
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Deckkraft" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="100"
                                       Value="{Binding FrameOpacity}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding FrameOpacity, Mode=TwoWay}"
                                             Minimum="0" Maximum="100" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <Grid ColumnDefinitions="92,*" VerticalAlignment="Center">
                    <TextBlock Text="Mischen" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <ComboBox Grid.Column="1"
                              Margin="6,0,0,0"
                              ItemsSource="{Binding AnnotationBlendModeOptions}"
                              SelectedItem="{Binding SelectedFrameBlendModeOption, Mode=TwoWay}"
                              FontSize="{DynamicResource FP.Font.Small}"
                              HorizontalAlignment="Stretch" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Drehung" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-180" Maximum="180"
                                       DefaultValue="0"
                                       Value="{Binding FrameRotation}" WheelIncrement="0.1"
                                       DragIncrement="0.1" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding FrameRotation, Mode=TwoWay}"
                                             Minimum="-180" Maximum="180" Increment="0.1"
                                             FormatString="F1" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Expander>
</UserControl>
