<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.DrawPanel">
    <!-- Getrennte, gerahmte Gruppen wie beim Text-Objekt (Eigenschaften/Schatten/Glühen): Farbe und
         Pinsel stehen als eigene adjustment-group-Blöcke untereinander, mit Abstand dazwischen. -->
    <StackPanel>

        <!-- FARBE (nur Pinsel) - Farbrad kopflos, wie der Farbmischer beim Text-Objekt. -->
        <Border Classes="adjustment-group" Margin="0,7,0,0" IsVisible="{Binding IsBrushPaintMode}">
            <icons:ColorMixer StrokeColor="{Binding BrushColorValue, Mode=TwoWay}"
                              StrokeLabel="Farbe"
                              ShowFill="False"
                              ShowSecondaryFill="False" />
        </Border>

        <!-- PINSEL (nur Pinsel) - Varianten und Parameter in eigener Gruppe. -->
        <Border Classes="adjustment-group" Margin="0,7,0,0" IsVisible="{Binding IsBrushPaintMode}">
            <Expander Header="{Binding CurrentToolLabel}" icons:ExpanderState.Key="draw-1">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <icons:SvgIcon Source="{Binding DataContext.CurrentToolIconSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Width="14" Height="14" />
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                        </StackPanel>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="2" Margin="0,8,0,0">
                    <!-- MALEBENE ANLEGEN wie "Text einfuegen" beim Text-Objekt: derselbe Weg wie der
                         Knopf im Ebenenpanel (EditorViewModel.AddPaintLayer). Die neue Ebene ist
                         danach markiert und der Pinsel bleibt scharf, man malt also sofort darauf. -->
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                            Margin="0,0,0,8"
                            Command="{Binding AddPaintLayerCommand}"
                            ToolTip.Tip="Neue Malebene: eine leere Ebene zum Bemalen anlegen">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/pencil-plus.svg"
                                           Width="16" Height="16" />
                            <TextBlock Text="Malebene anlegen" />
                        </StackPanel>
                    </Button>
                    <!-- Visueller Pinsel-Picker: gerenderte Beispielstriche je Variante.
                         Auf sechs Zeilen begrenzt, der Rest ist scrollbar - sonst schiebt die
                         wachsende Pinselliste Größe/Härte/Deckkraft aus dem sichtbaren Bereich.
                         243 = 6 x 38 Zeilenhöhe (28 Vorschau + 2x4 Padding + 2x1 Rahmen)
                         + 5 x 3 Abstand. -->
                    <ScrollViewer MaxHeight="243"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,6">
                    <ItemsControl ItemsSource="{Binding BrushPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="brush-preset"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding DataContext.SetBrushPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Key}"
                                        ToolTip.Tip="{Binding Label}">
                                    <Grid ColumnDefinitions="78,*" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{DynamicResource FP.Font.Small}" />
                                        <Image Grid.Column="1" Source="{Binding Preview}"
                                               Height="28" Stretch="Fill"
                                               HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Größe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="1" Maximum="2000"
                                           DefaultValue="24"
                                           Value="{Binding BrushSize}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushSize, Mode=TwoWay}"
                                                 Minimum="1" Maximum="2000" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Härte" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushHardness}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushHardness, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Deckkraft"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushOpacity}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushOpacity, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Fluss"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushFlow}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushFlow, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <!-- Glätten gilt für Pinsel, Radierer und Maskenpinsel gemeinsam und bleibt über
                         Sitzungen gemerkt (EditorViewModel.BrushSmoothing). -->
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Glätten"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Zieht den Strich ruhiger hinter dem Zeiger her und nimmt kleine Zitterer heraus. 0 folgt dem Zeiger genau" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushSmoothing}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushSmoothing, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <!-- Kompakter Farb-Button mit Hex, Pipette und zuletzt genutzten Farben. -->
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                        <TextBlock Text="Farbe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:ColorPickerButton Grid.Column="1"
                                                 SelectedColor="{Binding BrushColorValue, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <!-- BILDPINSEL: Radierer, Abwedeln, Nachbelichten, Schwamm und Farbe ersetzen in EINER
             Gruppe (EditorViewModelImageBrush.vb). Oben die Art, darunter die gemeinsamen Regler,
             dann was nur zu einer Art gehoert. Der Kopf traegt den Namen der gewaehlten Art. -->
        <Border Classes="adjustment-group" Margin="0,7,0,0" IsVisible="{Binding IsImageBrushMode}">
            <Expander Header="{Binding CurrentToolLabel}" icons:ExpanderState.Key="draw-2">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <icons:SvgIcon Source="{Binding DataContext.CurrentToolIconSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Width="14" Height="14" />
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                        </StackPanel>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="2" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <Button Classes="ghost" Padding="8,6"
                                Command="{Binding SetToolCommand}" CommandParameter="Eraser"
                                Classes.active="{Binding ImageBrushMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Eraser}"
                                ToolTip.Tip="Radiergummi: nimmt Bild weg oder malt die Hintergrundfarbe">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eraser.svg" Width="16" Height="16" />
                        </Button>
                        <Button Classes="ghost" Padding="8,6"
                                Command="{Binding SetToolCommand}" CommandParameter="Dodge"
                                Classes.active="{Binding ImageBrushMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dodge}"
                                ToolTip.Tip="Abwedeln: hellt unter dem Pinsel auf">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brightness-up.svg" Width="16" Height="16" />
                        </Button>
                        <Button Classes="ghost" Padding="8,6"
                                Command="{Binding SetToolCommand}" CommandParameter="Burn"
                                Classes.active="{Binding ImageBrushMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Burn}"
                                ToolTip.Tip="Nachbelichten: dunkelt unter dem Pinsel ab">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brightness-down.svg" Width="16" Height="16" />
                        </Button>
                        <Button Classes="ghost" Padding="8,6"
                                Command="{Binding SetToolCommand}" CommandParameter="Sponge"
                                Classes.active="{Binding ImageBrushMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Sponge}"
                                ToolTip.Tip="Schwamm: nimmt unter dem Pinsel Farbe weg oder verstärkt sie">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/droplet-half.svg" Width="16" Height="16" />
                        </Button>
                        <Button Classes="ghost" Padding="8,6"
                                Command="{Binding SetToolCommand}" CommandParameter="ReplaceColor"
                                Classes.active="{Binding ImageBrushMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ReplaceColor}"
                                ToolTip.Tip="Farbe ersetzen: färbt unter dem Pinsel um und behält Helligkeit und Struktur">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/replace.svg" Width="16" Height="16" />
                        </Button>
                        <!-- ROTE AUGEN: kein Zug, ein Klick ist ein fertiger Schritt im Pinselkreis
                             (EditorViewModel.RemoveRedEyeAt). Nur die Groesse zaehlt. -->
                        <Button Classes="ghost" Padding="8,6"
                                Command="{Binding SetToolCommand}" CommandParameter="RedEye"
                                Classes.active="{Binding ImageBrushMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=RedEye}"
                                ToolTip.Tip="Rote Augen entfernen">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eye.svg" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Größe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="1" Maximum="2000"
                                           DefaultValue="24"
                                           Value="{Binding BrushSize}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushSize, Mode=TwoWay}"
                                                 Minimum="1" Maximum="2000" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <TextBlock Text="Mit dem Pinselkreis auf die Pupille klicken. Er sollte das Rot ganz umfassen, aber nicht viel mehr: stark gerötete Haut im Kreis würde mit entfärbt."
                               IsVisible="{Binding IsRedEyeMode}"
                               Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Caption}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                    <!-- Haerte, Deckkraft, Fluss und Glaetten gehoeren zu einem Zug; Rote Augen ist ein
                         Klick mit fester Wirkung und braucht sie nicht. -->
                    <StackPanel Spacing="2" IsVisible="{Binding !IsRedEyeMode}">
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Härte" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushHardness}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushHardness, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <!-- Beim Radierer heisst der Regler Deckkraft, bei den vier uebrigen Arten Staerke:
                         derselbe Wert (BrushOpacity), dort ist er aber die Wirkung, keine Deckung. -->
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Deckkraft" IsVisible="{Binding !IsToneBrushMode}"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <TextBlock Text="Stärke" IsVisible="{Binding IsToneBrushMode}"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Wie stark ein Zug wirkt. Mehrere Züge übereinander bauen die Wirkung auf" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushOpacity}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushOpacity, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Fluss"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushFlow}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushFlow, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Glätten"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Zieht den Strich ruhiger hinter dem Zeiger her und nimmt kleine Zitterer heraus. 0 folgt dem Zeiger genau" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushSmoothing}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushSmoothing, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top" IsVisible="{Binding IsEraserPaintMode}">
                        <TextBlock Text="Hintergrundfarbe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:ColorPickerButton Grid.Column="1"
                                                 SelectedColor="{Binding EraserFillColorValue, Mode=TwoWay}" />
                    </Grid>
                    <!-- Abwedeln und Nachbelichten: auf welchen Tonbereich sie vor allem wirken. -->
                    <Grid ColumnDefinitions="92,*" VerticalAlignment="Center" IsVisible="{Binding IsDodgeBurnMode}">
                        <TextBlock Text="Bereich" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Wirkt vor allem auf die dunklen, die mittleren oder die hellen Töne" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <RadioButton GroupName="ToneRange" Content="Tiefen" IsChecked="{Binding ToneRangeShadows}"
                                         FontSize="{DynamicResource FP.Font.Small}" />
                            <RadioButton GroupName="ToneRange" Content="Mitten" IsChecked="{Binding ToneRangeMidtones}"
                                         FontSize="{DynamicResource FP.Font.Small}" />
                            <RadioButton GroupName="ToneRange" Content="Lichter" IsChecked="{Binding ToneRangeHighlights}"
                                         FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Grid>
                    <!-- Schwamm: Farbe wegnehmen oder verstaerken. -->
                    <Grid ColumnDefinitions="92,*" VerticalAlignment="Center" IsVisible="{Binding IsSpongeMode}">
                        <TextBlock Text="Wirkung" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <RadioButton GroupName="SpongeMode" Content="Entsättigen" IsChecked="{Binding SpongeDesaturate}"
                                         FontSize="{DynamicResource FP.Font.Small}" />
                            <RadioButton GroupName="SpongeMode" Content="Sättigen" IsChecked="{Binding SpongeSaturate}"
                                         FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Grid>
                    <!-- Farbe ersetzen: Farbton und Saettigung kommen von hier, die Helligkeit bleibt. -->
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top" IsVisible="{Binding IsReplaceColorMode}">
                        <TextBlock Text="Neue Farbe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Farbton und Sättigung dieser Farbe ersetzen die des Bildes; Helligkeit und Struktur bleiben" />
                        <icons:ColorPickerButton Grid.Column="1"
                                                 SelectedColor="{Binding ReplaceColorValue, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <!-- VERWISCHEN / REPARATURPINSEL / STEMPEL - gemeinsame Retusche-Parameter. -->
        <Border Classes="adjustment-group" Margin="0,7,0,0" IsVisible="{Binding ShowRetouchAdjustments}">
            <Expander Header="{Binding CurrentToolLabel}" icons:ExpanderState.Key="draw-3">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <icons:SvgIcon Source="{Binding DataContext.CurrentToolIconSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-reset"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Command="{Binding DataContext.ResetRetouchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Alle Retusche-Punkte zurücksetzen">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="2" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Radius" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="1" Maximum="2000"
                                           DefaultValue="24"
                                           Value="{Binding RetouchRadius}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding RetouchRadius, Mode=TwoWay}"
                                                 Minimum="1" Maximum="2000" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Stärke" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushHardness}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushHardness, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <!-- HAERTE DER KANTE, getrennt von der Staerke darueber: die meint die Wirkung des
                         ganzen Tupfers. Ab Werk 55, das ist die fruehere feste Kante. -->
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Härte" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="55"
                                           Value="{Binding RetouchEdgeHardness}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding RetouchEdgeHardness, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Deckkraft" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushOpacity}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushOpacity, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Fluss" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding BrushFlow}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding BrushFlow, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1"
                                                 FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <TextBlock Text="{Binding RetouchHintText}"
                                   Foreground="{DynamicResource FP.Text.Muted}"
                                   FontSize="{DynamicResource FP.Font.Caption}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Padding="8,4"
                                Margin="8,0,0,0"
                                IsVisible="{Binding IsCloneMode}"
                                IsEnabled="{Binding HasCloneSource}"
                                Command="{Binding ClearCloneSourceCommand}"
                                ToolTip.Tip="Quellpunkt verwerfen">
                            <TextBlock Text="Quelle lösen" FontSize="{DynamicResource FP.Font.Caption}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

    </StackPanel>
</UserControl>
