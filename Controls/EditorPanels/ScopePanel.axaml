<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.ScopePanel">
    <UserControl.Styles>
        <!-- Wie in der Infoleiste: Avalonia deckelt Flyouts sonst bei rund 450 Punkten und
             schneidet die native 600×300-Analyse ab. -->
        <Style Selector="FlyoutPresenter.scope-flyout">
            <Setter Property="MaxWidth" Value="720"/>
            <Setter Property="MaxHeight" Value="420"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </UserControl.Styles>

    <!-- Das Analysebild neben den Reglern. Es hat eine EIGENE Wahl der Darstellung (PanelScope,
         Kanal AdjustmentPanel): hier die Kanaltrennung, drueben in der Leiste die Verteilung -
         beides gleichzeitig sichtbar, und genau dafuer gibt es zwei Orte. Gerechnet wird aus
         demselben Bildstand, den Rest erledigt der Zwischenspeicher. -->
    <Expander Header="Analyse" icons:ExpanderState.Key="scope">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/chart-histogram.svg"
                            Width="14" Height="14" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                    </StackPanel>
                    <!-- Die Clipping-Warnung steht HIER und nicht beim Licht: das Analysepanel
                         zeigen alle fuenf Werkzeuge mit Reglern, und die Frage "frisst etwas
                         aus?" stellt sich an der Kurve oder bei den Farben genauso. In der
                         Kopfzeile bleibt der Schalter auch bei zugeklapptem Panel greifbar.
                         group-action, sonst blendet die Gruppenregel den Symbolknopf aus. -->
                    <Button Grid.Column="1"
                            Classes="icon-btn group-action"
                            Classes.active="{Binding DataContext.ShowClippingWarning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Command="{Binding DataContext.ToggleClippingWarningCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip.Tip="Ausgefressene Lichter rot und zugelaufene Tiefen blau markieren">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/alert-triangle.svg"
                            Width="14" Height="14" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="8" Margin="0,8,0,0">
            <!-- Dieselben drei Knoepfe wie in der Leiste, und aus demselben Grund nebeneinander:
                 die drei Darstellungen beantworten verschiedene Fragen. -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <Button Grid.Column="0" Classes="ghost" Classes.accent="{Binding PanelScope.IsHistogram}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="4,3" FontSize="{DynamicResource FP.Font.Small}"
                        Content="Histogramm"
                        Command="{Binding PanelScope.SetModeCommand}" CommandParameter="Histogram"/>
                <Button Grid.Column="1" Classes="ghost" Classes.accent="{Binding PanelScope.IsWaveform}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="4,3" FontSize="{DynamicResource FP.Font.Small}"
                        Content="Waveform"
                        Command="{Binding PanelScope.SetModeCommand}" CommandParameter="Waveform"/>
                <Button Grid.Column="2" Classes="ghost" Classes.accent="{Binding PanelScope.IsParade}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="4,3" FontSize="{DynamicResource FP.Font.Small}"
                        Content="RGB-Parade"
                        Command="{Binding PanelScope.SetModeCommand}" CommandParameter="Parade"/>
            </Grid>
            <!-- Beim Histogramm ein Kanal allein: dieselben Reiter und dieselbe Reihenfolge wie
                 an der Tonwertkurve, damit beide dasselbe meinen. -->
            <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding PanelScope.IsHistogram}">
                <Button Classes="info-tab channel-tab" Command="{Binding PanelScope.SetHistogramChannelCommand}"
                        CommandParameter="Rgb" Classes.active="{Binding PanelScope.IsHistogramRgb}">
                    <TextBlock Text="RGB" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="info-tab channel-tab" Command="{Binding PanelScope.SetHistogramChannelCommand}"
                        CommandParameter="Red" Classes.active="{Binding PanelScope.IsHistogramRed}">
                    <TextBlock Text="R" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="info-tab channel-tab" Command="{Binding PanelScope.SetHistogramChannelCommand}"
                        CommandParameter="Green" Classes.active="{Binding PanelScope.IsHistogramGreen}">
                    <TextBlock Text="G" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="info-tab channel-tab" Command="{Binding PanelScope.SetHistogramChannelCommand}"
                        CommandParameter="Blue" Classes.active="{Binding PanelScope.IsHistogramBlue}">
                    <TextBlock Text="B" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="info-tab channel-tab" Command="{Binding PanelScope.SetHistogramChannelCommand}"
                        CommandParameter="Luminance" Classes.active="{Binding PanelScope.IsHistogramLuminance}">
                    <TextBlock Text="L" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
            </StackPanel>
            <!-- 150 Punkt hoch wie in der Leiste: senkrecht liegen 256 Helligkeitsstufen, und bei
                 Waveform und Parade ist genau das die tragende Achse. -->
            <Panel Height="150">
                <!-- Die kleine Ansicht beantwortet die Reglerfrage schnell. Ein Klick öffnet
                     dieselbe Analyse in ihrer nativen 600×300-Größe, wie in der Infoleiste. -->
                <Button Padding="0" BorderThickness="0" Background="Transparent"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Cursor="Hand"
                        IsEnabled="{Binding PanelScopeImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Button.Flyout>
                        <Flyout Placement="Left" ShowMode="Standard"
                                FlyoutPresenterClasses="scope-flyout">
                            <Border Background="{DynamicResource FP.Bg.Input}" CornerRadius="6"
                                    ClipToBounds="True">
                                <Image Source="{Binding PanelScopeImage}" Width="600" Height="300"/>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                    <Border Background="{DynamicResource FP.Bg.Input}" CornerRadius="6" ClipToBounds="True">
                        <Image Source="{Binding PanelScopeImage}"
                               Stretch="Fill"
                               RenderOptions.BitmapInterpolationMode="LowQuality"/>
                    </Border>
                </Button>
                <!-- Solange nichts da ist, steht der Hinweis im leeren Kasten: bei einem RAW dauert
                     der Volldecode spuerbar, und ein leerer Rahmen sieht in der Zeit aus wie ein
                     Fehler statt wie Arbeit. -->
                <TextBlock Text="wird berechnet"
                           IsVisible="{Binding PanelScopeImage, Converter={x:Static ObjectConverters.IsNull}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource FP.Text.Muted}"
                           FontSize="{DynamicResource FP.Font.Small}"/>
            </Panel>
        </StackPanel>
    </Expander>
</UserControl>
