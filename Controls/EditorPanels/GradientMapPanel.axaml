<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.GradientMapPanel">
    <!-- Verlaufsumsetzung: die Helligkeit jedes Punktes waehlt eine Farbe auf dem Verlauf von der
         Tiefen- zur Lichterfarbe. Ab Werk Schwarz nach Weiss, also ein Graubild; erst die Staerke
         laesst sie wirken. -->
    <Expander Header="Verlaufsumsetzung" icons:ExpanderState.Key="gradient-map"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=gradient-map}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/gradient-linear.svg"
                            Width="14" Height="14" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon-btn group-reset"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Command="{Binding DataContext.ResetGradientMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip.Tip="Verlaufsumsetzung zurücksetzen">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                            Width="14" Height="14" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="2" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                <TextBlock Text="Tiefen" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:ColorPickerButton Grid.Column="1"
                                         SelectedColor="{Binding GradientMapShadowColorValue, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                <TextBlock Text="Lichter" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:ColorPickerButton Grid.Column="1"
                                         SelectedColor="{Binding GradientMapHighlightColorValue, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Stärke" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap" />
                <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100" DefaultValue="0"
                                   Value="{Binding GradientMapAmount}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding GradientMapAmount, Mode=TwoWay}" Minimum="0" Maximum="100" />
            </Grid>
        </StackPanel>
    </Expander>
</UserControl>
