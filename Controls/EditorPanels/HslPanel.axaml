<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.HslPanel">
    <Expander Header="Farbmischer" icons:ExpanderState.Key="hsl"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=hsl}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/color-filter.svg"
                            Width="14" Height="14" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                    </StackPanel>
                    <!-- Gruppenvergleich, beschrieben in LightPanel.axaml -->
                    <Button Grid.Column="1"
                            Classes="icon-btn group-compare"
                            Classes.comparing="{Binding DataContext.ComparingAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InListConverter}, ConverterParameter=hsl}"
                            IsVisible="{Binding DataContext.CanCompareAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Width="28" Height="28" Padding="0"
                            Command="{Binding DataContext.ToggleAdjustmentGroupCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="hsl"
                            ToolTip.Tip="Gruppe vorübergehend ausblenden, um vorher und nachher zu vergleichen">
                        <icons:SvgIcon Width="14" Height="14" />
                    </Button>
                    <Button Grid.Column="2"
                            Classes="icon-btn group-reset"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Command="{Binding DataContext.ResetHslCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip.Tip="Farbmischer zurücksetzen">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                            Width="14" Height="14" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="8" Margin="0,8,0,0">
            <!-- Die beiden Ansichten des Farbmischers als Symbolpaar: die acht Baender und die
                 Punktfarbe, die gewaehlte in der Akzentfarbe. Eine eigene Zeile, damit sie auch bei
                 schmalem Panel nicht mit den Kreisen um den Platz streitet. Im Rezept stehen beide
                 nebeneinander, die Ansicht ist nur Bedienung. -->
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <Button Classes="icon-btn group-action" Classes.active="{Binding IsMixerTab}"
                        Width="28" Height="28" CornerRadius="6"
                        Command="{Binding SelectHslTabCommand}" CommandParameter="mixer"
                        ToolTip.Tip="Farbmischer: acht Farbbänder">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/color-filter.svg" Width="18" Height="18" />
                </Button>
                <Button Classes="icon-btn group-action" Classes.active="{Binding IsPointColorTab}"
                        Width="28" Height="28" CornerRadius="6"
                        Command="{Binding SelectHslTabCommand}" CommandParameter="point"
                        ToolTip.Tip="Punktfarbe: eine Farbe im Bild aufnehmen und verschieben">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/target.svg" Width="18" Height="18" />
                </Button>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding IsMixerTab}">
            <!-- EINE ZEILE statt eines Farbrades: dieselbe Bauform wie die Etiketten der Galerie
                 (Kreis in einem runden Knopf). Das Rad brauchte 150 Bildpunkte Hoehe samt
                 Beschriftung fuer dieselbe Aussage, und darunter stehen noch drei Regler.

                 Zwei Marken je Kreis, beide ohne Zeichen: der GEWAEHLTE Kreis bekommt einen Ring
                 in der Akzentfarbe, ein ABWEICHENDES Band einen Punkt in der Mitte. Ohne die
                 zweite Marke saehe man nicht, wo sonst noch etwas eingestellt ist - bei einem
                 importierten Preset ist das der Normalfall. -->
            <ItemsControl ItemsSource="{Binding HslBandChips}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 28 Bildpunkte je Knopf bei 5 Abstand: acht davon brauchen 259 der 275
                             Bildpunkte, die im Panel wirklich zur Verfügung stehen (Spalte 330,
                             davon gehen Rahmen, Rand der Bildlaufleiste, Rand des Stapels und die
                             Polsterung der Gruppe ab). Der Rest ist Luft für die Bildlaufleiste,
                             die sich über den Inhalt legt. Die Prüfung "Farbmischer: acht Kreise
                             ..." baut genau diese Umgebung nach und wird rot, sobald die Zeile aus
                             dem Panel läuft. -->
                        <Button Classes="ghost" Width="28" Height="28" Padding="0" CornerRadius="14"
                                AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectHslBandCommand}"
                                CommandParameter="{Binding Key}"
                                PointerPressed="OnBandPointerPressed">
                            <ToolTip.Tip>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Label, Converter={StaticResource TranslateConverter}}" />
                                    <TextBlock Text="Mittlere Maustaste setzt dieses Band zurück"
                                               Foreground="{DynamicResource FP.Text.Secondary}"
                                               FontSize="{DynamicResource FP.Font.Small}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <Grid>
                                <!-- Der sichtbare Farbkreis waechst staerker als der Knopf: 20
                                     statt 16 Bildpunkte in einem Knopf von 28. Der Ring des
                                     gewaehlten Bandes liegt mit 26 knapp darum. -->
                                <Ellipse Width="20" Height="20" Fill="{Binding Fill}" />
                                <Ellipse Width="26" Height="26" StrokeThickness="2"
                                         Stroke="{DynamicResource FP.Accent}"
                                         IsVisible="{Binding IsSelected}" />
                                <Ellipse Width="7" Height="7" Fill="White"
                                         IsVisible="{Binding IsAdjusted}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding SelectedHslBandLabel}"
                       Foreground="{DynamicResource FP.Text.Secondary}"
                       FontSize="{DynamicResource FP.Font.Small}"
                       HorizontalAlignment="Center" />
            <!-- Die Regler stehen enger beieinander als Rad und Beschriftung darüber - wie in den
                 übrigen Anpassungs-Panels. -->
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Farbton" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       DefaultValue="0"
                                       Value="{Binding ActiveHslHue}"
                                   ColorTrack="{Binding ActiveHslHueTrack}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding ActiveHslHue, Mode=TwoWay}"
                                             Minimum="-100" Maximum="100" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Sättigung"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       DefaultValue="0"
                                       Value="{Binding ActiveHslSaturation}"
                                   ColorTrack="{Binding ActiveHslSaturationTrack}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding ActiveHslSaturation, Mode=TwoWay}"
                                             Minimum="-100" Maximum="100" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Luminanz"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       DefaultValue="0"
                                       Value="{Binding ActiveHslLuminance}"
                                   ColorTrack="{Binding ActiveHslLuminanceTrack}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding ActiveHslLuminance, Mode=TwoWay}"
                                             Minimum="-100" Maximum="100" Increment="1"
                                             FormatString="F0" />
                </Grid>
            </StackPanel>
            </StackPanel>

            <!-- PUNKTFARBE: eine Farbe im Bild aufnehmen und nur sie verschieben. Bis zu acht
                 Farbfelder, das gewaehlte traegt den Ring; die Regler gelten fuer das gewaehlte. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsPointColorTab}">
                <!-- Pipette und Farbfelder. Die Pipette in derselben Groesse wie am Farbwaehler;
                     die Farbfelder brechen um, wenn das Panel schmal ist, statt hinauszulaufen. -->
                <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center">
                    <Button Classes="icon-btn group-action" Width="28" Height="28" CornerRadius="6" VerticalAlignment="Top"
                            Command="{Binding PickPointColorCommand}"
                            ToolTip.Tip="Pipette: auf die Farbe im Bild klicken, die verschoben werden soll">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/color-picker.svg" Width="18" Height="18" />
                    </Button>
                    <ItemsControl Grid.Column="1" Margin="5,0,0,0" ItemsSource="{Binding PointColorChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="ghost" Width="28" Height="28" Padding="0" CornerRadius="14"
                                        AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectPointColorCommand}"
                                        CommandParameter="{Binding Index}"
                                        PointerPressed="OnPointColorPointerPressed"
                                        ToolTip.Tip="Mittlere Maustaste löscht dieses Farbfeld">
                                    <Grid>
                                        <Ellipse Width="20" Height="20" Fill="{Binding Fill}" />
                                        <Ellipse Width="26" Height="26" StrokeThickness="2"
                                                 Stroke="{DynamicResource FP.Accent}"
                                                 IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <TextBlock Text="Mit der Pipette eine Farbe im Bild aufnehmen"
                           IsVisible="{Binding !HasPointColors}"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" />
                <StackPanel Spacing="2" IsVisible="{Binding HasSelectedPointColor}">
                    <!-- Vorher und nachher: die aufgenommene Farbe und was das Feld daraus macht. -->
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Border Width="40" Height="16" CornerRadius="4" Background="{Binding SelectedPointColorSourceBrush}" />
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-right.svg" Width="12" Height="12" />
                        <Border Width="40" Height="16" CornerRadius="4" Background="{Binding SelectedPointColorResultBrush}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Farbton" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100" DefaultValue="0"
                                           Value="{Binding PointColorHueShift}" Margin="0,0"
                                           ColorTrack="{Binding PointColorHueTrackBrush}" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding PointColorHueShift, Mode=TwoWay}"
                                                 Minimum="-100" Maximum="100" Increment="1" FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Sättigung" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100" DefaultValue="0"
                                           Value="{Binding PointColorSaturationShift}" Margin="0,0"
                                           ColorTrack="{Binding PointColorSaturationTrackBrush}" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding PointColorSaturationShift, Mode=TwoWay}"
                                                 Minimum="-100" Maximum="100" Increment="1" FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Luminanz" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100" DefaultValue="0"
                                           Value="{Binding PointColorLuminanceShift}" Margin="0,0"
                                           ColorTrack="{Binding PointColorLuminanceTrackBrush}" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding PointColorLuminanceShift, Mode=TwoWay}"
                                                 Minimum="-100" Maximum="100" Increment="1" FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Streuung" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Rückt die getroffenen Farben auseinander oder näher an die aufgenommene" />
                        <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100" DefaultValue="0"
                                           Value="{Binding PointColorVariance}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding PointColorVariance, Mode=TwoWay}"
                                                 Minimum="-100" Maximum="100" Increment="1" FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Bereich" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Wie weit um die aufgenommene Farbe herum noch Farben getroffen werden" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100" DefaultValue="50"
                                           Value="{Binding PointColorRange}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding PointColorRange, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1" FormatString="F0" />
                    </Grid>
                    <CheckBox Content="Bereich anzeigen" Margin="0,4,0,0"
                              IsChecked="{Binding IsPointColorRangeVisible}"
                              FontSize="{DynamicResource FP.Font.Small}"
                              ToolTip.Tip="Zeigt grau, was das gewählte Farbfeld nicht trifft. Nur in der Vorschau" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Expander>
</UserControl>
