<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.SelectionPanel">
    <Expander Header="Auswahl" icons:ExpanderState.Key="selection">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <icons:SvgIcon
                        Source="avares://FerrumPix/Assets/Icons/outline/rectangle.svg"
                        Width="14" Height="14" />
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                </StackPanel>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="8" Margin="0,8,0,0">

            <TextBlock Text="Werkzeug" Foreground="{DynamicResource FP.Text.Secondary}"
                       FontSize="{DynamicResource FP.Font.Small}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Stretch">
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionModeCommand}" CommandParameter="Move"
                        Classes.active="{Binding SelectionMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Move}"
                        ToolTip.Tip="Verschieben">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/pointer.svg" Width="16" Height="16" />
                </Button>
                <!-- Derselbe Pinsel wie im Maskenwerkzeug, an derselben Stelle der Reihe: was ein
                     Zug bedeutet, soll nicht davon abhaengen, mit welchem Werkzeug man arbeitet.
                     Hinzufuegen und Abziehen kommen aus der Modusreihe darunter. -->
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionModeCommand}" CommandParameter="Brush"
                        Classes.active="{Binding IsBrushSelectionMode}"
                        ToolTip.Tip="Pinsel: Auswahl frei ins Bild malen - Hinzufügen und Abziehen über den Modus darunter">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brush.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionModeCommand}" CommandParameter="Rectangle"
                        Classes.active="{Binding SelectionMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Rectangle}"
                        ToolTip.Tip="Rechteck aufziehen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/rectangle.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionModeCommand}" CommandParameter="Ellipse"
                        Classes.active="{Binding SelectionMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Ellipse}"
                        ToolTip.Tip="Kreis/Ellipse aufziehen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/circle.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionModeCommand}" CommandParameter="Lasso"
                        Classes.active="{Binding SelectionMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Lasso}"
                        ToolTip.Tip="Freihand-Auswahl (Lasso)">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/lasso.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionModeCommand}" CommandParameter="MagicWand"
                        Classes.active="{Binding SelectionMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=MagicWand}"
                        ToolTip.Tip="Zauberstab: zusammenhängende Farbfläche wählen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/wand.svg" Width="16" Height="16" />
                </Button>
                <!-- Dasselbe Werkzeug wie im Maskenpanel, nur wird hier eine AUSWAHL daraus. Grau,
                     solange die Modelldatei fehlt - der Hinweis sagt dann, woran es liegt. -->
                <Button Classes="ghost" Padding="8,6"
                        IsEnabled="{Binding IsSubjectMaskAvailable}"
                        Command="{Binding SetSelectionModeCommand}" CommandParameter="Subject"
                        Classes.active="{Binding IsSubjectSelectionMode}"
                        ToolTip.Tip="{Binding SubjectMaskHint}" ToolTip.ShowOnDisabled="True">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/click.svg" Width="16" Height="16" />
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionModeCommand}" CommandParameter="ColorRange"
                        Classes.active="{Binding IsColorRangeSelectionMode}"
                        ToolTip.Tip="Farbbereich: Farbe anklicken und ähnliche Farben im ganzen Bild auswählen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/color-picker.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionModeCommand}" CommandParameter="LuminanceRange"
                        Classes.active="{Binding IsLuminanceRangeSelectionMode}"
                        ToolTip.Tip="Luminanzbereich: Schatten, Mitteltöne oder Lichter auswählen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brightness.svg" Width="16" Height="16" />
                </Button>
            </StackPanel>

            <!-- Objektauswahl: dieselben Regler wie im Maskenpanel. Sie zeichnen aus den GEMERKTEN
                 Klicks nach, ohne das Modell erneut zu fragen - ohne sie hier waere die Auswahl
                 nach dem Klick nicht mehr nachzujustieren. -->
            <!-- Pinsel: nur die Groesse. Weiche Kante und Dichte gehoeren der Maske als Ganzes und
                 stehen im Maskenwerkzeug unter den Maskeneigenschaften. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsBrushSelectionMode}">
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Pinselgröße" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="1" Maximum="500"
                                       DefaultValue="24"
                                       Value="{Binding BrushSize}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding BrushSize, Mode=TwoWay}"
                                             Minimum="1" Maximum="500" Increment="1"
                                             FormatString="F0" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding IsSubjectSelectionMode}">
                <TextBlock Text="Ein Klick ins Bild wählt das getroffene Objekt."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
                <TextBlock Text="Das erste Anklicken eines Bildes dauert einen Moment, danach geht es schnell."
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsSubjectMaskRunning}"
                           Foreground="{DynamicResource FP.Text.Muted}"
                           FontSize="{DynamicResource FP.Font.Caption}" />
                <TextBlock Text="Umfang der Auswahl" Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding SetSubjectGrainCommand}" CommandParameter="0"
                            Classes.active="{Binding IsGrainFine}"
                            ToolTip.Tip="Nur den getroffenen Teil, etwa ein Ärmel">
                        <TextBlock Text="Teil" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding SetSubjectGrainCommand}" CommandParameter="1"
                            Classes.active="{Binding IsGrainMedium}"
                            ToolTip.Tip="Den Gegenstand, zu dem der Teil gehört, etwa die Jacke">
                        <TextBlock Text="Mittel" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="2" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding SetSubjectGrainCommand}" CommandParameter="2"
                            Classes.active="{Binding IsGrainCoarse}"
                            ToolTip.Tip="Das ganze Objekt, etwa die Person">
                        <TextBlock Text="Ganzes" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Wie knapp die Kante sitzt. Klein lässt sie breiter auslaufen - für Haare, Zweige und Fell. Groß schneidet knapp - für harte Gegenstände.">
                    <TextBlock Text="Kante" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="50"
                                       Value="{Binding SubjectMaskEdge}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding SubjectMaskEdge, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Lässt die Auswahl um die Kante herum wachsen oder schrumpfen. Erkennt das Modell eine Haaresbreite zu wenig, holt man sie damit zurück.">
                    <TextBlock Text="Umfang" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       Value="{Binding SubjectMaskExtent}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding SubjectMaskExtent, Mode=TwoWay}" Minimum="-100" Maximum="100" />
                </Grid>
            </StackPanel>

            <TextBlock Text="Modus" Foreground="{DynamicResource FP.Text.Secondary}"
                       FontSize="{DynamicResource FP.Font.Small}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Stretch">
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionCombineModeCommand}" CommandParameter="New"
                        Classes.active="{Binding IsSelectionCombineNew}"
                        ToolTip.Tip="Neue Auswahl erstellen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/square.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionCombineModeCommand}" CommandParameter="Add"
                        Classes.active="{Binding IsSelectionCombineAdd}"
                        ToolTip.Tip="Zur bestehenden Auswahl hinzufügen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/square-plus.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionCombineModeCommand}" CommandParameter="Subtract"
                        Classes.active="{Binding IsSelectionCombineSubtract}"
                        ToolTip.Tip="Von der bestehenden Auswahl abziehen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/square-minus.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetSelectionCombineModeCommand}" CommandParameter="Intersect"
                        Classes.active="{Binding IsSelectionCombineIntersect}"
                        ToolTip.Tip="Schnittmenge mit bestehender Auswahl bilden">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/squares.svg" Width="16" Height="16" />
                </Button>
            </StackPanel>

            <!-- BESCHRIFTET statt als Symbol, wie im Maskenwerkzeug und aus demselben Grund: als
                 Symbolpaar hinter der Modusreihe war nicht zu sehen, dass die beiden etwas ganz
                 anderes tun als die vier davor - die sagen, was der naechste Zug tut, diese beiden
                 tun etwas mit der vorhandenen Auswahl. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                        IsEnabled="{Binding HasActiveSelection}"
                        Command="{Binding InvertSelectionCommand}"
                        ToolTip.Tip="Tauscht gewählte und freie Seite">
                    <TextBlock Text="Auswahl umkehren" FontSize="{DynamicResource FP.Font.Small}"
                               HorizontalAlignment="Center" />
                </Button>
                <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                        IsEnabled="{Binding HasActiveSelection}"
                        Command="{Binding ClearSelectionCommand}"
                        ToolTip.Tip="Hebt die Auswahl auf (STRG+D oder ESC)">
                    <TextBlock Text="Auswahl verwerfen" FontSize="{DynamicResource FP.Font.Small}"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <!-- ÜBERTRAGEN, wie bei der Maske: eine sorgfaeltig aufgebaute Auswahl ist Arbeit, und
                 dieselbe Form woanders noch einmal zu bauen war bisher der einzige Weg. Abgelegt
                 wird eine Abschrift - sie aendert sich nicht mit, wenn man die Auswahl danach
                 weiterbearbeitet. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                        IsEnabled="{Binding CanCopySelectionShape}"
                        Command="{Binding CopySelectionShapeCommand}"
                        ToolTip.Tip="Legt eine Abschrift dieser Auswahl ab">
                    <TextBlock Text="Auswahl kopieren" FontSize="{DynamicResource FP.Font.Small}"
                               HorizontalAlignment="Center" />
                </Button>
                <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                        IsEnabled="{Binding CanPasteSelectionShape}"
                        Command="{Binding PasteSelectionShapeCommand}"
                        ToolTip.Tip="Setzt die abgelegte Auswahl wieder ein. Eine vorhandene wird ersetzt">
                    <TextBlock Text="Auswahl einfügen" FontSize="{DynamicResource FP.Font.Small}"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <TextBlock Text="Auswahl im Bild erstellen, dann kopieren oder füllen."
                       Foreground="{DynamicResource FP.Text.Secondary}"
                       FontSize="{DynamicResource FP.Font.Small}"
                       TextWrapping="Wrap" />

            <!-- Zauberstab-Toleranz -->
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                  IsVisible="{Binding ShowMagicWandControls}">
                <TextBlock Text="Toleranz" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                   DefaultValue="15"
                                   Value="{Binding SelectionTolerance}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding SelectionTolerance, Mode=TwoWay}"
                                         Minimum="0" Maximum="100" Increment="1"
                                         FormatString="F0" />
            </Grid>
            <StackPanel Spacing="6" IsVisible="{Binding IsColorRangeSelectionMode}">
                <TextBlock Text="Eine Farbe im Bild anklicken; ähnliche Farben werden überall ausgewählt."
                           TextWrapping="Wrap" Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
                <Grid ColumnDefinitions="92,*,44">
                    <TextBlock Text="Toleranz" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ColorRangeTolerance}" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value" Value="{Binding ColorRangeTolerance, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44">
                    <TextBlock Text="Übergang" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding ColorRangeFeather}" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value" Value="{Binding ColorRangeFeather, Mode=TwoWay}" Minimum="1" Maximum="100" />
                </Grid>
                <CheckBox Content="Zusammenhängend"
                          IsChecked="{Binding ColorRangeContiguous}"
                          FontSize="{DynamicResource FP.Font.Small}"
                          ToolTip.Tip="Wählt nur die zusammenhängende Fläche am Klickpunkt statt gleicher Farben im ganzen Bild" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsLuminanceRangeSelectionMode}">
                <Grid ColumnDefinitions="92,*,44">
                    <TextBlock Text="Von" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LuminanceRangeFrom}" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value" Value="{Binding LuminanceRangeFrom, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44">
                    <TextBlock Text="Bis" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LuminanceRangeTo}" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value" Value="{Binding LuminanceRangeTo, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44">
                    <TextBlock Text="Übergang" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding LuminanceRangeFeather}" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value" Value="{Binding LuminanceRangeFeather, Mode=TwoWay}" Minimum="0" Maximum="50" />
                </Grid>
            </StackPanel>
            <!-- Weiche Kante: wirkt auf Anpassungen in der Auswahl, auf Kopieren und auf Füllen. Die Maske
                 selbst bleibt hart gespeichert, der Wert ist deshalb jederzeit nachträglich änderbar.
                 Denselben Regler benutzt der Masken-Pinsel im Werkzeug „Maske" für seine Randweichheit
                 (dort in die Stempel gebacken, siehe SelectionMaskSoftBaked). -->
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Weiche Kante" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                           ToolTip.Tip="Lässt die Auswahlkante über die angegebene Anzahl Bildpixel weich auslaufen (0 = harte Kante)" />
                <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="200"
                                   DefaultValue="0"
                                   Value="{Binding SelectionFeather}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding SelectionFeather, Mode=TwoWay}"
                                         Minimum="0" Maximum="200" Increment="1"
                                         FormatString="F0" />
            </Grid>
            <Button Classes="ghost"
                    HorizontalAlignment="Stretch"
                    Padding="10,6"
                    IsEnabled="{Binding HasActiveSelection}"
                    Command="{Binding CreateAdjustmentLayerFromSelectionCommand}"
                    ToolTip.Tip="Aus der Auswahl direkt eine Auswahlebene erstellen (ohne erst eine Anpassung ändern zu müssen)">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/adjustments-plus.svg"
                                   Width="16" Height="16" />
                    <TextBlock Text="Neue Auswahlebene" />
                </StackPanel>
            </Button>

            <Button Classes="ghost"
                    HorizontalAlignment="Stretch"
                    Padding="10,6"
                    IsEnabled="{Binding HasActiveSelection}"
                    Command="{Binding CopySelectionCommand}"
                    ToolTip.Tip="Auswahlinhalt als neues, frei verschiebbares Bild-Objekt kopieren">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/photo.svg"
                                   Width="16" Height="16" />
                    <TextBlock Text="Als Bild kopieren" />
                </StackPanel>
            </Button>

            <Border Height="1" Background="{DynamicResource FP.Border.Normal}" Margin="0,4,0,0" />
            <TextBlock Text="Füllen" Foreground="{DynamicResource FP.Text.Secondary}"
                       FontSize="{DynamicResource FP.Font.Small}" FontWeight="SemiBold" />
            <!-- WrapPanel statt StackPanel: die Beschriftungen sprengen sonst die Spaltenbreite.
                 In der laengsten Sprache summieren sich "Vollfarbe|Verlauf|Radial" auf 28 Zeichen -
                 im Deutschen passt es knapp, anderswo nicht. Umbruch statt fester Aufteilung, damit
                 es sich nach der tatsaechlichen Breite richtet.
                 Abstaende ueber Margin je Knopf, weil WrapPanel kein Spacing kennt. -->
            <WrapPanel Orientation="Horizontal">
                <Button Classes="ghost" Padding="8,4" Margin="0,0,6,4"
                        Command="{Binding SetAnnotationFillKindCommand}"
                        CommandParameter="Solid"
                        Classes.active="{Binding AnnotationFillKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Solid}">
                    <TextBlock Text="Vollfarbe" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,4" Margin="0,0,6,4"
                        Command="{Binding SetAnnotationFillKindCommand}"
                        CommandParameter="LinearGradient"
                        Classes.active="{Binding AnnotationFillKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=LinearGradient}">
                    <TextBlock Text="Verlauf" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,4" Margin="0,0,6,4"
                        Command="{Binding SetAnnotationFillKindCommand}"
                        CommandParameter="RadialGradient"
                        Classes.active="{Binding AnnotationFillKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=RadialGradient}">
                    <TextBlock Text="Radial" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
            </WrapPanel>
            <Grid ColumnDefinitions="92,*" VerticalAlignment="Top">
                <TextBlock Text="Farbe 1" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:ColorPickerButton Grid.Column="1"
                                         SelectedColor="{Binding AnnotationFillColorValue, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="92,*" VerticalAlignment="Top"
                  IsVisible="{Binding ShowGradientFillControls}">
                <TextBlock Text="Farbe 2" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:ColorPickerButton Grid.Column="1"
                                         SelectedColor="{Binding AnnotationFillColor2Value, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                  IsVisible="{Binding ShowLinearGradientAngleControl}">
                <TextBlock Text="Winkel" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="360"
                                   DefaultValue="0"
                                   Value="{Binding AnnotationGradientAngleDegrees}"
                                   Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding AnnotationGradientAngleDegrees, Mode=TwoWay}"
                                         Minimum="0" Maximum="360" Increment="1"
                                         FormatString="F0" />
            </Grid>
            <CheckBox Content="Verlauf invertieren"
                      IsChecked="{Binding AnnotationGradientInverted}" FontSize="{DynamicResource FP.Font.Small}"
                      IsVisible="{Binding ShowRadialGradientControl}" />
            <Button Classes="accent"
                    HorizontalAlignment="Stretch"
                    Padding="10,6"
                    IsEnabled="{Binding HasActiveSelection}"
                    Command="{Binding FillSelectionCommand}"
                    ToolTip.Tip="Auswahl mit der gewählten Füllung füllen">
                <TextBlock Text="Auswahl füllen" HorizontalAlignment="Center" />
            </Button>
            <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                Margin="0,10,0,0"
                IsVisible="{Binding IsMoveSelectionMode}"
                            IsEnabled="{Binding CanConvertKind}"
                            Command="{Binding ConvertKindCommand}"
                            ToolTip.Tip="{Binding ConvertKindHint}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrows-exchange.svg"
                                           Width="16" Height="16" />
                            <TextBlock Classes="no-translate" Text="{Binding ConvertKindText}" />
                        </StackPanel>
            </Button>
                        
            <!-- OBJEKT ENTFERNEN: braucht nur eine Markierung, egal aus welchem Zweig sie kommt -
                 gemalt, per Klick erkannt oder nach Entfernung ausgewaehlt. Deshalb steht der Knopf
                 nicht in einem der Zweige, sondern unter allen. -->
            <StackPanel Spacing="6" Margin="0,4,0,0">
                <Separator Margin="0,2,0,2" Background="{DynamicResource FP.Border.Normal}" Height="1"/>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                        IsEnabled="{Binding CanRemoveObject}"
                        Command="{Binding RemoveObjectCommand}"
                        ToolTip.Tip="{Binding RemoveObjectHint}" ToolTip.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eraser.svg"
                                       Width="16" Height="16" />
                        <TextBlock Text="Objekt entfernen" FontSize="{DynamicResource FP.Font.Small}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            
        </StackPanel>
        
    </Expander>
</UserControl>
