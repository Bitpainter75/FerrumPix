<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.SharpnessPanel">
    <StackPanel Spacing="7">
        <Border Classes="adjustment-group"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=sharpen}">
            <Expander Header="Schärfen" icons:ExpanderState.Key="sharpen">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/adjustments.svg"
                                    Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <!-- Gruppenvergleich, beschrieben in LightPanel.axaml -->
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-compare"
                                    Classes.comparing="{Binding DataContext.ComparingAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InListConverter}, ConverterParameter=sharpen}"
                                    IsVisible="{Binding DataContext.CanCompareAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Width="28" Height="28" Padding="0"
                                    Command="{Binding DataContext.ToggleAdjustmentGroupCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="sharpen"
                                    ToolTip.Tip="Gruppe vorübergehend ausblenden, um vorher und nachher zu vergleichen">
                                <icons:SvgIcon Width="14" Height="14" />
                            </Button>
                            <Button Grid.Column="2"
                                    Classes="icon-btn group-reset"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Command="{Binding DataContext.ResetSharpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Schärfen zurücksetzen">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="2" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Stärke" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="150"
                                           Value="{Binding Sharpness}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding Sharpness, Mode=TwoWay}" Minimum="0" Maximum="150" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Radius" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Wirkgröße der Schärfung: 0 = feine Kanten, höher schärft gröbere Strukturen." />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           Value="{Binding SharpenRadius}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding SharpenRadius, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                 Increment="0.1" FormatString="F1" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Details" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Hebt die feinen Details bei der Schärfung stärker hervor." />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           Value="{Binding SharpenDetail}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding SharpenDetail, Mode=TwoWay}" Minimum="0" Maximum="100" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Maskieren" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Beschränkt die Schärfung auf Kanten: 0 schärft die ganze Fläche, höher lässt glatte Flächen wie Himmel und Haut ruhig. Mit dem Zeiger darauf einmal ALT antippen zeigt die Gewichtung: hell wird geschärft, dunkel bleibt ruhig. Noch einmal ALT nimmt sie weg." />
                        <icons:RoundSlider x:Name="MaskingSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                           Value="{Binding SharpenMasking}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding SharpenMasking, Mode=TwoWay}" Minimum="0" Maximum="100" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*" VerticalAlignment="Center">
                        <TextBlock Text="Methode" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <ComboBox Name="SharpenMethodComboBox"
                                  Grid.Column="1"
                                  ItemsSource="{Binding SharpenMethodOptions}"
                                  SelectedItem="{Binding SharpenMethodLabel}"
                                  FontSize="{DynamicResource FP.Font.Small}"
                                  Margin="6,0,0,0"
                                  HorizontalAlignment="Stretch"
                                  DropDownOpened="OnMatchWidthDropDownOpened"
                                  ToolTip.Tip="Unsharp Mask: verstärkt Kanten und legt dabei helle und dunkle Säume an. Deconvolution: rechnet die Unschärfe zurück, feine Zeichnung wird ohne Säume wieder steil. Details steht dort für die Zahl der Durchläufe." />
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>
    </StackPanel>
</UserControl>
