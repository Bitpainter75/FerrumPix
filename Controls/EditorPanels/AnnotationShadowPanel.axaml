<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.AnnotationShadowPanel">
    <Expander Header="Schatten" icons:ExpanderState.Key="shadow"
              icons:ExpanderState.ExpandWhen="{Binding AnnotationShadowEnabled}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- "Aktiv" als Haken IN DER KOPFZEILE, ohne Text: auch bei zugeklappter Gruppe
                         zu sehen; an klappt sie auf, aus klappt sie zu (ExpanderState.ExpandWhen). -->
                    <CheckBox VerticalAlignment="Center" MinWidth="0" Padding="0"
                              ToolTip.Tip="{Binding $parent[Expander].DataContext.GroupActiveToolTip}"
                              IsChecked="{Binding $parent[Expander].DataContext.AnnotationShadowEnabled}" />
                    <icons:SvgIcon
                        Source="avares://FerrumPix/Assets/Icons/outline/shadow.svg"
                        Width="14" Height="14" />
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="2" Margin="0,8,0,0">
            <StackPanel Spacing="2" IsVisible="{Binding AnnotationShadowEnabled}">
                <!-- Lage: aussen unter dem Objekt (wie schon immer), innen auf seiner Flaeche an der
                     dem Licht zugewandten Kante, oder beides mit denselben Werten
                     (ImageAnnotation.ShadowPlacement, ImageProcessor.DrawInnerSilhouetteEffects). -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Classes="ghost" Padding="8,4" Margin="0,0,6,4"
                            Command="{Binding SetAnnotationShadowPlacementCommand}" CommandParameter=""
                            Classes.active="{Binding IsShadowOutside}"
                            ToolTip.Tip="Schatten unter dem Objekt">
                        <TextBlock Text="Außen" FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                    <Button Classes="ghost" Padding="8,4" Margin="0,0,6,4"
                            Command="{Binding SetAnnotationShadowPlacementCommand}" CommandParameter="Inside"
                            Classes.active="{Binding IsShadowInside}"
                            ToolTip.Tip="Schatten auf der Fläche, an der dem Licht zugewandten Innenkante">
                        <TextBlock Text="Innen" FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                    <Button Classes="ghost" Padding="8,4" Margin="0,0,6,4"
                            Command="{Binding SetAnnotationShadowPlacementCommand}" CommandParameter="Both"
                            Classes.active="{Binding IsShadowBoth}"
                            ToolTip.Tip="Außen und innen mit denselben Werten">
                        <TextBlock Text="Beides" FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                </WrapPanel>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                    <TextBlock Text="Farbe" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:ColorPickerButton Grid.Column="1"
                                             SelectedColor="{Binding AnnotationShadowColorValue, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Lichtwinkel"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="360"
                                       DefaultValue="225"
                                       Value="{Binding AnnotationShadowLightAngle}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AnnotationShadowLightAngle, Mode=TwoWay}"
                                             Minimum="0" Maximum="360" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Versatz X"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       DefaultValue="4"
                                       WheelIncrement="0.1" DragIncrement="0.1"
                                       Value="{Binding AnnotationShadowOffsetX}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AnnotationShadowOffsetX, Mode=TwoWay}"
                                             Minimum="-100" Maximum="100" Increment="0.1" CoarseIncrement="1"
                                             FormatString="F1" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Versatz Y"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       DefaultValue="4"
                                       WheelIncrement="0.1" DragIncrement="0.1"
                                       Value="{Binding AnnotationShadowOffsetY}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AnnotationShadowOffsetY, Mode=TwoWay}"
                                             Minimum="-100" Maximum="100" Increment="0.1" CoarseIncrement="1"
                                             FormatString="F1" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Weichzeichnen"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="6"
                                       Value="{Binding AnnotationShadowBlur}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AnnotationShadowBlur, Mode=TwoWay}"
                                             Minimum="0" Maximum="100" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Stärke" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="100"
                                       Value="{Binding AnnotationShadowStrength}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AnnotationShadowStrength, Mode=TwoWay}"
                                             Minimum="0" Maximum="100" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <!-- Groesse und Abrunden gelten nur aussen: innen liegt der Schatten auf der Flaeche
                     selbst, die sich weder vergroessern noch abrunden laesst. -->
                <StackPanel Spacing="2" IsVisible="{Binding ShowShadowOuterControls}">
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Größe" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="25" Maximum="300"
                                       DefaultValue="100"
                                       Value="{Binding AnnotationShadowSize}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AnnotationShadowSize, Mode=TwoWay}"
                                             Minimum="25" Maximum="300" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <CheckBox Content="Abgerundet" IsChecked="{Binding AnnotationShadowRounded}"
                          Margin="0,4,0,0" FontSize="{DynamicResource FP.Font.Small}" />
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      IsVisible="{Binding AnnotationShadowRounded}">
                    <TextBlock Text="Rundung" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="20"
                                       Value="{Binding AnnotationShadowCornerRadius}"
                                       Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AnnotationShadowCornerRadius, Mode=TwoWay}"
                                             Minimum="0" Maximum="100" Increment="1"
                                             FormatString="F0" />
                </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Expander>
</UserControl>
