<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.RotatePanel">
    <!-- DREHEN, AUSRICHTEN UND SPIEGELN gehoeren zum Zuschnitt: beides sagt, welcher Teil des
         Bildes in welcher Lage stehen bleibt, und beides wird im Werkzeug "Transformieren"
         nacheinander bedient. Das Verzerren steht seitdem fuer sich (WarpPanel) - dort geht es
         nicht um die Lage, sondern um die Form. -->
    <Border Classes="adjustment-group">
        <Expander Header="Drehen" icons:ExpanderState.Key="transform">
            <Expander.HeaderTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <!-- Das gedrehte Rechteck steht fuer die Gruppe. Der Rahmen gehoert
                                 dem ganzen Werkzeug, und die beiden Drehpfeile darunter sind
                                 die einzelnen Knoepfe - beide waeren hier eine Dopplung. -->
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/rotate-rectangle.svg"
                                Width="14" Height="14" />
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="icon-btn group-reset"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding DataContext.ResetTransformCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip.Tip="Drehen zurücksetzen">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                Width="14" Height="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </Expander.HeaderTemplate>
            <StackPanel Spacing="8" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="ghost" Height="44" Padding="8,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding RotateLeftCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/rotate-2.svg"
                                Width="20" Height="20" />
                            <TextBlock Text="Links" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" Height="44" Padding="8,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding RotateRightCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise-2.svg"
                                Width="20" Height="20" />
                            <TextBlock Text="Rechts" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Ausrichten"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-180" Maximum="180"
                                       DefaultValue="0"
                                       Value="{Binding StraightenDegrees}"
                                       WheelIncrement="0.1"
                                       Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding StraightenDegrees, Mode=TwoWay}"
                                             Minimum="-180" Maximum="180" Increment="0.1"
                                             FormatString="F1" />
                </Grid>
                <CheckBox Content="Leinwand automatisch vergrößern"
                          IsChecked="{Binding StraightenExpandCanvas}"
                          FontSize="{DynamicResource FP.Font.Small}"
                          ToolTip.Tip="Vergrößert die Leinwand beim Ausrichten so, dass keine Bildecken abgeschnitten werden" />
                <!-- KEIN EIGENER ANWENDEN-KNOPF MEHR: Ausschnitt und Lage haengen aneinander (eine
                     Drehung versetzt den Rahmen) und werden von EINEM Knopf unter beiden Gruppen
                     uebernommen - siehe EditorView, direkt unter diesem Panel. -->

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="ghost" Height="44" Padding="8,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding FlipHorizontalCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/flip-horizontal.svg"
                                Width="20" Height="20" />
                            <TextBlock Text="Horizontal" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" Height="44" Padding="8,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding FlipVerticalCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/flip-vertical.svg"
                                Width="20" Height="20" />
                            <TextBlock Text="Vertikal" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Expander>
    </Border>
</UserControl>
