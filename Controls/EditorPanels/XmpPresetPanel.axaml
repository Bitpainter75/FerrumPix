<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.XmpPresetPanel">
    <Expander Header="XMP-Preset" icons:ExpanderState.Key="xmp-preset"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=xmp-preset}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/filter.svg"
                            Width="14" Height="14" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon-btn group-reset"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Command="{Binding DataContext.ResetXmpPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip.Tip="Preset entfernen und Regler zurücksetzen">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                            Width="14" Height="14" />
                    </Button>
                    <Button Grid.Column="2"
                            Classes="icon-btn"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Click="OnLoadXmpPresetClick"
                            ToolTip.Tip="XMP laden">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/circle-plus.svg"
                            Width="14" Height="14" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="6" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Classes="ghost" Padding="8,5"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        BorderBrush="{DynamicResource FP.Accent}"
                        Click="OnLoadXmpPresetClick">
                    <TextBlock Text="XMP laden" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Grid.Column="1" Classes="ghost" Padding="8,5"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        BorderBrush="{DynamicResource FP.Accent}"
                        Click="OnLoadXmpFolderClick">
                    <TextBlock Text="Ordner laden" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
            </Grid>
            <StackPanel Spacing="3" Margin="0,2,0,2">
                <TextBlock Text="Zusätzlich anwenden" FontSize="{DynamicResource FP.Font.Small}"
                           Foreground="{DynamicResource FP.Text.Muted}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                    <CheckBox Grid.Row="0" Grid.Column="0" Content="Objektivkorrektur"
                              IsChecked="{Binding ImportXmpLensCorrections}"
                              ToolTip.Tip="Übernimmt die im XMP aktivierte Objektivkorrektur, sofern passende Messdaten vorhanden sind" />
                    <CheckBox Grid.Row="0" Grid.Column="1" Content="Farbsäume korrigieren"
                              IsChecked="{Binding ImportXmpChromaticAberration}"
                              ToolTip.Tip="Korrigiert Farbsäume an kontrastreichen Kanten" />
                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Ausrichten &amp; Perspektive"
                              IsChecked="{Binding ImportXmpTransform}"
                              ToolTip.Tip="Übernimmt Begradigen sowie horizontale, vertikale und Seitenverhältnis-Korrekturen" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Zuschnitt"
                              IsChecked="{Binding ImportXmpCrop}"
                              ToolTip.Tip="Übernimmt den in Lightroom gespeicherten Bildausschnitt" />
                </Grid>
                <TextBlock Text="Adobe-Profile werden erkannt; ihre 3D-Daten liegen meist nicht in der XMP."
                           TextWrapping="Wrap" FontSize="{DynamicResource FP.Font.Small}"
                           Foreground="{DynamicResource FP.Text.Muted}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SavedXmpPresets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="look-pill"
                                Classes.active="{Binding IsLastApplied}"
                                CornerRadius="12"
                                Background="{DynamicResource FP.Bg.Input}"
                                BorderBrush="{DynamicResource FP.Border.Normal}"
                                BorderThickness="1"
                                Margin="0,0,6,6"
                                Padding="0">
                            <!-- Die Polsterung sitzt in den Schaltflaechen, nicht am Rahmen: lag sie
                                 aussen, war nur der Text selbst anklickbar und ein Treffer knapp
                                 darueber oder darunter tat nichts. -->
                            <Grid ColumnDefinitions="Auto,Auto">
                                <Button Grid.Column="0"
                                        Classes="ghost"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,4,4,4"
                                        Click="OnApplySavedXmpPresetClick">
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FP.Font.Small}" />
                                </Button>
                                <Button Grid.Column="1"
                                        Classes="ghost"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,4,8,4"
                                        Click="OnRemoveSavedXmpPresetClick"
                                        ToolTip.Tip="Preset entfernen">
                                    <TextBlock Text="×" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource FP.Text.Muted}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Expander>
</UserControl>
