<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.ResizePanel">
    <StackPanel Spacing="7">
        <Border Classes="adjustment-group">
            <Expander Header="Bildgröße" icons:ExpanderState.Key="resize-size">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/aspect-ratio.svg"
                            Width="14" Height="14" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon-btn group-reset"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Command="{Binding DataContext.ResetResizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip.Tip="Größe zurücksetzen">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                            Width="14" Height="14" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="8" Margin="0,8,0,0">
            <Grid ColumnDefinitions="92,*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Breite" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:SliderValueUpDown Classes="combo-like" Grid.Column="1"
                               Value="{Binding ResizeWidth}" Minimum="0" Maximum="50000"
                               Increment="10" Margin="6,0,0,0" FontSize="{DynamicResource FP.Font.Small}" />
                <TextBlock Grid.Column="2" Text="px"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
            </Grid>
            <Grid ColumnDefinitions="92,*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Höhe" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:SliderValueUpDown Classes="combo-like" Grid.Column="1"
                               Value="{Binding ResizeHeight}" Minimum="0" Maximum="50000"
                               Increment="10" Margin="6,0,0,0" FontSize="{DynamicResource FP.Font.Small}" />
                <TextBlock Grid.Column="2" Text="px"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
            </Grid>
            <CheckBox Content="Seitenverhältnis beibehalten"
                      IsChecked="{Binding LockResizeAspect}" FontSize="{DynamicResource FP.Font.Small}" />
            <Grid ColumnDefinitions="108,*" VerticalAlignment="Center">
                <TextBlock Text="Neuberechnung"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ResizeInterpolationOptions}"
                          SelectedItem="{Binding ResizeInterpolationLabel}"
                          FontSize="{DynamicResource FP.Font.Small}"
                          Margin="6,0,0,0"
                          HorizontalAlignment="Stretch"
                          DropDownOpened="OnMatchWidthDropDownOpened"
                          ToolTip.Tip="Berechnungsmethode für die Größenänderung">
                        <ComboBox.ItemTemplate>
                            <!-- Angezeigt wird uebersetzt, gespeichert bleibt der deutsche WERT: er
                                 steht im Rezept und in jedem Select Case. -->
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
            </Grid>
            <WrapPanel>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}"
                        CommandParameter="Original">
                    <TextBlock Text="Original" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="75%">
                    <TextBlock Text="75%" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="50%">
                    <TextBlock Text="50%" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="25%">
                    <TextBlock Text="25%" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="UHD">
                    <TextBlock Text="UHD" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}"
                        CommandParameter="Full-HD">
                    <TextBlock Text="Full-HD" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="SD">
                    <TextBlock Text="SD" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="1500">
                    <TextBlock Text="1500" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="1000">
                    <TextBlock Text="1000" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="800">
                    <TextBlock Text="800" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="500">
                    <TextBlock Text="500" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="256">
                    <TextBlock Text="256" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="128">
                    <TextBlock Text="128" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="64">
                    <TextBlock Text="64" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
                <Button Classes="ghost" Padding="8,5" Margin="0,0,6,6"
                        Command="{Binding SetResizePresetCommand}" CommandParameter="32">
                    <TextBlock Text="32" FontSize="{DynamicResource FP.Font.Small}" />
                </Button>
            </WrapPanel>
            <Button Classes="accent"
                    HorizontalAlignment="Stretch"
                    Padding="10,6"
                    Command="{Binding ApplyResizeCommand}"
                    IsEnabled="{Binding HasImageResizeChanges}"
                    ToolTip.Tip="Bildgröße auf die Vorschau anwenden">
                <StackPanel Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center">
                    <icons:SvgIcon
                        Source="avares://FerrumPix/Assets/Icons/outline/resize.svg"
                        Width="16" Height="16" />
                    <TextBlock Text="Bildgröße anwenden" />
                </StackPanel>
            </Button>
        </StackPanel>
            </Expander>
        </Border>

        <Border Classes="adjustment-group"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=resize-canvas}">
            <Expander Header="Leinwand" icons:ExpanderState.Key="resize-canvas">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/layout.svg"
                                    Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-reset"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    Command="{Binding DataContext.ResetCanvasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Leinwand zurücksetzen">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="13" Height="13" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="92,*,Auto" VerticalAlignment="Center">
                        <TextBlock Text="Breite" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:SliderValueUpDown Classes="combo-like" Grid.Column="1"
                                       Value="{Binding CanvasWidth}" Minimum="0" Maximum="50000"
                                       Increment="10" Margin="6,0,0,0" FontSize="{DynamicResource FP.Font.Small}" />
                        <TextBlock Grid.Column="2" Text="px"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,Auto" VerticalAlignment="Center">
                        <TextBlock Text="Höhe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:SliderValueUpDown Classes="combo-like" Grid.Column="1"
                                       Value="{Binding CanvasHeight}" Minimum="0" Maximum="50000"
                                       Increment="10" Margin="6,0,0,0" FontSize="{DynamicResource FP.Font.Small}" />
                        <TextBlock Grid.Column="2" Text="px"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    </Grid>
                    <CheckBox Content="Seitenverhältnis beibehalten"
                              IsChecked="{Binding LockCanvasAspect}" FontSize="{DynamicResource FP.Font.Small}" />
                    <Grid ColumnDefinitions="92,*" VerticalAlignment="Top">
                        <TextBlock Text="Position" Foreground="{DynamicResource FP.Text.Secondary}"
                                   FontSize="{DynamicResource FP.Font.Small}" VerticalAlignment="Top" Margin="0,10,0,0" />
                        <Border Grid.Column="1" BorderBrush="{DynamicResource FP.Border.Normal}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10"
                                HorizontalAlignment="Left">
                            <Grid Width="72" Height="72">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Classes="anchor-dot"
                                Command="{Binding SetCanvasAnchorCommand}"
                                CommandParameter="TopLeft" ToolTip.Tip="Anker oben links">
                            <Grid>
                                <Border Classes="anchor-dot-idle" />
                                <Border Classes="anchor-dot-active"
                                        IsVisible="{Binding CanvasAnchor, Converter={StaticResource StringEqualsConverter}, ConverterParameter=TopLeft}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1" Classes="anchor-dot"
                                Command="{Binding SetCanvasAnchorCommand}"
                                CommandParameter="Top" ToolTip.Tip="Anker oben">
                            <Grid>
                                <Border Classes="anchor-dot-idle" />
                                <Border Classes="anchor-dot-active"
                                        IsVisible="{Binding CanvasAnchor, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Top}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="2" Classes="anchor-dot"
                                Command="{Binding SetCanvasAnchorCommand}"
                                CommandParameter="TopRight" ToolTip.Tip="Anker oben rechts">
                            <Grid>
                                <Border Classes="anchor-dot-idle" />
                                <Border Classes="anchor-dot-active"
                                        IsVisible="{Binding CanvasAnchor, Converter={StaticResource StringEqualsConverter}, ConverterParameter=TopRight}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="0" Classes="anchor-dot"
                                Command="{Binding SetCanvasAnchorCommand}"
                                CommandParameter="Left" ToolTip.Tip="Anker links">
                            <Grid>
                                <Border Classes="anchor-dot-idle" />
                                <Border Classes="anchor-dot-active"
                                        IsVisible="{Binding CanvasAnchor, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Left}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Classes="anchor-dot"
                                Command="{Binding SetCanvasAnchorCommand}"
                                CommandParameter="Center" ToolTip.Tip="Anker Mitte">
                            <Grid>
                                <Border Classes="anchor-dot-idle" />
                                <Border Classes="anchor-dot-active"
                                        IsVisible="{Binding CanvasAnchor, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Center}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="2" Classes="anchor-dot"
                                Command="{Binding SetCanvasAnchorCommand}"
                                CommandParameter="Right" ToolTip.Tip="Anker rechts">
                            <Grid>
                                <Border Classes="anchor-dot-idle" />
                                <Border Classes="anchor-dot-active"
                                        IsVisible="{Binding CanvasAnchor, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Right}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="0" Classes="anchor-dot"
                                Command="{Binding SetCanvasAnchorCommand}"
                                CommandParameter="BottomLeft"
                                ToolTip.Tip="Anker unten links">
                            <Grid>
                                <Border Classes="anchor-dot-idle" />
                                <Border Classes="anchor-dot-active"
                                        IsVisible="{Binding CanvasAnchor, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BottomLeft}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="1" Classes="anchor-dot"
                                Command="{Binding SetCanvasAnchorCommand}"
                                CommandParameter="Bottom" ToolTip.Tip="Anker unten">
                            <Grid>
                                <Border Classes="anchor-dot-idle" />
                                <Border Classes="anchor-dot-active"
                                        IsVisible="{Binding CanvasAnchor, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Bottom}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="2" Classes="anchor-dot"
                                Command="{Binding SetCanvasAnchorCommand}"
                                CommandParameter="BottomRight"
                                ToolTip.Tip="Anker unten rechts">
                            <Grid>
                                <Border Classes="anchor-dot-idle" />
                                <Border Classes="anchor-dot-active"
                                        IsVisible="{Binding CanvasAnchor, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BottomRight}" />
                            </Grid>
                        </Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <Button Classes="accent"
                            HorizontalAlignment="Stretch"
                            Padding="10,6"
                            Command="{Binding ApplyCanvasCommand}"
                            IsEnabled="{Binding HasCanvasSizeChanges}"
                            ToolTip.Tip="Leinwandgröße auf die Vorschau anwenden">
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Center">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/frame.svg"
                                Width="16" Height="16" />
                            <TextBlock Text="Leinwandgröße anwenden" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Expander>
        </Border>

        <!-- HINTERGRUND: eine Eigenschaft des Dokuments, kein Werkzeug. Sie steht hier, weil hier
             der Platz entsteht, der sie braucht - eine erweiterte Leinwand ist sonst durchsichtig.
             Sie fuellt aber ALLES Durchsichtige, auch die leeren Ecken von Begradigen und Verzerren
             und weggeradierte Stellen. -->
        <Border Classes="adjustment-group"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=hintergrund}">
            <Expander Header="Hintergrund" icons:ExpanderState.Key="hintergrund">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/color-swatch.svg"
                                    Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-reset"
                                    Width="28" Height="28" Padding="0"
                                    Command="{Binding DataContext.ClearDocumentBackgroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Wieder durchsichtig">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="6" Margin="0,8,0,0">
                    <!-- Die drei haeufigsten Faelle direkt, der Waehler daneben fuer alles andere. -->
                    <!-- Die erste Spalte ist breiter: "Transparent" ist mit Symbol laenger als
                         "Schwarz" und "Weiss", und in gleich breiten Dritteln wuerde es
                         abgeschnitten. -->
                    <Grid ColumnDefinitions="1.5*,*,*" ColumnSpacing="6">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="5,5"
                                Command="{Binding SetDocumentBackgroundCommand}" CommandParameter="Transparent"
                                Classes.active="{Binding IsDocumentBackgroundTransparent}">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/border-none.svg"
                                               Width="14" Height="14" />
                                <TextBlock Text="Transparent" FontSize="{DynamicResource FP.Font.Small}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Padding="5,5"
                                Command="{Binding SetDocumentBackgroundCommand}" CommandParameter="Black"
                                Classes.active="{Binding IsDocumentBackgroundBlack}">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/moon.svg"
                                               Width="14" Height="14" />
                                <TextBlock Text="Schwarz" FontSize="{DynamicResource FP.Font.Small}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="ghost" HorizontalAlignment="Stretch" Padding="5,5"
                                Command="{Binding SetDocumentBackgroundCommand}" CommandParameter="White"
                                Classes.active="{Binding IsDocumentBackgroundWhite}">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/sun.svg"
                                               Width="14" Height="14" />
                                <TextBlock Text="Weiß" FontSize="{DynamicResource FP.Font.Small}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="92,*" VerticalAlignment="Center">
                        <TextBlock Text="Farbe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:ColorPickerButton Grid.Column="1"
                                                 SelectedColor="{Binding CanvasBackgroundColorValue, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>
    </StackPanel>
</UserControl>
