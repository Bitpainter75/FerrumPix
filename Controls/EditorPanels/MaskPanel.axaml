<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.MaskPanel">
    <Expander Header="Maske" icons:ExpanderState.Key="mask">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <icons:SvgIcon
                        Source="avares://FerrumPix/Assets/Icons/outline/mask.svg"
                        Width="14" Height="14" />
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                </StackPanel>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="8" Margin="0,8,0,0">

            <!-- Symbolreihe wie im Auswahlwerkzeug: die drei Arten schliessen einander aus,
                 und die Beschriftung stand nur in die Breite. Was sie tun, sagt der Tooltip. -->
            <TextBlock Text="Werkzeug" Foreground="{DynamicResource FP.Text.Secondary}"
                       FontSize="{DynamicResource FP.Font.Small}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetMaskModeCommand}" CommandParameter="Verschieben"
                        Classes.active="{Binding IsMaskMoveMode}"
                        ToolTip.Tip="Verschieben: Objekte und Ebenen greifen, ohne zu malen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/pointer.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetMaskModeCommand}" CommandParameter="Brush"
                        Classes.active="{Binding IsMaskBrushMode}"
                        ToolTip.Tip="Pinsel: Maske frei ins Bild malen - Hinzufügen und Abziehen über den Modus darunter">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brush.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetMaskModeCommand}" CommandParameter="Linear"
                        Classes.active="{Binding IsMaskLinearMode}"
                        ToolTip.Tip="Linearer Verlauf: im Bild ziehen, die Maske läuft vom Startpunkt zum Endpunkt aus. Umschalt rastet die Richtung">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/gradient-linear.svg" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Padding="8,6"
                        Command="{Binding SetMaskModeCommand}" CommandParameter="Radial"
                        Classes.active="{Binding IsMaskRadialMode}"
                        ToolTip.Tip="Radialer Verlauf: von der Mitte nach aussen ziehen. Mit „Umkehren“ wirkt die Maske aussen statt innen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/gradient-radial.svg" Width="16" Height="16" />
                </Button>
                <!-- Ohne Modelldatei GRAU statt weg, mit dem Weg zur Datei im Hinweis. Ein
                     verschwundener Knopf verschweigt, dass es die Funktion gibt. -->
                <Button Classes="ghost" Padding="8,6"
                        IsEnabled="{Binding IsDepthMaskAvailable}"
                        Command="{Binding SetMaskModeCommand}" CommandParameter="Tiefe"
                        Classes.active="{Binding IsMaskDepthMode}"
                        ToolTip.Tip="{Binding DepthMaskHint}">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/stack-3.svg" Width="16" Height="16" />
                </Button>
                <!-- Objektauswahl: der Bestand wird beim Programmstart einmal erhoben - siehe
                     AiModelService.CheckInventory. -->
                <Button Classes="ghost" Padding="8,6"
                        IsEnabled="{Binding IsSubjectMaskAvailable}"
                        Command="{Binding SetMaskModeCommand}" CommandParameter="Objekt"
                        Classes.active="{Binding IsMaskObjectMode}"
                        ToolTip.Tip="{Binding SubjectMaskHint}">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/click.svg" Width="16" Height="16" />
                </Button>
            </StackPanel>

            <!-- MODUS-REIHE, EINMAL FÜR ALLE ARTEN. Sie stand vorher zweimal im Panel (Pinsel und
                 Objekt) und bei den Verläufen gar nicht - dort gab es also weder Plus noch Minus,
                 und jeder Zug erzeugte zwangsläufig eine neue Maske. Seit eine Maske aus mehreren
                 Bestandteilen bestehen kann, gilt die Wahl für JEDE Art, und deshalb steht sie hier
                 oben bei der Art-Auswahl statt in den Zweigen darunter.
                 Umkehren und Verwerfen entscheiden im ViewModel selbst, ob eine Auswahl oder ein
                 Verlauf gemeint ist - ein Verlauf hat keine aktive Auswahl. -->
            <StackPanel Spacing="8">
                <TextBlock Text="Modus" Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="ghost" Padding="8,6"
                            Command="{Binding SetSelectionCombineModeCommand}" CommandParameter="New"
                            Classes.active="{Binding IsSelectionCombineNew}"
                            ToolTip.Tip="Neue Maske beginnen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/square.svg" Width="16" Height="16" />
                    </Button>
                    <Button Classes="ghost" Padding="8,6"
                            Command="{Binding SetSelectionCombineModeCommand}" CommandParameter="Add"
                            Classes.active="{Binding IsSelectionCombineAdd}"
                            ToolTip.Tip="Zur Maske hinzufügen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/square-plus.svg" Width="16" Height="16" />
                    </Button>
                    <Button Classes="ghost" Padding="8,6"
                            Command="{Binding SetSelectionCombineModeCommand}" CommandParameter="Subtract"
                            Classes.active="{Binding IsSelectionCombineSubtract}"
                            ToolTip.Tip="Von der Maske abziehen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/square-minus.svg" Width="16" Height="16" />
                    </Button>
                    <Button Classes="ghost" Padding="8,6"
                            Command="{Binding SetSelectionCombineModeCommand}" CommandParameter="Intersect"
                            Classes.active="{Binding IsSelectionCombineIntersect}"
                            ToolTip.Tip="Nur die Überschneidung behalten">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/layers-intersect.svg" Width="16" Height="16" />
                    </Button>
                    <Border Width="1" Margin="4,4" Background="{DynamicResource FP.Border.Normal}" />
                    <Button Classes="ghost" Padding="8,6"
                            IsEnabled="{Binding CanInvertMask}"
                            Command="{Binding InvertCurrentMaskCommand}"
                            ToolTip.Tip="Maske umkehren">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrows-exchange.svg" Width="16" Height="16" />
                    </Button>
                    <Button Classes="ghost" Padding="8,6"
                            IsEnabled="{Binding CanDiscardMask}"
                            Command="{Binding DiscardCurrentMaskCommand}"
                            ToolTip.Tip="Maske verwerfen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/deselect.svg" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Verschieben-Zweig: hier wird nicht gemalt. Der Knopf wandelt die aktuelle Form in
                 die jeweils andere - es ist dasselbe Alpha-Raster, nur mit anderer Bedeutung. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsMaskMoveMode}">
                <TextBlock Text="Objekte und Ebenen greifen, ohne zu malen."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                        IsEnabled="{Binding CanConvertKind}"
                        Command="{Binding ConvertKindCommand}"
                        ToolTip.Tip="{Binding ConvertKindHint}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrows-exchange.svg"
                                       Width="16" Height="16" />
                        <TextBlock Classes="no-translate" Text="{Binding ConvertKindText}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Tiefen-Zweig. Es gibt hier keinen Klick: das Modell liest das ganze Bild, und die
                 Regler schneiden aus der Tiefenkarte einen Bereich heraus. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsMaskDepthMode}">
                <TextBlock Text="Wählt alles, was in einem Entfernungsbereich liegt. 100 ist am nächsten, 0 am weitesten weg."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
                <TextBlock Text="Die Tiefe wird einmal je Bild berechnet, das dauert einen Moment."
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsDepthMaskRunning}"
                           Foreground="{DynamicResource FP.Text.Muted}"
                           FontSize="{DynamicResource FP.Font.Caption}" />
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Der ferne Rand des gewählten Bereichs">
                    <TextBlock Text="Von" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       Value="{Binding DepthFrom}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding DepthFrom, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Der nahe Rand des gewählten Bereichs">
                    <TextBlock Text="Bis" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       Value="{Binding DepthTo}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding DepthTo, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Lässt die Maske an beiden Rändern auslaufen. Ohne das zieht sich eine sichtbare Kante quer durchs Bild">
                    <TextBlock Text="Übergang" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="50"
                                       Value="{Binding DepthFeather}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding DepthFeather, Mode=TwoWay}" Minimum="0" Maximum="50" />
                </Grid>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                        IsEnabled="{Binding HasActiveSelection}"
                        Command="{Binding CreateAdjustmentLayerFromSelectionCommand}"
                        ToolTip.Tip="Aus der Tiefenmaske eine Maskenebene erstellen">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/adjustments-plus.svg"
                                       Width="16" Height="16" />
                        <TextBlock Text="Neue Maskenebene" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Objekt-Zweig. Dieselbe Modus-Reihe wie beim Pinsel: was ein Klick bedeutet, soll
                 nicht davon abhaengen, mit welchem Werkzeug man gerade arbeitet. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsMaskObjectMode}">
                <TextBlock Text="Ein Klick ins Bild wählt das getroffene Objekt."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
                <TextBlock Text="Das erste Anklicken eines Bildes dauert einen Moment, danach geht es schnell."
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsSubjectMaskRunning}"
                           Foreground="{DynamicResource FP.Text.Muted}"
                           FontSize="{DynamicResource FP.Font.Caption}" />
                <!-- Ein Klick ist mehrdeutig: die Jacke, die Person oder die Gruppe? Das Modell
                     beantwortet alle drei auf einmal - die Wahl kostet weder einen neuen Klick
                     noch eine erneute Modellabfrage. -->
                <TextBlock Text="Umfang der Auswahl" Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding SetSubjectGrainCommand}" CommandParameter="0"
                            Classes.active="{Binding IsGrainFine}"
                            ToolTip.Tip="Nur den getroffenen Teil, etwa ein Ärmel">
                        <TextBlock Text="Teil" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding SetSubjectGrainCommand}" CommandParameter="1"
                            Classes.active="{Binding IsGrainMedium}"
                            ToolTip.Tip="Den Gegenstand, zu dem der Teil gehört, etwa die Jacke">
                        <TextBlock Text="Mittel" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="2" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5"
                            Command="{Binding SetSubjectGrainCommand}" CommandParameter="2"
                            Classes.active="{Binding IsGrainCoarse}"
                            ToolTip.Tip="Das ganze Objekt, etwa die Person">
                        <TextBlock Text="Ganzes" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
                <!-- Feinschliff. Beide aendern NUR, wie die Modellausgabe in Deckung uebersetzt
                     wird - das Modell wird nicht erneut gefragt, die Maske entsteht sofort neu. -->
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Wie knapp die Kante sitzt. Klein lässt sie breiter auslaufen - für Haare, Zweige und Fell. Groß schneidet knapp - für harte Gegenstände.">
                    <TextBlock Text="Kante" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="50"
                                       Value="{Binding SubjectMaskEdge}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding SubjectMaskEdge, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Lässt die Maske um die Kante herum wachsen oder schrumpfen. Erkennt das Modell eine Haaresbreite zu wenig, holt man sie damit zurück.">
                    <TextBlock Text="Umfang" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       Value="{Binding SubjectMaskExtent}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding SubjectMaskExtent, Mode=TwoWay}" Minimum="-100" Maximum="100" />
                </Grid>
                <!-- Derselbe Knopf wie beim Pinsel-Zweig: sitzt die Maske, wird sie zur Ebene. -->
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                        IsEnabled="{Binding HasActiveSelection}"
                        Command="{Binding CreateAdjustmentLayerFromSelectionCommand}"
                        ToolTip.Tip="Aus der Objektmaske eine Maskenebene erstellen">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/adjustments-plus.svg"
                                       Width="16" Height="16" />
                        <TextBlock Text="Neue Maskenebene" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Pinsel-Zweig -->
            <StackPanel Spacing="8" IsVisible="{Binding IsMaskBrushMode}">
                <TextBlock IsVisible="{Binding IsRefiningGradientMask}"
                           Text="Der Pinsel bessert den gewählten Verlauf nach: Striche nehmen Bereiche hinzu, mit „Abziehen“ wieder weg. Der Verlauf selbst bleibt verschiebbar."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}" />
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Pinselgröße" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="1" Maximum="500"
                                       DefaultValue="24"
                                       Value="{Binding BrushSize}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding BrushSize, Mode=TwoWay}"
                                             Minimum="1" Maximum="500" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <!-- Beim Pinsel bleibt „Weiche Kante“ eine Strecke in Bildpixeln: sie wird in die
                     Stempel gebacken (siehe SelectionMaskSoftBaked). Der Verlauf braucht dagegen
                     einen Anteil und hat deshalb seinen eigenen Regler weiter unten. -->
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Weiche Kante" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                               ToolTip.Tip="Lässt den Maskenrand über die angegebene Anzahl Bildpixel weich auslaufen (0 = harte Kante)" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="200"
                                       DefaultValue="0"
                                       Value="{Binding SelectionFeather}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding SelectionFeather, Mode=TwoWay}"
                                             Minimum="0" Maximum="200" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                        IsEnabled="{Binding HasActiveSelection}"
                        Command="{Binding CreateAdjustmentLayerFromSelectionCommand}"
                        ToolTip.Tip="Aus der gemalten Maske eine Maskenebene erstellen">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/adjustments-plus.svg"
                                       Width="16" Height="16" />
                        <TextBlock Text="Neue Maskenebene" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Verlaufs-Zweig -->
            <StackPanel Spacing="8" IsVisible="{Binding ShowGradientControls}">
                <Border Height="1" Background="{DynamicResource FP.Border.Normal}" />
                <TextBlock Text="Im Bild ziehen, um den Verlauf aufzuspannen. Die Griffe bleiben danach greifbar."
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Small}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasSelectedGradientMask}" />
                <!-- Bestandteile der Maske. Erscheint erst ab dem zweiten: bei einem einzigen sagt die
                     Liste nichts, was die Regler darunter nicht schon zeigen. Die angeklickte Zeile
                     ist die, die Griffe und Regler bedienen. -->
                <StackPanel Spacing="4" IsVisible="{Binding HasMaskComponents}">
                    <TextBlock Text="Bestandteile"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               FontSize="{DynamicResource FP.Font.Small}" />
                    <ItemsControl ItemsSource="{Binding MaskComponentRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,1">
                                    <Button Grid.Column="0" Grid.ColumnSpan="3" Classes="ghost"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="6,3"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding DataContext.SelectMaskComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Index}"
                                            ToolTip.Tip="Diesen Bestandteil bedienen">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding ModeLabel}"
                                                       Width="12"
                                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                                       FontSize="{DynamicResource FP.Font.Small}" />
                                            <icons:SvgIcon Source="{Binding IconSource}" Width="14" Height="14" />
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="{DynamicResource FP.Font.Small}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Classes="ghost" Padding="4"
                                            Command="{Binding DataContext.RemoveMaskComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Index}"
                                            ToolTip.Tip="Diesen Bestandteil entfernen">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/trash.svg"
                                                       Width="13" Height="13" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Übergang" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                               ToolTip.Tip="Wie weit der Verlauf zwischen voller und keiner Wirkung ausläuft. Klein = harte Kante, gross = sanft über die ganze Strecke" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="50"
                                       Value="{Binding GradientFeatherPercent}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding GradientFeatherPercent, Mode=TwoWay}"
                                             Minimum="0" Maximum="100" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      IsVisible="{Binding ShowRadialRatioControl}">
                    <TextBlock Text="Stauchung" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                               ToolTip.Tip="Verhältnis der beiden Halbachsen: 1,00 ist ein Kreis, darunter wird die Ellipse flach" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0.05" Maximum="4"
                                       DefaultValue="1"
                                       Value="{Binding GradientRadiusRatio}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding GradientRadiusRatio, Mode=TwoWay}"
                                             Minimum="0.05" Maximum="4" Increment="0.05"
                                             FormatString="F2" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      IsVisible="{Binding HasSelectedGradientMask}">
                    <TextBlock Text="Winkel" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="360"
                                       DefaultValue="0"
                                       Value="{Binding GradientAngleDegrees}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding GradientAngleDegrees, Mode=TwoWay}"
                                             Minimum="0" Maximum="360" Increment="1"
                                             FormatString="F0" />
                </Grid>
                <CheckBox Content="Wirkung umkehren"
                          IsChecked="{Binding GradientInverted}"
                          FontSize="{DynamicResource FP.Font.Small}"
                          ToolTip.Tip="Tauscht gedeckte und freie Seite - beim radialen Verlauf wirkt die Korrektur dann aussen statt innen" />
            </StackPanel>

    
            <!-- OBJEKT ENTFERNEN: braucht nur eine Markierung, egal aus welchem Zweig sie kommt -
                 gemalt, per Klick erkannt oder nach Entfernung ausgewaehlt. Deshalb steht der Knopf
                 nicht in einem der Zweige, sondern unter allen. -->
            <StackPanel Spacing="6" Margin="0,4,0,0">
                <Separator Margin="0,2,0,2" Background="{DynamicResource FP.Border}" Height="1"/>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,6"
                        IsEnabled="{Binding CanRemoveObject}"
                        Command="{Binding RemoveObjectCommand}"
                        ToolTip.Tip="{Binding RemoveObjectHint}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eraser.svg"
                                       Width="16" Height="16" />
                        <TextBlock Text="Objekt entfernen" FontSize="{DynamicResource FP.Font.Small}" />
                    </StackPanel>
                </Button>
            </StackPanel>
    </StackPanel>
    </Expander>
</UserControl>
