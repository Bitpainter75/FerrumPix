<UserControl xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:icons="clr-namespace:FerrumPix.Controls"
         x:Class="FerrumPix.Controls.EditorPanels.DetailsPanel">
    <StackPanel Spacing="7">
        <Expander Header="Details" icons:ExpanderState.Key="details"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=details}">
            <Expander.HeaderTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/adjustments.svg"
                                Width="14" Height="14" />
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                        </StackPanel>
                        <!-- Gruppenvergleich, beschrieben in LightPanel.axaml -->
                        <Button Grid.Column="1"
                                Classes="icon-btn group-compare"
                                Classes.comparing="{Binding DataContext.ComparingAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InListConverter}, ConverterParameter=details}"
                                IsVisible="{Binding DataContext.CanCompareAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Width="28" Height="28" Padding="0"
                                Command="{Binding DataContext.ToggleAdjustmentGroupCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="details"
                                ToolTip.Tip="Gruppe vorübergehend ausblenden, um vorher und nachher zu vergleichen">
                            <icons:SvgIcon Width="14" Height="14" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="icon-btn group-reset"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding DataContext.ResetDetailGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip.Tip="Details zurücksetzen">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                Width="14" Height="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </Expander.HeaderTemplate>
            <StackPanel Spacing="2" Margin="0,8,0,0">
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Klarheit" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       Value="{Binding Clarity}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value slider-value-wide"
                                             Value="{Binding Clarity, Mode=TwoWay}" Minimum="-100" Maximum="100"
                                             Increment="0.1" FormatString="F1" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Struktur" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       Value="{Binding Structure}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value slider-value-wide"
                                             Value="{Binding Structure, Mode=TwoWay}" Minimum="-100" Maximum="100"
                                             Increment="0.1" FormatString="F1" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Dunst" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       Value="{Binding Haze}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value slider-value-wide"
                                             Value="{Binding Haze, Mode=TwoWay}" Minimum="-100" Maximum="100"
                                             Increment="0.1" FormatString="F1" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Glühen" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                       Value="{Binding Glow}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value slider-value-wide"
                                             Value="{Binding Glow, Mode=TwoWay}" Minimum="-100" Maximum="100"
                                             Increment="0.1" FormatString="F1" />
                </Grid>
                <!-- Weichzeichnen hatte frueher eine eigene Gruppe mit diesem einen Regler. -->
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Weichzeichnen" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                               ToolTip.Tip="Zeichnet das ganze Bild gleichmäßig weich. Die Stärke richtet sich nach der Bildgröße, Vorschau und Export sehen gleich aus." />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       Value="{Binding Blur}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding Blur, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
