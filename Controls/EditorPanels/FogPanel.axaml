<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.FogPanel">
    <!-- NEBEL NACH TIEFE: je ferner ein Punkt, desto mehr Nebelfarbe liegt ueber ihm. Wie die
         Tiefen-Unschaerfe mit eigenem Anwenden, weil er die Tiefenkarte braucht; die Hinweise zu
         ShowOnDisabled stehen in BokehPanel.axaml. -->
    <Border Classes="adjustment-group"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=fog}">
        <Expander Header="Nebel nach Tiefe" icons:ExpanderState.Key="fog">
            <Expander.HeaderTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/mist.svg"
                                Width="14" Height="14" />
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="icon-btn group-reset"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding DataContext.ResetFogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip.Tip="Nebel zurücksetzen">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                Width="14" Height="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </Expander.HeaderTemplate>
            <StackPanel Spacing="2" Margin="0,8,0,0" IsEnabled="{Binding CanRequestModels}"
                        ToolTip.Tip="{Binding FogHint}" ToolTip.ShowOnDisabled="True">
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Wie dicht der Nebel am fernsten Punkt wird">
                    <TextBlock Text="Dichte" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100" DefaultValue="0"
                                       Value="{Binding FogDensity}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding FogDensity, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Ab dieser Entfernung beginnt der Nebel. 100 ist am nächsten">
                    <TextBlock Text="Beginn" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100" DefaultValue="60"
                                       Value="{Binding FogNear}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding FogNear, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                      ToolTip.Tip="Ab dieser Entfernung liegt die volle Dichte. 0 ist am weitesten weg">
                    <TextBlock Text="Volle Dichte" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100" DefaultValue="0"
                                       Value="{Binding FogFar}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding FogFar, Mode=TwoWay}" Minimum="0" Maximum="100" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top" Margin="0,4,0,0">
                    <TextBlock Text="Farbe" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:ColorPickerButton Grid.Column="1"
                                             SelectedColor="{Binding FogColorValue, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="Wird beim Anwenden in die Pixel gerechnet, wie eine Retusche. Die Tiefe wird einmal je Bild ermittelt."
                           Foreground="{DynamicResource FP.Text.Muted}"
                           FontSize="{DynamicResource FP.Font.Caption}" TextWrapping="Wrap"
                           Margin="0,8,0,6"/>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,5"
                        IsEnabled="{Binding HasFogChanges}"
                        Command="{Binding ApplyFogCommand}">
                    <TextBlock Text="Anwenden" FontSize="{DynamicResource FP.Font.Small}"
                               HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Expander>
    </Border>
</UserControl>
