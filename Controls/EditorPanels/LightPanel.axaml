<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.LightPanel">
    <Expander Header="Licht" icons:ExpanderState.Key="light"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=light}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/exposure.svg"
                            Width="14" Height="14" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <!-- Die Clipping-Warnung hat ihren Knopf im Analysepanel. Wer das nicht
                             zeigt (ab Werk aus), findet denselben Knopf hier, bei den Reglern, mit
                             denen man auf sie reagiert. Nie beide Knoepfe zugleich; der Haken
                             unten im Panel steht unabhaengig davon immer da. -->
                        <Button Classes="icon-btn group-action"
                                Classes.active="{Binding DataContext.ShowClippingWarning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                IsVisible="{Binding !DataContext.IsScopeInAdjustmentPanelsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding DataContext.ToggleClippingWarningCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip.Tip="Ausgefressene Lichter rot und zugelaufene Tiefen blau markieren">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/alert-triangle.svg"
                                Width="14" Height="14" />
                        </Button>
                        <Button Classes="icon-btn group-reset"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding DataContext.ResetLightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip.Tip="Licht zurücksetzen">
                            <icons:SvgIcon
                                Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="2" Margin="0,8,0,0">
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <!-- DAS ZAHLENFELD ZEIGT BLENDENSTUFEN, der Regler bleibt auf seinen Punkten.
                     25 Punkte sind eine Stufe (siehe ExposureStopsConverter), der volle Weg also
                     plus/minus 5 - Adobes Bereich. Vorher stand hier eine blanke Zahl zwischen
                     -125 und 125, und die sagt einem Fotografen nichts; "-1,60" sagt alles.
                     Zahlenfeld und Mausrad gehen in 0,01 Stufen, der Zug in 0,02; mit SHIFT
                     geht das Zahlenfeld in Viertelstufen.
                     IN DER HISTORIE HEISST DER REGLER WEITER NUR "Belichtung"
                     (EditorViewModel.GetHistoryLabelForProperty): (EV) ist die Einheit der
                     Anzeige, nicht Teil seines Namens. -->
                <TextBlock Text="Belichtung (EV)"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-125" Maximum="125"
                                   Value="{Binding Exposure}"
                                   DragIncrement="0.5" WheelIncrement="0.25" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Exposure, Mode=TwoWay, Converter={StaticResource ExposureStopsConverter}}"
                                         Minimum="-5" Maximum="5"
                                         Increment="0.01" CoarseIncrement="0.25" FormatString="F2" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Helligkeit"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                   Value="{Binding Brightness}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Brightness, Mode=TwoWay}" Minimum="-100" Maximum="100" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Kontrast" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                   Value="{Binding Contrast}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Contrast, Mode=TwoWay}" Minimum="-100" Maximum="100" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Lichter" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                   Value="{Binding Highlights}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Highlights, Mode=TwoWay}" Minimum="-100" Maximum="100" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Tiefen" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                   Value="{Binding ShadowsLevel}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding ShadowsLevel, Mode=TwoWay}" Minimum="-100" Maximum="100" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Weiß" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                   Value="{Binding Whites}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Whites, Mode=TwoWay}" Minimum="-100" Maximum="100" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Schwarz" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                   Value="{Binding Blacks}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Blacks, Mode=TwoWay}" Minimum="-100" Maximum="100" />
            </Grid>
            <!-- EIN HAKEN UND KEIN REGLER, und zwar aus einem handfesten Grund: die Stufe sitzt
                 im Decode, das Umschalten laesst also die Umsetzung neu laufen.

                 SICHTBAR AN "IsRawDeveloped", also an derselben Auskunft, die auch die Fusszeile
                 einfaerbt: hat libraw die Datei WIRKLICH entwickelt? Die Endung allein reicht
                 dafuer nicht - kennt libraw die Kamera nicht, faellt der Weg still auf die
                 eingebettete Vorschau zurueck, und dort gaebe es nichts zu holen. Ein Haken, der
                 nichts tun kann, ist schlimmer als keiner. -->
            <CheckBox Content="Lichter aus den Rohdaten holen"
                      IsChecked="{Binding RawHighlightRecoveryEnabled}"
                      IsVisible="{Binding IsRawDeveloped}"
                      FontSize="{DynamicResource FP.Font.Small}"
                      Margin="0,6,0,0"
                      ToolTip.Tip="Holt Zeichnung zurück, die über Weiss liegt und heute abgeschnitten wird. Wirkt nur dort, wo ein Kanal ausgefressen ist und ein anderer nicht. Das Umschalten entwickelt die Datei neu und dauert deshalb einen Moment."/>
            <!-- Die Warnung steht bei den Reglern, mit denen man auf sie reagiert: Lichter,
                 Tiefen, Weiß und Schwarz sitzen direkt darüber. Sie ist reine Ansicht und geht
                 in kein Rezept und keine Datei. Der Haken bleibt auch neben dem Symbolknopf im
                 Analysepanel stehen: das Panel ist ab Werk aus, und dann ist er der einzige
                 sichtbare Schalter. -->
            <CheckBox Content="Clipping-Warnung anzeigen" IsChecked="{Binding ShowClippingWarning}"
                      Margin="0,6,0,0"
                      ToolTip.Tip="Ausgefressene Lichter rot und zugelaufene Tiefen blau markieren" />
        </StackPanel>
    </Expander>
</UserControl>
