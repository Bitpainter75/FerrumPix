<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.ThresholdPanel">
    <!-- Schwellenwert: alles ab dieser Helligkeit wird weiss, alles darunter schwarz. 0 ist aus. -->
    <Expander Header="Schwellenwert" icons:ExpanderState.Key="threshold"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=threshold}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/contrast.svg"
                            Width="14" Height="14" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon-btn group-reset"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Command="{Binding DataContext.ResetThresholdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip.Tip="Schwellenwert zurücksetzen">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                            Width="14" Height="14" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="2" Margin="0,8,0,0">
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Schwelle" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                           ToolTip.Tip="Ab dieser Helligkeit wird ein Punkt weiß, darunter schwarz. 0 schaltet den Schwellenwert aus" />
                <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="255" DefaultValue="0"
                                   Value="{Binding ThresholdLevel}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding ThresholdLevel, Mode=TwoWay}" Minimum="0" Maximum="255" />
            </Grid>
        </StackPanel>
    </Expander>
</UserControl>
