<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.AnnotationGlowPanel">
    <!-- Zu, solange "Aktiv" aus ist, auf, sobald es an ist (ExpanderState.ExpandWhen), wie
         Füllung, Kontur und Schatten. -->
    <Expander Header="Glühen" icons:ExpanderState.Key="glow"
              icons:ExpanderState.ExpandWhen="{Binding AnnotationGlowEnabled}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- "Aktiv" als Haken in der Kopfzeile, wie beim Schatten. -->
                    <CheckBox VerticalAlignment="Center" MinWidth="0" Padding="0"
                              ToolTip.Tip="{Binding $parent[Expander].DataContext.GroupActiveToolTip}"
                              IsChecked="{Binding $parent[Expander].DataContext.AnnotationGlowEnabled}" />
                    <icons:SvgIcon
                        Source="avares://FerrumPix/Assets/Icons/outline/sparkles.svg"
                        Width="14" Height="14" />
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="2" Margin="0,8,0,0">
            <StackPanel Spacing="2" IsVisible="{Binding AnnotationGlowEnabled}">
                <!-- Lage wie beim Schatten: aussen um das Objekt, innen von der Kante in die Flaeche,
                     oder beides (ImageAnnotation.GlowPlacement). -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Classes="ghost" Padding="8,4" Margin="0,0,6,4"
                            Command="{Binding SetAnnotationGlowPlacementCommand}" CommandParameter=""
                            Classes.active="{Binding IsGlowOutside}"
                            ToolTip.Tip="Glühen um das Objekt herum">
                        <TextBlock Text="Außen" FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                    <Button Classes="ghost" Padding="8,4" Margin="0,0,6,4"
                            Command="{Binding SetAnnotationGlowPlacementCommand}" CommandParameter="Inside"
                            Classes.active="{Binding IsGlowInside}"
                            ToolTip.Tip="Glühen von der Kante nach innen">
                        <TextBlock Text="Innen" FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                    <Button Classes="ghost" Padding="8,4" Margin="0,0,6,4"
                            Command="{Binding SetAnnotationGlowPlacementCommand}" CommandParameter="Both"
                            Classes.active="{Binding IsGlowBoth}"
                            ToolTip.Tip="Außen und innen mit denselben Werten">
                        <TextBlock Text="Beides" FontSize="{DynamicResource FP.Font.Small}" />
                    </Button>
                </WrapPanel>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                    <TextBlock Text="Farbe" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:ColorPickerButton Grid.Column="1"
                                             SelectedColor="{Binding AnnotationGlowColorValue, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Größe"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="{Binding GlowSizeDefault}"
                                       Value="{Binding AnnotationGlowBlur}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AnnotationGlowBlur, Mode=TwoWay}"
                                             Minimum="0" Maximum="100" Increment="0.1"
                                             FormatString="F1" />
                </Grid>
                <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                    <TextBlock Text="Stärke" Foreground="{DynamicResource FP.Text.Secondary}"
                               VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                    <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                       DefaultValue="100"
                                       Value="{Binding AnnotationGlowStrength}" Margin="0,0" />
                    <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                             Value="{Binding AnnotationGlowStrength, Mode=TwoWay}"
                                             Minimum="0" Maximum="100" Increment="1"
                                             FormatString="F0" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Expander>
</UserControl>
