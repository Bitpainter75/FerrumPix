<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.EffectsPanel">
    <!-- Die Gruppe rahmt sich selbst, EditorView darf nicht noch einmal darum herum rahmen.
         Die Vignette stand frueher hier und steht seit 0.9.71 im SharpnessPanel. -->
    <StackPanel Spacing="7">
        <Border Classes="adjustment-group"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=grain}">
            <Expander Header="Körnung" icons:ExpanderState.Key="grain">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/adjustments.svg"
                                    Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <!-- Gruppenvergleich, beschrieben in LightPanel.axaml -->
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-compare"
                                    Classes.comparing="{Binding DataContext.ComparingAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InListConverter}, ConverterParameter=grain}"
                                    IsVisible="{Binding DataContext.CanCompareAdjustmentGroups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Width="28" Height="28" Padding="0"
                                    Command="{Binding DataContext.ToggleAdjustmentGroupCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="grain"
                                    ToolTip.Tip="Gruppe vorübergehend ausblenden, um vorher und nachher zu vergleichen">
                                <icons:SvgIcon Width="14" Height="14" />
                            </Button>
                            <Button Grid.Column="2"
                                    Classes="icon-btn group-reset"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Command="{Binding DataContext.ResetGrainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Körnung zurücksetzen">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="2" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Stärke" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Wie stark das Korn im Bild liegt." />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           Value="{Binding Grain}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding Grain, Mode=TwoWay}" Minimum="0" Maximum="100" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Größe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Korngröße: 0 = feines Korn, höher = gröber." />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           Value="{Binding GrainSize}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding GrainSize, Mode=TwoWay}" Minimum="0" Maximum="100" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Rauheit" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"
                                   ToolTip.Tip="Unregelmäßigkeit des Korns: höher = fleckiger (manche Bereiche stärker gekörnt)." />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           Value="{Binding GrainFrequency}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding GrainFrequency, Mode=TwoWay}" Minimum="0" Maximum="100" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Farbe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}"
                                   ToolTip.Tip="Farbigkeit des Korns: 0 = graues Korn, höher = farbige Speckles wie bei hoch empfindlichem Farbfilm." />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           Value="{Binding GrainColor}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding GrainColor, Mode=TwoWay}" Minimum="0" Maximum="100" />
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>
    </StackPanel>
</UserControl>
