<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.ColorPanel">
    <Expander Header="Farbe" icons:ExpanderState.Key="color"
        IsVisible="{Binding HiddenAdjustmentGroups, Converter={StaticResource NotInListConverter}, ConverterParameter=color}">
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/color-filter.svg"
                            Width="14" Height="14" />
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon-btn group-reset"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Command="{Binding DataContext.ResetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip.Tip="Farbe zurücksetzen">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                            Width="14" Height="14" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <StackPanel Spacing="2" Margin="0,8,0,0">
            <Grid ColumnDefinitions="92,*" VerticalAlignment="Center">
                <TextBlock Text="Weißabgleich"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="NoWrap" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding WhiteBalanceOptions}"
                          SelectedItem="{Binding WhiteBalance}"
                          HorizontalAlignment="Stretch"
                          FontSize="{DynamicResource FP.Font.Small}"
                          Margin="6,0,0,0"
                          DropDownOpened="OnMatchWidthDropDownOpened">
                        <ComboBox.ItemTemplate>
                            <!-- Angezeigt wird uebersetzt, gespeichert bleibt der deutsche WERT: er
                                 steht im Rezept und in jedem Select Case. -->
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
            </Grid>
            <!-- ZWEI TEMPERATURZEILEN, eine davon sichtbar. Eine RAW-Datei traegt den
                 Weissabgleich der Aufnahme; dort nennt der Regler die Farbtemperatur der Szene in
                 Kelvin, so wie in jedem Entwicklungsprogramm. Alles andere hat keine
                 Aufnahmetemperatur, auf die sich eine absolute Zahl beziehen koennte, und behaelt
                 den relativen Regler. -->
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                  IsVisible="{Binding !HasAbsoluteWhiteBalance}">
                <TextBlock Text="Temperatur"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                   Value="{Binding Temperature}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Temperature, Mode=TwoWay}" Minimum="-100" Maximum="100" />
            </Grid>
            <!-- SPALTENTEILUNG WIE ALLE ANDEREN ZEILEN: 92, Rest, 44. Eine eigene Breite fuer die
                 Zahlenspalte laesst den Regler frueher enden als die Zeilen darunter, und die
                 gemeinsame Kante der Regler ist die auffaelligste Linie im Panel. Der
                 Kelvin-Wert ist vierstellig und braucht dafuer ein etwas breiteres Feld - das
                 regelt die Klasse, nicht die Spalte. -->
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                  IsVisible="{Binding HasAbsoluteWhiteBalance}">
                <TextBlock Text="Temperatur"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="2000" Maximum="12000"
                                   Value="{Binding KelvinTemperature}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value slider-value-wide"
                                         Value="{Binding KelvinTemperature, Mode=TwoWay}"
                                         Minimum="2000" Maximum="12000" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Tönung" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-150" Maximum="150"
                                   Value="{Binding Tint}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Tint, Mode=TwoWay}" Minimum="-150" Maximum="150" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Dynamik" Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                   Value="{Binding Vibrance}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Vibrance, Mode=TwoWay}" Minimum="-100" Maximum="100" />
            </Grid>
            <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                <TextBlock Text="Sättigung"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                   Value="{Binding Saturation}" Margin="0,0" />
                <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                         Value="{Binding Saturation, Mode=TwoWay}" Minimum="-100" Maximum="100" />
            </Grid>
        </StackPanel>
    </Expander>
</UserControl>
