<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Controls.EditorPanels.TransformPanel">
    <StackPanel Spacing="7">
        <Border Classes="adjustment-group">
            <Expander Header="Drehen" icons:ExpanderState.Key="transform">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/frame.svg"
                                    Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-reset"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Command="{Binding DataContext.ResetTransformCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Drehen zurücksetzen">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Classes="ghost" Height="44" Padding="8,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding RotateLeftCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-2.svg"
                                    Width="20" Height="20" />
                                <TextBlock Text="Links" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="ghost" Height="44" Padding="8,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding RotateRightCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise-2.svg"
                                    Width="20" Height="20" />
                                <TextBlock Text="Rechts" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center">
                        <TextBlock Text="Ausrichten"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="-180" Maximum="180"
                                           DefaultValue="0"
                                           Value="{Binding StraightenDegrees}"
                                           WheelIncrement="0.1"
                                           Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding StraightenDegrees, Mode=TwoWay}"
                                                 Minimum="-180" Maximum="180" Increment="0.1"
                                                 FormatString="F1" />
                    </Grid>
                    <CheckBox Content="Leinwand automatisch vergrößern"
                              IsChecked="{Binding StraightenExpandCanvas}"
                              FontSize="{DynamicResource FP.Font.Small}"
                              ToolTip.Tip="Vergrößert die Leinwand beim Ausrichten so, dass keine Bildecken abgeschnitten werden, statt das Bild zum Ausgleich hineinzuzoomen" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Classes="ghost" Height="44" Padding="8,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding FlipHorizontalCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/flip-horizontal.svg"
                                    Width="20" Height="20" />
                                <TextBlock Text="Horizontal" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="ghost" Height="44" Padding="8,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding FlipVerticalCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/flip-vertical.svg"
                                    Width="20" Height="20" />
                                <TextBlock Text="Vertikal" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <!-- ERST WAEHLEN, dann erscheint das Overlay. Beide gleichzeitig ueber dem Bild war ein
             Fehler: Eck-Anfasser und Rasterpunkte liegen teils uebereinander, und man sieht zwei
             Werkzeuge, von denen man eines meint. Nochmal auf denselben Knopf waehlt wieder ab. -->
        <Border Classes="adjustment-group">
            <Expander Header="Verzerren" icons:ExpanderState.Key="warp">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/perspective.svg"
                                           Width="14" Height="14" />
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                        </StackPanel>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="6" Margin="0,8,0,0">
                <!-- Nach dem TEXT bemessen, nicht zu gleichen Teilen: "Perspektive" ist doppelt
                     so lang wie "Gitter", und gleich breite Knoepfe lassen den einen
                     gequetscht und die anderen halb leer aussehen. -->
                <!-- Ist ein Objekt markiert, gehoeren die Anfasser IHM. Der Hinweis steht EINMAL
                     ueber der Wahl und nicht in jeder der drei Gruppen - er gilt fuer alle. -->
                <Border Background="{DynamicResource FP.Bg.Input}"
                        BorderBrush="{DynamicResource FP.Border.Normal}"
                        BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="8,6"
                        IsVisible="{Binding WarpsTheObject}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Ein Objekt ist markiert - Ecken, Raster und Linien verzerren dieses Objekt, nicht das Bild. Die Verzerrung gehört zum Objekt, wirkt sofort und wird nicht eingebacken."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   FontSize="{DynamicResource FP.Font.Small}" />
                        <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,5"
                                IsEnabled="{Binding HasObjectWarp}"
                                Command="{Binding ResetObjectWarpCommand}">
                            <TextBlock Text="Objektverzerrung zurücksetzen"
                                       FontSize="{DynamicResource FP.Font.Small}"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
                <!-- WrapPanel statt einer Reihe: mit dem vierten Knopf passt die Wahl nicht mehr in
                     jede Panelbreite, und ein abgeschnittener Knopf ist schlimmer als eine zweite
                     Zeile. Der Abstand steht am Knopf, weil WrapPanel keinen kennt. -->
                <WrapPanel Orientation="Horizontal">
                    <Button Classes="ghost" Padding="12,6" Margin="0,0,6,6"
                            Command="{Binding SetWarpModeCommand}" CommandParameter="Perspektive"
                            Classes.active="{Binding IsWarpPerspective}"
                            ToolTip.Tip="Die vier Ecken im Bild ziehen">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/perspective.svg"
                                           Width="14" Height="14" />
                            <TextBlock Text="Perspektive" FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Padding="12,6" Margin="0,0,6,6"
                            Command="{Binding SetWarpModeCommand}" CommandParameter="Gitter"
                            Classes.active="{Binding IsWarpGrid}"
                            ToolTip.Tip="Das Stützpunktraster im Bild ziehen">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/grid-dots.svg"
                                           Width="14" Height="14" />
                            <TextBlock Text="Gitter" FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Padding="12,6" Margin="0,0,6,6"
                            Command="{Binding SetWarpModeCommand}" CommandParameter="Linien"
                            Classes.active="{Binding IsWarpLines}"
                            ToolTip.Tip="Linien auf Kanten legen und ziehen">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/vector.svg"
                                           Width="14" Height="14" />
                            <TextBlock Text="Linien" FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Padding="12,6" Margin="0,0,6,6"
                            Command="{Binding SetWarpModeCommand}" CommandParameter="Verformen"
                            Classes.active="{Binding IsWarpEnvelope}"
                            ToolTip.Tip="Die vier Ränder biegen, das Innere folgt">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/vector-bezier-arc.svg"
                                           Width="14" Height="14" />
                            <TextBlock Text="Verformen" FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock Text="Erst wählen, dann liegt das jeweilige Werkzeug über dem Bild. Nochmal darauf klicken blendet es wieder aus."
                           Foreground="{DynamicResource FP.Text.Muted}"
                           FontSize="{DynamicResource FP.Font.Caption}" TextWrapping="Wrap" />
                <!-- Die Verzerrung des BILDES steht im Rezept und ist damit jederzeit wieder
                     wegzunehmen - anders als frueher, als sie in den Pixeln stand. Der Knopf nimmt
                     ALLE VIER Arten zurueck, auch die Perspektive: deren eigener Knopf sitzt in
                     ihrer Gruppe, und die ist ausgeblendet, sobald ein anderer Modus gewaehlt ist. -->
                <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,5"
                        Margin="0,8,0,0"
                        IsVisible="{Binding HasAnyImageWarp}"
                        Command="{Binding ResetImageWarpCommand}"
                        ToolTip.Tip="Nimmt alle übernommenen Verzerrungen des Bildes wieder weg">
                    <TextBlock Text="Verzerrung des Bildes zurücknehmen"
                               FontSize="{DynamicResource FP.Font.Small}"
                               HorizontalAlignment="Center"/>
                </Button>
                </StackPanel>
            </Expander>
        </Border>

        <!-- PERSPEKTIVE: eine Matrix, und deshalb in derselben Geometriestufe wie Drehen und
             Beschnitt - Masken wandern von selbst mit. Objekte tun das NICHT: ein Rechteck bleibt
             unter einer Perspektive kein Rechteck, dafuer muessten sie Vierecke werden.
             Bewusst getrennt von der Gitterverzerrung darunter: die eine ist eine Matrix und wirkt
             laufend, die andere ein Knotenfeld mit eigenem "Anwenden". Im Rezept stehen beide. -->
        <Border Classes="adjustment-group" >
            <Border.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="IsWarpPerspective"/>
                    <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="perspektive"/>
                </MultiBinding>
            </Border.IsVisible>
            <Expander Header="Perspektive" icons:ExpanderState.Key="perspektive" IsExpanded="True">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/perspective.svg"
                                    Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-reset"
                                    Width="28" Height="28" Padding="0"
                                    Command="{Binding DataContext.ResetPerspectiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Verzerren zurücksetzen">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="2" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                          ToolTip.Tip="Kippt um die waagerechte Achse: richtet stürzende Linien an Gebäuden auf">
                        <TextBlock Text="Senkrecht" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                           Value="{Binding PerspectiveVertical}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding PerspectiveVertical, Mode=TwoWay}" Minimum="-100" Maximum="100" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                          ToolTip.Tip="Kippt um die senkrechte Achse">
                        <TextBlock Text="Waagerecht" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                           Value="{Binding PerspectiveHorizontal}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding PerspectiveHorizontal, Mode=TwoWay}" Minimum="-100" Maximum="100" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                          ToolTip.Tip="Dehnt das Ergebnis in die Breite oder in die Höhe">
                        <TextBlock Text="Seitenverhältnis" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                           Value="{Binding PerspectiveAspect}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding PerspectiveAspect, Mode=TwoWay}" Minimum="-100" Maximum="100" />
                    </Grid>
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                          ToolTip.Tip="Holt das Bild heran, um die leer gewordenen Ecken zu verdecken">
                        <TextBlock Text="Größe" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="-100" Maximum="100"
                                           Value="{Binding PerspectiveScale}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding PerspectiveScale, Mode=TwoWay}" Minimum="-100" Maximum="100" />
                    </Grid>
                    <TextBlock Text="Die vier Ecken lassen sich auch direkt im Bild ziehen."
                               Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Caption}" TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="Masken kippen mit. Eingefügte Objekte nicht - sie bleiben Rechtecke."
                               Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Caption}" TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               IsVisible="{Binding HasPerspectiveWarning}"/>
                </StackPanel>
            </Expander>
        </Border>

        <!-- GITTERVERZERRUNG: freie Verzerrung ueber ein Stuetzpunktraster. Bewusst mit eigenem
             "Anwenden": bis dahin ist sie eine Vorschau, danach ein Knotenfeld IM REZEPT - nichts
             wird in die Pixel gebacken, und eine zweite Verzerrung setzt sich auf die erste. -->
        <Border Classes="adjustment-group" >
            <Border.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="IsWarpGrid"/>
                    <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="gitterverzerrung"/>
                </MultiBinding>
            </Border.IsVisible>
            <Expander Header="Gitterverzerrung" icons:ExpanderState.Key="gitterverzerrung" IsExpanded="True">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/grid-dots.svg"
                                    Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-reset"
                                    Width="28" Height="28" Padding="0"
                                    Command="{Binding DataContext.ResetWarpGridCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Gitter zurücksetzen">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="2" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="92,*,44" VerticalAlignment="Center"
                          ToolTip.Tip="Wie fein das Stützpunktraster ist. Gröber verzerrt weicher, feiner genauer.">
                        <TextBlock Text="Raster" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="2" Maximum="12" DefaultValue="4"
                                           Value="{Binding WarpGridSize}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding WarpGridSize, Mode=TwoWay}" Minimum="2" Maximum="12" />
                    </Grid>
                    <!-- Hinweis und Anwenden gelten nur dem BILD. Ist ein Objekt markiert, ist die
                         Verzerrung dort laengst eingetragen und bleibt eine Angabe - es gibt nichts
                         zu uebernehmen. -->
                    <TextBlock Text="Die Punkte im Bild ziehen. Anwenden übernimmt die Verzerrung ins Rezept: Masken gehen mit, und beim nächsten Öffnen steht sie wieder da."
                               IsVisible="{Binding WarpsTheImage}"
                               Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Caption}" TextWrapping="Wrap"
                               Margin="0,6,0,6"/>
                    <!-- Der Akzent wie bei Zuschneiden und Bildgröße: es ist der Knopf, der die
                         Arbeit wirksam macht, und ohne etwas zu übernehmen bleibt er ausgegraut. -->
                    <Button Classes="accent" HorizontalAlignment="Stretch" Padding="10,5"
                            IsVisible="{Binding WarpsTheImage}"
                            IsEnabled="{Binding HasWarpGridChanges}"
                            Command="{Binding ApplyWarpGridCommand}">
                        <TextBlock Text="Anwenden" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Expander>
        </Border>

        <!-- VERFORMEN: dasselbe Viereck wie die Perspektive, aber seine vier RAENDER sind Kurven.
             Vier Ecken, je Kante zwei Griffe, das Innere folgt den Raendern. Damit biegt man eine
             Flaeche in einem Zug, wofuer man am Stuetzpunktraster ein Dutzend Punkte einzeln
             nachfuehren muesste. Wie das Raster wandert sie beim Anwenden als Knotenfeld ins
             Rezept. -->
        <Border Classes="adjustment-group">
            <Border.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="IsWarpEnvelope"/>
                    <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="verformen"/>
                </MultiBinding>
            </Border.IsVisible>
            <Expander Header="Verformen" icons:ExpanderState.Key="verformen" IsExpanded="True">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/vector-bezier-arc.svg"
                                    Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-reset"
                                    Width="28" Height="28" Padding="0"
                                    Command="{Binding DataContext.ResetEnvelopeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Verformung zurücksetzen">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="Im Bild an den vier Ecken ziehen oder an den kleinen Griffen daneben: die Ecken setzen die Lage, die Griffe biegen den Rand dazwischen. Das Innere folgt den Rändern."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               FontSize="{DynamicResource FP.Font.Small}" />
                    <TextBlock Text="Die Ränder bleiben im Bild. Wo einer nach innen gebogen wird, wird das Bild danach durchsichtig."
                               IsVisible="{Binding WarpsTheImage}"
                               Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Caption}" TextWrapping="Wrap" />
                    <TextBlock Text="Anwenden übernimmt die Verformung ins Rezept: Masken gehen mit, und beim nächsten Öffnen steht sie wieder da."
                               IsVisible="{Binding WarpsTheImage}"
                               Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Caption}" TextWrapping="Wrap" />
                    <Button Classes="accent" HorizontalAlignment="Stretch" Padding="10,5"
                            IsVisible="{Binding WarpsTheImage}"
                            IsEnabled="{Binding HasEnvelopeChanges}"
                            Command="{Binding ApplyEnvelopeCommand}">
                        <TextBlock Text="Anwenden" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Expander>
        </Border>

        <!-- LINIENVERZERRUNG. Man legt eine Linie auf eine KANTE im Bild und zieht sie an ihren
             neuen Platz; die Kante geht als Ganzes mit, die Umgebung folgt weich. Das ist der
             Unterschied zum Stuetzpunktraster darueber: dort muesste man einer Kante ein Dutzend
             Punkte einzeln nachfuehren. Wie das Raster wandert sie beim Anwenden als Knotenfeld
             ins Rezept. -->
        <Border Classes="adjustment-group" IsVisible="{Binding IsWarpLines}">
            <Expander Header="Linienverzerrung" icons:ExpanderState.Key="linienverzerrung" IsExpanded="True">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/vector.svg"
                                    Width="14" Height="14" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon-btn group-reset"
                                    Width="28" Height="28" Padding="0"
                                    Command="{Binding DataContext.ResetLinesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip.Tip="Alle Linien entfernen">
                                <icons:SvgIcon
                                    Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                    Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="Im Bild eine Linie über eine Kante ziehen. Danach die Linie oder eines ihrer Enden an den neuen Platz ziehen - die Kante geht mit, die Umgebung folgt weich."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               FontSize="{DynamicResource FP.Font.Small}" />
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Text="Linien" Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <TextBlock Grid.Column="1" Classes="no-translate"
                                   Text="{Binding LineCount}"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FP.Font.Small}" />
                    </Grid>
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,5"
                            Command="{Binding RemoveLastLineCommand}"
                            ToolTip.Tip="Die zuletzt gezogene Linie wieder entfernen">
                        <TextBlock Text="Letzte Linie entfernen" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="Anwenden übernimmt die Verzerrung ins Rezept: Masken und eingefügte Objekte gehen mit, und beim nächsten Öffnen steht sie wieder da."
                               IsVisible="{Binding WarpsTheImage}"
                               Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Caption}" TextWrapping="Wrap" />
                    <Button Classes="accent" HorizontalAlignment="Stretch" Padding="10,5"
                            IsVisible="{Binding WarpsTheImage}"
                            IsEnabled="{Binding HasLineChanges}"
                            Command="{Binding ApplyLinesCommand}">
                        <TextBlock Text="Anwenden" FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Expander>
        </Border>
    </StackPanel>
</UserControl>
