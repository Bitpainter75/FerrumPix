{
  "format": 1,
  "id": "spoilerhead.silicon-bonk",
  "version": 1,
  "name": {
    "en": "Silicon Bonk (Adaptive Black & White)",
    "de": "Silicon Bonk (Adaptives Schwarzweiß)"
  },
  "description": {
    "en": "Turns a finished color picture into black and white. Hue and Luminance work like a color filter in front of the lens.",
    "de": "Macht aus einem fertigen Farbbild ein Schwarzweißbild. Farbton und Luminanz wirken wie ein Farbfilter vor dem Objektiv."
  },
  "author": "Spoilerhead, original concept by Bernd Gruber (grubernd)",
  "license": "GPL-2.0-or-later OR LGPL-2.0-or-later",
  "url": "https://github.com/spoilerhead/asp_plugins",
  "stage": "before-grain",
  "controls": [
    { "key": "hue", "type": "slider", "track": "hue", "min": 0, "max": 360, "default": 45,
      "label": { "en": "Hue", "de": "Farbton" } },
    { "key": "luminance", "type": "slider", "track": { "luminance": "hue" }, "min": -100, "max": 100, "default": 0,
      "label": { "en": "Luminance", "de": "Luminanz" } },
    { "key": "midpoint", "type": "slider", "track": "black-white", "min": -100, "max": 100, "default": 0,
      "label": { "en": "Midpoint", "de": "Mittelpunkt" } },
    { "key": "contrast", "type": "slider", "min": -50, "max": 200, "default": 0,
      "label": { "en": "Contrast", "de": "Kontrast" } },
    { "key": "residual", "type": "slider", "min": 0, "max": 200, "default": 0,
      "label": { "en": "Residual color", "de": "Restfarbe" } },
    { "key": "preserve", "type": "toggle", "default": false,
      "label": { "en": "Preserve highlights and details", "de": "Lichter und Details schützen" } }
  ],
  "shader": [
    "// Copyright (C) Spoilerhead 2011-2026. Licensed GPL-2.0-or-later OR LGPL-2.0-or-later.",
    "// Original source: https://github.com/spoilerhead/asp_plugins",
    "const float PI = 3.14159265358979323846;",
    "",
    "// The original keeps this fast sine on purpose: a true sine changes the look.",
    "float fastSin(float x) {",
    "    if (x < -PI) x += 2.0 * PI;",
    "    else if (x > PI) x -= 2.0 * PI;",
    "    return x < 0.0 ? (1.27323954 + 0.405284735 * x) * x",
    "                   : (1.27323954 - 0.405284735 * x) * x;",
    "}",
    "",
    "float3 effect(float3 color) {",
    "    // The original works on linear light encoded with gamma 2.2.",
    "    float3 c = pow(fpToLinear(color), float3(1.0 / 2.2));",
    "",
    "    float amount = contrast / 100.0;",
    "    float linearContrast = amount > 1.0 ? 1.0 + 2.0 * (amount - 1.0) * (amount - 1.0) : 1.0;",
    "    amount = min(amount, 1.0);",
    "",
    "    float lo = min(c.r, min(c.g, c.b)), hi = max(c.r, max(c.g, c.b));",
    "    float value = dot(c, float3(0.299, 0.587, 0.114));",
    "    float sat = 0.0, h = 0.0;",
    "    if (value > 0.000001 && hi - lo > 0.000001) {",
    "        sat = (hi - lo) / value;",
    "        if (hi == c.r) {",
    "            h = (c.g - c.b) / (hi - lo) / 6.0;",
    "            if (h < 0.0) h += 1.0;",
    "        } else if (hi == c.g) h = 1.0 / 3.0 + (c.b - c.r) / (hi - lo) / 6.0;",
    "        else h = 2.0 / 3.0 + (c.r - c.g) / (hi - lo) / 6.0;",
    "    }",
    "",
    "    // The color filter: colors near the chosen hue get lighter, the opposite ones darker.",
    "    float filterWeight = 0.5 * fastSin((h - hue / 360.0) * 2.0 * PI + PI / 2.0);",
    "    filterWeight *= clamp(sat * (2.0 - sat), 0.0, 1.0);",
    "    value *= 1.0 + luminance / 100.0 * filterWeight;",
    "",
    "    if (preserve > 0.5) value = ((-0.4481 * value + 0.5489) * value + 0.7659) * value + 0.03891;",
    "    value += midpoint / 100.0 * (value - value * value);",
    "    value = clamp(value, 0.0, 1.0);",
    "    value -= amount / 4.4 * fastSin(2.0 * PI * value);",
    "    value = clamp((value - 0.5) * linearContrast + 0.5, 0.0, 1.0);",
    "",
    "    sat *= residual / 100.0;",
    "    if (value <= 0.000001) c = float3(0.0);",
    "    else if (sat <= 0.000001) c = float3(value);",
    "    else {",
    "        float hf = h * 6.0, chroma = value * sat;",
    "        float f = hf - floor(hf), q = chroma * (1.0 - f), t = chroma * f;",
    "        if (hf < 1.0) c = float3(chroma, t, 0.0);",
    "        else if (hf < 2.0) c = float3(q, chroma, 0.0);",
    "        else if (hf < 3.0) c = float3(0.0, chroma, t);",
    "        else if (hf < 4.0) c = float3(0.0, q, chroma);",
    "        else if (hf < 5.0) c = float3(t, 0.0, chroma);",
    "        else c = float3(chroma, 0.0, q);",
    "        c += value - dot(c, float3(0.299, 0.587, 0.114));",
    "    }",
    "    return fpToSrgb(pow(clamp(c, 0.0, 1.0), float3(2.2)));",
    "}"
  ]
}
