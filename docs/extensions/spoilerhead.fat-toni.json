{
  "format": 1,
  "id": "spoilerhead.fat-toni",
  "version": 1,
  "name": {
    "en": "Fat Toni (Split Toning)",
    "de": "Fat Toni (Teiltonung)"
  },
  "description": {
    "en": "Tones highlights and shadows separately and can tint the base like a paper color. Works on black and white and on color pictures.",
    "de": "Tont Lichter und Tiefen getrennt und kann den Grund wie eine Papierfarbe einfärben. Wirkt auf Schwarzweiß- und auf Farbbilder."
  },
  "author": "Spoilerhead",
  "license": "GPL-2.0-or-later OR LGPL-2.0-or-later",
  "url": "https://github.com/spoilerhead/asp_plugins",
  "stage": "after-grain",
  "controls": [
    { "key": "highlightHue", "type": "slider", "track": "hue", "min": 0, "max": 360, "default": 0,
      "section": { "en": "Highlights", "de": "Lichter" },
      "label": { "en": "Hue", "de": "Farbton" } },
    { "key": "highlightSaturation", "type": "slider", "track": { "saturation": "highlightHue" }, "min": 0, "max": 100, "default": 0,
      "label": { "en": "Saturation", "de": "Sättigung" } },
    { "key": "shadowHue", "type": "slider", "track": "hue", "min": 0, "max": 360, "default": 0,
      "section": { "en": "Shadows", "de": "Tiefen" },
      "label": { "en": "Hue", "de": "Farbton" } },
    { "key": "shadowSaturation", "type": "slider", "track": { "saturation": "shadowHue" }, "min": 0, "max": 100, "default": 0,
      "label": { "en": "Saturation", "de": "Sättigung" } },
    { "key": "baseHue", "type": "slider", "track": "hue", "min": 0, "max": 360, "default": 0,
      "section": { "en": "Base (paper)", "de": "Grund (Papier)" },
      "label": { "en": "Hue", "de": "Farbton" } },
    { "key": "baseSaturation", "type": "slider", "track": { "saturation": "baseHue" }, "min": 0, "max": 100, "default": 0,
      "label": { "en": "Saturation", "de": "Sättigung" } },
    { "key": "baseLuminance", "type": "slider", "track": { "luminance": "baseHue" }, "min": 0, "max": 100, "default": 100,
      "label": { "en": "Luminance", "de": "Luminanz" } },
    { "key": "midpoint", "type": "slider", "track": "black-white", "min": -100, "max": 100, "default": 0,
      "section": { "en": "Mixing", "de": "Mischung" },
      "label": { "en": "Midpoint", "de": "Mittelpunkt" } },
    { "key": "separation", "type": "slider", "min": 0, "max": 100, "default": 50,
      "label": { "en": "Separation", "de": "Trennung" } },
    { "key": "contrast", "type": "slider", "min": 0, "max": 100, "default": 85,
      "label": { "en": "Contrast", "de": "Kontrast" } }
  ],
  "shader": [
    "// Copyright (C) Spoilerhead 2011-2026. Licensed GPL-2.0-or-later OR LGPL-2.0-or-later.",
    "// Original source: https://github.com/spoilerhead/asp_plugins",
    "const float PI = 3.14159265358979323846;",
    "",
    "// The original keeps this fast sine on purpose: a true sine changes the look.",
    "float fastSin(float x) {",
    "    if (x < -PI) x += 2.0 * PI;",
    "    else if (x > PI) x -= 2.0 * PI;",
    "    return x < 0.0 ? (1.27323954 + 0.405284735 * x) * x",
    "                   : (1.27323954 - 0.405284735 * x) * x;",
    "}",
    "",
    "float3 effect(float3 color) {",
    "    // The original works on linear light encoded with gamma 2.2.",
    "    float3 c = pow(fpToLinear(color), float3(1.0 / 2.2));",
    "",
    "    float3 highTone = fpHslToRgb(float3(highlightHue / 360.0, highlightSaturation / 100.0, 0.5));",
    "    float3 lowTone = fpHslToRgb(float3(shadowHue / 360.0, shadowSaturation / 100.0, 0.5));",
    "    float3 baseTone = fpHslToRgb(float3(baseHue / 360.0, baseSaturation / 100.0, baseLuminance / 100.0));",
    "",
    "    // Where between shadows and highlights this pixel lies.",
    "    float a = clamp((c.r + c.g + c.b) / 3.0 + midpoint / 200.0, 0.0, 1.0);",
    "    a = clamp(a - separation / 200.0 * fastSin(2.0 * PI * a), 0.0, 1.0);",
    "    float3 tone = highTone * a + lowTone * (1.0 - a);",
    "",
    "    float3 screen = 1.0 - (1.0 - tone) * (1.0 - c);",
    "    float3 overlay = c * screen + (1.0 - c) * tone * c;",
    "    float mixing = contrast / 100.0;",
    "    c = baseTone * (overlay * mixing + clamp(c + tone - 0.5, 0.0, 1.0) * (1.0 - mixing));",
    "    return fpToSrgb(pow(clamp(c, 0.0, 1.0), float3(2.2)));",
    "}"
  ]
}
