<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:FerrumPix.Controls">

    <Styles.Resources>
        <FontFamily x:Key="FP.Font.Family">Segoe UI, Cantarell, DejaVu Sans, sans-serif</FontFamily>

        <!-- DIE LEERE SPALTE IM MENUE. Ein Menueeintrag hat fuenf Spalten, und eine davon traegt
             den Tastenkuerzel-Text. Der ist bei uns ueberall leer - die Anwendung setzt weder
             InputGestureText noch HotKey -, seine Spalte ist aber trotzdem 24 Bildpunkte breit,
             weil der Abstand am Textfeld haengt und nicht am Text. Diese 24 Punkte stehen genau
             ZWISCHEN der Beschriftung und dem Pfeil eines Untermenues und schoben ihn nach rechts.
             Auf null gesetzt gewinnt jedes Menue der Anwendung diese Breite zurueck. -->
        <Thickness x:Key="MenuInputGestureTextMargin">0</Thickness>


        <!-- Schriftgrößen für Text. Eine App-weite Vergrößerung ist eine Änderung an diesen neun
             Zahlen - vorher standen sie 418-mal in den AXAML-Dateien. -->
        <x:Double x:Key="FP.Font.Label">9</x:Double>
        <x:Double x:Key="FP.Font.Caption">10</x:Double>
        <x:Double x:Key="FP.Font.Small">11</x:Double>
        <x:Double x:Key="FP.Font.Body">12</x:Double>
        <x:Double x:Key="FP.Font.ItemTitle">13</x:Double>
        <x:Double x:Key="FP.Font.Subtitle">14</x:Double>
        <x:Double x:Key="FP.Font.Title">15</x:Double>
        <x:Double x:Key="FP.Font.Heading">18</x:Double>
        <x:Double x:Key="FP.Font.Display">24</x:Double>

        <!-- Symbolzeichen (×, −, +, ↑, ↓, □, ⧉) in Fenster- und Schließen-Schaltflächen. Sie sind
             Grafik, keine Typografie, und dürfen bei einer Schriftvergrößerung nicht mitwachsen -
             sonst sprengen sie ihre Schaltflächen. -->
        <x:Double x:Key="FP.Glyph.Small">10</x:Double>
        <x:Double x:Key="FP.Glyph.Medium">13</x:Double>
        <x:Double x:Key="FP.Glyph.Large">14</x:Double>
        <x:Double x:Key="FP.Glyph.XLarge">16</x:Double>

        <SolidColorBrush x:Key="FP.Bg.Root" Color="#0B0E11"/>
        <SolidColorBrush x:Key="FP.Bg.Dark" Color="#0E1216"/>
        <SolidColorBrush x:Key="FP.Bg.Panel" Color="#11161B"/>
        <SolidColorBrush x:Key="FP.Bg.Content" Color="#141A20"/>
        <SolidColorBrush x:Key="FP.Bg.Elevated" Color="#192128"/>
        <SolidColorBrush x:Key="FP.Bg.Hover" Color="#1F2830"/>
        <SolidColorBrush x:Key="FP.Bg.Input" Color="#10161B"/>
        <SolidColorBrush x:Key="FP.Bg.Active" Color="#24303A"/>

        <SolidColorBrush x:Key="FP.Accent" Color="#F08A1A"/>
        <SolidColorBrush x:Key="FP.Accent.Light" Color="#FF9D2F"/>
        <SolidColorBrush x:Key="FP.Accent.Dark" Color="#BC6711"/>
        <SolidColorBrush x:Key="FP.Accent.Dim" Color="#2B1606"/>
        <SolidColorBrush x:Key="FP.Brand.Accent" Color="#F08A1A"/>

        <SolidColorBrush x:Key="FP.Text.Primary" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="FP.Text.Secondary" Color="#A6AFB7"/>
        <SolidColorBrush x:Key="FP.Text.Muted" Color="#6C7780"/>
        <SolidColorBrush x:Key="FP.Text.Accent" Color="#F08A1A"/>
        <!-- Für Zustände, die der Nutzer NICHT übersehen darf (fehlgeschlagene Vorschau). Bewusst kein
             Orange: das ist die Akzentfarbe der App und liest sich als "aktiv", nicht als "kaputt". -->
        <SolidColorBrush x:Key="FP.Text.Danger" Color="#FF6B6B"/>

        <SolidColorBrush x:Key="FP.Border.Subtle" Color="#182028"/>
        <SolidColorBrush x:Key="FP.Border.Normal" Color="#26313B"/>
        <SolidColorBrush x:Key="FP.Border.Strong" Color="#34414C"/>

        <SolidColorBrush x:Key="FP.Sel.Bg" Color="#24303A"/>
        <SolidColorBrush x:Key="FP.Sel.Hover" Color="#2A3742"/>

        <!-- DAS UNTERMENUE IST EIN EIGENES POPUP. Es steckt in der Vorlage des Menueeintrags und
             ist weder ein ContextMenu noch ein MenuFlyoutPresenter - die Regeln weiter unten
             greifen also nicht an ihm. Sein Aussehen holt es sich ausschliesslich ueber diese
             Schluessel, und ohne sie stand es mit Hintergrund und Rahmen des
             Standarderscheinungsbilds da (Nutzerbefund 2026-08-11). Die Werte sind dieselben wie
             bei FP.Bg.Elevated und FP.Border.Normal; ausgeschrieben wie bei den ComboBox-Schluesseln
             darunter, weil ein Verweis auf einen spaeter erklaerten Schluessel ins Leere liefe. -->
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#192128"/>
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#26313B"/>
        <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
        <Thickness x:Key="MenuFlyoutPresenterThemePadding">6</Thickness>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#192128"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#26313B"/>
        <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1F2830"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#24303A"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#24303A"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2A3742"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#2A3742"/>
        <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ListBoxItemBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#1F2830"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#24303A"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#24303A"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#2A3742"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#2A3742"/>
        <SolidColorBrush x:Key="ListBoxItemForeground" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ListBoxItemForegroundPointerOver" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPointerOver" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPressed" Color="#E7ECF0"/>

        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#24303A"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#2A3742"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#34414C"/>
        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#1F2830"/>
        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#24303A"/>
        <SolidColorBrush x:Key="SystemControlHighlightListHighBrush" Color="#2A3742"/>
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#F08A1A"/>
        <SolidColorBrush x:Key="SystemControlHighlightAltLowBrush" Color="#24303A"/>
        <SolidColorBrush x:Key="SystemControlHighlightAltMediumBrush" Color="#2A3742"/>
        <SolidColorBrush x:Key="SystemControlHighlightAltHighBrush" Color="#34414C"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBackgroundPointerOver" Color="#1F2830"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBackgroundPressed" Color="#24303A"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBackgroundSelected" Color="#24303A"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBackgroundSelectedPointerOver" Color="#2A3742"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBackgroundSelectedPressed" Color="#2A3742"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBorderBrushPointerOver" Color="#34414C"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBorderBrushPressed" Color="#34414C"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBorderBrushSelected" Color="#34414C"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBorderBrushSelectedPointerOver" Color="#34414C"/>
        <SolidColorBrush x:Key="ComboBoxItemRevealBorderBrushSelectedPressed" Color="#34414C"/>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Root}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FP.Font.Family}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Small}"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Caption}"/>
    </Style>
    <!-- Die Statuszeile des Editors. Die Farbe MUSS aus einer Klasse kommen und darf nicht am TextBlock
         stehen: ein lokal gesetztes Foreground schlägt jeden Style-Setter, die Fehlerfarbe käme dann nie
         durch. Der zweite, spezifischere Selektor steht danach und gewinnt bei gesetzter Klasse. -->
    <Style Selector="TextBlock.status-text">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="TextBlock.status-text.failed">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Danger}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section-header">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Label}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="10,10,10,4"/>
        <Setter Property="LetterSpacing" Value="1.3"/>
    </Style>
    <Style Selector="TextBlock.brand">
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Heading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="TextBlock.brand-accent">
        <Setter Property="Foreground" Value="{DynamicResource FP.Brand.Accent}"/>
    </Style>

    <Style Selector="icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Icon+Text-Buttons packen ihren Inhalt in ein horizontales StackPanel - darin wird das
         (kürzere) TextBlock per Default auf die Höhe des (höheren) Icons gestreckt und rendert den
         Text dann oben statt vertikal zentriert. -->
    <Style Selector="Button StackPanel[Orientation=Horizontal] > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="UserControl.settings-view Button:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="UserControl.editor-view Button:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.accent icons|SvgIcon">
        <Setter Property="IconBrush" Value="White"/>
    </Style>
    <!-- Filter-Knopf der Galerie: traegt die Akzentfarbe, solange ein Filter greift (Favoriten,
         Bewertung, Farbetikett oder Dateityp). Ohne das war ein aktiver Filter nur an einem
         kleinen Punkt hinter der Beschriftung zu erkennen - man suchte die fehlenden Bilder im
         Ordner statt im Filter. Die Setter stehen doppelt (Button UND ContentPresenter): der
         :pointerover-Zustand der Basis-Schaltflaeche setzt Hintergrund und Rahmen direkt am
         ContentPresenter und wuerde den Akzent beim Ueberfahren sonst wieder ueberschreiben. -->
    <Style Selector="Button.filter-btn.active">
        <Setter Property="Background" Value="{DynamicResource FP.Accent.Dim}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.filter-btn.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent.Dim}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Button.filter-btn.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent.Dim}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent.Light}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Accent.Light}"/>
    </Style>
    <!-- Nur das Symbol AUF dem Knopf, deshalb die eigene Klasse. Der Inhalt eines Flyouts haengt
         im Logikbaum unter dem Knopf, der ihn oeffnet: ohne diese Einschraenkung faerbte die Regel
         bei aktivem Filter JEDES Symbol im Aufklapper mit, auch die Bewertungssterne. -->
    <Style Selector="Button.filter-btn.active icons|SvgIcon.filter-glyph">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>

    <!-- ZEILE IN EINEM NAVIGATIONSBAUM (Suchlisten, Immich, Nextcloud, Favoriten).
         Holt die Einrueckung zurueck, die der Baum fuer seinen Aufklapp-Pfeil freihaelt. In den
         Serverbaeumen ist der Pfeil ausgeblendet (dort klappt ein Klick auf die Zeile auf), im
         Ordnerbaum bleibt er - deshalb traegt dessen Zeile diese Klasse nicht. -->
    <Style Selector="Grid.baumzeile">
        <Setter Property="Margin" Value="-34,3,0,3"/>
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <!-- IN EINEM AUFKLAPPMENUE BRAUCHT DERSELBE KNOPF EINE ANDERE FARBE. Der FlyoutPresenter ist
         selbst FP.Bg.Elevated, die Regel darueber malt also genau den Untergrund - die Zeile unter
         dem Zeiger sah aus wie jede andere. Gemeldet wurde es fuer das Sortiermenue, es galt aber
         fuer jedes Menue aus Ghost-Knoepfen. FP.Bg.Hover ist dieselbe Farbe, die auch die
         Kontextmenues nehmen, und sie hebt sich in allen vier Themen ab. -->
    <Style Selector="FlyoutPresenter Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>
    <Style Selector="Button.insert-option-btn">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style Selector="Button.insert-option-btn.compact">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
    </Style>
    <Style Selector="Button.insert-option-btn /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
    </Style>
    <Style Selector="Button.insert-option-btn.active">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <Style Selector="Button.insert-option-btn.active /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <Style Selector="Button.insert-option-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="Button.insert-option-btn.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Button.insert-option-btn.selected-kind icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Button.info-tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="0,0,0,8"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="Button.info-tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.info-tab.active">
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Button.info-tab.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.dropdown-btn">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Button.dropdown-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="Button.dropdown-btn:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dropdown-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dropdown-btn:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dropdown-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="MinWidth" Value="220"/>
    </Style>
    <Style Selector="Button.dropdown-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>
    <Style Selector="Button.dropdown-item:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.dropdown-item:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dropdown-item:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dropdown-item:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dropdown-item:pointerover:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dropdown-item:pointerover:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dropdown-item:pointerover:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dropdown-item TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="Button.dropdown-item:pressed TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <!-- Ghost-Buttons in der Toolbar ohne Rahmen -->
    <Style Selector="Border.toolbar Button.ghost">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- Ausnahme: beschriftete Knoepfe in der Mitte der Leiste (Diashow, Anpassen) behalten ihren
         Rahmen. Sie stehen frei zwischen zwei Symbolgruppen, und ohne Rahmen ist nicht zu sehen,
         wo die Klickflaeche anfaengt. Steht nach der Regel oben, damit sie diese ueberschreibt. -->
    <Style Selector="Border.toolbar Button.ghost.framed">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
    </Style>
    <Style Selector="Button.ghost.active">
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Die acht Stufen des Schriftgrads. OHNE RAHMEN, auch die aktive: acht Kaestchen
         nebeneinander waeren ein Gitter, und die Schaltflaechen tragen ohnehin verschieden
         grosse Schrift - der Groessenunterschied ist die eigentliche Auskunft, ein Rahmen
         drumherum lenkt davon ab. Gewaehlt ist, was den Akzent traegt. -->
    <Style Selector="Button.font-step">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="Button.font-step:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <Style Selector="Button.font-step.active">
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Die Farbe muss AUCH an den ContentPresenter: er zeichnet den Text des Knopfes, und ohne
         diese Zeile bleibt er in der Vordergrundfarbe des Themes stehen. Dieselbe Stelle, an der
         auch die Filterknoepfe ihren Akzent bekommen. -->
    <Style Selector="Button.font-step.active /template/ ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.ghost.active icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
