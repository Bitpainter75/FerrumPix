    <!-- Nach dem Platzieren wird PendingInsertKind geleert, der Knopf verliert also seinen
         Aktiv-Rahmen. Solange das erzeugte Objekt ausgewählt ist, bleibt sein Werkzeug wenigstens am
         eingefärbten Symbol erkennbar - dasselbe Signal wie bei den Knöpfen im Einfügen-Panel. -->
    <Style Selector="Button.tool-btn-row.selected-kind icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Button.winchr">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#A0A8AF"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.winchr:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#24303A"/>
        <Setter Property="TextElement.Foreground" Value="#EDF2F7"/>
    </Style>
    <Style Selector="Button.winchr.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#BE3A2B"/>
        <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.theme-choice">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Content}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.theme-choice:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="Button.theme-choice.active">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="Button.swatch.active">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.wnd-btn, Button.wnd-close">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.wnd-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="Button.wnd-close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#3A1511"/>
        <Setter Property="BorderBrush" Value="#8D332A"/>
        <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>

    <!-- WAS MAN AM DATEPICKER SIEHT, IST EIN KNOPF IN SEINER VORLAGE (PART_FlyoutButton), nicht
         der DatePicker selbst. Fläche, Rahmen, Radius und Höhe muessen deshalb DORT stehen; am
         DatePicker gesetzt lagen sie hinter dem Knopf und blieben unsichtbar, waehrend der Knopf
         weiter die Werte des allgemeinen Button-Stils trug (Radius 6, Innenabstand 14,8) und mit
         Fluents Mindestbreite von 296 aus der Reihe fiel.
         Ein Stil auf ein Vorlagenteil sticht dessen Vorlagenbindung, die Werte greifen also auch
         da, wo Fluent selbst etwas bindet. Der DatePicker tritt zurueck: ohne Flaeche, ohne
         Rahmen, ohne Innenabstand - sonst laege Chrom ueber Chrom. -->
    <Style Selector="DatePicker.capture-date-picker">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Dieselben Werte wie beim Textfeld daneben (Feldfläche, Rahmen, Radius 8) und dieselbe
         Höhe 36, damit Datum, Uhrzeit und Inkrement eine gemeinsame Kante bilden. Innenabstand
         nur waagerecht: die Höhe steht fest, senkrecht zentriert der Knopf seinen Inhalt.
         Der Zustand unter dem Zeiger kommt aus dem allgemeinen Button-Stil und sieht damit aus
         wie ueberall sonst. -->
    <Style Selector="DatePicker.capture-date-picker /template/ Button#PART_FlyoutButton">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- DIESELBE FALLE WIE BEI DEN ICON+TEXT-KNOEPFEN, nur mit einem Grid: Tag, Monat und Jahr
         liegen in den Zellen von PART_ButtonContentGrid, ein TextBlock ohne eigene Ausrichtung
         wird darin auf die volle Zellenhöhe gestreckt und zeichnet seinen Text dann OBEN. Die
         Zentrierung des Knopfes greift nur am Gitter als Ganzem, nicht an den Feldern darin. -->
    <Style Selector="DatePicker.capture-date-picker /template/ Grid#PART_ButtonContentGrid">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="DatePicker.capture-date-picker /template/ TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Die zwei Trennstriche zwischen Tag, Monat und Jahr kommen sonst aus Fluents Palette und
         waeren im dunklen Theme kaum zu sehen. -->
    <Style Selector="DatePicker.capture-date-picker /template/ Rectangle#PART_FirstSpacer">
        <Setter Property="Fill" Value="{DynamicResource FP.Border.Normal}"/>
    </Style>
    <Style Selector="DatePicker.capture-date-picker /template/ Rectangle#PART_SecondSpacer">
        <Setter Property="Fill" Value="{DynamicResource FP.Border.Normal}"/>
    </Style>
    <!-- IN EINEM AUFKLAPPFENSTER LOESCHT EIN ELEMENT, DAS SELBST NICHTS ZEICHNET, DEN HINTERGRUND
         SEINES ELTERNTEILS; an seiner Stelle kommt der Hintergrund des MENUES zum Vorschein. Am
         gerenderten Aufklappfenster gemessen: ein leerer Border ueber einer roten Flaeche zeigte in
         seinem Bereich nicht rot, sondern die Menuefarbe, ein Border MIT Hintergrund dagegen den
         eigenen - schon ein durchsichtiger Hintergrund genuegt, um das Loeschen zu verhindern. In
         der Vorlage einer TextBox stapeln sich mehrere solche leeren Behaelter (Raster, Andockfeld,
         Rollbereich); in den Suchkaesten der Filtermenues stand deshalb ein hellerer Block ueber die
         ganze Breite des Feldes, auch nachdem das Feld seine Flaeche selbst malte
         (Nutzerbefund 2026-08-16). Der Rollbereich liegt zuoberst und deckt die Textflaeche ab, ihn
         zu faerben genuegt. Im Hauptfenster tritt das nicht auf, nur in Popups - dort aber in JEDEM
         Textfeld, auch in den Hex-Feldern der Farbwaehler. Die Klassen mit bewusst durchsichtigem
         Feld ziehen das weiter unten einzeln wieder zurueck. -->
    <Style Selector="TextBox /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
    </Style>
    <Style Selector="TextBox.search-input">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <!-- DAS FELD MALT SEINE FLAECHE SELBST, UND ZWAR IN DER FARBE SEINES KASTENS. Durchsichtig
         waere naheliegend, weil der Kasten darunter dieselbe Farbe hat - in einem Aufklappfenster
         kam darunter aber nicht der Kasten zum Vorschein, sondern der Hintergrund des MENUES: hinter
         dem Platzhaltertext stand ein hellerer Block ueber die ganze Breite des Feldes
         (Nutzerbefund 2026-08-16). Der Grund steht beim Rollbereich weiter oben. Alle Suchkaesten
         liegen auf FP.Bg.Input, das Feld faellt also nirgends auf. Jeder Zustand braucht seine
         eigene Regel, und das ist keine Doppelung: der Hintergrund einer TextBox haengt bei Avalonia
         am PART_BorderElement der Vorlage, nicht an ihrer Background-Eigenschaft. Ein Background an
         der TextBox selbst - ob als Klasse oder direkt am Element - laeuft ins Leere. -->
    <Style Selector="TextBox.search-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.search-input:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.overlay-editor">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SelectionBrush" Value="#55F08A1A"/>
    </Style>
    <Style Selector="TextBox.overlay-editor /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.overlay-editor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.overlay-editor:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- Der Text auf der Buehne steht ueber dem Bild und darf keine Flaeche mitbringen. -->
    <Style Selector="TextBox.overlay-editor /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.search-input:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="TextBox.slider-value">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Caption}"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style Selector="TextBox.slider-value:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <!-- Das Zahlenfeld sitzt AUF der Reglerzeile und nimmt deren Farbe an, nicht die eines Feldes. -->
    <Style Selector="TextBox.slider-value /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- 1. Haupt-Style: Gilt für NumericUpDown, aber NUR mit der Klasse .slider-value -->
    <Style Selector=":is(NumericUpDown).slider-value">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Caption}"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="ShowButtonSpinner" Value="False"/>
    </Style>

    <!-- 2. Fokus-Zustand -->
    <Style Selector=":is(NumericUpDown).slider-value:focus-within">
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- 3. Das eigentliche Textfeld im Template stylen -->
    <Style Selector=":is(NumericUpDown).slider-value /template/ TextBox#PART_TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="SelectionBrush" Value="#55F08A1A"/>
        <Setter Property="Padding" Value="2,0,2,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector=":is(NumericUpDown).slider-value /template/ TextBox#PART_TextBox /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector=":is(NumericUpDown).slider-value /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector=":is(NumericUpDown).slider-value /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 4. Buttons im Template unsichtbar machen -->
    <Style Selector=":is(NumericUpDown).slider-value /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Width" Value="0"/>
    </Style>
    <Style Selector=":is(NumericUpDown).slider-value /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Width" Value="0"/>
    </Style>

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="Slider /template/ Border">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Slider /template/ RepeatButton /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Bg.Root}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Slider /template/ Thumb /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Bg.Root}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Slider:pointerover /template/ Thumb /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Bg.Root}"/>
    </Style>
    <Style Selector="icons|RoundSlider">
        <Setter Property="TrackBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="FillBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="ThumbBorderBrush" Value="{DynamicResource FP.Bg.Root}"/>
        <!-- Bestimmt die Zeilenhöhe der Schieberegler-Zeilen: die Spur ist nur 4px hoch, der Rest ist
             Klickfläche um sie herum. -->
        <Setter Property="Height" Value="36"/>
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="13"/>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="13"/>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="MinWidth" Value="10"/>
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb">
        <Setter Property="MinHeight" Value="10"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <Style Selector="ListBoxItem:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.layers-list ListBoxItem:selected Border.layer-item">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Standard-Ebenenliste (LayersPanelView): flache, volle Zeilen mit dünnem Trenner, ausgewählte Zeile
         voll in Akzentfarbe gefüllt (wie in üblichen Bildbearbeitungen, nur in der App-Farbe statt Blau). -->
    <Style Selector="ListBox.layers-panel-list">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.layers-panel-list ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Border.layers-panel-row">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="ListBox.layers-panel-list ListBoxItem:pointerover Border.layers-panel-row">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
    </Style>
    <Style Selector="ListBox.layers-panel-list ListBoxItem:selected Border.layers-panel-row">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="ListBox.layers-panel-list ListBoxItem:selected Border.layers-panel-row TextBlock.layer-name">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
    <!-- Auge auf einer ausgewählten (orangefarbenen) Zeile: sichtbar = weiß, ausgeblendet = gedämpftes Weiß. -->
    <Style Selector="ListBox.layers-panel-list ListBoxItem:selected Border.layers-panel-row ToggleButton.layer-eye icons|SvgIcon">
        <Setter Property="IconBrush" Value="#99FFFFFF"/>
    </Style>
    <Style Selector="ListBox.layers-panel-list ListBoxItem:selected Border.layers-panel-row ToggleButton.layer-eye:checked icons|SvgIcon">
        <Setter Property="IconBrush" Value="#FFFFFFFF"/>
    </Style>

    <!-- MEHRFACHauswahl: die ListBox markiert nur EINE Zeile. Alle weiteren markierten Ebenen sehen
         deshalb über diese Klasse genauso aus wie die ausgewählte - sonst wirkte eine funktionierende
         Mehrfachauswahl, als hätte sie nicht gegriffen. -->
    <Style Selector="Border.layers-panel-row.multi-selected">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Border.layers-panel-row.multi-selected TextBlock.layer-name">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
    <Style Selector="Border.layers-panel-row.multi-selected ToggleButton.layer-eye icons|SvgIcon">
        <Setter Property="IconBrush" Value="#99FFFFFF"/>
    </Style>
    <Style Selector="Border.layers-panel-row.multi-selected ToggleButton.layer-eye:checked icons|SvgIcon">
        <Setter Property="IconBrush" Value="#FFFFFFFF"/>
    </Style>

    <Style Selector="ListBoxItem:selected:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
    </Style>
    <Style Selector="ListBox.filmstrip-list ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ListBox.filmstrip-list ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TreeViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,6"/>
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Width" Value="220"/>
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter, ContextMenu">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="208"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
    </Style>
    <!-- Das Zeichen fuer ein Untermenue kommt aus UNSEREM Symbolsatz und steht direkt hinter der
         Beschriftung (siehe die Vorlage der Kontextmenues in Galerie, Betrachter und Editor).
         Das der Standardvorlage sitzt in der letzten Spalte, also immer am rechten Rand des
         Menues - je breiter das Menue, desto weiter weg vom Wort. Deshalb bleibt es aus. -->
    <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>
    <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- Die Beschriftung fuellt ihre Spalte aus. Nur so kann das Zeichen fuer ein Untermenue
             an den rechten Rand ruecken - sonst waere die Zeile so breit wie ihr Text, und alles
             darin klebte links zusammen. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="MenuItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="MenuItem:pressed /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="MenuItem:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Rechts etwas mehr Platz als links: bei krummer Anwendungsskalierung (AVALONIA_SCREEN_SCALE_FACTORS,
             siehe AppSettingsService.ApplyApplicationScaleEnvironment) rundet Avalonia die Breite des
             Tooltip-Popups ab, wodurch das letzte Zeichen abgeschnitten wurde ("Anpassen" -> "Anpasse").
             Der Puffer fällt optisch nicht auf und deckt die Rundung in jeder Skalierung ab. -->
        <Setter Property="Padding" Value="8,4,14,4"/>
        <!-- Krumme Skalierung, Teil 2: Der feste Padding-Puffer reichte nicht
             für alle Textlängen - die Layout-Rundung arbeitet bei fraktionalen Faktoren in
             Gerätepixel-Schritten (1,72 => 0,58-DIP-Raster) und kann die Textbreite ABRUNDEN,
             der Fehler wächst mit der Zeichenzahl. Ohne Layout-Rundung bekommt der Text exakt
             seine gemessene Breite; die minimal weichere 1-px-Kante des Tooltips ist der Preis. -->
        <Setter Property="UseLayoutRounding" Value="False"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Small}"/>
        <Setter Property="MinWidth" Value="0"/>
        <!-- Krumme Skalierung, Teil 3: 260 war zu knapp. Zusammen mit dem Umbruch weiter unten
             wurde aus einem um wenige Punkte zu breiten Text ein FEHLENDES WORT - es rutschte auf
             eine zweite Zeile, die das Popup nicht mehr zeigte ("Drehen und Verzerren" ->
             "Drehen und"). Breiter gefasst bleiben die Beschriftungen der Werkzeuge auch bei
             groesster Schrift einzeilig; nur die langen Erklaertexte brechen noch um, und die
             sollen es. -->
        <Setter Property="MaxWidth" Value="440"/>
    </Style>
    <!-- Tooltip-Texte dürfen umbrechen: Texte über MaxWidth (260) wurden bisher bei JEDER
         Skalierung hart abgeschnitten (TextBlock ohne Wrapping, z.B. die langen Erklär-Tooltips
         im Transformieren-Panel). Mit Umbruch bestimmt die Messung die nötige Höhe gleich mit. -->
    <Style Selector="ToolTip TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <!-- Krumme Skalierung, Teil 4: Den Puffer gegen die Rundung liefert ein Leerzeichen, das
             LocalizationService beim Übersetzen an jeden Kurzhinweis hängt - es wird mitgemessen
             und ist nicht sichtbar. Hier steht bewusst kein zweiter Kniff dagegen. -->
    </Style>

    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Dark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="Border.statusbar">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Dark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="Border.panel-right">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>
    <!-- Dasselbe Panel auf der linken Seite: die Trennlinie gehoert dann nach rechts, zur Buehne
         hin. Mit der rechten Fassung stuende sie zur Werkzeugleiste hin und dort doppelt. -->
    <Style Selector="Border.panel-left">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <Style Selector="Border.thumb-card">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Content}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.thumb-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="Border.thumb-card.list-row">
        <Setter Property="Margin" Value="5,3"/>
    </Style>
    <Style Selector="Border.thumb-card.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.thumb-card.navigation-selected">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="StackPanel.gallery-hover-actions">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="StackPanel.gallery-meta-badges">
        <Setter Property="Panel.ZIndex" Value="3"/>
    </Style>
    <!-- Umschaltbare Kachel-Badges (Sterne/Favorit/Metadaten): versteckt, beim Überfahren der Kachel
         sichtbar - ODER dauerhaft sichtbar, wenn die Klasse badge-always gesetzt ist (an die
         Galerie-Einstellung gebunden). Ein Regler pro Badge, siehe SettingsView/GalleryViewModel. -->
    <Style Selector=":is(Control).gallery-toggle-badge">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Border.thumb-card:pointerover :is(Control).gallery-toggle-badge">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector=":is(Control).gallery-toggle-badge.badge-always">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector="Border.gallery-metadata-overlay">
        <Setter Property="Panel.ZIndex" Value="4"/>
        <Setter Property="Background" Value="#D811161B"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MaxWidth" Value="190"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Border.gallery-metadata-overlay.compact">
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="MaxWidth" Value="160"/>
    </Style>
    <Style Selector="Border.thumb-card:pointerover StackPanel.gallery-hover-actions">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <!-- Sichtbarkeit der Sterne kommt jetzt aus gallery-toggle-badge (versteckt/hover/immer). Hier bleibt
         nur die Stapelordnung; die alten Opacity-/Hover-Regeln würden sonst gallery-toggle-badge.badge-always
         überschreiben (spätere Stile gewinnen in Avalonia) und die "immer sichtbar"-Einstellung aushebeln. -->
    <Style Selector="StackPanel.gallery-rating-actions">
        <Setter Property="Panel.ZIndex" Value="3"/>
    </Style>
    <Style Selector="StackPanel.gallery-rating-actions.compact">
        <Setter Property="Spacing" Value="0"/>
    </Style>
    <Style Selector="Button.gallery-overlay-btn">
        <Setter Property="Background" Value="#8C0F1318"/>
        <Setter Property="BorderBrush" Value="#66384450"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.gallery-overlay-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#B81A2028"/>
        <Setter Property="BorderBrush" Value="#80536476"/>
    </Style>
    <Style Selector="Button.gallery-overlay-btn.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#AA6E1D1D"/>
        <Setter Property="BorderBrush" Value="#C08E2D2D"/>
    </Style>
    <Style Selector="Border.gallery-meta-pill">
        <Setter Property="Background" Value="#C010141A"/>
        <Setter Property="BorderBrush" Value="#8A4C5A69"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style Selector="Border.gallery-meta-pill.compact">
        <Setter Property="Padding" Value="3"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Content}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="Border.section">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Content}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="Border.adjustment-group">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Content}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="Border.adjustment-group Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border.adjustment-group Expander:pointerover">
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- Blendet Symbolknöpfe in Anpassungsgruppen aus, die weder zum Inhalt der Gruppe gehören noch
         sie zurücksetzen. Zwei Ausnahmen tragen eine eigene Klasse:
         "group-action" = Teil des Gruppeninhalts (z.B. Tauschen und Pipette im Farbmischer),
         "group-reset"  = der Zurücksetzer oben rechts, der NUR seine eigene Gruppe zurücksetzt.
         Die Zurücksetzer waren bis mit ausgeblendet - zurückgesetzt wurde zentral über
         einen Knopf in der Panel-Kopfzeile. Das ist zurückgenommen: jede Gruppe setzt sich selbst
         zurück, und dafür muss ihr Knopf auch sichtbar sein. -->
    <Style Selector="Border.adjustment-group Button.icon-btn:not(.group-action):not(.group-reset)">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.divider">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="Margin" Value="6,8"/>
    </Style>
    <Style Selector="Border.metric-pill">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="Border.look-pill.active">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Border.preview-frame">
        <Setter Property="Background" Value="#0B0F13"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- Favoriten-Herz: inaktiv = Textfarbe, aktiv = Akzentfarbe -->
    <Style Selector="Button.favorite-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Button.favorite-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.favorite-btn:pressed /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.72"/>
    </Style>
    <Style Selector="Button.selection-badge">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="#CC10161B"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="Transparent"/>
    </Style>
    <Style Selector="Button.video-play-badge">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Button.video-play-badge:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent.Light}"/>
    </Style>
    <Style Selector="Button.video-play-badge:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent.Dark}"/>
    </Style>
    <Style Selector="Button.selection-badge.compact">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Button.selection-badge:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="Button.selection-badge.active">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.selection-badge.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.selection-badge icons|SvgIcon.badge-glyph">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="Button.selection-badge.active icons|SvgIcon.badge-glyph">
        <Setter Property="IconBrush" Value="White"/>
    </Style>
    <Style Selector="Button.favorite-btn:pointerover icons|SvgIcon.fav-heart">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="Button.favorite-btn:pointerover icons|SvgIcon.fav-heart.active">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Accent.Light}"/>
    </Style>
    <Style Selector="Button.image-favorite-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.image-favorite-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="icons|SvgIcon.fav-heart">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="icons|SvgIcon.fav-heart.active">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <!-- Bewertungssterne: SVG-basiert, aktiv in Akzentfarbe -->
    <Style Selector="Button.star-btn icons|SvgIcon.rating-star">
        <Setter Property="IconBrush" Value="#EAEFF5"/>
        <Setter Property="Opacity" Value="0.92"/>
        <Setter Property="Effect">
            <DropShadowEffect BlurRadius="0"
                              OffsetX="1"
                              OffsetY="1"
                              Color="#B0000000"/>
        </Setter>
    </Style>
    <Style Selector="Button.star-btn.active icons|SvgIcon.rating-star">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Ausgewählte Thumbnail-Karte: oranger Rahmen -->
    <Style Selector="ListBoxItem:selected Border.thumb-card">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <Style Selector="ComboBox:pressed /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="ComboBox /template/ ToggleButton#DropDownButton:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
    </Style>
    <Style Selector="ComboBox /template/ ToggleButton#DropDownButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
    </Style>
    <!-- Die Ausklappliste ist NIE schmaler als das Feld selbst:
         MinWidth auf Popup UND Rahmen - das Popup allein garantiert nur den Platz, der Rahmen
         darin durfte sonst auf die (schmaleren) Einträge zusammenfallen. -->
    <Style Selector="ComboBox /template/ Popup#PART_Popup">
        <Setter Property="MinWidth" Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <Style Selector="ComboBox /template/ Popup#PART_Popup Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MinWidth" Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <Style Selector="ComboBox /template/ Popup#PART_Popup ScrollViewer">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>

    <Style Selector="NumericUpDown.combo-like">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="TextBox.combo-like">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="TextBox.combo-like:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <Style Selector="TextBox.combo-like:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <!-- PART_TextBox ist selbst ein vollwertiges TextBox-Control mit eigenem Fokus-Erscheinungsbild
         (eigener Rahmen/Hintergrund im :focus-Zustand seines eigenen Templates) - ohne diese
         Overrides überdeckt das beim Reinklicken den feinen äußeren Rahmen des NumericUpDown mit der
         dunkleren Eingabefeld-Hintergrundfarbe. VerticalContentAlignment/HorizontalContentAlignment
         zentrieren den Text vertikal statt am oberen Rand kleben zu bleiben. -->
    <Style Selector="NumericUpDown.combo-like /template/ TextBox#PART_TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ TextBox#PART_TextBox /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ RepeatButton#PART_DecreaseButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ RepeatButton#PART_IncreaseButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ RepeatButton#PART_DecreaseButton:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ RepeatButton#PART_IncreaseButton:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ RepeatButton#PART_DecreaseButton /template/ ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="NumericUpDown.combo-like /template/ RepeatButton#PART_IncreaseButton /template/ ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
    </Style>
    <Style Selector="ComboBoxItem:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pressed">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
    </Style>
    <Style Selector="Popup Border">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
    </Style>

    <Style Selector="Expander">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Content}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,5,10,2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid RowDefinitions="Auto,Auto">
                        <ToggleButton Background="Transparent"
                                      BorderThickness="0"
                                      Padding="{TemplateBinding Padding}"
                                      MinHeight="28"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  Foreground="{TemplateBinding Foreground}"/>
                                <!-- Sichtbarer Auf-/Zuklapp-Indikator: dreht sich beim Öffnen um 180°. -->
                                <Path Name="ExpandChevron" Grid.Column="1"
                                      Data="M2,3 L5,6 L8,3"
                                      Stroke="{DynamicResource FP.Text.Secondary}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="10" Height="9" Stretch="None"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Margin="8,0,0,0"
                                      RenderTransformOrigin="50%,50%"/>
                            </Grid>
                        </ToggleButton>
                        <ContentPresenter Grid.Row="1"
                                          IsVisible="{TemplateBinding IsExpanded}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- Klapp-Chevron: zeigt zu (nach unten) im Grundzustand, dreht beim Öffnen nach oben. -->
    <Style Selector="Expander /template/ Path#ExpandChevron">
        <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Expander:expanded /template/ Path#ExpandChevron">
        <Setter Property="RenderTransform" Value="rotate(180deg)"/>
    </Style>
    <Style Selector="Expander:pointerover /template/ Path#ExpandChevron">
        <Setter Property="Stroke" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Expander:pointerover /template/ ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Expander:pointerover /template/ ToggleButton ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton:checked">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Expander:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
</Styles>
