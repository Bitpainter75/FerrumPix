<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
      <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FerrumPix</RootNamespace>
    <AssemblyName>FerrumPix</AssemblyName>
    <Version>0.9.15</Version>
    <AssemblyVersion>0.9.15.0</AssemblyVersion>
    <FileVersion>0.9.15.0</FileVersion>
    <InformationalVersion>0.9.15</InformationalVersion>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <WindowsOnly>false</WindowsOnly>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ApplicationIcon>FerrumPix_Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native" Version="8.18.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <Content Include="$(NuGetPackageRoot)netvips.native.$(RuntimeIdentifier)/8.18.4/THIRD-PARTY-NOTICES.md"
             Condition="Exists('$(NuGetPackageRoot)netvips.native.$(RuntimeIdentifier)/8.18.4/THIRD-PARTY-NOTICES.md')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>licenses/libvips-THIRD-PARTY-NOTICES.md</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Objektivdaten\**" />
    <!-- Die Objektivdaten liegen als gewoehnliche Assembly-Ressource und NICHT als
         Avalonia-Ressource: sie werden auch ohne laufende Anwendung gelesen (Pruefstand,
         Messwerkzeuge), und Avaloniens Ressourcenlader setzt eine gestartete App voraus. -->
    <EmbeddedResource Include="Assets\Objektivdaten\objektivdaten.zip" />
  </ItemGroup>

  <!--
    libmpv is part of the macOS application instead of being an end-user prerequisite.
    The universal dylibs support both osx-arm64 and osx-x64 and are copied next to the
    executable so their @rpath dependencies can be preloaded from one directory.
  -->
  <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <Content Include="Native/libmpv/osx/*.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>libmpv/%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="Native/libmpv/NOTICE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>licenses/libmpv-NOTICE.md</TargetPath>
    </Content>
    <Content Include="Native/libmpv/LGPL-2.1.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>licenses/LGPL-2.1.txt</TargetPath>
    </Content>
    <Content Include="Native/libmpv/GPL-2.0.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>licenses/GPL-2.0.txt</TargetPath>
    </Content>
  </ItemGroup>
</Project>
