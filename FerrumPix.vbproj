<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
      <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FerrumPix</RootNamespace>
    <AssemblyName>FerrumPix</AssemblyName>
    <Version>0.9.93</Version>
    <AssemblyVersion>0.9.93.0</AssemblyVersion>
    <FileVersion>0.9.93.0</FileVersion>
    <InformationalVersion>0.9.93-1</InformationalVersion>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <WindowsOnly>false</WindowsOnly>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ApplicationIcon>FerrumPix_Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <!-- Ohne diesen Schalter gilt der VB-Standard "aus": spaete Bindung und verengende
         Umwandlungen uebersetzen stillschweigend, und die Warnungen, die sie melden wuerden,
         sind mit abgeschaltet. Die gemeldeten "0 Warnungen" waren damit zum Teil ein Ergebnis
         dieser Unterdrueckung. Gerade in VB ist das teuer: True wird zur Zahl -1 und nicht 1,
         und ein Boolean, wo ein Double stehen sollte, faellt sonst niemandem auf. -->
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <!-- Zeichnen ohne Bildschirm: der Start mit dem Schalter fuer den Browser (BrowserBridge). -->
    <PackageReference Include="Avalonia.Headless" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <!-- Die Grafikbeschleunigung fuer die gelernten Modelle: EINE Bibliothek je System, die
         darunter Vulkan, Direct3D oder Metal nimmt. Es gibt sie fuer win-x64, win-arm64,
         linux-x64, linux-arm64 und osx-arm64; osx-x64 bekommt sie nicht mitgeliefert und
         rechnet weiter auf dem Prozessor - GpuAccelerationService faengt das ab. Kostet rund
         zehn Megabyte im Paket.
         Gehalten auf 0.5.0 (und ONNX Runtime auf 1.31.1, der Stand, mit dem sie lief): 0.6.0
         bringt unter Windows eine Vorabversion der D3D12 Agility SDK mit, die den
         Entwicklermodus verlangt. Damit kam auf einer GeForce GTX 1060 schon die Probe nicht
         mehr zurueck, und das Entrauschen mit Modell hing ohne Abbruch. Erst wieder anheben,
         wenn eine Fassung die Agility SDK nicht mehr als Vorabversion mitbringt. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.EP.WebGpu" Version="0.5.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <!-- MetadataExtractor lädt den XMP-Leser erst beim Auswerten eines JPEG-Segments. Als
         direkte Abhängigkeit wird die DLL auch in selbständige Linux-Pakete übernommen. -->
    <PackageReference Include="XmpCore" Version="6.1.10.1" />
    <!-- TIFF lesen: SkiaSharp kann das Format nicht. Rein verwaltet (kein natives Beiwerk),
         BSD-3-Clause und damit mit der GPL-3 der Anwendung vertraeglich. -->
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Eine RAW-Entwicklung legt einige Gigabyte grosser Felder an. In der Voreinstellung behaelt
         die Speicherbereinigung die freigewordenen Bereiche: ein Messlauf ueber dieselben Wege
         belegte nach zehn Aufnahmen 10 bis 16 GB, mit diesem Schalter (dort Stufe 9) 2 bis 7.
         In 0.9.71-2 war er draussen, weil er die Regler zaeh machen sollte; das Stocken kam aber
         vom Startwert der Farbrauschminderung (0.9.71-3). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Objektivdaten\**;Assets\FerrumPix_Icon.icns" />
    <!-- Die macOS-Symboldatei wird ausschliesslich beim Paketieren gelesen und nie zur
         Laufzeit. Ohne diesen Ausschluss laege sie in JEDEM Build mit drin, auch im
         Windows- und Linux-Binary, und das ohne einen einzigen Zugriff darauf. -->
    <!-- Die Objektivdaten liegen als gewoehnliche Assembly-Ressource und NICHT als
         Avalonia-Ressource: sie werden auch ohne laufende Anwendung gelesen (Pruefstand,
         Messwerkzeuge), und Avaloniens Ressourcenlader setzt eine gestartete App voraus. -->
    <EmbeddedResource Include="Assets\Objektivdaten\objektivdaten.zip" />
    <!-- Versionierte, pruefbare Referenzwerte fuer die kameraabhaengige RAW-Grundbelichtung. -->
    <EmbeddedResource Include="Resources\CameraBaselineTable.json" />
    <!-- Eigene Farbmatrizen fuer Kameras, die die geladene LibRaw noch nicht kennt. -->
    <EmbeddedResource Include="Resources\CameraColorMatrices.json" />
    <!-- Kameramatrizen fuer Normlicht A und D65 je Kamera, gemischt nach dem Weissabgleich (zweimatrizen.py). -->
    <EmbeddedResource Include="Resources\CameraIlluminantMatrices.json" />
    <!-- Sensorrand je Kamera und Bildgroesse, aus Adobes DefaultCrop (sensorrand.py). -->
    <EmbeddedResource Include="Resources\CameraSensorCrops.json" />
    <!-- Gemessene Kennlinien der Tonregler fuer Tonmodell 2 (Diagnostics/Reglereichung). -->
    <EmbeddedResource Include="Resources\ToneSliderCurves.json" />
    <!-- Objektivkennungen fuer Nikon, Sony A und Pentax, erzeugt mit packaging/ci/lens-ids.py. -->
    <EmbeddedResource Include="Resources\NikonLensIds.tsv" />
    <EmbeddedResource Include="Resources\SonyAMountLensIds.tsv" />
    <EmbeddedResource Include="Resources\PentaxLensIds.tsv" />
    <EmbeddedResource Include="Resources\CanonLensTypes.tsv" />
  </ItemGroup>

  <!-- Nur fuer Windows: das Paket Microsoft.ML.OnnxRuntime legt seine Windows-Bibliotheken
       (onnxruntime.dll, onnxruntime_providers_shared.dll) ueber die eigene .props als None-Eintrag
       an, unabhaengig vom Zielsystem. Unter Linux und macOS laedt die Anwendung die .so bzw.
       .dylib aus runtimes/; die DLLs waren dort rund 17 MB ohne jeden Zugriff (gefunden im
       AppImage 0.9.91-3). Gebaut fuer ein anderes System als Windows fallen sie weg. Ohne
       Zielsystem (Entwicklungsbau) entscheidet das System, auf dem gebaut wird. -->
  <PropertyGroup>
    <TargetsWindowsRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win'))</TargetsWindowsRuntime>
    <TargetsWindowsRuntime Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</TargetsWindowsRuntime>
  </PropertyGroup>
  <Target Name="DropWindowsOnnxRuntimeElsewhere" BeforeTargets="AssignTargetPaths" Condition="'$(TargetsWindowsRuntime)' != 'true'">
    <ItemGroup>
      <None Remove="@(None)" Condition="'%(None.Link)' == 'onnxruntime.dll' OR '%(None.Link)' == 'onnxruntime_providers_shared.dll'" />
    </ItemGroup>
  </Target>

  <!-- Bibliotheken, die nur beim Binden gebraucht werden und zur Laufzeit von niemandem gelesen:
       die statische libe_sqlite3.a aus SQLitePCLRaw.lib.e_sqlite3 (runtimes/linux-*/native,
       1,8 MB im AppImage 0.9.91-3) und die Importbibliotheken onnxruntime.lib und
       onnxruntime_providers_shared.lib aus Microsoft.ML.OnnxRuntime (runtimes/win-*/native). -->
  <Target Name="DropLinkOnlyLibraries" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.a' OR '%(Extension)' == '.lib'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.a' OR '%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>
</Project>
