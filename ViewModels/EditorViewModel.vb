            Dim nextFilterPreset = If(hasFilter, normalized, "")
            If Not String.Equals(_lastAppliedFilterPresetName, nextFilterPreset, StringComparison.Ordinal) Then
                _lastAppliedFilterPresetName = nextFilterPreset
