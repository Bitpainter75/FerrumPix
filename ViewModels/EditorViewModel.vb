                Dim previousHeight = Me.CanvasHeight
                If _canvasWidth = clamped Then Return
                Me.RaiseAndSetIfChanged(_canvasWidth, clamped)
                If _lockCanvasAspect AndAlso Not _isUpdatingCanvas AndAlso previousWidth > 0 Then
