                    Case "Aqua" : Return "Aqua"
                    Case "Blue" : Return "Blau"
                    Case "Purple" : Return "Lila"
                    Case "Magenta" : Return "Magenta"
                    Case Else : Return "Rot"
                End Select
            End Get
        End Property

