<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:models="clr-namespace:FerrumPix.Models"
             xmlns:vm="clr-namespace:FerrumPix.ViewModels"
             xmlns:views="clr-namespace:FerrumPix.Views"
             x:Class="FerrumPix.Views.SettingsView"
             Classes="settings-view"
             Background="{DynamicResource FP.Bg.Root}"
             Focusable="True"
             KeyDown="OnKeyDown">

    <Grid ColumnDefinitions="250,*">

        <!-- Die Bereichsliste kann laenger sein als das Fenster hoch: sechzehn Eintraege brauchen
             gut 700 Punkte, und auf einem kleinen Bildschirm oder in einem verkleinerten Fenster
             fielen die untersten heraus - ohne jeden Hinweis, dass da noch etwas ist. Der
             Rollbereich zeigt seine Leiste nur, wenn er gebraucht wird; die Ueberschrift bleibt
             ausserhalb stehen, damit sie beim Rollen nicht verschwindet. -->
        <Border Grid.Column="0" Classes="sidebar" Padding="12,16,10,16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Einstellungen" FontSize="{DynamicResource FP.Font.Title}"
                           FontWeight="SemiBold" Margin="6,0,0,8"/>
                <!-- SUCHE UEBER DEN ANGEZEIGTEN TEXT, also in jeder Sprache ohne eigene
                     Stichwortliste: Bezeichnung, Erklaerung, Knopf- und Hakentexte und Tooltips
                     einer Zeile. Was nicht trifft, klappt weg, auch Abschnitte und ihre Eintraege
                     hier links. Die Mechanik steht in SettingsSearch. -->
                <!-- Gebaut wie die Suchleiste der Galerie: Lupe, Feld, und ein X zum Leeren, das
                     nur bei Text erscheint. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource FP.Bg.Input}"
                        BorderBrush="{DynamicResource FP.Border.Normal}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Height="34"
                        Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/magnifying-glass.svg"
                                       Width="18" Height="18" VerticalAlignment="Center" Opacity="0.65"/>
                        <TextBox x:Name="SettingsSearchBox" Grid.Column="1"
                                 Classes="search-input"
                                 BorderThickness="0"
                                 Padding="0"
                                 Height="20"
                                 Margin="10,0,0,2"
                                 PlaceholderText="Einstellungen durchsuchen"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnSettingsSearchChanged"/>
                        <Button Grid.Column="2"
                                Classes="ghost"
                                Width="22"
                                Height="22"
                                Padding="0"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Click="OnSettingsSearchClearClick"
                                IsVisible="{Binding #SettingsSearchBox.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                ToolTip.Tip="Suche zurücksetzen">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/x.svg"
                                           Width="12" Height="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.75"/>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsNavPanel" Spacing="10">

                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="GeneralSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/gear.svg" Width="18" Height="18"/>
                        <TextBlock Text="Allgemein"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="AppearanceSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/palette.svg" Width="18" Height="18"/>
                        <TextBlock Text="Darstellung"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="GallerySection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/image.svg" Width="18" Height="18"/>
                        <TextBlock Text="Galerie"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="ViewerSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/play.svg" Width="18" Height="18"/>
                        <TextBlock Text="Viewer"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="InfoPanelSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/info.svg" Width="18" Height="18"/>
                        <TextBlock Text="Info-Leiste"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="FilmstripSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/film-strip.svg" Width="18" Height="18"/>
                        <TextBlock Text="Filmstreifen"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="EditorSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/plus-minus.svg" Width="18" Height="18"/>
                        <TextBlock Text="Editor"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="RawSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/aperture.svg" Width="18" Height="18"/>
                        <TextBlock Text="RAW-Entwicklung"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="ImmichSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/cloud.svg" Width="18" Height="18"/>
                        <TextBlock Text="Immich"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="NextcloudSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/cloud.svg" Width="18" Height="18"/>
                        <TextBlock Text="Nextcloud"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="ExternalProgramsSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-square-out.svg" Width="18" Height="18"/>
                        <TextBlock Text="Externe Programme"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        IsVisible="{Binding ModelRuntimeAvailable}"
                        Tag="ModelsSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/brain.svg" Width="18" Height="18"/>
                        <TextBlock Text="Modelle"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="MapSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/map-trifold.svg" Width="18" Height="18"/>
                        <TextBlock Text="Kartenansicht"/>
                    </StackPanel>
                </Button>
                <!-- Nur mit vorhandener Laufzeit fuer die Modelle, NICHT mit eingeschalteter
                     Erkennung: im Abschnitt steht der Schalter selbst, und der muss auch dann
                     erreichbar sein, wenn die Erkennung aus ist. Ohne die Laufzeit dagegen laesst
                     sich dort nichts einschalten, und ein Abschnitt ohne bedienbaren Inhalt ist
                     ein leeres Versprechen. -->
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        IsVisible="{Binding ModelRuntimeAvailable}"
                        Tag="PeopleSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/users.svg" Width="18" Height="18"/>
                        <TextBlock Text="Personen"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="CatalogSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/database.svg" Width="18" Height="18"/>
                        <TextBlock Text="Katalog"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="PerformanceSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/gear-six.svg" Width="18" Height="18"/>
                        <TextBlock Text="Leistung"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="ShortcutsSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/keyboard.svg" Width="18" Height="18"/>
                        <TextBlock Text="Tastenkürzel"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="TechnologySection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/certificate.svg" Width="18" Height="18"/>
                        <TextBlock Text="Technologie"/>
                    </StackPanel>
                </Button>
            </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,66">
        <!-- Die Leiste steht DAUERHAFT in voller Breite: die Seite ist lang, und man soll ohne
             Zeigerbewegung sehen, wo man in ihr steht. Automatisch zog sie sich zur schmalen Linie
             zusammen. -->
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" Padding="28,26,24,32"
                      Margin="0,0,8,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Visible"
                      AllowAutoHide="False">
            <!-- Hier stehen nur die RAHMEN der Abschnitte: Name, Klasse section und gebundene
                 Sichtbarkeit. Ihr Inhalt liegt je Abschnitt in Views/Settings/<Name>View.axaml und
                 kommt erst zur Laufzeit hinein (SettingsView.BuildSection): "Allgemein" sofort,
                 die übrigen danach von oben nach unten, vorgezogen beim Klick links, beim Rollen
                 und beim Suchen. Ein neuer Abschnitt braucht beides, den Rahmen hier und seinen
                 Eintrag in SettingsView.SectionFactories. -->
            <StackPanel x:Name="SettingsSectionsPanel" Spacing="18" MaxWidth="960" Margin="0,0,0,0">
                <TextBlock x:Name="SettingsSearchEmpty" IsVisible="False"
                           Text="Keine Einstellung gefunden"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Body}"/>

                <Border x:Name="GeneralSection" Classes="section">
                </Border>

                <Border x:Name="AppearanceSection" Classes="section">
                </Border>

                <Border x:Name="GallerySection" Classes="section">
                </Border>

                <Border x:Name="ViewerSection" Classes="section">
                </Border>

                <!-- Alles zur Info-Leiste steht HIER zusammen. Vorher lagen die Schalter in drei
                     Bereichen verstreut - der für die Galerie unter "Galerie", der für den
                     Betrachter unter "Betrachter", die beiden für das Analysebild unter "Editor" -,
                     obwohl es dieselbe Leiste ist, dieselbe für alle drei Ansichten. Wer sie
                     einrichten wollte, musste den Dialog dreimal durchsuchen. -->
                <Border x:Name="InfoPanelSection" Classes="section">
                </Border>

                <!-- Der Filmstreifen in Viewer, Vollbild und Editor. Die Zeilen standen bis zum
                     2026-10-31 verteilt in den Abschnitten Viewer und Editor. -->
                <Border x:Name="FilmstripSection" Classes="section">
                </Border>

                <Border x:Name="EditorSection" Classes="section">
                </Border>

                <Border x:Name="RawSection" Classes="section">
                </Border>

                <Border x:Name="ImmichSection" Classes="section">
                </Border>

                <!-- NEXTCLOUD. Bewusst ein eigener Abschnitt neben Immich und keine gemeinsame
                     "Server"-Seite: die beiden Quellen koennen Verschiedenes. Nextcloud zeigt
                     seine Bilder aus dem Dateibaum des Benutzers, deshalb ist dort ein Original
                     ersetzbar und eine Begleitdatei ablegbar - bei Immich ist beides nicht so.
                     Eine gemeinsame Maske muesste den kleinsten gemeinsamen Nenner anbieten. -->
                <Border x:Name="NextcloudSection" Classes="section">
                </Border>

                <!-- MODELLE als eigener Abschnitt. Sie sind kein Randthema der Technologieliste:
                     hier wird als einziger Ort in der ganzen Anwendung etwas aus dem Netz geholt,
                     und ohne diese Dateien fehlen die Werkzeuge, die darauf aufbauen.

                     KEINE ANZAHL im Text darunter. Hier stand "Vier Werkzeuge", und es waren
                     laengst sieben Gruppen - eine Zahl in einer Ueberschrift veraltet mit dem
                     naechsten Eintrag, ohne dass jemand sie ansieht. -->
                <!-- Externe Programme. "Öffnen mit" gibt die Originaldatei an ein eingetragenes
                     Programm, ohne Bearbeitungen und ohne Rückweg. G'MIC ist der eine Rundweg aus
                     dem Editor; es wird nicht mitgeliefert, sondern hier gefunden oder eingetragen.
                     Steht hinter Nextcloud: wie die Server ein Weg aus FerrumPix hinaus. -->
                <Border x:Name="ExternalProgramsSection" Classes="section">
                </Border>

                <Border x:Name="ModelsSection" Classes="section" IsVisible="{Binding ModelRuntimeAvailable}">
                </Border>

                <!-- KARTENANSICHT. Ein eigener Abschnitt und nicht bei den Modellen: der ist ohne
                     Modell-Laufzeit ausgeblendet, die Karte braucht keine. Einschalten geht nur über
                     die Rückfrage im ViewModel (MapViewEnabled), denn die Kacheln kommen aus dem
                     Netz. Die Adresse ist änderbar, weil die Kachelrichtlinie der OSM-Stiftung das
                     verlangt; sie wird erst beim Verlassen des Feldes übernommen. Der Speicher
                     bleibt auch bei ausgeschalteter Karte sichtbar, damit er sich leeren lässt. -->
                <Border x:Name="MapSection" Classes="section">
                </Border>

                <!-- PERSONEN. Eine Wand aus Gesichtern, keine Liste aus Namen: eine Person erkennt
                     man am Gesicht. Wer hundert Gruppen aufräumt, sucht nach Doppelgängern und nach
                     Kacheln, die gar keine Person zeigen - beides sieht man in Bildern auf einen
                     Blick und in einer Namensliste überhaupt nicht.

                     ZWEI ZUSTÄNDE, kein dritter: die Wand ODER eine geöffnete Person. Die Bilder
                     kommen im Hintergrund nach und verkleinert dekodiert (FacePanelService). -->
                <Border x:Name="PeopleSection" Classes="section" IsVisible="{Binding ModelRuntimeAvailable}">
                </Border>

                <!-- KATALOG. Steht als eigener Bereich über der Leistung: hier geht es darum,
                     WAS FerrumPix über den Fotobestand weiß - überwachte Ordner, Aufnahmedaten,
                     abgelegte Vorschaubilder. Die Leistung darunter regelt, WIE schnell es das
                     tut (Cachegrößen, Qualität). Beides stand einmal beieinander, und der
                     Abschnitt war dadurch weder das eine noch das andere. -->
                <Border x:Name="CatalogSection" Classes="section">
                </Border>


                <Border x:Name="PerformanceSection" Classes="section">
                </Border>

                <!-- Rein informative Übersicht der Belegungen. Die Texte
                     beschreiben die tatsächliche Behandlung in GalleryView/ViewerView/EditorView/
                     MainWindow - bei Änderungen an den Tasten-Handlern hier nachziehen. -->
                <Border x:Name="ShortcutsSection" Classes="section">
                </Border>


                <!-- Technologie und Lizenzen. Die Liste muss die
                     tatsächlich ausgelieferten Bestandteile abbilden: bei Änderungen an den
                     PackageReference-Einträgen in FerrumPix.vbproj und an den gebündelten
                     Bibliotheken in packaging/ hier nachziehen. -->
                <Border x:Name="TechnologySection" Classes="section">
                </Border>

                <Border Height="150" Background="Transparent"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource FP.Bg.Dark}" BorderBrush="{DynamicResource FP.Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Button Classes="ghost" Padding="12,8" Command="{Binding ResetCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/clock-counter-clockwise.svg" Width="18" Height="18"/>
                        <TextBlock Text="Auf Standardeinstellungen zurücksetzen"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="ghost" Padding="18,8" Command="{Binding CancelCommand}">Abbrechen</Button>
                    <Button Classes="accent" Padding="18,8" Command="{Binding ApplyCommand}">Speichern</Button>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
