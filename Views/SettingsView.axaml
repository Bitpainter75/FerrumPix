<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:models="clr-namespace:FerrumPix.Models"
             xmlns:vm="clr-namespace:FerrumPix.ViewModels"
             x:Class="FerrumPix.Views.SettingsView"
             Classes="settings-view"
             Background="{DynamicResource FP.Bg.Root}"
             Focusable="True"
             KeyDown="OnKeyDown">

    <Grid ColumnDefinitions="250,*">

        <Border Grid.Column="0" Classes="sidebar" Padding="12,16,10,16">
            <StackPanel Spacing="10">
                <TextBlock Text="Einstellungen" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold" Margin="6,0,0,8"/>

                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="GeneralSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/settings.svg" Width="16" Height="16"/>
                        <TextBlock Text="Allgemein"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="AppearanceSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/palette.svg" Width="16" Height="16"/>
                        <TextBlock Text="Darstellung"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="GallerySection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/photo.svg" Width="16" Height="16"/>
                        <TextBlock Text="Galerie"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="ViewerSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/player-play.svg" Width="16" Height="16"/>
                        <TextBlock Text="Betrachter"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="EditorSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/exposure.svg" Width="16" Height="16"/>
                        <TextBlock Text="Editor"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="RawSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/aperture.svg" Width="16" Height="16"/>
                        <TextBlock Text="RAW-Entwicklung"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="ImmichSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/cloud.svg" Width="16" Height="16"/>
                        <TextBlock Text="Immich"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="NextcloudSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/cloud.svg" Width="16" Height="16"/>
                        <TextBlock Text="Nextcloud"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        IsVisible="{Binding ModelRuntimeAvailable}"
                        Tag="ModelsSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brain.svg" Width="16" Height="16"/>
                        <TextBlock Text="Modelle"/>
                    </StackPanel>
                </Button>
                <!-- Nur mit vorhandener Laufzeit fuer die Modelle, NICHT mit eingeschalteter
                     Erkennung: im Abschnitt steht der Schalter selbst, und der muss auch dann
                     erreichbar sein, wenn die Erkennung aus ist. Ohne die Laufzeit dagegen laesst
                     sich dort nichts einschalten, und ein Abschnitt ohne bedienbaren Inhalt ist
                     ein leeres Versprechen. -->
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        IsVisible="{Binding ModelRuntimeAvailable}"
                        Tag="PeopleSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/users.svg" Width="16" Height="16"/>
                        <TextBlock Text="Personen"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="CatalogSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/database.svg" Width="16" Height="16"/>
                        <TextBlock Text="Katalog"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="PerformanceSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/settings-bolt.svg" Width="16" Height="16"/>
                        <TextBlock Text="Leistung"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="ShortcutsSection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/keyboard.svg" Width="16" Height="16"/>
                        <TextBlock Text="Tastenkürzel"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,10"
                        Tag="TechnologySection"
                        Click="OnSectionNavClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/license.svg" Width="16" Height="16"/>
                        <TextBlock Text="Technologie"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,66">
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" Padding="28,26,24,32"
                      Margin="0,0,8,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" MaxWidth="960" Margin="0,0,0,0">

                <Border x:Name="GeneralSection" Classes="section">
                    <StackPanel Spacing="16">
                        <Border Height="180" BorderThickness="0" Padding="0, 20" Margin="-22,0,0,0" >
                            <Grid HorizontalAlignment="Center">
                                <Image Source="avares://FerrumPix/Assets/FerrumPix_SettingsDark.png"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding IsDarkOrGrayDarkThemeMode}"/>
                                <Image Source="avares://FerrumPix/Assets/FerrumPix_SettingsLight.png"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding IsLightOrGrayLightThemeMode}"/>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" ColumnSpacing="12" >
                            <TextBlock Text="Version" Foreground="{DynamicResource FP.Text.Muted}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding DisplayVersion}" VerticalAlignment="Center"/>
                                <Button Classes="ghost" Padding="10,4" VerticalAlignment="Center"
                                        IsVisible="{Binding IsUpdateAvailable}"
                                        Click="OnReleasePageClick"
                                        ToolTip.Tip="Veröffentlichte Fassung herunterladen">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/external-link.svg" Width="14" Height="14"
                                                       IconBrush="{DynamicResource FP.Accent}"/>
                                        <TextBlock Text="Aktualisierung verfügbar:" Foreground="{DynamicResource FP.Accent}"/>
                                        <TextBlock Text="{Binding AvailableVersion}" Foreground="{DynamicResource FP.Accent}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Homepage" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="https://ferrumpix.app" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Padding="12,7" Click="OnHomepageClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/external-link.svg" Width="14" Height="14"/>
                                    <TextBlock Text="Öffnen"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="GitHub Repository" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="https://github.com/Bitpainter75/FerrumPix" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Padding="12,7" Click="OnGitHubClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/external-link.svg" Width="14" Height="14"/>
                                    <TextBlock Text="Öffnen"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource FP.Border.Normal}"/>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Allgemein" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Grundlegende Einstellungen für Startverhalten und Sprache." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Start mit Bilddatei" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Legt fest, welcher Modus verwendet wird, wenn FerrumPix mit einem Bild als Parameter geöffnet wird." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsStartupGalleryMode}"
                                        Padding="10,6"
                                        Command="{Binding SetStartupImageModeCommand}"
                                        CommandParameter="Gallery">Galerie</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsStartupViewerMode}"
                                        Padding="10,6"
                                        Command="{Binding SetStartupImageModeCommand}"
                                        CommandParameter="Viewer">Viewer</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsStartupEditorMode}"
                                        Padding="10,6"
                                        Command="{Binding SetStartupImageModeCommand}"
                                        CommandParameter="Editor">Editor</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsStartupFullscreenMode}"
                                        Padding="10,6"
                                        Command="{Binding SetStartupImageModeCommand}"
                                        CommandParameter="Fullscreen">Vollbild</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Start ohne Bilddatei" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Legt fest, was erscheint, wenn FerrumPix ohne ein Bild geöffnet wird." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsStartupNoImageGalleryMode}"
                                        Padding="10,6"
                                        Command="{Binding SetStartupNoImageModeCommand}"
                                        CommandParameter="Gallery">Galerie</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsStartupNoImageViewerMode}"
                                        Padding="10,6"
                                        Command="{Binding SetStartupNoImageModeCommand}"
                                        CommandParameter="Viewer">Viewer</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsStartupNoImageEditorMode}"
                                        Padding="10,6"
                                        Command="{Binding SetStartupNoImageModeCommand}"
                                        CommandParameter="Editor">Editor</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Sprache" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Verwendet standardmäßig die Systemsprache; falls nicht unterstützt, Englisch." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- AUSWAHLLISTE statt Knopfreihe: mit jeder weiteren Sprache waere die
                                 Reihe laenger geworden, bis sie nicht mehr in die Zeile passt. Die
                                 Namen stehen in ihrer eigenen Sprache - wer die Oberflaeche in einer
                                 Sprache sieht, die er nicht versteht, findet "Deutsch" wieder. -->
                            <ComboBox Grid.Column="1"
                                      Name="LanguageComboBox"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      FontSize="{DynamicResource FP.Font.Body}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="no-translate" Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Papierkorb überspringen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Löscht Dateien und Ordner dauerhaft, statt sie in den Papierkorb zu verschieben." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding DeleteSkipTrash}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Sicherheitsabfrage beim Löschen überspringen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Löscht Dateien und Ordner ohne vorherige Bestätigung." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding DeleteSkipConfirmation}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="AppearanceSection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Darstellung" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Wählen Sie das Erscheinungsbild der Benutzeroberfläche." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Button Grid.Column="0"
                                    Classes="theme-choice"
                                    Classes.active="{Binding IsDarkThemeMode}"
                                    Command="{Binding SetThemeModeCommand}"
                                    CommandParameter="Dark"
                                    Margin="0,0,6,0">
                                <StackPanel Spacing="10">
                                    <Border Height="92" CornerRadius="6" ClipToBounds="True" Background="#11161B">
                                        <Image Source="avares://FerrumPix/Assets/Gallery.png"
                                               Stretch="UniformToFill"
                                               Opacity="0.78"/>
                                    </Border>
                                    <TextBlock Text="Dunkel" Foreground="{DynamicResource FP.Text.Secondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Classes="theme-choice"
                                    Classes.active="{Binding IsLightThemeMode}"
                                    Command="{Binding SetThemeModeCommand}"
                                    CommandParameter="Light"
                                    Margin="6,0">
                                <StackPanel Spacing="10">
                                    <Border Height="92" CornerRadius="6" ClipToBounds="True" Background="#E9EDF2">
                                        <Image Source="avares://FerrumPix/Assets/Gallery_Light.png"
                                               Stretch="UniformToFill"
                                               Opacity="0.9"/>
                                    </Border>
                                    <TextBlock Text="Hell" Foreground="{DynamicResource FP.Text.Secondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Classes="theme-choice"
                                    Classes.active="{Binding IsGrayDarkThemeMode}"
                                    Command="{Binding SetThemeModeCommand}"
                                    CommandParameter="GrayDark"
                                    Margin="6,0">
                                <StackPanel Spacing="10">
                                    <Border Height="92" CornerRadius="6" ClipToBounds="True" Background="#232628">
                                        <Image Source="avares://FerrumPix/Assets/Gallery_GrayDark.png"
                                               Stretch="UniformToFill"
                                               Opacity="0.88"/>
                                    </Border>
                                    <TextBlock Text="Grau Dunkel" Foreground="{DynamicResource FP.Text.Secondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Classes="theme-choice"
                                    Classes.active="{Binding IsGrayLightThemeMode}"
                                    Command="{Binding SetThemeModeCommand}"
                                    CommandParameter="GrayLight"
                                    Margin="6,0,0,0">
                                <StackPanel Spacing="10">
                                    <Border Height="92" CornerRadius="6" ClipToBounds="True" Background="#4A5057">
                                        <Image Source="avares://FerrumPix/Assets/Gallery_GrayLight.png"
                                               Stretch="UniformToFill"
                                               Opacity="0.92"/>
                                    </Border>
                                    <TextBlock Text="Grau Hell" Foreground="{DynamicResource FP.Text.Secondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="12" Margin="0,4,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Akzentfarbe" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Wählen Sie eine Akzentfarbe für Hervorhebungen und aktive Elemente." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="swatch" Classes.active="{Binding IsOrangeAccent}" Background="#F08A1A" Command="{Binding SetAccentColorCommand}" CommandParameter="#F08A1A"/>
                            <Button Classes="swatch" Classes.active="{Binding IsRedAccent}" Background="#E74C3C" Command="{Binding SetAccentColorCommand}" CommandParameter="#E74C3C"/>
                            <Button Classes="swatch" Classes.active="{Binding IsPinkAccent}" Background="#F03B88" Command="{Binding SetAccentColorCommand}" CommandParameter="#F03B88"/>
                            <Button Classes="swatch" Classes.active="{Binding IsPurpleAccent}" Background="#8B5CF6" Command="{Binding SetAccentColorCommand}" CommandParameter="#8B5CF6"/>
                            <Button Classes="swatch" Classes.active="{Binding IsBlueAccent}" Background="#3B82F6" Command="{Binding SetAccentColorCommand}" CommandParameter="#3B82F6"/>
                            <Button Classes="swatch" Classes.active="{Binding IsCyanAccent}" Background="#0891B2" Command="{Binding SetAccentColorCommand}" CommandParameter="#0891B2"/>
                            <Button Classes="swatch" Classes.active="{Binding IsTealAccent}" Background="#0F766E" Command="{Binding SetAccentColorCommand}" CommandParameter="#0F766E"/>
                            <Button Classes="swatch" Classes.active="{Binding IsGreenAccent}" Background="#22C55E" Command="{Binding SetAccentColorCommand}" CommandParameter="#22C55E"/>
                            <Button Classes="swatch" Classes.active="{Binding IsYellowAccent}" Background="#FACC15" Command="{Binding SetAccentColorCommand}" CommandParameter="#FACC15"/>
                        </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="12" Margin="0,4,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Transparenz-Hintergrund" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="Legt fest, wie transparente Bildbereiche in Viewer und Editor dargestellt werden." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                    <TextBlock Text="Darstellung" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="Schachbrettmuster (Standard), echt durchsichtig oder eine feste Farbe." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsTransparencyCheckerboardMode}"
                                            Padding="10,6"
                                            Command="{Binding SetTransparencyBackgroundModeCommand}"
                                            CommandParameter="Checkerboard">Schachbrett</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsTransparencyNoneMode}"
                                            Padding="10,6"
                                            Command="{Binding SetTransparencyBackgroundModeCommand}"
                                            CommandParameter="None">Transparent</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsTransparencySolidMode}"
                                            Padding="10,6"
                                            Command="{Binding SetTransparencyBackgroundModeCommand}"
                                            CommandParameter="Solid">Farbe</Button>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsTransparencySolidMode}">
                                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                    <TextBlock Text="Hintergrundfarbe" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="Volltonfarbe hinter transparenten Bereichen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Height="34" Padding="6,4" Width="140" ToolTip.Tip="Hintergrundfarbe wählen">
                                    <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                        <Border Width="26"
                                                Height="22"
                                                Background="{Binding TransparencyBackgroundColorBrush}"
                                                BorderBrush="{DynamicResource FP.Border.Strong}"
                                                BorderThickness="1"
                                                CornerRadius="4"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TransparencyBackgroundColor}"
                                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                                   FontSize="{DynamicResource FP.Font.Body}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Opened="OnLocalizedFlyoutOpened" Placement="Bottom">
                                            <Border Background="{DynamicResource FP.Bg.Panel}"
                                                    BorderBrush="{DynamicResource FP.Border.Normal}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10">
                                                <StackPanel Spacing="2" Width="230">
                                                    <ColorPicker Color="{Binding TransparencyBackgroundColorValue, Mode=TwoWay}"
                                                                 ColorModel="Rgba"
                                                                 HorizontalAlignment="Stretch"/>
                                                    <TextBox Text="{Binding TransparencyBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             PlaceholderText="#AARRGGBB"
                                                             FontSize="{DynamicResource FP.Font.Body}"/>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Schriftgrad" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Vergrößert oder verkleinert die Schrift der Oberfläche in ganzen Stufen. Wirkt sofort."
                                           Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="{Binding FontSizeOffsetMinimum}"
                                                   Maximum="{Binding FontSizeOffsetMaximum}"
                                                   DefaultValue="0"
                                                   DragIncrement="1"
                                                   WheelIncrement="1"
                                                   Value="{Binding FontSizeOffset}"/>
                                <TextBlock Text="{Binding FontSizeOffsetText}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="56"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Anwendungsskalierung wirkt nur auf Avalonias X11-Backend, siehe
                             IsApplicationScaleSupported - unter Windows skaliert das OS selbst. -->
                        <StackPanel Spacing="14" IsVisible="{Binding IsApplicationScaleSupported}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                    <TextBlock Text="Anwendungsskalierung" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="Skaliert die komplette Oberfläche beim nächsten Start." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <icons:RoundSlider Width="150"
                                                       Minimum="100"
                                                       Maximum="250"
                                                       DefaultValue="100"
                                                       Value="{Binding ApplicationScalePercent}"/>
                                    <TextBlock Text="{Binding ApplicationScaleText}"
                                               Foreground="{DynamicResource FP.Text.Secondary}"
                                               FontSize="{DynamicResource FP.Font.Body}"
                                               Width="42"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,220">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Bildschirm für Skalierung" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="Legt fest, auf welchem Bildschirm die gewählte Skalierung angewendet wird." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        x:Name="ScaleScreenDropDownButton"
                                        Classes="dropdown-btn"
                                        Width="220"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Flyout>
                                        <Flyout Opened="OnLocalizedFlyoutOpened" Placement="BottomEdgeAlignedLeft" VerticalOffset="2">
                                            <ItemsControl ItemsSource="{Binding ApplicationScaleScreens}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="dropdown-item"
                                                                MinWidth="220"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Padding="10,8"
                                                                Click="OnScaleScreenOptionClick">
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding ApplicationScaleScreen}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <icons:SvgIcon Grid.Column="1"
                                                       Source="avares://FerrumPix/Assets/Icons/outline/chevron-down.svg"
                                                       Width="16"
                                                       Height="16"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <TextBlock Text="Änderung wird nach einem Neustart aktiv."
                                       Foreground="{DynamicResource FP.Accent}"
                                       FontSize="{DynamicResource FP.Font.Body}"
                                       IsVisible="{Binding IsApplicationScaleRestartRequired}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="GallerySection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Galerie" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Einstellungen für die Ordner- und Dateiansicht im Seitenbereich." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Versteckte Ordner anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt Ordner an, deren Name mit einem Punkt beginnt (z. B. .config, .local)." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHiddenFolders}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bild aus der Galerie öffnen mit" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gilt für den Doppelklick auf ein Bild und für die Eingabetaste. Videos werden immer im Viewer geöffnet." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryOpenViewer}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryOpenTargetCommand}"
                                        CommandParameter="Viewer">Viewer</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryOpenEditor}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryOpenTargetCommand}"
                                        CommandParameter="Editor">Editor</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Info-Leiste in der Galerie" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt rechts die Angaben zum markierten Bild: Aufnahmedaten, Histogramm, Bewertung, Etikett und Stichwörter. Lässt sich in der Galerie auch über das Info-Symbol oben rechts umschalten." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryInfoSidebarExpanded}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Fußzeile in der Galerie" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt unten die Leiste mit Menü, Auswahl und Anzahl. Ausgeschaltet bleibt mehr Platz für die Bilder; die Aktionen der Leiste stehen weiterhin im Menü mit der rechten Maustaste." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryShowFooter}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Verweisen aus dem persönlichen Ordner folgen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Erlaubt Kopieren, Verschieben, Umbenennen und Löschen auch dann, wenn ein Ordner nur ein Verweis auf einen Ort außerhalb des persönlichen Ordners ist, etwa auf eine zweite Festplatte. Ausgeschaltet bleibt die Dateiarbeit auf den persönlichen Ordner beschränkt. Ansehen und Bearbeiten sind nie eingeschränkt." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding FollowLinkedFolders}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Ordner in der Galerie anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt Unterordner neben Bildern an; Doppelklick öffnet den Ordner." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryShowFolders}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Übergeordnete Ordner anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Blendet in der Galerie zusätzlich einen Eintrag für den übergeordneten Ordner ein." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryShowParentFolder}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bewertungssterne immer anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt die Sterne auf der Kachel dauerhaft an statt erst beim Überfahren mit der Maus." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryRatingBadgesAlwaysVisible}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Favoriten-Herz immer anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt das Favoriten-Herz auf der Kachel dauerhaft an statt erst beim Überfahren mit der Maus." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryFavoriteBadgeAlwaysVisible}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Metadaten-Symbole immer anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt die Metadaten-Symbole (EXIF, IPTC, XMP, ICC) auf der Kachel dauerhaft an statt erst beim Überfahren mit der Maus." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryMetadataBadgesAlwaysVisible}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Ansicht" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Legt fest, ob die Galerie als Raster, als Liste oder in Gruppen angezeigt wird." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryViewModeGrid}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryViewModeCommand}"
                                        CommandParameter="Grid">Raster</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryViewModeList}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryViewModeCommand}"
                                        CommandParameter="List">Liste</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryViewModeGroup}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryViewModeCommand}"
                                        CommandParameter="Group">Gruppen</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Zeitleiste am rechten Rand" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt Jahre bzw. Anfangsbuchstaben passend zur Sortierung; Klick oder Ziehen springt an die Stelle." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryTimelineEnabled}"
                                          OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Startordner der Galerie" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Bestimmt, welcher Ordner beim Start der Anwendung geöffnet wird." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupPicturesFolder}"
                                            Padding="10,6"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Pictures">Bilder-Ordner</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupLastFolder}"
                                            Padding="10,6"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Last">Letzter Ordner</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupCustomFolder}"
                                            Padding="10,6"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Custom">Benutzerdefiniert</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupImmich}"
                                            Padding="10,6"
                                            IsVisible="{Binding IsGalleryStartupImmichAvailable}"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Immich"
                                            ToolTip.Tip="Startet in Immich „Alle Fotos“; ohne Verbindung greift der Bilder-Ordner">Immich (Alle Fotos)</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupNextcloud}"
                                            Padding="10,6"
                                            IsVisible="{Binding IsGalleryStartupNextcloudAvailable}"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Nextcloud"
                                            ToolTip.Tip="Startet in Nextcloud mit der Zeitachse; ohne Verbindung greift der Bilder-Ordner">Nextcloud (Alle Fotos)</Button>
                                </StackPanel>
                                <Grid ColumnDefinitions="260,Auto" ColumnSpacing="6" IsVisible="{Binding IsGalleryStartupCustomFolder}">
                                    <TextBox Text="{Binding GalleryStartupCustomFolder, Mode=TwoWay}"
                                             PlaceholderText="Ordner auswählen"
                                             IsReadOnly="True"/>
                                    <Button Grid.Column="1"
                                            Classes="ghost"
                                            Padding="10,6"
                                            Click="OnBrowseGalleryStartupFolderClick">Auswählen</Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ViewerSection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Betrachter" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Legt fest, wie Bilder beim Öffnen dargestellt werden." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bilder an Fenstergröße anpassen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Öffnet Bilder skaliert auf die verfügbare Fensterfläche statt in Originalgröße." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ViewerOpenFitToWindow}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Einpassen-Verhalten" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gilt nur für den Betrachter: nur verkleinern, wenn das Bild größer als die Anzeigefläche ist, oder immer auf die Fläche skalieren." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsViewerFitBehaviorOnlyWhenLarger}"
                                        Padding="10,6"
                                        Command="{Binding SetViewerFitBehaviorCommand}"
                                        CommandParameter="OnlyWhenLarger">Nur wenn größer</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsViewerFitBehaviorAlways}"
                                        Padding="10,6"
                                        Command="{Binding SetViewerFitBehaviorCommand}"
                                        CommandParameter="Always">Immer einpassen</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Filmstrip im Viewer anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt die Bildleiste am unteren Rand des Viewers an." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ViewerShowFilmstrip}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Fußzeile im Viewer" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt unten die Leiste mit Bildangaben, Zoom und Bewertung. Ausgeschaltet bleibt mehr Platz für das Bild; geblättert und gezoomt wird dann über Tastatur, Mausrad und das Menü mit der rechten Maustaste. Der Filmstrip hat einen eigenen Schalter und bleibt stehen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ViewerShowFooter}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Info-Seitenleiste im Viewer anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Blendet die rechte Metadatenleiste ein oder aus." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ViewerInfoSidebarExpanded}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Diashow-Dauer" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Legt fest, wie lange ein Bild in der Diashow sichtbar bleibt." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="1"
                                                   Maximum="30"
                                                   DefaultValue="3"
                                                   Value="{Binding ViewerSlideshowIntervalSeconds}"/>
                                <TextBlock Text="{Binding ViewerSlideshowIntervalSeconds, StringFormat={}{0}s}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Hardwarebeschleunigung für Videowiedergabe" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Nutzt die Grafikhardware zur Videodekodierung. Bei Bildfehlern in der Videowiedergabe deaktivieren (Software-Decoding). Wirkt beim nächsten Öffnen eines Videos." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding VideoHardwareAcceleration}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <Border x:Name="EditorSection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Editor" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Einstellungen für Bearbeitung und Vorschau." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Eigene Einstellung, NICHT dieselbe wie im Betrachter-Abschnitt: beim
                             Betrachten will man ein kleines Bild oft formatfüllend sehen, beim
                             Bearbeiten dagegen in Originalgröße. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Einpassen-Verhalten" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gilt nur für den Editor: nur verkleinern, wenn das Bild größer als die Bearbeitungsfläche ist, oder immer auf die Fläche skalieren." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsEditorFitBehaviorOnlyWhenLarger}"
                                        Padding="10,6"
                                        Command="{Binding SetEditorFitBehaviorCommand}"
                                        CommandParameter="OnlyWhenLarger">Nur wenn größer</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsEditorFitBehaviorAlways}"
                                        Padding="10,6"
                                        Command="{Binding SetEditorFitBehaviorCommand}"
                                        CommandParameter="Always">Immer einpassen</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Werkzeug beim Öffnen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Welches Werkzeug aktiv ist, sobald der Editor geöffnet wird." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsEditorStartupToolSelection}"
                                        Padding="10,6"
                                        Command="{Binding SetEditorStartupToolCommand}"
                                        CommandParameter="Selection">Auswahl</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsEditorStartupToolAdjust}"
                                        Padding="10,6"
                                        Command="{Binding SetEditorStartupToolCommand}"
                                        CommandParameter="Adjust">Anpassen</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Seite des Anpassungspanels" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Wo die Einstellungen des gewählten Werkzeugs stehen: rechts neben der Bearbeitungsfläche oder links direkt neben der Werkzeugleiste. Links liegen Werkzeug und Einstellungen beieinander, was auf breiten Bildschirmen kürzere Wege bedeutet." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- Links steht links, Rechts steht rechts: die Knopfreihe zeigt damit
                                 dasselbe, was sie einstellt. Umgekehrt liest sie sich verdreht. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsEditorAdjustmentsPanelLeft}"
                                        Padding="10,6"
                                        Command="{Binding SetEditorAdjustmentsPanelSideCommand}"
                                        CommandParameter="Left">Links</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsEditorAdjustmentsPanelRight}"
                                        Padding="10,6"
                                        Command="{Binding SetEditorAdjustmentsPanelSideCommand}"
                                        CommandParameter="Right">Rechts</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Textebenen aus Photoshop-Dateien" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Beim Öffnen einer Photoshop-Datei mit Textebenen: als Text übernehmen (der Wortlaut bleibt tippbar, das Aussehen kann abweichen), als Bild übernehmen (jeder Bildpunkt stimmt, der Text ist fest) oder jedes Mal nachfragen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsPsdTextImportAsk}"
                                        Padding="10,6"
                                        Command="{Binding SetPsdTextImportCommand}"
                                        CommandParameter="Ask">Immer fragen</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsPsdTextImportText}"
                                        Padding="10,6"
                                        Command="{Binding SetPsdTextImportCommand}"
                                        CommandParameter="Text">Als Text</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsPsdTextImportImage}"
                                        Padding="10,6"
                                        Command="{Binding SetPsdTextImportCommand}"
                                        CommandParameter="Image">Als Bild</Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660">
                                <TextBlock Text="Reihenfolge der Werkzeuggruppen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Legt fest, in welcher Reihenfolge die Gruppen in der linken Werkzeugleiste des Editors stehen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- Breit genug, dass die längste Gruppenbeschriftung nicht bis an die
                                 Pfeilknöpfe heranläuft - „Transformieren" braucht in mehreren
                                 Sprachen deutlich mehr Platz als im Deutschen. -->
                            <!-- FESTE Breite statt "so breit wie noetig": nur dann stehen die
                                 Pfeile aller Zeilen an derselben Stelle am rechten Rand. Vorher
                                 rutschten sie mit der Laenge der Beschriftung hin und her. -->
                            <ItemsControl ItemsSource="{Binding EditorToolGroupItems}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource FP.Bg.Input}"
                                                BorderBrush="{DynamicResource FP.Border.Normal}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Margin="0,0,0,6"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Text="{Binding Label}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,24,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FP.Font.Body}"/>
                                                <Button Grid.Column="1"
                                                        Classes="ghost"
                                                        Padding="10,4"
                                                        Margin="0,0,4,0"
                                                        ToolTip.Tip="Nach oben"
                                                        Command="{Binding DataContext.MoveEditorToolGroupUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Key}">▲</Button>
                                                <Button Grid.Column="2"
                                                        Classes="ghost"
                                                        Padding="10,4"
                                                        ToolTip.Tip="Nach unten"
                                                        Command="{Binding DataContext.MoveEditorToolGroupDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Key}">▼</Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Sichtbare Anpassungsgruppen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Legt fest, welche Gruppen im Anpassungsbereich des Editors erscheinen. Ausblenden ändert nur die Anzeige: eingestellte Werte bleiben erhalten und wirken weiter." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding AdjustmentGroupItems}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsVisibleEntry, Mode=TwoWay}"
                                                  Margin="0,0,12,2">
                                            <TextBlock Classes="no-translate" Text="{Binding Label}"
                                                       FontSize="{DynamicResource FP.Font.Body}"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Filmstrip im Editor anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt die Bildleiste am unteren Rand des Editors an." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding EditorShowFilmstrip}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Fußzeile im Editor" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt unten die Leiste mit Bildangaben und Zoom. Ausgeschaltet bleibt mehr Höhe für die Arbeitsfläche. Der Filmstrip hat einen eigenen Schalter und bleibt stehen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding EditorShowFooter}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Info-Seitenleiste im Editor anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Blendet die rechte Metadatenleiste ein oder aus." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding EditorInfoSidebarExpanded}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Ebenen-Seitenleiste im Editor anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Blendet das Ebenen-Panel neben der Info-Leiste ein oder aus." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding EditorLayersPanelExpanded}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Miniaturen im Ebenen-Panel" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt in jeder Zeile ein kleines Abbild dessen, was auf der Ebene liegt, und daneben ihre Maske. Aus: wieder das Symbol des Werkzeugs. Bei vielen Bild-Ebenen dauert der erste Aufbau des Panels damit etwas länger." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding EditorLayerThumbnails}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Einrast-Abstand zum Bildrand" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Abstand der Einrast-Linien zu den Bildrändern beim Verschieben von Objekten, in Prozent. 0 = deaktiviert; an Rändern, Mitte und anderen Objekten rasten Objekte immer." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="0"
                                                   Maximum="20"
                                                   Value="{Binding EditorSnapMarginPercent}"/>
                                <TextBlock Text="{Binding EditorSnapMarginPercent, StringFormat={}{0}%}"
                                           MinWidth="42"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Standardformat" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Vorgewähltes Zielformat in Speichern unter, Exportieren nach und den übrigen Stapelfunktionen. FPX ist das weiterbearbeitbare Projektformat und steht in Speichern unter und Exportieren nach zur Wahl; wo es das nicht gibt, wird JPG genommen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsDefaultSaveFormatJpg}"
                                        Padding="10,6"
                                        Command="{Binding SetDefaultSaveFormatCommand}"
                                        CommandParameter="JPG">JPG</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsDefaultSaveFormatPng}"
                                        Padding="10,6"
                                        Command="{Binding SetDefaultSaveFormatCommand}"
                                        CommandParameter="PNG">PNG</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsDefaultSaveFormatWebp}"
                                        Padding="10,6"
                                        Command="{Binding SetDefaultSaveFormatCommand}"
                                        CommandParameter="WEBP">WEBP</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsDefaultSaveFormatPdf}"
                                        Padding="10,6"
                                        Command="{Binding SetDefaultSaveFormatCommand}"
                                        CommandParameter="PDF">PDF</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsDefaultSaveFormatFpx}"
                                        Padding="10,6"
                                        Command="{Binding SetDefaultSaveFormatCommand}"
                                        CommandParameter="FPX">FPX</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="JPG-Qualität" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Wird für das Speichern und Exportieren als JPG verwendet." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="1"
                                                   Maximum="100"
                                                   DefaultValue="90"
                                                   Value="{Binding JpgSaveQuality}"/>
                                <TextBlock Text="{Binding JpgSaveQuality, StringFormat={}{0}%}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Metadaten beim Speichern übernehmen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Übernimmt EXIF/XMP beim Speichern unter, Exportieren und Konvertieren." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding PreserveMetadataOnSave}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="XMP-Katalogdaten synchronisieren" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Schreibt Bewertung, Farb-Label und Stichworte zusätzlich in ein XMP-Sidecar, damit andere Programme sie sehen. Die .fpxmp-Bearbeitung bleibt unberührt." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding SyncCatalogToXmp}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Fehlende XMP-Sidecars anlegen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Legt beim Synchronisieren auch neue .xmp-Dateien an, wenn noch keine existiert." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding CreateXmpSidecarIfMissing}"
                                          IsEnabled="{Binding SyncCatalogToXmp}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Lineale im Editor anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Blendet die Pixel-Lineale am oberen und linken Rand der Vorschau ein." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding EditorShowRulers}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Raster im Editor anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt ein Pixelraster über dem Bild an." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding EditorShowGrid}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Rastergröße" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Kantenlänge einer Rasterzelle im Editor, in Bildpixeln." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="2"
                                                   Maximum="500"
                                                   DefaultValue="50"
                                                   Value="{Binding EditorGridSize}"/>
                                <TextBlock Text="{Binding EditorGridSize, StringFormat={}{0} px}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="52"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <Border x:Name="RawSection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="RAW-Entwicklung" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Wie RAW-Dateien entwickelt und in Galerie, Betrachter und Editor angezeigt werden." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bearbeitete RAWs als Thumbnail entwickeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt in der Galerie das entwickelte RAW mit deiner Bearbeitung – aber nur, wenn dafür eine .fpxmp existiert. Unbearbeitete RAWs bleiben beim schnellen eingebetteten JPG." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding DevelopRawThumbnails}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bearbeitete RAWs im Viewer entwickeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt auch im Viewer das entwickelte, bearbeitete RAW statt der eingebetteten Vorschau – nur bei vorhandener .fpxmp." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding DevelopRawInViewer}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="RAWs ohne Bearbeitung im Stapel entwickeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Stapelfunktionen wie Bildgröße ändern oder Exportieren nach entwickeln RAWs in voller Sensorauflösung. Ausgeschaltet nehmen sie für unbearbeitete RAWs die eingebettete Vorschau – schneller, aber kleiner. RAWs MIT Bearbeitung (.fpxmp) werden unabhängig davon immer entwickelt und mit ihrem Rezept geschrieben." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding DevelopRawInBatch}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Grundhelligkeit an das Kameramodell anpassen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="RAW-Dateien verschiedener Kameras kommen unterschiedlich hell aus dem Sensor. Eingeschaltet gleicht FerrumPix das anhand von Referenzwerten für über 200 Kameramodelle an, damit dieselbe Aufnahme mit verschiedenen Kameras gleich hell entwickelt wird." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding UseCameraBaselineTable}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Objektivfehler korrigieren" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gleicht Verzeichnung, Farbsäume an den Bildecken und Randabdunklung anhand von Messwerten für das verwendete Objektiv aus. Objektiv und Kamera werden aus den Aufnahmedaten erkannt; liegen für das Objektiv keine Messwerte vor, bleibt das Bild unverändert. Diese Vorgabe lässt sich pro Bild im Werkzeug übersteuern." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LensDatabaseInfo}" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding LensCorrectionEnabled}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ImmichSection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Immich" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Bindet einen self-hosted Immich-Server ein. Alben erscheinen im Navigationsbereich der Galerie; Bilder lassen sich betrachten und (als Kopie) bearbeiten." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Immich aktivieren" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt den Immich-Zweig mit deinen Alben im Galeriebaum an." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImmichEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ImmichEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Server-URL" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Basis-Adresse deiner Immich-Instanz, z. B. http://nas:2283" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     PlaceholderText="http://nas:2283"
                                     Text="{Binding ImmichServerUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ImmichEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="API-Key" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Im Immich-Webinterface unter Konto → API-Keys erzeugen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     PasswordChar="•"
                                     Text="{Binding ImmichApiKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ImmichEnabled}">
                            <TextBlock Text="{Binding ImmichConnectionMessage}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Body}"
                                       HorizontalAlignment="Left"
                                       MaxWidth="660"
                                       Margin="0,0,40,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Classes="ghost" Padding="12,7"
                                    IsEnabled="{Binding !ImmichIsTesting}"
                                    Command="{Binding TestImmichConnectionCommand}">Verbindung testen</Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ImmichEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Sterne in Beschreibung speichern" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Speichert FerrumPix-Bewertungen in einem abgegrenzten Block der Immich-Beschreibung statt im Immich-Rating-Feld." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImmichStoreRatingInDescription}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ImmichEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Stichwörter in Beschreibung speichern" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Speichert FerrumPix-Stichwörter in einem abgegrenzten Block der Immich-Beschreibung statt als Immich-Stichwörter." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImmichStoreTagsInDescription}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Ab Werk AUS: hier verlässt eine Angabe den Rechner, die sonst nirgends
                             hingeht - wer auf welchem Foto zu sehen ist. -->
                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ImmichEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Erkannte Personen nach Immich schreiben" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Schreibt die Namen der auf einem Immich-Bild erkannten Personen als Immich-Stichwörter auf den Server. Nur benannte Gruppen, und nur nach einem Durchlauf der Personenerkennung. Aus: die Erkennung bleibt auf diesem Gerät." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImmichWritePeopleTags}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource FP.Border.Normal}" Margin="0,4"/>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ImmichEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Vorhandene Assets aktualisieren" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Bearbeitungen ersetzen das Immich-Asset, aus dem sie stammen (Alben, Stichwörter, Bewertung und Favorit bleiben erhalten; das Original wandert in den Immich-Papierkorb). Gilt für Speichern UND für Speichern unter mit Ziel Immich. Aus: jede Bearbeitung legt ein neues Asset an." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImmichUpdateExistingAssets}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ImmichEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Löschen in Immich erlauben" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Löschen wirkt in Galerie und Betrachter auch auf Immich-Assets - also auf den Server, nicht nur auf die lokale Ansicht. Aus: Immich-Bilder lassen sich nicht löschen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImmichAllowDelete}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ImmichAllowDelete}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Endgültig löschen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Umgeht den Immich-Papierkorb: gelöschte Assets sind sofort weg und lassen sich auch im Immich-Webinterface nicht wiederherstellen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImmichDeletePermanently}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource FP.Border.Normal}" Margin="0,4"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Immich-Cache leeren" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Löscht die lokal zwischengespeicherten Immich-Vorschaubilder und den Metadaten-Index. Beides wird bei Bedarf neu geladen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImmichCacheMessage}" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" VerticalAlignment="Center"/>
                                <Button Classes="ghost" Padding="12,7" Command="{Binding ClearImmichCacheCommand}">Cache leeren</Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- NEXTCLOUD. Bewusst ein eigener Abschnitt neben Immich und keine gemeinsame
                     "Server"-Seite: die beiden Quellen koennen Verschiedenes. Nextcloud zeigt
                     seine Bilder aus dem Dateibaum des Benutzers, deshalb ist dort ein Original
                     ersetzbar und eine Begleitdatei ablegbar - bei Immich ist beides nicht so.
                     Eine gemeinsame Maske muesste den kleinsten gemeinsamen Nenner anbieten. -->
                <Border x:Name="NextcloudSection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Nextcloud" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Bindet eine Nextcloud ein. Zeitachse und Alben erscheinen im Navigationsbereich der Galerie. Die Memories-App wird nicht vorausgesetzt." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Nextcloud aktivieren" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt den Nextcloud-Zweig mit deiner Zeitachse und deinen Alben im Galeriebaum an." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NextcloudEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding NextcloudEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Server-URL" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Adresse deiner Nextcloud, z. B. https://wolke.example.de" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     PlaceholderText="https://wolke.example.de"
                                     Text="{Binding NextcloudServerUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding NextcloudEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Benutzername" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Der Anmeldename deines Nextcloud-Kontos." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     Text="{Binding NextcloudUserName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding NextcloudEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="App-Passwort" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="In Nextcloud unter Einstellungen, Sicherheit, App-Passwort erstellen. Das Kontopasswort funktioniert bei Zwei-Faktor-Anmeldung nicht." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     PasswordChar="•"
                                     Text="{Binding NextcloudAppPassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding NextcloudEnabled}">
                            <!-- Dieselbe Breite und derselbe Abstand wie bei jeder Beschreibung auf
                                 dieser Seite. Ohne den Rand stiess die Meldung an den Knopf: sie ist
                                 die laengste der Oberflaeche und wird in anderen Sprachen und bei
                                 groesserer Schrift noch laenger. -->
                            <TextBlock Text="{Binding NextcloudConnectionMessage}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Body}"
                                       HorizontalAlignment="Left"
                                       MaxWidth="660"
                                       Margin="0,0,40,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Classes="ghost" Padding="12,7"
                                    IsEnabled="{Binding !NextcloudIsTesting}"
                                    Command="{Binding TestNextcloudConnectionCommand}">Verbindung testen</Button>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource FP.Border.Normal}" Margin="0,4"/>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding NextcloudEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Löschen in Nextcloud erlauben" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Erlaubt es, Bilder vom Server zu löschen. Sie landen im Papierkorb von Nextcloud und lassen sich dort wiederherstellen. Aus: Löschen bleibt bei Serverbildern wirkungslos." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NextcloudAllowDelete}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding NextcloudAllowDelete}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Endgültig löschen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gelöschte Bilder gehen am Papierkorb von Nextcloud vorbei und sind sofort weg. Aus: sie liegen im Papierkorb und lassen sich dort wiederherstellen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NextcloudDeletePermanently}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding NextcloudEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Originale auf dem Server ersetzen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Speichern schreibt die Bearbeitung an die Stelle des Originals. Die Datei bleibt dieselbe, sie behält Alben und Freigaben. Aus: neben dem Original entsteht nur eine Begleitdatei mit der Bearbeitung. RAW und PSD bleiben in jedem Fall unangetastet." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NextcloudReplaceOriginal}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding NextcloudEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Zielordner für Uploads" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Dorthin kommen hochgeladene Bilder. Ein vorhandener Name wird nicht überschrieben, sondern nummeriert." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     Text="{Binding NextcloudUploadFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PlaceholderText="/Photos"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Trenner wie über "Immich-Cache leeren": darunter geht es nicht mehr um
                             die Verbindung, sondern ums Aufräumen. -->
                        <Border Height="1" Background="{DynamicResource FP.Border.Normal}" Margin="0,4"/>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding NextcloudEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Nextcloud-Cache leeren" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Löscht die lokal zwischengespeicherten Nextcloud-Vorschaubilder. Sie werden bei Bedarf neu geladen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NextcloudCacheMessage}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           VerticalAlignment="Center"/>
                                <Button Classes="ghost" Padding="12,7" Command="{Binding ClearNextcloudCacheCommand}">Cache leeren</Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MODELLE als eigener Abschnitt. Sie sind kein Randthema der Technologieliste:
                     hier wird als einziger Ort in der ganzen Anwendung etwas aus dem Netz geholt,
                     und ohne diese Dateien fehlen die Werkzeuge, die darauf aufbauen.

                     KEINE ANZAHL im Text darunter. Hier stand "Vier Werkzeuge", und es waren
                     laengst sieben Gruppen - eine Zahl in einer Ueberschrift veraltet mit dem
                     naechsten Eintrag, ohne dass jemand sie ansieht. -->
                <Border x:Name="ModelsSection" Classes="section" IsVisible="{Binding ModelRuntimeAvailable}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Modelle" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Einige Werkzeuge brauchen eine Modelldatei, die sich hier nachladen lässt. Was nicht geladen ist, erscheint auch nicht im Editor." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <ItemsControl ItemsSource="{Binding ModelGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="adjustment-group" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Classes="no-translate" Text="{Binding Name}" FontSize="{DynamicResource FP.Font.Body}"/>
                                                        <TextBlock Classes="no-translate" Text="{Binding Description}" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                                        <TextBlock Classes="no-translate" Text="{Binding StatusText}" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Classes="no-translate" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}"/>
                                                    <Button Grid.Column="2" Classes="accent" Padding="12,7" VerticalAlignment="Center"
                                                            IsVisible="{Binding ButtonVisible}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.FetchModelCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Classes="no-translate" Text="{Binding ButtonText}" FontSize="{DynamicResource FP.Font.Small}"/>
                                                    </Button>
                                                </Grid>
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                             IsVisible="{Binding Running}" Height="4"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="no-translate" Text="{Binding ModelFolder}" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Die Grafikkarte steht HIER und nicht bei der Leistung: es geht um die
                             Modelle und um nichts sonst, und wer die Dateien gerade geholt hat,
                             steht ohnehin an dieser Stelle. Der Statustext gehoert unter den
                             Schalter - "Grafikkarte nutzen" ohne die Angabe, WELCHE gefunden wurde
                             und ob darauf wirklich etwas laeuft, waere ein Schalter ins Ungewisse. -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                    <TextBlock Text="Grafikkarte für gelernte Modelle nutzen" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="Lässt Entrauschen, Hochskalieren, Objektauswahl und Tiefenkarte auf der Grafikkarte rechnen statt auf dem Prozessor. Das Ergebnis bleibt dasselbe, nur die Wartezeit wird kürzer. Die übrigen Modelle bleiben beim Prozessor, weil sie dort gemessen schneller sind." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Classes="ghost" Padding="12,7"
                                            Command="{Binding CheckGpuAccelerationCommand}"
                                            IsEnabled="{Binding GpuAccelerationAvailable}"
                                            ToolTip.Tip="Lädt ein Modell versuchsweise auf die Grafikkarte und schließt es sofort wieder. Nur so zeigt sich, ob der Treiber die Karte wirklich hergibt.">Prüfen</Button>
                                    <ToggleSwitch IsChecked="{Binding GpuAccelerationEnabled}"
                                                  IsEnabled="{Binding GpuAccelerationAvailable}"
                                                  OnContent=""
                                                  OffContent=""
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding GpuAccelerationStatusText}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Small}"
                                       TextWrapping="Wrap"
                                       Classes="no-translate"/>

                            <!-- Die Auswahl erscheint NUR, wenn wirklich mehr als eine Karte im
                                 Rechner steckt. Bei einer einzigen waere sie eine Frage ohne
                                 Antwortmoeglichkeit - welche es ist, steht in der Zeile darueber. -->
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasMultipleGpuDevices}">
                                <TextBlock Text="Verwendete Grafikkarte"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding GpuDeviceOptions}"
                                          SelectedItem="{Binding SelectedGpuDevice, Mode=TwoWay}"
                                          IsEnabled="{Binding GpuAccelerationAvailable}"
                                          MinWidth="260"
                                          VerticalAlignment="Center"
                                          FontSize="{DynamicResource FP.Font.Body}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="no-translate" Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <!-- Ein Kartenbild gibt es (noch) nicht, und der Text hat eines
                                     versprochen. Was die Ortstabelle wirklich leistet, sind NAMEN
                                     aus Koordinaten - und die entstehen ohne jede Verbindung nach
                                     außen. -->
                                <TextBlock Text="Aufnahmeorte benennen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Macht aus den Koordinaten im Foto einen Ort und ein Land: sie erscheinen in der Info-Leiste, im Ortsfilter über der Galerie und in der Suche. Die Zuordnung kommt aus einer Ortstabelle auf diesem Gerät - es wird nichts abgefragt und nichts gesendet. Eine Karte zeigt FerrumPix nicht." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding PhotoMapEnabled}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PERSONEN. Eine Wand aus Gesichtern, keine Liste aus Namen: eine Person erkennt
                     man am Gesicht. Wer hundert Gruppen aufräumt, sucht nach Doppelgängern und nach
                     Kacheln, die gar keine Person zeigen - beides sieht man in Bildern auf einen
                     Blick und in einer Namensliste überhaupt nicht.

                     ZWEI ZUSTÄNDE, kein dritter: die Wand ODER eine geöffnete Person. Die Bilder
                     kommen im Hintergrund nach und verkleinert dekodiert (FacePanelService). -->
                <Border x:Name="PeopleSection" Classes="section" IsVisible="{Binding ModelRuntimeAvailable}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Personen" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Gesichter finden, zu Personen zusammenfassen und benennen - alles auf diesem Gerät." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Die beiden Schalter stehen HIER und nicht bei den Modellen: dort geht es
                             um Dateien, hier um die Sache selbst. Sie bleiben sichtbar, auch wenn
                             die Erkennung aus ist - sonst gäbe es keinen Weg, sie einzuschalten. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Personen erkennen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Sucht Gesichter in Ihren Fotos und fasst dieselbe Person zusammen, damit Sie nach ihr suchen können. Läuft auf Ihrem Gerät; die Merkmale bleiben in Ihrer Bibliothek und werden nirgendwohin gesendet. Namen vergeben Sie selbst." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding FaceRecognitionEnabled}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Relativ zur Bildkante und nicht in Bildpunkten: 80 Punkte sind auf einem
                             24-Megapixel-Foto ein Kopf in der dritten Reihe und auf einem
                             Handyschnappschuss ein Porträt. -->
                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding FaceRecognitionEnabled}">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Kleinste erkannte Person" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gesichter unterhalb dieser Größe kommen gar nicht erst in die Bibliothek - gemessen an der kürzeren Bildkante, damit dieselbe Angabe auf jedem Foto dasselbe bedeutet. Auf einem Stadtfest bleibt so die dritte Reihe im Hintergrund draußen. Bei „alle&quot; bleibt, was die Erkennung findet." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <!-- Ab Werk 3 Prozent, gemessen und nicht geraten: an einem
                                     gewachsenen Bestand liegen die kleinsten so noch behaltenen
                                     Gesichter klar ueber der Grenze, ab der ohnehin nichts mehr
                                     vermessen wird. Der Regler schneidet dort also nach Geschmack
                                     und rettet nicht vor Unbrauchbarem.
                                     BIS 10 und nicht weiter: bei 8 Prozent faellt schon rund die
                                     Haelfte aller gefundenen Gesichter weg. Ein Bereich, dessen
                                     obere Haelfte niemand sinnvoll benutzt, macht den nuetzlichen
                                     Teil nur schwerer zu treffen. -->
                                <icons:RoundSlider Width="150"
                                                   Minimum="0"
                                                   Maximum="10"
                                                   DefaultValue="3"
                                                   DragIncrement="1"
                                                   WheelIncrement="1"
                                                   Value="{Binding FaceMinimumSizePercent}"/>
                                <TextBlock Text="{Binding FaceMinimumSizeText}" Classes="no-translate"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="56"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>


                        <Border Height="1" Background="{DynamicResource FP.Border.Normal}" Margin="0,4"/>

                        <!-- HIER STEHEN NUR NOCH DIE SCHALTER. Die Kachelwand ist ein eigener
                             Bereich geworden, erreichbar über den Knopf in der Galerie: in den
                             Einstellungen legt man fest, WIE das Programm arbeitet - Gruppen
                             aufzuräumen ist dagegen Arbeit am Bestand. Der Knopf hier führt
                             hinüber, damit niemand suchen muss. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Personen verwalten" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Die gefundenen Gruppen als Wand aus Gesichtern: benennen, zusammenführen und falsch Zugeordnetes herauslösen. Zu finden in der Galerie über dem Knopf für die Einstellungen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Padding="12,7" VerticalAlignment="Center"
                                    IsEnabled="{Binding FaceRecognitionEnabled}"
                                    Click="OnManagePeopleClick">Öffnen</Button>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- KATALOG. Steht als eigener Bereich über der Leistung: hier geht es darum,
                     WAS FerrumPix über den Fotobestand weiß - überwachte Ordner, Aufnahmedaten,
                     abgelegte Vorschaubilder. Die Leistung darunter regelt, WIE schnell es das
                     tut (Cachegrößen, Qualität). Beides stand einmal beieinander, und der
                     Abschnitt war dadurch weder das eine noch das andere. -->
                <Border x:Name="CatalogSection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Katalog" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Welche Ordner FerrumPix kennt und was es über sie gespeichert hat." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Katalogindex. Bisher entstanden Katalogeintrag und Vorschaubild erst
                             beim Ansehen eines Ordners; wer seinen Fotobestand hier einträgt, hat
                             Suche und Filter darauf, ohne jeden Ordner einmal besucht zu haben. -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                    <TextBlock Text="Ordner überwachen" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="FerrumPix liest die Aufnahmedaten dieser Ordner samt Unterordner in den Katalog und legt die Vorschaubilder an. Beim nächsten Mal wird nur gelesen, was sich geändert hat. Neben den Fotos wird dabei nichts angelegt." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Padding="12,7"
                                        VerticalAlignment="Center"
                                        Click="OnAddCatalogWatchFolderClick">Ordner hinzufügen</Button>
                            </Grid>

                            <!-- SUCHE UND SAMMELAKTION. Ein Fotobestand hat vierstellig viele Ordner
                                 (gemessen 1800). Ohne Filter ist die Liste nicht zu bedienen, und
                                 ohne eine Aktion auf die Treffer müsste man tausendmal einzeln
                                 klicken. Das Aufräumen-Menü wirkt deshalb auf GENAU DAS, was der
                                 Filter gerade übrig lässt - die Zahl steht im Knopf und noch einmal
                                 in der Rückfrage. -->
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                                <Border Grid.Column="0"
                                        Background="{DynamicResource FP.Bg.Input}"
                                        BorderBrush="{DynamicResource FP.Border.Normal}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,0"
                                        Height="34"
                                        Margin="0,0,8,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/search.svg"
                                                       Width="16" Height="16" VerticalAlignment="Center" Opacity="0.65"/>
                                        <TextBox Grid.Column="1"
                                                 Classes="search-input"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 Height="20"
                                                 Margin="10,0,0,2"
                                                 Text="{Binding FolderFilter}"
                                                 PlaceholderText="Ordner suchen"
                                                 VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="2" Classes="ghost"
                                                Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding ClearFolderFilterCommand}"
                                                IsVisible="{Binding HasFolderFilter}"
                                                ToolTip.Tip="Suche zurücksetzen">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                                           Width="12" Height="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.75"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="1" Classes="ghost" Padding="12,7" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding RefreshThumbnailCacheCommand}">Aktualisieren</Button>
                                <!-- EIN Knopf statt drei: die Zeilen wurden sonst so breit, dass für
                                     den Pfad nichts übrig blieb. Alle drei Wege fragen vorher nach -
                                     auch der harmlose, denn eine Reihe, in der nur zwei von drei
                                     nachfragen, erzieht dazu, die Frage wegzuklicken. -->
                                <Button Grid.Column="2" Classes="ghost" Padding="12,7"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding CanRunFolderActions}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Aktionen" VerticalAlignment="Center"/>
                                        <TextBlock Classes="no-translate" Text="{Binding FilteredFolderCount, StringFormat=({0})}"
                                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <!-- Das Suchen steht ÜBER dem Trenner, das Entfernen
                                                 darunter: das eine legt etwas an, das andere wirft
                                                 etwas weg, und die beiden sollen nicht so dicht
                                                 beieinander liegen, dass man sich verklickt. -->
                                            <MenuItem Header="Gesichter suchen"
                                                      Command="{Binding ScanFacesFilteredCommand}"
                                                      IsEnabled="{Binding FaceIndex.CanStart}"/>
                                            <Separator/>
                                            <MenuItem Header="Katalogdaten entfernen"
                                                      Command="{Binding CleanFilteredCatalogCommand}"/>
                                            <MenuItem Header="Vorschaubilder löschen"
                                                      Command="{Binding CleanFilteredThumbnailsCommand}"/>
                                            <MenuItem Header="Beides entfernen"
                                                      Command="{Binding CleanFilteredBothCommand}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!-- Der Fortschritt der Gesichtssuche. Sie wird aus der Liste heraus
                                 gestartet und läuft über eine große Sammlung Stunden - der Stand
                                 gehört deshalb sichtbar hierher und nicht nur in die Galerie. -->
                            <StackPanel Spacing="2"
                                        IsVisible="{Binding FaceIndex.HasStatus}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding FaceIndex.StatusText}"
                                               Classes="no-translate"
                                               Foreground="{DynamicResource FP.Text.Secondary}"
                                               FontSize="{DynamicResource FP.Font.Body}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="ghost" Padding="10,5"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding FaceIndex.IsRunning}"
                                            Command="{Binding FaceIndex.StopCommand}">Stoppen</Button>
                                </Grid>
                                <ProgressBar Height="4" Minimum="0" Maximum="100"
                                             Value="{Binding FaceIndex.ProgressPercent}"
                                             IsVisible="{Binding FaceIndex.HasProgress}"/>
                                <TextBlock Text="{Binding FaceIndex.DisabledHint}"
                                           IsVisible="{Binding FaceIndex.HasDisabledHint}"
                                           Foreground="{DynamicResource FP.Text.Muted}"
                                           FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Text="{Binding FolderSummaryText}"
                                       Classes="no-translate"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Body}"
                                       TextWrapping="Wrap"/>

                            <!-- EIGENE HÖHE UND EIGENER SCROLL, und darin eine ListBox statt einer
                                 ItemsControl: nur so virtualisiert Avalonia. In der scrollenden
                                 Einstellungsseite entstünden sonst alle Zeilen auf einmal - bei 1800
                                 Ordnern hängt die Seite beim Öffnen sekundenlang.
                                 Auswahl ist abgeschaltet: die Zeilen sind zum Lesen und Bedienen da,
                                 eine markierte Zeile hätte keine Bedeutung. -->
                            <ListBox ItemsSource="{Binding FolderRows}"
                                     IsVisible="{Binding HasFolderRows}"
                                     MaxHeight="420"
                                     SelectionMode="Single"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerTheme>
                                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                    </ControlTheme>
                                </ListBox.ItemContainerTheme>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource FP.Bg.Input}"
                                                BorderBrush="{DynamicResource FP.Border.Normal}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="{Binding Depth, Converter={StaticResource FolderDepthToMarginConverter}}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Das Aufklapp-Zeichen ist ein Knopf und kein
                                                     bloßes Zeichen: eine Gruppe klappt man an
                                                     genau dieser Stelle auf, und ein Zeichen ohne
                                                     Trefferfläche lässt danebenklicken. -->
                                                <!-- Ein SYMBOL und kein Buchstabe: ein "v" sitzt auf
                                                     der Grundlinie und damit sichtbar zu tief im
                                                     runden Knopf (Nutzerbefund). Ein SvgIcon füllt
                                                     seinen Kasten und zentriert sich darin.
                                                     Zwei Symbole statt eines gedrehten: die Drehung
                                                     bräuchte einen RenderTransform samt Ursprung,
                                                     und der Satz hat beide Richtungen ohnehin. -->
                                                <Button Grid.Column="0" Classes="ghost"
                                                        Width="20" Height="20" Padding="0"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        IsVisible="{Binding CanExpand}"
                                                        Command="{Binding Actions.ToggleFolderRowCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Panel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/chevron-right.svg"
                                                                       Width="14" Height="14"
                                                                       IsVisible="{Binding !IsExpanded}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/chevron-down.svg"
                                                                       Width="14" Height="14"
                                                                       IsVisible="{Binding IsExpanded}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Panel>
                                                </Button>
                                                <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="no-translate"
                                                                   Text="{Binding Title}"
                                                                   FontSize="{DynamicResource FP.Font.Body}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                        <Border IsVisible="{Binding IsWatched}"
                                                                Background="{DynamicResource FP.Accent}"
                                                                CornerRadius="4" Padding="6,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="überwacht"
                                                                       FontSize="{DynamicResource FP.Font.Label}"
                                                                       Foreground="{DynamicResource FP.Bg.Base}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="no-translate"
                                                               Text="{Binding DetailText}"
                                                               Foreground="{DynamicResource FP.Text.Secondary}"
                                                               FontSize="{DynamicResource FP.Font.Small}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Classes="ghost" Padding="10,5"
                                                            IsVisible="{Binding CanWatch}"
                                                            Command="{Binding Actions.WatchFolderRowCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Diesen Ordner samt Unterordnern überwachen">Überwachen</Button>
                                                    <Button Classes="ghost" Padding="10,5"
                                                            IsVisible="{Binding IsWatched}"
                                                            Command="{Binding Actions.UnwatchFolderRowCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Nicht mehr überwachen. Abgelegte Daten bleiben erhalten.">Nicht überwachen</Button>
                                                    <!-- EIN Menü für alles, was diese Zeile kann.
                                                         Drei Knöpfe nebeneinander ließen für den
                                                         Pfad nichts übrig, und die Zeile ist bei
                                                         eingerückten Unterordnern ohnehin schmaler. -->
                                                    <Button Classes="ghost" Padding="10,5"
                                                            IsEnabled="{Binding Actions.CanRunFolderActions}">
                                                        <TextBlock Text="Aktionen"/>
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuItem Header="Gesichter suchen"
                                                                          Command="{Binding Actions.ScanFacesRowCommand}"
                                                                          CommandParameter="{Binding}"
                                                                          IsEnabled="{Binding Actions.FaceIndex.CanStart}"/>
                                                                <Separator/>
                                                                <MenuItem Header="Katalogdaten entfernen"
                                                                          IsEnabled="{Binding HasAnything}"
                                                                          Command="{Binding Actions.CleanRowCatalogCommand}"
                                                                          CommandParameter="{Binding}"/>
                                                                <MenuItem Header="Vorschaubilder löschen"
                                                                          IsEnabled="{Binding HasAnything}"
                                                                          Command="{Binding Actions.CleanRowThumbnailsCommand}"
                                                                          CommandParameter="{Binding}"/>
                                                                <MenuItem Header="Beides entfernen"
                                                                          IsEnabled="{Binding HasAnything}"
                                                                          Command="{Binding Actions.CleanRowBothCommand}"
                                                                          CommandParameter="{Binding}"/>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding ThumbnailCacheResultMessage}"
                                       IsVisible="{Binding ThumbnailCacheResultMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Body}"
                                       TextWrapping="Wrap"
                                       Classes="no-translate"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                    <TextBlock Text="Kurz nach dem Start indizieren" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="Der Lauf beginnt einige Sekunden nach dem Start und arbeitet im Hintergrund. Er lässt sich jederzeit anhalten." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding CatalogIndexOnStartup}"
                                              OnContent=""
                                              OffContent=""
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                    <TextBlock Text="Jetzt indizieren" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="{Binding CatalogIndex.StatusText}"
                                               IsVisible="{Binding CatalogIndex.HasStatus}"
                                               Foreground="{DynamicResource FP.Text.Secondary}"
                                               FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                    <ProgressBar Height="4" Minimum="0" Maximum="100"
                                                 Value="{Binding CatalogIndex.ProgressPercent}"
                                                 IsVisible="{Binding CatalogIndex.HasProgress}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <!-- Starten und Stoppen tauschen die Plätze, statt einer davon
                                         ausgegraut danebenzustehen: zwei Knöpfe, von denen immer
                                         einer tot ist, sagen weniger als einer, der das Richtige tut. -->
                                    <Button Classes="ghost" Padding="12,7"
                                            IsVisible="{Binding !CatalogIndex.IsRunning}"
                                            IsEnabled="{Binding CatalogIndex.CanStart}"
                                            Command="{Binding CatalogIndex.StartCommand}">Starten</Button>
                                    <Button Classes="ghost" Padding="12,7"
                                            IsVisible="{Binding CatalogIndex.IsRunning}"
                                            Command="{Binding CatalogIndex.StopCommand}">Stoppen</Button>
                                </StackPanel>
                            </Grid>

                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Datenbank bereinigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Entfernt Metadaten (Bewertungen, Favoriten, Stichwörter) von Bildern, die nicht mehr existieren." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CleanupResultMessage}" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" VerticalAlignment="Center"/>
                                <Button Classes="ghost" Padding="12,7" Command="{Binding CleanupDatabaseCommand}">Bereinigen</Button>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>


                <Border x:Name="PerformanceSection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Leistung" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Wie schnell FerrumPix arbeitet: Größe und Qualität der Zwischenspeicher." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Vorschaubilder zwischenspeichern" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Speichert Vorschaubilder auf dem Gerät, damit Ordner beim nächsten Öffnen schneller geladen werden." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ThumbnailCacheEnabled}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Vorschaubild-Qualität" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Bestimmt die JPEG-Qualität neu erzeugter zwischengespeicherter Vorschaubilder." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="45"
                                                   Maximum="95"
                                                   DefaultValue="82"
                                                   Value="{Binding ThumbnailQuality}"/>
                                <TextBlock Text="{Binding ThumbnailQuality, StringFormat={}{0}%}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Vorschaubild-Speichercache" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Wie viele Vorschaubilder maximal gleichzeitig im Arbeitsspeicher gehalten werden. Höhere Werte verringern erneutes Laden beim Scrollen, benötigen aber mehr Arbeitsspeicher." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="50"
                                                   Maximum="5000"
                                                   DefaultValue="250"
                                                   Value="{Binding ThumbnailMemoryCacheCapacity}"/>
                                <TextBlock Text="{Binding ThumbnailMemoryCacheCapacity}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>



                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Fehlerdiagnose-Protokoll" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Schreibt Details zu Vorschau-/Wiedergabe-Fehlern nach %LocalAppData%/FerrumPix/logs/diagnostics.log. Nur bei Bedarf zur Fehlersuche einschalten." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding EnableDiagnosticLogging}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Rein informative Übersicht der Belegungen. Die Texte
                     beschreiben die tatsächliche Behandlung in GalleryView/ViewerView/EditorView/
                     MainWindow - bei Änderungen an den Tasten-Handlern hier nachziehen. -->
                <Border x:Name="ShortcutsSection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Tastenkürzel" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Übersicht der Tasten- und Mausbelegung in Galerie, Betrachter und Editor." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="Überall" FontWeight="SemiBold" FontSize="{DynamicResource FP.Font.Body}"/>
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="F11" Tag="MacFullscreen" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Vollbild ein/aus" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="1 bis 5" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bewertung setzen (dieselbe Zahl erneut entfernt sie); in einem Eingabefeld bleibt die Ziffer eine Ziffer" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="0" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bewertung entfernen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+1 bis STRG+5" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bewertung setzen (dieselbe Zahl erneut entfernt sie)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+0" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bewertung entfernen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ALT+1 bis ALT+9" Tag="Alt" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Farbetikett setzen (dieselbe Farbe erneut entfernt es)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ALT+0" Tag="Alt" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Farbetikett entfernen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="PUNKT oder KOMMA" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Favorit ein/aus" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+Q" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Favorit ein/aus" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Galerie" FontWeight="SemiBold" FontSize="{DynamicResource FP.Font.Body}" Margin="0,6,0,0"/>
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Pfeiltasten" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Auswahl bewegen (SHIFT: Bereich erweitern)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Bild auf" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Eine Seite nach oben" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Bild ab" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Eine Seite nach unten" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="POS1" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Zum ersten Element" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ENDE" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Zum letzten Element" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Eingabe oder Doppelklick" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bild öffnen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="LEERTASTE (halten)" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Schnellvorschau" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+A" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Alles auswählen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+C" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Kopieren" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+X" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Ausschneiden" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+V" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Einfügen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+F" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Suche" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+W oder W" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Filter anwenden" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+R oder R" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bildgröße ändern" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+D oder D" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Konvertieren nach" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+T oder T" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Exportieren nach" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+P oder P" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Auswahl drucken" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ENTF" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Löschen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="F2" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Umbenennen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="F5" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Aktualisieren" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ESC" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Auswahl aufheben" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+Mausrad oder Rechtsklick+Mausrad" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Kachelgröße ändern" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Bildvergleich" FontWeight="SemiBold" FontSize="{DynamicResource FP.Font.Body}" Margin="0,6,0,0"/>
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="LEERTASTE" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Seiten tauschen - das rechte Bild wird das neue angeheftete" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="PFEIL LINKS oder rechts" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Nur die rechte Fläche blättert weiter, das angeheftete Bild bleibt links stehen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ESC" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Vergleich beenden" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Klick auf eine Fläche" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Diese Fläche bekommt den Fokus; Fußzeile und Infopanel zeigen ihr Bild" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Doppelklick auf eine Fläche" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Dieses Bild im Editor öffnen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Ziehen mit links oder rechts" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Ausschnitt verschieben; gekoppelt zieht die andere Fläche mit" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+Mausrad oder Rechtsklick+Mausrad" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Zoomen - ein Wert gilt für beide Flächen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ENTF" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Im Vergleich ohne Wirkung - gelöscht wird über die Marke auf dem jeweiligen Bild" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Betrachter" FontWeight="SemiBold" FontSize="{DynamicResource FP.Font.Body}" Margin="0,6,0,0"/>
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="PFEIL LINKS oder Bild auf" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Voriges Bild" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="PFEIL RECHTS oder Bild ab" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Nächstes Bild" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Plus" Tag="MacZoomIn" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Vergrößern" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Minus" Tag="MacZoomOut" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Verkleinern" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="F" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bild einpassen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="LEERTASTE" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Diashow starten/stoppen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+PFEIL LINKS" Tag="MacRotateLeft" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Nach links drehen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+PFEIL RECHTS" Tag="MacRotateRight" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Nach rechts drehen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+R oder R" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bildgröße ändern" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+D oder D" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Konvertieren nach" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+T oder T" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Exportieren nach" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+W oder W" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Filter anwenden" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+I oder I" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Info-Leiste ein/aus" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+E oder E" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Im Editor öffnen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+P oder P" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Drucken" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ENTF" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Löschen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="F2" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Umbenennen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ESC" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Zurück zur Galerie (im Vollbild: Vollbild verlassen)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+Mausrad oder Rechtsklick+Mausrad" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Am Mauszeiger zoomen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Rechte Maustaste (halten und ziehen)" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bildausschnitt verschieben" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Editor" FontWeight="SemiBold" FontSize="{DynamicResource FP.Font.Body}" Margin="0,6,0,0"/>
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+N" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Neues Bild anlegen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+Z" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Rückgängig" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+Y" Tag="MacRedo" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Wiederholen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+S" Tag="MacSave" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Speichern (wenn nicht möglich: Speichern unter)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+A" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Alles auswählen (bei Auswahl-Werkzeugen)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+C" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Auswahl kopieren" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+V" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Auswahl einfügen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+D" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Objekt duplizieren; ohne Objekt: Auswahl aufheben" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+Klick" Tag="Selection" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Objekt zur Auswahl hinzufügen oder herausnehmen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+SHIFT+G" Tag="PrimaryShift" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Gruppierung aufheben" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+P" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Drucken (aktueller Bearbeitungsstand)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+R oder R" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Werkzeug: Bildgröße" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+T oder T" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Werkzeug: Text" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+B oder B" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Werkzeug: Zeichnen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+G" Tag="Primary" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Markierte Ebenen gruppieren" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+M oder M" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Werkzeug: Einfügen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+I oder I" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Werkzeug: Bild" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+K oder K" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Werkzeug: QR-Code" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+PFEIL LINKS" Tag="MacRotateLeft" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Nach links drehen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+PFEIL RECHTS" Tag="MacRotateRight" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Nach rechts drehen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+E oder E" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Radierer umschalten (im Zeichnen-Werkzeug)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Pfeiltasten" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Objekt verschieben (SHIFT: größere Schritte)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ALT (beim Ziehen von Objekten)" Tag="MacOption" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Einrasten vorübergehend aus" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="[" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Werkzeuggröße kleiner" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="]" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Werkzeuggröße größer" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="LEERTASTE (halten)" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bildausschnitt verschieben" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ENTF" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Objekt löschen; ohne Objekt: Bild löschen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="ESC" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Auswahl abwählen, Zug abbrechen, Editor verlassen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+Mausrad oder Rechtsklick+Mausrad" Tag="Application" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Am Mauszeiger zoomen" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="Rechte Maustaste (halten und ziehen)" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Bildausschnitt verschieben" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
                                <TextBlock Text="STRG+ENTER oder SHIFT+ENTER" Tag="MacTextNewline" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="Neue Zeile im Text-Objekt (Text bricht nie automatisch um)" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>


                <!-- Technologie und Lizenzen. Die Liste muss die
                     tatsächlich ausgelieferten Bestandteile abbilden: bei Änderungen an den
                     PackageReference-Einträgen in FerrumPix.vbproj und an den gebündelten
                     Bibliotheken in packaging/ hier nachziehen. -->
                <Border x:Name="TechnologySection" Classes="section">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Technologie" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="FerrumPix baut auf diesen Projekten auf. Die Schaltflächen öffnen die Projektseite und den Lizenztext im Browser." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>



                        <StackPanel Spacing="10">
                            <!-- ZWEISPALTIG und knapp: die Liste ist ein Nachschlagewerk, kein
                                 Fliesstext. Paketname, ein Halbsatz wozu, und die beiden Knoepfe zu
                                 Projektseite und Lizenz. -->
                            <UniformGrid Columns="2">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="FerrumPix" FontSize="{DynamicResource FP.Font.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Diese Anwendung" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Padding="8,5" VerticalAlignment="Center" Tag="https://github.com/Bitpainter75/FerrumPix" Click="OnLicenseLinkClick" ToolTip.Tip="Projektseite öffnen">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brand-github.svg" Width="13" Height="13"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="ghost" Padding="8,5" VerticalAlignment="Center" Tag="https://www.gnu.org/licenses/gpl-3.0.html" Click="OnLicenseLinkClick" ToolTip.Tip="Lizenztext öffnen">
                                        <TextBlock Text="GPL-3.0" FontSize="{DynamicResource FP.Font.Small}"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text=".NET 10" FontSize="{DynamicResource FP.Font.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Laufzeitumgebung" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Padding="8,5" VerticalAlignment="Center" Tag="https://github.com/dotnet/runtime" Click="OnLicenseLinkClick" ToolTip.Tip="Projektseite öffnen">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brand-github.svg" Width="13" Height="13"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="ghost" Padding="8,5" VerticalAlignment="Center" Tag="https://github.com/dotnet/runtime/blob/main/LICENSE.TXT" Click="OnLicenseLinkClick" ToolTip.Tip="Lizenztext öffnen">
                                        <TextBlock Text="MIT" FontSize="{DynamicResource FP.Font.Small}"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Avalonia UI 12.1" FontSize="{DynamicResource FP.Font.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Oberfläche und Fensterverwaltung" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Padding="8,5" VerticalAlignment="Center" Tag="https://github.com/AvaloniaUI/Avalonia" Click="OnLicenseLinkClick" ToolTip.Tip="Projektseite öffnen">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brand-github.svg" Width="13" Height="13"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="ghost" Padding="8,5" VerticalAlignment="Center" Tag="https://github.com/AvaloniaUI/Avalonia/blob/master/licence.md" Click="OnLicenseLinkClick" ToolTip.Tip="Lizenztext öffnen">
                                        <TextBlock Text="MIT" FontSize="{DynamicResource FP.Font.Small}"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ReactiveUI 12.0" FontSize="{DynamicResource FP.Font.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Datenbindung der Ansichtsmodelle" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Padding="8,5" VerticalAlignment="Center" Tag="https://github.com/reactiveui/ReactiveUI" Click="OnLicenseLinkClick" ToolTip.Tip="Projektseite öffnen">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brand-github.svg" Width="13" Height="13"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="ghost" Padding="8,5" VerticalAlignment="Center" Tag="https://github.com/reactiveui/ReactiveUI/blob/main/LICENSE" Click="OnLicenseLinkClick" ToolTip.Tip="Lizenztext öffnen">
                                        <TextBlock Text="MIT" FontSize="{DynamicResource FP.Font.Small}"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ONNX Runtime 1.28" FontSize="{DynamicResource FP.Font.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Führt gelernte Modelle aus, Telemetrie abgeschaltet" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Padding="8,5" VerticalAlignment="Center" Tag="https://github.com/microsoft/onnxruntime" Click="OnLicenseLinkClick" ToolTip.Tip="Projektseite öffnen">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brand-github.svg" Width="13" Height="13"/>
