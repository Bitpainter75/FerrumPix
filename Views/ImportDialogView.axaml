<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Views.ImportDialogView">

    <!-- Importieren (MainWindowViewModelImport): Quelle, Aufnahmetage, Ziel, Sicherung.
         Die Zusammenfassung steht UNTEN, direkt über den Knöpfen, und erst, wenn eine Quelle
         gewählt ist: oben ohne Quelle las sich ihr Text wie eine Überschrift. -->
    <StackPanel Spacing="10">

        <!-- QUELLE: erkannte Datenträger zur Auswahl, darunter der gelesene Ordner mit eigener Wahl. -->
        <TextBlock Text="Quelle"
                   FontSize="{DynamicResource FP.Font.Small}"
                   Foreground="{DynamicResource FP.Text.Secondary}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasDialogImportSources}">
            <ComboBox ItemsSource="{Binding DialogImportSources}"
                      SelectedItem="{Binding DialogImportSelectedSource, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Classes="no-translate"/>
            <Button Grid.Column="1"
                    Classes="icon-btn"
                    Width="38" Height="32"
                    Click="OnRefreshSourcesClick"
                    ToolTip.Tip="Datenträger neu suchen">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/refresh.svg" Width="18" Height="18"/>
            </Button>
        </Grid>
        <TextBlock Text="Kein Wechseldatenträger gefunden. Wähle einen Ordner."
                   IsVisible="{Binding !HasDialogImportSources}"
                   Foreground="{DynamicResource FP.Text.Muted}"
                   FontSize="{DynamicResource FP.Font.Small}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding DialogImportSourceFolder, Mode=TwoWay}"
                     Classes="no-translate"
                     MinHeight="36"/>
            <Button Grid.Column="1"
                    Classes="icon-btn"
                    Width="38" Height="36"
                    Click="OnBrowseSourceClick"
                    ToolTip.Tip="Ordner wählen">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/folder-open.svg" Width="18" Height="18"/>
            </Button>
        </Grid>
        <CheckBox IsChecked="{Binding DialogImportIncludeSubfolders, Mode=TwoWay}">
            <TextBlock Text="Mit Unterordnern"/>
        </CheckBox>

        <!-- AUFNAHMETAGE: je Tag ein Haken, alle ab Werk an. -->
        <TextBlock Text="Aufnahmetage"
                   IsVisible="{Binding HasDialogImportDays}"
                   FontSize="{DynamicResource FP.Font.Small}"
                   Foreground="{DynamicResource FP.Text.Secondary}"/>
        <Border IsVisible="{Binding HasDialogImportDays}"
                BorderBrush="{DynamicResource FP.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,4">
            <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DialogImportDays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                <TextBlock Text="{Binding Label}" Classes="no-translate"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <CheckBox IsChecked="{Binding DialogImportIncludeRawPartners, Mode=TwoWay}"
                  IsVisible="{Binding HasDialogImportRawPartners}">
            <TextBlock Text="JPEG und HEIF neben einer RAW mit importieren" TextWrapping="Wrap"/>
        </CheckBox>

        <!-- ZIEL: zuerst der aktuelle Ordner, zur Wahl die Ziele aus den Einstellungen; das Feld
             darunter laesst sich frei aendern, auch mit Platzhaltern. -->
        <TextBlock Text="Ziel"
                   FontSize="{DynamicResource FP.Font.Small}"
                   Foreground="{DynamicResource FP.Text.Secondary}"/>
        <ComboBox ItemsSource="{Binding DialogImportTargetChoices}"
                  SelectedItem="{Binding DialogImportSelectedTargetChoice, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  Classes="no-translate"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding DialogImportTargetFolder, Mode=TwoWay}"
                     Classes="no-translate"
                     MinHeight="36"/>
            <Button Grid.Column="1"
                    Classes="icon-btn"
                    Width="38" Height="36"
                    Click="OnBrowseTargetClick"
                    ToolTip.Tip="Ordner wählen">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/folder-open.svg" Width="18" Height="18"/>
            </Button>
        </Grid>
        <TextBlock Text="Platzhalter: {pictures} Bilder-Ordner, {datetaken:yyyy} Jahr der Aufnahme, {datetaken:yyyy-MM-dd} Tag, {camera} Kamera."
                   Foreground="{DynamicResource FP.Text.Muted}"
                   FontSize="{DynamicResource FP.Font.Small}"
                   TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsDialogImportPatternVisible}">
            <TextBlock Text="Unterordner"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource FP.Text.Secondary}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding DialogImportPatterns}"
                      SelectedItem="{Binding DialogImportSelectedPattern, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Classes="no-translate"/>
        </Grid>

        <!-- SICHERUNG: ein zweites Ziel, das genauso geprüft beschrieben wird. -->
        <CheckBox IsChecked="{Binding DialogImportUseBackup, Mode=TwoWay}">
            <TextBlock Text="Zusätzlich in einen zweiten Ordner sichern"/>
        </CheckBox>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding DialogImportUseBackup}">
            <TextBox Text="{Binding DialogImportBackupFolder, Mode=TwoWay}"
                     Classes="no-translate"
                     MinHeight="36"/>
            <Button Grid.Column="1"
                    Classes="icon-btn"
                    Width="38" Height="36"
                    Click="OnBrowseBackupClick"
                    ToolTip.Tip="Ordner wählen">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/folder-open.svg" Width="18" Height="18"/>
            </Button>
        </Grid>

        <!-- ZUSAMMENFASSUNG: was beim Bestätigen passiert. -->
        <Border Background="{DynamicResource FP.Bg.Input}"
                BorderBrush="{DynamicResource FP.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,4,0,0"
                IsVisible="{Binding HasDialogImportSummary}">
            <TextBlock Text="{Binding DialogImportSummary}"
                       Classes="no-translate"
                       Foreground="{DynamicResource FP.Text.Secondary}"
                       FontSize="{DynamicResource FP.Font.Small}"
                       TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</UserControl>
