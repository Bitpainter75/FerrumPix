<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:models="clr-namespace:FerrumPix.Models"
             xmlns:vm="clr-namespace:FerrumPix.ViewModels"
             x:Class="FerrumPix.Views.KeywordManagerOverlayView"
             x:DataType="vm:KeywordManagerViewModel">

    <UserControl.Styles>
        <!-- Die Zeilen des Baums sind KEINE Ghost-Knöpfe: die tragen einen Rahmen, und eine Liste
             aus lauter umrandeten Kästchen mit einem zweiten Kästchen für den Pfeil davor liest
             sich wie ein Formular, nicht wie ein Baum. Eine Zeile ist hier eine Fläche ohne Rand,
             die unter dem Zeiger und als gewählte Zeile eine Füllung bekommt. -->
        <Style Selector="Button.kw-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.kw-row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        </Style>
        <Style Selector="Button.kw-row.active">
            <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.kw-row.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FP.Bg.Active}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        </Style>
        <!-- Beim Ziehen: die Zeile, unter die das gezogene Wort käme. -->
        <Style Selector="Button.kw-row.drop /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FP.Bg.Active}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.kw-top">
            <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.kw-top.drop">
            <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
            <Setter Property="Background" Value="{DynamicResource FP.Bg.Active}"/>
        </Style>
        <Style Selector="Button.kw-arrow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.kw-arrow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        </Style>
    </UserControl.Styles>

    <!-- Der Dialog zum Ordnen der Stichwörter. Links der Baum, rechts das gewählte Wort. Jede
         Änderung gilt sofort (sie schreibt eine Zeile in die Ordnung und an keinem Bild), deshalb
         gibt es unten nur "Schließen". -->
    <Border Background="#B8000000"
            IsVisible="{Binding IsOpen}">
        <Panel>
        <!-- Das Schild am Zeiger während des Ziehens. Es nimmt keine Zeigerereignisse an, sonst
             fände die Suche nach der Zeile unter dem Zeiger immer nur das Schild. -->
        <Canvas IsHitTestVisible="False" ZIndex="10" IsVisible="{Binding IsDragging}">
            <Border x:Name="DragBadge"
                    Padding="12,6"
                    CornerRadius="14"
                    Background="{DynamicResource FP.Accent}"
                    BoxShadow="0 3 12 #88000000">
                <TextBlock Text="{Binding DraggedName}" Classes="no-translate"
                           Foreground="{DynamicResource FP.OnAccent}"
                           FontWeight="SemiBold"/>
            </Border>
        </Canvas>
        <Border Width="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource FP.Bg.Panel}"
                BorderBrush="{DynamicResource FP.Border.Strong}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="22">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Stichwörter ordnen"
                               FontSize="{DynamicResource FP.Font.Heading}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource FP.Text.Primary}"/>
                    <TextBlock Text="Hänge Stichwörter untereinander, etwa Hunde und Katzen unter Tiere. Wer in der Galerie Tiere wählt, findet dann auch die Bilder mit Hunde. An den Bildern selbst ändert sich nichts."
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="24">

                    <!-- Links: alle Stichwörter als Baum, mit Suche. -->
                    <StackPanel Spacing="8">
                        <Border Background="{DynamicResource FP.Bg.Input}"
                                BorderBrush="{DynamicResource FP.Border.Normal}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/magnifying-glass.svg"
                                               Width="18" Height="18" VerticalAlignment="Center" Opacity="0.65"/>
                                <TextBox Grid.Column="1"
                                         Classes="search-input"
                                         BorderThickness="0"
                                         Padding="0"
                                         Text="{Binding SearchText}"
                                         PlaceholderText="Stichwort suchen"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- Die Ablage für die oberste Ebene. Immer da und nicht erst beim Ziehen:
                             erschiene sie erst dann, rutschte die Liste unter dem Zeiger weg. -->
                        <Border x:Name="TopLevelDrop" Classes="kw-top"
                                Classes.drop="{Binding IsDropOnTop}"
                                Padding="10,7">
                            <TextBlock Text="Oberste Ebene"
                                       Foreground="{DynamicResource FP.Text.Muted}"
                                       FontSize="{DynamicResource FP.Font.Small}"/>
                        </Border>
                        <Border BorderBrush="{DynamicResource FP.Border.Normal}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="340">
                            <Panel>
                                <ScrollViewer x:Name="RowsScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsRepeater ItemsSource="{Binding Rows}" Margin="4">
                                        <ItemsRepeater.Layout><StackLayout Orientation="Vertical"/></ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TagFilterOption}">
                                                <Grid ColumnDefinitions="Auto,Auto,*">
                                                    <Border Width="{Binding IndentWidth}"/>
                                                    <Button Grid.Column="1" Classes="kw-arrow"
                                                            IsVisible="{Binding ShowsTree}"
                                                            IsHitTestVisible="{Binding HasChildren}"
                                                            Click="OnExpandClick">
                                                        <Panel>
                                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/caret-down.svg"
                                                                           Width="12" Height="12" IsVisible="{Binding ShowsExpandedArrow}"/>
                                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/caret-right.svg"
                                                                           Width="12" Height="12" IsVisible="{Binding ShowsCollapsedArrow}"/>
                                                        </Panel>
                                                    </Button>
                                                    <Button Grid.Column="2" Classes="kw-row"
                                                            Classes.active="{Binding IsSelected}"
                                                            Classes.drop="{Binding IsDropTarget}"
                                                            Click="OnRowClick">
                                                        <TextBlock Text="{Binding Label}" Classes="no-translate"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                                <TextBlock Text="Keine Stichwörter vergeben"
                                           IsVisible="{Binding HasNoRows}"
                                           Foreground="{DynamicResource FP.Text.Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                        </Border>
                    </StackPanel>

                    <!-- Rechts: was sich am gewählten Wort ändern lässt. -->
                    <StackPanel Grid.Column="1" Spacing="18">
                        <TextBlock Text="Ziehe ein Stichwort auf ein anderes, um es darunter zu hängen, oder wähle eines aus."
                                   IsVisible="{Binding HasNoSelection}"
                                   Foreground="{DynamicResource FP.Text.Muted}"
                                   TextWrapping="Wrap"/>

                        <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
                            <!-- "Auswahl aufheben" ist der Weg zurück auf die oberste Ebene: nur ohne
                                 gewähltes Wort legt das Feld unten dort an. -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <TextBlock Text="{Binding SelectedName}" Classes="no-translate"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource FP.Text.Primary}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="ghost" Padding="10,4" Margin="8,0,0,0"
                                        Command="{Binding ClearSelectionCommand}">
                                    <TextBlock Text="Auswahl aufheben" FontSize="{DynamicResource FP.Font.Small}"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="Steht unter"
                                       Foreground="{DynamicResource FP.Text.Secondary}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <AutoCompleteBox Text="{Binding ParentText, Mode=TwoWay}"
                                                 ItemsSource="{Binding ParentCandidates}"
                                                 PlaceholderText="Oberste Ebene"
                                                 FilterMode="Contains"
                                                 MinimumPrefixLength="0"
                                                 MinHeight="34"
                                                 VerticalAlignment="Center"
                                                 KeyDown="OnParentKeyDown"/>
                                <Button Grid.Column="1" Classes="accent" Padding="14,0" Margin="8,0,0,0"
                                        Height="34" MinWidth="104" HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Command="{Binding ApplyParentCommand}">
                                    <TextBlock Text="Einordnen"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="Ein Weg wie Reisen &gt; Italien legt die Stufen darüber gleich mit an."
                                       Foreground="{DynamicResource FP.Text.Muted}"
                                       FontSize="{DynamicResource FP.Font.Small}"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Classes="ghost" Padding="12,6"
                                        IsEnabled="{Binding SelectedHasParent}"
                                        Command="{Binding MoveToTopCommand}">
                                    <TextBlock Text="Auf die oberste Ebene"/>
                                </Button>
                                <Button Classes="ghost" Padding="12,6"
                                        IsEnabled="{Binding CanRemoveSelected}"
                                        Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="Nur für ein Stichwort, das an keinem Bild steht. Was darunter hängt, rückt eine Stufe hinauf."
                                        ToolTip.ShowOnDisabled="True">
                                    <TextBlock Text="Entfernen"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Neues Stichwort darunter"
                                       IsVisible="{Binding HasSelection}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"/>
                            <TextBlock Text="Neues Stichwort auf der obersten Ebene"
                                       IsVisible="{Binding HasNoSelection}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding NewChildText, Mode=TwoWay}"
                                         MinHeight="34"
                                         KeyDown="OnNewChildKeyDown"/>
                                <Button Grid.Column="1" Classes="ghost" Padding="14,0" Margin="8,0,0,0"
                                        Height="34" MinWidth="104" HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Command="{Binding AddChildCommand}">
                                    <TextBlock Text="Anlegen"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusText}"
                                   IsVisible="{Binding HasStatus}"
                                   Foreground="{DynamicResource FP.Accent}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Classes="ghost"
                            Padding="14,8"
                            Command="{Binding CloseCommand}">
                        <TextBlock Text="Schließen"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </Panel>
    </Border>
</UserControl>
