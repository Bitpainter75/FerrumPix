<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:views="clr-namespace:FerrumPix.Views"
             xmlns:vm="clr-namespace:FerrumPix.ViewModels"
             xmlns:services="clr-namespace:FerrumPix.Services"
             xmlns:models="clr-namespace:FerrumPix.Models"
             xmlns:panels="clr-namespace:FerrumPix.Controls.EditorPanels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="FerrumPix.Views.EditorView"
             Classes="editor-view"
             Background="{DynamicResource FP.Bg.Root}"
             Focusable="True"
             FocusAdorner="{x:Null}"
             KeyDown="OnKeyDown"
             KeyUp="OnKeyUp"
             PointerReleased="OnGlobalPointerReleased">

    <!-- Erste Spalte Auto statt fest 190: die Breite kommt aus ToolSidebarWidth, damit die
         Werkzeugleiste auf Symbolbreite einklappen kann (Zustand in den Einstellungen). -->
    <Grid x:Name="EditorRootGrid" RowDefinitions="60,*,Auto" ColumnDefinitions="Auto,*,330,320,300">

        <!-- EIN Kontextmenue fuer Buehne, Filmstreifen und Fusszeile. -->
        <Grid.ContextMenu>
            <ContextMenu x:Name="EditorKontextMenu" Opened="OnFooterMenuOpened" ItemsSource="{Binding ContextActions}">
            <!-- Eine Vorlage fuer alle Eintraege. Symbol und Text liegen zusammen im
            Header statt in MenuItem.Icon: die eingebaute Symbolspalte ist breiter
            als 16 Punkte und schob das Zeichen sichtbar nach links weg. So bestimmt
            der Abstand hier die Lage, und zwar fuer jeden Eintrag gleich.

            Die Zeilen mit Sternen, Herz und Farbkreisen tragen die Klasse "widget" und
            bleiben ausgenommen: sie bringen ihren Inhalt selbst mit. Ohne diese Ausnahme
            ueberschrieb die Vorlage ihn - erst waren sie leer, dann nicht bedienbar. -->
            <ContextMenu.Styles>
            <Style Selector="MenuItem:not(.widget)">
            <!-- Schmaler als die Vorgabe des Erscheinungsbilds (208): die Eintraege sind kurz,
                 und ein Menue, das breiter ist als sein laengster Text, wirkt leer. -->
            <Setter Property="MinWidth" Value="178"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="CommandParameter" Value="{Binding Parameter}"/>
            <Setter Property="ItemsSource" Value="{Binding Children}"/>
            <Setter Property="Header">
            <Template>
            <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:SvgIcon Source="{Binding IconSource}"
            Width="16" Height="16"
            VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
            </StackPanel>
            </Template>
            </Setter>
            </Style>
            </ContextMenu.Styles>
            </ContextMenu>
        </Grid.ContextMenu>


        <!-- Die obere Leiste ist waehrend eines laufenden Vorgangs GESPERRT, so wie die
             Werkzeugleiste, die Regler und die Fusszeile. Sie war es als einzige nicht, und
             gerade hier stehen die Knoepfe, die am meisten anrichten: Rueckgaengig und
             Speichern greifen auf ein Bild zu, das in diesem Augenblick Kachel fuer Kachel
             neu geschrieben wird. -->
        <Border Grid.Row="0" Grid.ColumnSpan="5" Classes="toolbar" Height="60" Padding="24,0"
                IsEnabled="{Binding IsInteractionAllowed}">
            <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding BackToViewerCommand}"
                            ToolTip.Tip="Zurück">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/home.svg"
                                       Width="20" Height="20" />
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding PreviousCommand}"
                            ToolTip.Tip="Vorheriges Bild">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-left.svg"
                                       Width="20" Height="20" />
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding NextCommand}"
                            ToolTip.Tip="Nächstes Bild">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-right.svg"
                                       Width="20" Height="20" />
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding ShowNewDocumentDialogCommand}"
                            ToolTip.Tip="Neues Bild (Strg+N)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/photo-plus.svg"
                                       Width="20" Height="20" />
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding PrintCommand}"
                            ToolTip.Tip="Drucken (Strg+P)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/printer.svg"
                                       Width="20" Height="20" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-110,0,0,0">
                    <Button Name="PanModeButton" Classes="ghost" Height="38" Padding="8,2"
                            Margin="0,0,0,0" ToolTip.Tip="Verschieben-Modus ein- oder ausschalten"
                            Focusable="False"
                            Click="OnPanModeToggleClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/pinned.svg"
                                           Width="20" Height="20" />
                            <TextBlock Text="Verschieben" IsVisible="{Binding AreToolbarLabelsVisible}" />
                        </StackPanel>
                    </Button>

                    <Button Name="RulerModeButton" Classes="ghost" Height="38" Padding="8,2"
                            Margin="0,0,0,0" ToolTip.Tip="Lineale und Hilfslinien ein- oder ausblenden"
                            Focusable="False"
                            Click="OnRulerModeToggleClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/ruler-2.svg"
                                           Width="20" Height="20" />
                            <TextBlock Text="Lineale" IsVisible="{Binding AreToolbarLabelsVisible}" />
                        </StackPanel>
                    </Button>

                    <Button Name="GridModeButton" Classes="ghost" Height="38" Padding="8,2"
                            Margin="0,0,0,0" ToolTip.Tip="Raster ein- oder ausblenden (Größe: Einstellungen → Editor)"
                            Focusable="False"
                            Click="OnGridModeToggleClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/grid-pattern.svg"
                                           Width="20" Height="20" />
                            <TextBlock Text="Raster" IsVisible="{Binding AreToolbarLabelsVisible}" />
                        </StackPanel>
                    </Button>

                    <Button Classes="ghost"
                            Height="38"
                            Padding="8,2"
                            Margin="0,0,0,0"
                            IsEnabled="{Binding CanShowBeforeAfter}"
                            Classes.active="{Binding ShowBeforeImage}"
                            Click="OnToggleBeforeAfterClick"
                            ToolTip.Tip="Vergleich ein- oder ausblenden">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eye.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Vergleich" IsVisible="{Binding AreToolbarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                    
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Classes="icon-btn" Width="38" Height="38"
                            IsEnabled="{Binding CanUndo}"
                            Command="{Binding UndoCommand}"
                            ToolTip.Tip="Rückgängig">
                        <Canvas Width="20" Height="20">
                            <Path Stroke="{DynamicResource FP.Text.Secondary}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="M 8 5 L 4 9 L 8 13 M 5 9 H 12 C 15 9 17 11 17 14 C 17 17 15 19 12 19 H 8" />
                        </Canvas>
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            IsEnabled="{Binding CanRedo}"
                            Command="{Binding RedoCommand}"
                            ToolTip.Tip="Wiederholen">
                        <Canvas Width="20" Height="20">
                            <Path Stroke="{DynamicResource FP.Text.Secondary}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="M 12 5 L 16 9 L 12 13 M 15 9 H 8 C 5 9 3 11 3 14 C 3 17 5 19 8 19 H 12" />
                        </Canvas>
                    </Button>
                    <Button Classes="accent" Height="38" Padding="16,7" Command="{Binding SaveCommand}"
                            ToolTip.Tip="Speichern"
                            IsEnabled="{Binding CanSaveInPlace}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/device-floppy.svg"
                                           Width="20" Height="20" />
                            <TextBlock Text="Speichern" IsVisible="{Binding AreToolbarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost active" Height="38" Padding="12,7" Command="{Binding SaveAsCommand}"
                            ToolTip.Tip="Speichern unter...">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/file-export.svg"
                                           Width="20" Height="20" />
                            <TextBlock Text="Speichern unter..." IsVisible="{Binding AreToolbarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon-btn"
                            Width="38" Height="38"
                            Command="{Binding DeleteCurrentCommand}"
                            ToolTip.Tip="Löschen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/trash.svg"
                                       Width="18" Height="18" />
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Classes.active="{Binding IsLayersPanelVisible}"
                            Command="{Binding ToggleLayersPanelCommand}"
                            ToolTip.Tip="Ebenen-Panel">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/stack-2.svg" Width="20"
                                       Height="20" />
                    </Button>
                    <Button Classes="icon-btn"
                            Width="38" Height="38"
                            Click="OnToggleFilmstripClick"
                            Classes.active="{Binding ShowFilmstrip}"
                            IsEnabled="{Binding CanToggleFilmstrip}"
                            ToolTip.Tip="Filmstreifen ein- oder ausblenden">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eye.svg"
                                       Width="18" Height="18" />
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Classes.active="{Binding IsInfoSidebarVisible}"
                            Command="{Binding ToggleInfoSidebarCommand}"
                            ToolTip.Tip="Info-Seitenleiste">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/info-circle.svg" Width="20"
                                       Height="20" />
                    </Button>
                    <Button Classes="icon-btn"
                            Width="38" Height="38"
                            Click="OnSettingsClick"
                            ToolTip.Tip="Einstellungen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/settings.svg"
                                       Width="18" Height="18" />
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Click="OnFullscreenClick"
                            ToolTip.Tip="Vollbild">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/maximize.svg"
                                       Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GESPERRT, solange ein langer Vorgang laeuft - genau wie die Regler rechts. Ein
             Werkzeugwechsel mitten im Entrauschen fuehrt sonst zu einem Bild, dessen Zustand
             niemand mehr erklaeren kann. -->
        <Border Grid.Row="1" Grid.Column="0" Classes="sidebar" Padding="8,8" Width="{Binding ToolSidebarWidth}"
                IsEnabled="{Binding IsInteractionAllowed}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" FocusAdorner="{x:Null}">
                <StackPanel Spacing="2">
                    <!-- Die drei Werkzeuggruppen liegen in einem Raster mit drei Zeilen: welche
                         Gruppe oben steht, sagt die Einstellung (Zeilennummer je Gruppe). Ein
                         gestapeltes Panel könnte das nicht - eine Reihenfolge lässt sich nicht
                         binden, eine Zeilennummer schon. -->
                    <Grid RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Row="{Binding ToolGroupRowTransform}" Spacing="2">
                    <TextBlock Text="TRANSFORMIEREN" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Caption}"
                               FontWeight="SemiBold" Margin="10,10,0,4" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Zuschneiden"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Crop"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Crop}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/crop.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Zuschneiden" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Bildgröße"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Resize"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Resize}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/aspect-ratio.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Bildgröße" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Drehen und Verzerren"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Rotate"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Rotate}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/rotate-2.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Drehen und Verzerren" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="{Binding ToolGroupRowAdjust}" Spacing="2">
                    <TextBlock Text="ANPASSUNGEN" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Caption}"
                               FontWeight="SemiBold" Margin="10,10,0,4" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                    <Button Classes="tool-btn-row"
                            IsVisible="{Binding ShowsToolAdjust}"
                            ToolTip.Tip="Anpassen"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Adjust"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Adjust}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/exposure.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Anpassen" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            IsVisible="{Binding ShowsToolColor}"
                            ToolTip.Tip="Farbe"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Color"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Color}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/color-filter.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Farbe" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tool-btn-row"
                            IsVisible="{Binding ShowsToolDetails}"
                            ToolTip.Tip="Details"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Details"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Details}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/adjustments.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Details" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            IsVisible="{Binding ShowsToolEffects}"
                            ToolTip.Tip="Effekte"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Effects"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Effects}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/sparkles.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Effekte" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            IsVisible="{Binding ShowsToolFilter}"
                            ToolTip.Tip="Filter"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Filters"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Filters}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/palette.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Filter" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="{Binding ToolGroupRowTools}" Spacing="2">
                    <!-- Die Werkzeuge stehen hier einzeln, statt hinter den Sammelknöpfen "Text und Bild"
                         und "Malen" zu liegen: ein Klick wählt direkt das Werkzeug, mit dem gearbeitet
                         wird. Die zugehörigen Panels rechts zeigen nur noch dessen Einstellungen. -->
                    <TextBlock Text="WERKZEUGE" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Caption}"
                               FontWeight="SemiBold" Margin="10,10,0,4" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Auswahl"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Selection"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Selection}"
                            Classes.selected-kind="{Binding SelectedAnnotationToolbarKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Selection}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/pointer.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Auswahl" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Maske"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Mask"
                            Classes.active="{Binding CurrentTool, Converter={StaticResource EditorToolEqualsConverter}, ConverterParameter=Mask}"
                            Classes.selected-kind="{Binding IsMaskToolbarAccented}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/mask.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Maske" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Text"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Text"
                            Classes.active="{Binding PendingInsertKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Text}"
                            Classes.selected-kind="{Binding SelectedAnnotationToolbarKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Text}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/text-size.svg" Width="18" Height="18" />
                            <TextBlock Text="Text" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Bild"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Image"
                            Classes.active="{Binding PendingInsertKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Image}"
                            Classes.selected-kind="{Binding SelectedAnnotationToolbarKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Image}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/photo.svg" Width="18" Height="18" />
                            <TextBlock Text="Bild" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="QR-Code"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="QR"
                            Classes.active="{Binding PendingInsertKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=QR}"
                            Classes.selected-kind="{Binding SelectedAnnotationToolbarKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=QR}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/qrcode.svg" Width="18" Height="18" />
                            <TextBlock Text="QR-Code" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Wasserzeichen"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Watermark"
                            Classes.active="{Binding PendingInsertKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Watermark}"
                            Classes.selected-kind="{Binding SelectedAnnotationToolbarKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Watermark}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/copyright.svg" Width="18" Height="18" />
                            <TextBlock Text="Wasserzeichen" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Pinsel"
                            IsEnabled="{Binding CanUsePixelTools}"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Brush"
                            Classes.active="{Binding SelectedPaintMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Brush}"
                            Classes.selected-kind="{Binding SelectedAnnotationToolbarKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Brush}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brush.svg" Width="18" Height="18" />
                            <TextBlock Text="Pinsel" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Radiergummi"
                            IsEnabled="{Binding CanUsePixelTools}"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Eraser"
                            Classes.active="{Binding SelectedPaintMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Eraser}"
                            Classes.selected-kind="{Binding SelectedAnnotationToolbarKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Eraser}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eraser.svg" Width="18" Height="18" />
                            <TextBlock Text="Radiergummi" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Verwischen"
                            IsEnabled="{Binding CanUsePixelTools}"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Blur"
                            Classes.active="{Binding SelectedPaintMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Blur}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/blur.svg" Width="18" Height="18" />
                            <TextBlock Text="Verwischen" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Reparaturpinsel"
                            IsEnabled="{Binding CanUsePixelTools}"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Repair"
                            Classes.active="{Binding SelectedPaintMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Repair}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/bandage.svg" Width="18" Height="18" />
                            <TextBlock Text="Reparaturpinsel" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Stempel (Alt+Klick setzt die Quelle)"
                            IsEnabled="{Binding CanUsePixelTools}"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Clone"
                            Classes.active="{Binding SelectedPaintMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Clone}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/rubber-stamp.svg" Width="18" Height="18" />
                            <TextBlock Text="Stempel" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tool-btn-row"
                            ToolTip.Tip="Formen und Symbole"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="Insert"
                            Classes.active="{Binding IsGeometryToolSelected}"
                            Classes.selected-kind="{Binding SelectedAnnotationToolbarKind, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Insert}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/shape.svg"
                                           Width="18" Height="18" />
                            <TextBlock Text="Formen und Symbole" FontSize="{DynamicResource FP.Font.Body}" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource FP.Bg.Root}" Padding="2">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                            IsVisible="{Binding IsDocumentLoading}">
                    <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="Bild und Bearbeitungen werden geladen…"
                               Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Small}"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                            IsVisible="{Binding ShowNoImagePlaceholder}">
                    <TextBlock Text="Kein Bild zum Bearbeiten" Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Subtitle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Öffne ein Bild aus dem Betrachter" Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Small}" HorizontalAlignment="Center" />
                </StackPanel>

                <Grid RowDefinitions="*,Auto"
                      IsVisible="{Binding ShowEditorDocument}">
                    <!-- Die Lineale teilen sich Spalte bzw. Zeile mit dem Vorschau-Canvas; ihre lokalen
                         Koordinaten entlang der Skala sind damit identisch mit denen des Canvas. Sind sie
                         ausgeblendet, kollabieren die Auto-Spur und der Canvas nutzt die volle Fläche. -->
                    <Grid Grid.Row="0" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
                        <Button x:Name="RulerCornerButton"
                                Grid.Row="0" Grid.Column="0"
                                Width="18" Height="18"
                                MinWidth="0" MinHeight="0" Padding="0"
                                CornerRadius="0"
                                Focusable="False"
                                IsVisible="False"
                                Background="{DynamicResource FP.Bg.Elevated}"
                                BorderBrush="{DynamicResource FP.Border.Normal}"
                                BorderThickness="0,0,1,1"
                                Click="OnClearGuidesClick"
                                ToolTip.Tip="Alle Hilfslinien entfernen" />
                        <icons:RulerControl x:Name="TopRuler"
                                            Grid.Row="0" Grid.Column="1"
                                            Height="18"
                                            IsHorizontal="True"
                                            IsVisible="False"
                                            Cursor="Hand"
                                            RulerBackground="{DynamicResource FP.Bg.Elevated}"
                                            ImageAreaBrush="{DynamicResource FP.Bg.Panel}"
                                            TickBrush="{DynamicResource FP.Border.Strong}"
                                            LabelBrush="{DynamicResource FP.Text.Muted}"
                                            MarkerBrush="{DynamicResource FP.Accent}"
                                            PointerPressed="OnRulerPointerPressed"
                                            PointerMoved="OnRulerPointerMoved"
                                            PointerReleased="OnRulerPointerReleased" />
                        <icons:RulerControl x:Name="LeftRuler"
                                            Grid.Row="1" Grid.Column="0"
                                            Width="18"
                                            IsHorizontal="False"
                                            IsVisible="False"
                                            Cursor="Hand"
                                            RulerBackground="{DynamicResource FP.Bg.Elevated}"
                                            ImageAreaBrush="{DynamicResource FP.Bg.Panel}"
                                            TickBrush="{DynamicResource FP.Border.Strong}"
                                            LabelBrush="{DynamicResource FP.Text.Muted}"
                                            MarkerBrush="{DynamicResource FP.Accent}"
                                            PointerPressed="OnRulerPointerPressed"
                                            PointerMoved="OnRulerPointerMoved"
                                            PointerReleased="OnRulerPointerReleased" />
                    <Canvas x:Name="PreviewCanvas"
                            PointerWheelChanged="OnCanvasWheelZoom"
                            Grid.Row="1" Grid.Column="1"
                            Background="Transparent"
                            ClipToBounds="True"
                            SizeChanged="OnPreviewCanvasSizeChanged"
                            PointerPressed="OnSliderPointerPressed"
                            PointerMoved="OnSliderPointerMoved"
                            PointerReleased="OnSliderPointerReleased"
                            PointerCaptureLost="OnPreviewCanvasCaptureLost"
                            PointerExited="OnPreviewCanvasPointerExited"
                            DragDrop.AllowDrop="True"
                            DragDrop.DragOver="OnPreviewCanvasDragOver"
                            DragDrop.Drop="OnPreviewCanvasDrop">
                        <Border x:Name="ImageBackgroundBorder"
                                Background="{Binding TransparencyBackgroundBrush}"
                                IsHitTestVisible="False" />
                        <Image x:Name="AfterImageControl"
                               Source="{Binding DisplayImage}"
                               Stretch="Fill"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <!-- STUFE 3 (Zoom-Detail): hochaufgeloester Viewport-Ausschnitt ueber dem
                             AfterImage, sobald der Zoom die Szenen-Aufloesung uebersteigt. Quelle
                             und Position setzt UpdateZoomDetailOverlay (Code-Behind), damit
                             Ausschnitt und Layout im selben Durchlauf konsistent bleiben. -->
                        <Image x:Name="ZoomDetailImageControl"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               IsVisible="False"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Image x:Name="BeforeImageControl"
                               Source="{Binding BeforeDisplayImage}"
                               Stretch="Fill"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <!-- Vorher-Seite des Zoom-Details (Original, nur Geometrie): liegt ueber dem
                             BeforeImage und wird wie dieses an der Vergleichslinie geclippt. -->
                        <Image x:Name="ZoomDetailBeforeImageControl"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               IsVisible="False"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Image x:Name="RetouchLivePatchImage"
                               Source="{Binding RetouchLivePatchImage}"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               IsVisible="{Binding HasRetouchLivePatch}"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Border x:Name="ImageFrameBorder"
                                Background="Transparent"
                                BorderBrush="{DynamicResource FP.Border.Strong}"
                                BorderThickness="1"
                                IsHitTestVisible="False" />
                        <!-- Raster und Hilfslinien liegen über dem Bild, aber unter Zuschnitt- und
                             Objekt-Overlay, damit sie deren Anfasspunkte nicht verdecken. -->
                        <icons:PixelGridOverlay x:Name="GridOverlay" IsVisible="False" IsHitTestVisible="False" />
                        <Canvas x:Name="GuideLayer" IsHitTestVisible="False" ClipToBounds="True" />
                        <Border x:Name="SliderDivider"
                                Width="2"
                                Background="{DynamicResource FP.Accent}"
                                Opacity="0.9" />
                        <!-- Unsichtbare, breite Griffzone über der 2-px-Trennlinie: die Linie selbst
                             ist praktisch nicht greifbar (Linie ziehen +
                             Größenänderungs-Cursor wie bei den Hilfslinien). -->
                        <Border x:Name="SliderDividerHit"
                                Width="14"
                                Background="Transparent"
                                Cursor="SizeWestEast" />
                        <Border x:Name="SliderHandleCircle"
                                Width="36" Height="36"
                                Background="#F2F2F2"
                                CornerRadius="18"
                                BorderBrush="{DynamicResource FP.Border.Normal}"
                                BorderThickness="1"
                                Cursor="SizeWestEast">
                            <StackPanel Orientation="Horizontal" Spacing="3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Width="7" Height="12"
                                      Stretch="Uniform"
                                      Stroke="#1A1A1A"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M 10 0 L 0 10 L 10 20" />
                                <Path Width="7" Height="12"
                                      Stretch="Uniform"
                                      Stroke="#1A1A1A"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M 0 0 L 10 10 L 0 20" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="BeforeLabel" Background="#262933" CornerRadius="6" Padding="10,5">
                            <TextBlock Text="Vorher" FontSize="{DynamicResource FP.Font.Small}" Foreground="White" />
                        </Border>
                        <Border x:Name="AfterLabel" Background="#262933" CornerRadius="6" Padding="10,5">
                            <TextBlock Text="Nachher" FontSize="{DynamicResource FP.Font.Small}" Foreground="White" />
                        </Border>
                        <Border x:Name="CropOverlay"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="SizeAll"
                                IsVisible="False">
                            <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*">
                                <Rectangle Grid.RowSpan="3"
                                           Grid.ColumnSpan="3"
                                           Fill="#12008CFF"
                                           Stroke="{DynamicResource FP.Accent}"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="5,3" />
                                <Border Grid.RowSpan="3" Grid.Column="1" Width="1" Background="#CCFFFFFF"
                                        HorizontalAlignment="Left" />
                                <Border Grid.RowSpan="3" Grid.Column="1" Width="1" Background="#CCFFFFFF"
                                        HorizontalAlignment="Right" />
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="#CCFFFFFF"
                                        VerticalAlignment="Top" />
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="#CCFFFFFF"
                                        VerticalAlignment="Bottom" />
                                <Border Grid.RowSpan="3" Grid.Column="1" Width="1" Background="#66000000"
                                        HorizontalAlignment="Left" Margin="1,0,0,0" />
                                <Border Grid.RowSpan="3" Grid.Column="1" Width="1" Background="#66000000"
                                        HorizontalAlignment="Right" Margin="0,0,1,0" />
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="#66000000"
                                        VerticalAlignment="Top" Margin="0,1,0,0" />
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="#66000000"
                                        VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                <Border Grid.RowSpan="3"
                                        Grid.ColumnSpan="3"
                                        Background="#CC1A1D24"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="6,6,0,0">
                                    <TextBlock x:Name="CropSizeBadgeText"
                                               Text=""
                                               Foreground="White"
                                               FontSize="{DynamicResource FP.Font.Small}"
                                               FontWeight="SemiBold" />
                                </Border>
                                <Border Width="16" Height="16" CornerRadius="8"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="-9,-9,0,0" />
                                <Border Grid.Column="1" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Margin="0,-8,0,0" />
                                <Border Grid.Column="2" Width="16" Height="16" CornerRadius="8"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-9,-9,0" />
                                <Border Grid.Row="1" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-8,0,0,0" />
                                <Border Grid.Row="1" Grid.Column="2" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,-8,0" />
                                <Border Grid.Row="2" Width="16" Height="16" CornerRadius="8"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="-9,0,0,-9" />
                                <Border Grid.Row="2" Grid.Column="1" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Margin="0,0,0,-8" />
                                <Border Grid.Row="2" Grid.Column="2" Width="16" Height="16" CornerRadius="8"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-9,-9" />
                            </Grid>
                        </Border>
                        <Image x:Name="SelectionMaskOverlay"
                               Source="{Binding SelectionMaskPreviewImage}"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               IsVisible="False" />
                        <icons:GradientMaskOverlayControl x:Name="GradientMaskOverlay"
                                                          StrokeBrush="{DynamicResource FP.Accent}"
                                                          IsHitTestVisible="False"
                                                          IsVisible="False" />
                        <!-- Live-Vorschau der Gitterverzerrung: liegt UEBER dem Bild und unter den
                             Overlays, damit die Rasterpunkte darauf sichtbar bleiben. -->
                        <Image x:Name="ToolPreviewImage"
                               Source="{Binding ToolPreviewImage}"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               IsVisible="{Binding HasPreview}"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <!-- ZIndex: die Verzerrungs-Overlays liegen OBEN. Ihre Ecken sitzen bei
                             einem markierten Objekt auf demselben Rechteck wie die Griffe des
                             Objektrahmens - darunter waeren sie weder zu sehen noch zu greifen. -->
                        <icons:PerspectiveOverlayControl x:Name="PerspectiveOverlay"
                                                      ZIndex="10"
                                                         StrokeBrush="{DynamicResource FP.Accent}"
                                                         IsHitTestVisible="False"
                                                         IsVisible="False" />
                        <icons:GridWarpOverlayControl x:Name="GridWarpOverlay"
                                                      ZIndex="10"
                                                      StrokeBrush="{DynamicResource FP.Accent}"
                                                      IsHitTestVisible="False"
                                                      IsVisible="False" />
                        <icons:LineWarpOverlayControl x:Name="LineWarpOverlay"
                                                      ZIndex="10"
                                                      StrokeBrush="{DynamicResource FP.Accent}"
                                                      IsHitTestVisible="False"
                                                      IsVisible="False" />
                        <icons:SelectionOverlayControl x:Name="SelectionOverlay"
                                                       FillBrush="{Binding SelectionFillPreviewBrush}"
                                                       StrokeBrush="{DynamicResource FP.Accent}"
                                                       IsHitTestVisible="False"
                                                       IsVisible="False" />
                        <icons:SelectionOverlayControl x:Name="SelectionDragOverlay"
                                                       FillBrush="#33FFFFFF"
                                                       StrokeBrush="{DynamicResource FP.Accent}"
                                                       IsHitTestVisible="False"
                                                       IsVisible="False" />
                        <Border x:Name="TextOverlay"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="SizeAll"
                                IsVisible="False"
                                PointerPressed="OnTextOverlayPointerPressed"
                                PointerMoved="OnTextOverlayPointerMoved"
                                PointerReleased="OnTextOverlayPointerReleased"
                                PointerCaptureLost="OnTextOverlayCaptureLost">
                            <Grid>
                                <!-- Gegenstrich: liegt in den Luecken des Rahmens und traegt die
                                     GEGENFARBE (siehe PositionTextOverlayFromViewModel). Der Rahmen
                                     selbst folgt der Konturfarbe des Objekts - ein schwarzes Objekt
                                     auf dunklem Bild waere sonst nicht zu sehen. StrokeDashArray und
                                     -Offset rechnen in VIELFACHEN der Strichbreite, beide Rechtecke
                                     brauchen deshalb dieselbe Breite. -->
                                <Rectangle x:Name="TextOverlayFrameCounter"
                                           Fill="Transparent"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="4,4"
                                           StrokeDashOffset="4"
                                           IsHitTestVisible="False" />
                                <Rectangle x:Name="TextOverlayFrame"
                                           Fill="Transparent"
                                           Stroke="{DynamicResource FP.Accent}"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="4,4"
                                           IsHitTestVisible="False" />
                                <!-- Kein AcceptsReturn/Wrap: neue Zeile nur per Strg+Enter (Handler im
                                     Code-Behind), damit die Anzeige exakt den Zeilen des Renderers
                                     entspricht - der bricht nicht automatisch um. -->
                                <!-- KEINE Bildlaufleisten: die Textbox ist nur Eingabefeld und liegt
                                     unsichtbar ueber dem gezeichneten Text. Ist der Text breiter als
                                     der Rahmen, blendete Avalonia sonst die waagerechte Leiste ein -
                                     sichtbar als grauer Strich unter dem Auswahlrahmen, der beim
                                     Verschieben und Groessenaendern mitwandert (Nutzer-Screenshot). -->
                                <TextBox x:Name="TextOverlayEditor"
                                         Classes="overlay-editor"
                                         Text="{Binding AnnotationText}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         VerticalContentAlignment="Top"
                                         IsHitTestVisible="False"
                                         FocusAdorner="{x:Null}" />
                                <Border x:Name="TextSizeBadge"
                                        IsVisible="False"
                                        IsHitTestVisible="False"
                                        Background="#CC1A1D24"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="0,-30,0,0">
                                    <TextBlock x:Name="TextSizeBadgeText" Text="" Foreground="White" FontSize="{DynamicResource FP.Font.Small}"
                                               FontWeight="SemiBold" />
                                </Border>
                                <!-- Die GRIFFE des Rahmens in einer eigenen Flaeche: beim Verzerren am
                                     Objekt sind sie weg (ShowsObjectFrameHandles). Ihre Stellen sind
                                     dann von den Verzerrungsecken belegt, und greifbar ist dort die
                                     Verzerrung. Der Rahmen selbst bleibt stehen. -->
                                <Panel x:Name="TextOverlayHandles" IsVisible="{Binding ShowsObjectFrameHandles}">
                                <Border Width="1" Height="20" Background="{DynamicResource FP.Accent}"
                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-20,0,0"
                                        IsHitTestVisible="False" />
                                <Border Width="16" Height="16" CornerRadius="8"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Margin="0,-36,0,0" IsHitTestVisible="False"
                                        ToolTip.Tip="Ziehen zum Drehen (Shift = 15°-Schritte)" />
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="-8,-8,0,0" IsHitTestVisible="False" />
                                <Border Width="12" Height="12" CornerRadius="6"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Margin="0,-7,0,0" IsHitTestVisible="False" />
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-8,-8,0" IsHitTestVisible="False" />
                                <Border Width="12" Height="12" CornerRadius="6"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-7,0,0,0" IsHitTestVisible="False" />
                                <Border Width="12" Height="12" CornerRadius="6"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,-7,0" IsHitTestVisible="False" />
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="-8,0,0,-8" IsHitTestVisible="False" />
                                <Border Width="12" Height="12" CornerRadius="6"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Margin="0,0,0,-7" IsHitTestVisible="False" />
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource FP.Accent}" BorderBrush="White"
                                        BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-8,-8" IsHitTestVisible="False" />
                                </Panel>
                            </Grid>
                        </Border>
                        <!-- Aufgezogenes Auswahlrechteck für Objekte (Ziehen auf freier Fläche in den
                             Objekt-Werkzeugen). Fängt keine Zeigereignisse ab. -->
                        <Border x:Name="ObjectMarquee" IsVisible="False" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FP.Accent}" BorderThickness="1"
                                Background="#22F08A1A" />
                        <Line x:Name="SnapGuideV" IsVisible="False" IsHitTestVisible="False" Stroke="#FFFF3B8D"
                              StrokeThickness="1" StrokeDashArray="4,3" />
                        <Line x:Name="SnapGuideH" IsVisible="False" IsHitTestVisible="False" Stroke="#FFFF3B8D"
                              StrokeThickness="1" StrokeDashArray="4,3" />
                        <Polyline x:Name="BrushPreviewOutlineLine"
                                  IsVisible="False"
                                  IsHitTestVisible="False"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        <Polyline x:Name="BrushPreviewLine"
                                  IsVisible="False"
                                  IsHitTestVisible="False"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        <Ellipse x:Name="BrushCursorPreview"
                                 IsVisible="False"
                                 IsHitTestVisible="False"
                                 Stroke="{DynamicResource FP.Accent}"
                                 StrokeThickness="1.5" />
                        <!-- Zeigt beim Klonen, von welcher Stelle die Textur kopiert wird. -->
                        <Ellipse x:Name="CloneSourceMarker"
                                 IsVisible="False"
                                 IsHitTestVisible="False"
                                 Stroke="{DynamicResource FP.Accent}"
                                 StrokeThickness="1.5"
                                 StrokeDashArray="3,3" />
                    </Canvas>
                    <!-- LIVE-VORSCHAU rechnet. Bewusst zurueckhaltend und OHNE Sperre: sie
                         entsteht ja gerade deshalb, weil man am Regler zieht. Ohne diesen Hinweis
                         wartet man vor einem Bild, das sich scheinbar nicht ruehrt - besonders
                         nachdem die Tiefenkarte einmal berechnet ist und der langsame Teil danach
                         gar nicht mehr auffaellt. -->
                    <Border Grid.Row="1" Grid.Column="1"
                            IsVisible="{Binding ShowsPreviewBusy}"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,10,10,0"
                            Background="{DynamicResource FP.Bg.Elevated}"
                            BorderBrush="{DynamicResource FP.Border.Normal}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Opacity="0.9">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="Vorschau"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Small}" />
                        </StackPanel>
                    </Border>
                    <!-- BESCHAEFTIGT. Auf dem Bild, nicht im Fuss: dorthin schaut man, waehrend man
                         arbeitet. Faengt auch die Maus ab, damit ein Zug ins Leere gar nicht erst
                         anfaengt. Erscheint erst nach einer Viertelsekunde - sonst blitzt es bei
                         jeder Reglerbewegung auf. -->
                    <Border Grid.Row="1" Grid.Column="1"
                            IsVisible="{Binding ShowsBusy}"
                            Background="#66000000"
                            IsHitTestVisible="True">
                        <Border Background="{DynamicResource FP.Bg.Elevated}"
                                BorderBrush="{DynamicResource FP.Border.Strong}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18,12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                                             VerticalAlignment="Center" />
                                <TextBlock Classes="no-translate"
                                           Text="{Binding BusyText}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FP.Font.Body}" />
                                <!-- ABBRECHEN. Nur bei den langen Modellwegen da - beim Einbacken
                                     eines Strichs waere es eine Schaltflaeche, die niemand trifft.
                                     Dieselbe Wirkung hat Esc. -->
                                <Button Classes="icon-btn"
                                        Width="26" Height="26" Padding="0"
                                        IsVisible="{Binding CanCancelBusy}"
                                        Command="{Binding CancelBusyCommand}"
                                        ToolTip.Tip="Abbrechen (Esc). Das Entrauschen steigt an der nächsten Kachel aus, das Entfernen nach seinem Durchlauf - das Bild bleibt dabei unverändert.">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                                   Width="14" Height="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Classes="panel-right">
            <Grid RowDefinitions="*">
                <Grid Grid.Row="0">
                    <ScrollViewer x:Name="AdjustmentsScrollViewer"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalScrollBarVisibility="Auto"
                                  AllowAutoHide="True"
                                  FocusAdorner="{x:Null}"
                                  Margin="0,0,8,0">
                        <!-- GESPERRT, solange etwas rechnet. Was das Ergebnis verdirbt, soll man
                             gar nicht erst anfassen koennen - vorher nahm der Regler die Eingabe
                             an und der spaeter eintreffende Vorgang ueberschrieb sie wieder. -->
                        <StackPanel x:Name="AdjustmentsStackPanel"
                                    Margin="10,2,10,10"
                                    IsEnabled="{Binding IsInteractionAllowed}"
                                    HorizontalAlignment="Stretch">
                            <!-- OHNE aeusseren Rahmen: das Panel bringt seit dem Verzerren ZWEI
                                 Gruppen mit und rahmt jede selbst (siehe DetailsPanel). -->
                            <panels:TransformPanel Margin="0,7,0,0"
                                                   IsVisible="{Binding ShowTransformAdjustments}" />

                            <!-- DrawPanel bringt seine eigenen adjustment-group-Rahmen mit (Farbe, Pinsel,
                                 Werkzeug getrennt), daher hier kein umschließender Rahmen. -->
                            <panels:DrawPanel IsVisible="{Binding ShowDrawControls}" />

                            <!-- Schatten und Glühen auch für den Pinsel (wie beim Text-Objekt). -->
                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    IsVisible="{Binding IsBrushPaintMode}">
                                <panels:AnnotationShadowPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    IsVisible="{Binding IsBrushPaintMode}">
                                <panels:AnnotationGlowPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    IsVisible="{Binding ShowLayerToolOptions}">
                                <panels:InsertPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    IsVisible="{Binding ShowSelectionAdjustments}">
                                <panels:SelectionPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    IsVisible="{Binding ShowMaskAdjustments}">
                                <panels:MaskPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    IsVisible="{Binding ShowCropAdjustments}">
                                <panels:CropPanel />
                            </Border>

                            <panels:ResizePanel Margin="0,7,0,0"
                                                IsVisible="{Binding ShowResizeAdjustments}" />

                            <!-- EINE Gruppe für alles, was die Regler in einem Rutsch setzt: die
                                 automatische Bildverbesserung misst DIESES Bild, eine gespeicherte
                                 Anpassung überträgt eine fertige Reglerstellung auf eine ganze
                                 Serie. Beides gehört bewusst in den Anpassen-Bereich und nicht zu
                                 den Filtern - es ist kein Look, sondern die Grundeinstellung.
                                 Die gespeicherten Anpassungen ersetzen das frühere Kopieren und
                                 Einfügen: das hielt genau einen Stand und war beim nächsten
                                 Kopieren weg. -->
                            <Border Classes="adjustment-group" Margin="0,7,0,0">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowLightAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="adjust-presets"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <Expander Header="Anpassungen" icons:ExpanderState.Key="adjust-presets">
                                    <Expander.HeaderTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <icons:SvgIcon
                                                        Source="avares://FerrumPix/Assets/Icons/outline/wand.svg"
                                                        Width="14" Height="14" />
                                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <!-- Zuruecksetzen wie in jeder anderen Gruppe. Es nimmt die
                                                     REGLER zurueck (Anpassen, Farbe, Details, Effekte,
                                                     Kurve, Filter) - also alles, was die automatische
                                                     Bildverbesserung oder eine gespeicherte Anpassung
                                                     setzt. Zuschnitt, Objekte, Masken und gebackene
                                                     Retusche bleiben stehen. -->
                                                <Button Grid.Column="1"
                                                        Classes="icon-btn group-reset"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Command="{Binding DataContext.ResetPixelAdjustmentsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip.Tip="Alle Regler zurücksetzen - nimmt die automatische Bildverbesserung und eine angewendete Anpassung wieder heraus">
                                                    <icons:SvgIcon
                                                        Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise.svg"
                                                        Width="14" Height="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </Expander.HeaderTemplate>
                                    <StackPanel Spacing="6" Margin="0,8,0,0">
                                        <Button Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="8,6"
                                                Classes.active="{Binding IsAutoAdjustApplied}"
                                                Command="{Binding AutoAdjustCommand}"
                                                ToolTip.Tip="Bild messen und die Grundregler automatisch einstellen (der Zurücksetzen-Pfeil oben nimmt es wieder heraus)">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icons:SvgIcon
                                                    Source="avares://FerrumPix/Assets/Icons/outline/wand.svg"
                                                    Width="14" Height="14"
                                                    VerticalAlignment="Center" />
                                                <!-- Umbruch statt Abschneiden: die Beschriftung ist in
                                                     anderen Sprachen deutlich länger (italienisch rund
                                                     ein Drittel), und das Panel ist schmal. -->
                                                <TextBlock Text="Automatische Bildverbesserung"
                                                           FontSize="{DynamicResource FP.Font.Small}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Auswahlliste und Namensfeld untereinander und gleich
                                             breit: sie gehören zusammen (was ist gewählt / wie soll
                                             es heißen). Die Knöpfe stehen darunter in EINER Reihe zu
                                             gleichen Teilen. -->
                                        <ComboBox ItemsSource="{Binding AdjustmentPresetNames}"
                                                  SelectedItem="{Binding SelectedAdjustmentPresetName}"
                                                  PlaceholderText="Keine Anpassung gespeichert"
                                                  MinHeight="32"
                                                  FontSize="{DynamicResource FP.Font.Small}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBox Text="{Binding AdjustmentPresetNameDraft}"
                                                 PlaceholderText="Name"
                                                 MinHeight="32"
                                                 FontSize="{DynamicResource FP.Font.Small}"
                                                 HorizontalAlignment="Stretch" />
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                            <Button Classes="ghost"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="6,5"
                                                    IsEnabled="{Binding CanApplyAdjustmentPreset}"
                                                    Command="{Binding ApplyAdjustmentPresetCommand}"
                                                    ToolTip.Tip="Die gewählte Anpassung auf dieses Bild anwenden">
                                                <TextBlock Text="Anwenden" FontSize="{DynamicResource FP.Font.Small}"
                                                           TextWrapping="Wrap" TextAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="ghost"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="6,5"
                                                    IsEnabled="{Binding CanSaveAdjustmentPreset}"
                                                    Command="{Binding SaveAdjustmentPresetCommand}"
                                                    ToolTip.Tip="Die aktuellen Regler unter diesem Namen merken - ein gleichnamiger Eintrag wird ersetzt">
                                                <TextBlock Text="Speichern" FontSize="{DynamicResource FP.Font.Small}"
                                                           TextWrapping="Wrap" TextAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Classes="ghost"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="6,5"
                                                    IsEnabled="{Binding CanApplyAdjustmentPreset}"
                                                    Command="{Binding DeleteAdjustmentPresetCommand}">
                                                <TextBlock Text="Löschen" FontSize="{DynamicResource FP.Font.Small}"
                                                           TextWrapping="Wrap" TextAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowLightAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="light"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:LightPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowColorAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="color"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:ColorPanel />
                            </Border>

                            <!-- DETAILS + KÖRNUNG (je eigene Karte im Panel, wie ResizePanel) -->
                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowDetailAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="details"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:DetailsPanel />
                            </Border>

                            <!-- RAUSCHEN direkt unter den Details: alles zum Rauschen an einem Ort. -->
                            <panels:NoisePanel Margin="0,7,0,0"
                                               IsVisible="{Binding ShowDetailAdjustments}" />

                            <!-- SCHÄRFE -->
                            <panels:SharpnessPanel Margin="0,7,0,0"
                                                   IsVisible="{Binding ShowDetailAdjustments}" />

                            <!-- Die Tiefen-Unschaerfe steht am Ende der Details: sie wird gebacken,
                                 alles davor bleibt ein Rezeptwert - was man wieder loswird, gehoert
                                 vor das, was bleibt. -->
                            <panels:BokehPanel Margin="0,7,0,0"
                                               IsVisible="{Binding ShowDetailAdjustments}" />

                            <!-- EFFEKTE: eigenes Werkzeug. Was hier steht, fuegt dem Bild etwas hinzu,
                                 was vorher nicht da war - die Details darueber holen nur heraus, was
                                 in der Aufnahme steckt. -->
                            <!-- VIGNETTE + KÖRNUNG (je eigene Karte im Panel) -->
                            <panels:EffectsPanel Margin="0,7,0,0"
                                                 IsVisible="{Binding ShowEffectsAdjustments}" />

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowEffectsAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="frame"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:FramePanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowFilterAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="filter"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:FilterPanel />
                            </Border>

                            <!-- TONWERTKURVE (ausklappbar) -->
                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowFilterAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="xmp-preset"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:XmpPresetPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowFilterAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="lut"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:LutPresetPanel />
                            </Border>

                            <!-- TONWERTKURVE (ausklappbar) -->
                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowLightAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="curve"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:CurvePanel />
                            </Border>

                            <!-- OBJEKTIVKORREKTUR (ausklappbar) - gehört unter die Kurve: sie sitzt
                                 im Decode, also VOR allem, was die Regler darüber tun. -->
                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowLightAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="objektivkorrektur"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:LensCorrectionPanel />
                            </Border>

                            <!-- FILMNEGATIV (ausklappbar) - gehört zu "Anpassen": die Umkehr ist eine
                                 Dichteoperation, auf der Belichtung und Kurve erst aufsetzen. -->
                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowLightAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="film-negative"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:FilmNegativePanel />
                            </Border>

                            <!-- COLOR GRADING (ausklappbar) -->
                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowColorAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="hsl"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:HslPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowColorAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="color-grading"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:ColorGradingPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    >
                                <Border.IsVisible>
                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                        <Binding Path="ShowColorAdjustments"/>
                                        <Binding Path="HiddenAdjustmentGroups" Converter="{StaticResource NotInListConverter}" ConverterParameter="calibration"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <panels:CalibrationPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    IsVisible="{Binding ShowAnnotationProperties}">
                                <panels:AnnotationPropertiesPanel />
                            </Border>

                            <!-- Schatten und Glühen sind objekt-eigen: bei einer Mehrfachauswahl
                                 beschrieben sie nur den Anker und bleiben deshalb weg. -->
                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    IsVisible="{Binding ShowSingleAnnotationEffects}">
                                <panels:AnnotationShadowPanel />
                            </Border>

                            <Border Classes="adjustment-group" Margin="0,7,0,0"
                                    IsVisible="{Binding ShowSingleAnnotationEffects}">
                                <panels:AnnotationGlowPanel />
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <views:InfoSidebarView Grid.Row="1" Grid.Column="3" Width="320" />

        <views:LayersPanelView Grid.Row="1" Grid.Column="4" Width="300" />

        <!-- Leerzustand: der Editor hält gar kein Dokument (Start ohne Bilddatei, oder der
             Neu-Dialog wurde abgebrochen). Deckt die ganze Arbeitszeile ab - Werkzeuge und Panels
             darunter wären ohne Dokument nur verwirrend. Steht NACH ihnen im Baum, liegt also
             darüber. -->
        <Border Grid.Row="1" Grid.ColumnSpan="5"
                Background="{DynamicResource FP.Bg.Root}"
                IsVisible="{Binding ShowEditorEmptyState}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/photo.svg"
                               Width="56" Height="56"
                               HorizontalAlignment="Center"
                               IconBrush="{DynamicResource FP.Text.Secondary}" />
                <TextBlock Text="Kein Bild geöffnet"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource FP.Font.Subtitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="Lege ein leeres Bild an oder öffne eine vorhandene Datei."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FP.Text.Secondary}"
                           FontSize="{DynamicResource FP.Font.Body}" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Classes="accent" Padding="16,8"
                            Command="{Binding ShowNewDocumentDialogCommand}">Neues Bild</Button>
                    <Button Classes="ghost" Padding="16,8"
                            Click="OnPlaceholderOpenImageClick">Bild öffnen</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Liegt über dem Platzhalter: beim Start ohne Bilddatei erscheinen beide, der Dialog vorn. -->
        <views:NewDocumentDialogOverlayView Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="5" ZIndex="200" />

        <!-- Auch der Fuss mit Filmstreifen und Menue: waehrend eines Modelllaufs zum naechsten Bild
             zu blaettern hiesse, dass der Commit auf ein Bild trifft, das gar nicht mehr offen ist.
             Der Commit selbst faengt das ab (er verfaellt), aber der Nutzer stuende dann vor einem
             Ergebnis, das er nirgends sieht. -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="5"
                Classes="window-drag"
                Background="{DynamicResource FP.Bg.Dark}"
                BorderBrush="{DynamicResource FP.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="24,8,24,8"
                IsEnabled="{Binding IsInteractionAllowed}">
            <!-- Dasselbe Menue wie hinter der Schaltflaeche, hier als Rechtsklick auf die
                 Fussleiste. Bewusst NICHT auf der Bildflaeche: dort ist die rechte Taste
                 bereits belegt (im Editor hebt sie die Auswahl auf, im Betrachter zoomt sie). -->
            <Grid RowDefinitions="Auto,28">
                <ListBox Name="FilmstripListBox"
                         Classes="filmstrip-list"
                         Height="110"
                         IsVisible="{Binding ShowFilmstrip}"
                         ItemsSource="{Binding FilmstripItems}"
                         SelectedIndex="{Binding CurrentFilmstripIndex, Mode=OneWay}"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" Margin="0,0,0,8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ImageItem}">
                            <Border Width="148" Height="100"
                                    Classes="thumb-card"
                                    Classes.selected="{Binding IsSelected}"
                                    ClipToBounds="True"
                                    PointerPressed="OnFilmstripItemPressed">
                                <Border CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="LowQuality" />
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <!-- Fussmenue wie in Galerie und Betrachter, hier bewusst KURZ: die
                             Stapelfunktionen der Galerie arbeiten auf der Datei, waehrend im Editor
                             ungespeicherte Aenderungen offen sein koennen. Was bleibt, ist das, was
                             sich auf das gerade bearbeitete Bild bezieht. -->
                        <Button Classes="icon-btn" Width="34" Height="34"
                                Margin="-14,0,0,0"
                                ToolTip.Tip="Menü für dieses Bild"
                                Click="OnFooterMenuButtonClick">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/menu-2.svg"
                                           Width="20" Height="20"/>
                        </Button>
                        <!-- Sitzt in der Fusszeile statt in der Leiste selbst: so bleibt der Knopf
                             auch bei eingeklappter Leiste an derselben Stelle erreichbar. -->
                        <Button Classes="icon-btn" Width="34" Height="34"
                                Margin="-8,0,0,0"
                                Command="{Binding ToggleToolSidebarCommand}"
                                ToolTip.Tip="Werkzeugleiste ein- oder ausklappen">
                            <Panel>
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/layout-sidebar-left-collapse.svg"
                                               Width="18" Height="18" IsVisible="{Binding AreToolSidebarLabelsVisible}" />
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/layout-sidebar-left-expand.svg"
                                               Width="18" Height="18" IsVisible="{Binding IsToolSidebarCollapsed}" />
                            </Panel>
                        </Button>
                        <!-- Dateiname und Farbetikett stehen jetzt als Fenstertitel oben in der Mitte. -->
                        <!-- KEIN StatusText hier: die Fußzeile ist die linke Spalte eines *,Auto,*-Rasters
                             und wächst mit dem Text, bis sie die mittig zentrierten Zoom-Bedienelemente
                             überdeckt („Gespeichert als <langer Dateiname>"). Der Status steht ohnehin
                             oben in der Werkzeugleiste. -->
                        <!-- Bildgröße wie im Betrachter; ein "Bild x von y" wäre hier belanglos,
                             bearbeitet wird immer genau eines. Der Wert folgt Zuschnitt, Bildgröße
                             und Leinwand - es ist die Größe, die ein Export ergäbe. -->
                        <TextBlock Text="{Binding OutputSizeText}" Foreground="{DynamicResource FP.Text.Secondary}"
                                   FontSize="{DynamicResource FP.Font.Body}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="ghost" Height="20" Padding="4,0,4,2" VerticalContentAlignment="Center"
                                Focusable="False"
                                Click="OnZoomOutClick" ToolTip.Tip="Verkleinern">
                            <TextBlock Text="−" FontSize="{DynamicResource FP.Glyph.Large}" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center" />
                        </Button>
                        <icons:RoundSlider Name="EditorZoomSlider" Width="110" Height="26" MinHeight="0" Minimum="0" Maximum="100"
                                           VerticalAlignment="Center" />
                        <Button Classes="ghost" Height="20" Padding="4,0,4,2" VerticalContentAlignment="Center"
                                Focusable="False"
                                Click="OnZoomInClick" ToolTip.Tip="Vergrößern">
                            <TextBlock Text="+" FontSize="{DynamicResource FP.Glyph.Large}" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="ghost" Height="26" Padding="8,2" Margin="12,0,0,0" Focusable="False"
                                Classes.active="{Binding IsZoomActualActive}"
                                Click="OnZoomActualClick" ToolTip.Tip="Auf 100 Prozent springen">
                            <TextBlock Name="ZoomPercentText" Text="100%" Foreground="{DynamicResource FP.Text.Primary}"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="ghost" Height="26" Padding="8,2" Margin="8,0,0,0" Focusable="False"
                                Classes.active="{Binding IsZoomFitActive}"
                                Click="OnZoomFitClick"
                                ToolTip.Tip="Bild vollständig in die Vorschau einpassen">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/aspect-ratio.svg"
                                               Width="20" Height="20" />
                                <TextBlock Text="Einpassen" VerticalAlignment="Center" IsVisible="{Binding AreToolbarLabelsVisible}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                            <!-- Ein Platz für zwei Angaben: über dem Bild die Mausposition, sonst der
                                 Status. Rechtsbündig, damit die Zahlen beim Fahren über das Bild nicht
                                 unter den Sternen hin- und herspringen. -->
                            <TextBlock Text="{Binding FooterStatusText}"
                                       Classes="status-text"
                                       Classes.failed="{Binding IsFooterStatusFailed}"
                                       IsVisible="{Binding FooterStatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="{DynamicResource FP.Font.Body}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       MaxWidth="320"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,20,0" />
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center" 
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=1}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="1">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=2}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="2">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=3}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="3">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=4}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="4">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=5}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="5">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="icon-btn"
                                    Width="24" Height="24" VerticalAlignment="Center"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    ToolTip.Tip="Favorit" Margin="6,0,0,0">
                                <Grid Width="20" Height="20">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                   Width="20" Height="20"
                                                   Classes="fav-heart"
                                                   IsVisible="{Binding !IsFavorite}" />
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                   Width="20" Height="20"
                                                   Classes="fav-heart active"
                                                   IsVisible="{Binding IsFavorite}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Schnellvorschau-Overlay (Mausrad-Klick auf Filmstrip) -->
        <Panel Name="FilmstripPreviewOverlay"
               Grid.RowSpan="3" Grid.ColumnSpan="4"
               IsVisible="False"
               Background="#D9000000"
               ZIndex="100">
            <Image Name="FilmstripPreviewImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="60" />
        </Panel>

    </Grid>
</UserControl>
