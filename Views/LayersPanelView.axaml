<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Views.LayersPanelView">

    <!-- Eigenständiges, ein-/ausschaltbares Ebenen-Panel im Standard-Layout üblicher Bildbearbeitungen:
         oben eine Deckkraft-/Mischmodus-Leiste, darunter der Ebenenstapel (Vorschau links, Name, Auge rechts,
         ausgewählte Zeile voll in Akzentfarbe), die feste Hintergrund-Ebene mit Schloss und unten eine
         Icon-Werkzeugleiste. Bindet ans EditorViewModel; alle Aktionen nutzen bestehende Kommandos. -->
    <Border x:Name="LayersPanelBorder" Classes="panel-right" Padding="0"
            IsVisible="{Binding IsLayersPanelVisible}">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

            <!-- Kopfleiste: Deckkraft (Slider) über dem Mischmodus der markierten Ebene. -->
            <Border Grid.Row="0" Padding="10,10,10,8"
                    BorderBrush="{DynamicResource FP.Border.Subtle}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="8" IsEnabled="{Binding HasSelectedPanelLayer}">
                    <Grid ColumnDefinitions="70,*,44" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Deckkraft"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <icons:RoundSlider Grid.Column="1" Minimum="0" Maximum="100"
                                           DefaultValue="100"
                                           Value="{Binding SelectedLayerOpacity}" Margin="0,0" />
                        <icons:SliderValueUpDown Grid.Column="2" Classes="slider-value"
                                                 Value="{Binding SelectedLayerOpacity, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Increment="1" FormatString="F0" />
                    </Grid>
                    <Grid ColumnDefinitions="70,*" VerticalAlignment="Center"
                          IsEnabled="{Binding HasSelectedAnnotation}">
                        <TextBlock Grid.Column="0" Text="Mischen"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Small}" />
                        <ComboBox Grid.Column="1" Margin="6,0,0,0"
                                  ItemsSource="{Binding AnnotationBlendModeOptions}"
                                  SelectedItem="{Binding SelectedAnnotationBlendModeOption, Mode=TwoWay}"
                                  FontSize="{DynamicResource FP.Font.Small}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ebenenstapel: oberster Eintrag = vorderste Ebene, Hintergrund liegt fest darunter. -->
            <Grid Grid.Row="1" x:Name="LayerListArea">
            <ListBox x:Name="LayerListBox"
                     Classes="layers-panel-list"
                     ItemsSource="{Binding LayerRows}"
                     SelectedItem="{Binding SelectedLayerRow, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     VerticalAlignment="Stretch"
                     KeyDown="OnLayerListKeyDown"
                     ContextRequested="OnLayerRowContextRequested"
                     DragDrop.AllowDrop="True"
                     DragDrop.DragOver="OnLayerListDragOver"
                     DragDrop.DragLeave="OnLayerListDragLeave"
                     DragDrop.Drop="OnLayerListDrop"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="layers-panel-row" Padding="8,5" MinHeight="46"
                                Classes.multi-selected="{Binding IsInMultiSelection}"
                                DragDrop.AllowDrop="True"
                                PointerPressed="OnLayerRowPointerPressed"
                                PointerMoved="OnLayerRowPointerMoved"
                                DragDrop.DragOver="OnLayerRowDragOver"
                                DragDrop.Drop="OnLayerRowDrop">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="{Binding IndentMargin}">
                                <!-- Klapp-Pfeil nur bei einer Gruppen-Kopfzeile; sonst hält die Spalte
                                     nur die Breite, damit Symbole und Namen aller Zeilen fluchten. -->
                                <Button Grid.Column="0" Classes="ghost"
                                        Width="16" Height="30" Padding="0" MinWidth="16"
                                        Background="Transparent" BorderThickness="0"
                                        IsVisible="{Binding IsGroupHeader}"
                                        Command="{Binding DataContext.ToggleAnnotationGroupCollapsedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Gruppe auf- oder zuklappen">
                                    <icons:SvgIcon Source="{Binding GroupToggleIconSource}"
                                                   Width="12" Height="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <!-- Miniatur der Ebene, sonst das Typsymbol. Die Miniatur sagt, WAS
                                     auf der Ebene liegt; bei mehreren gleichartigen Ebenen sagte das
                                     Symbol allein gar nichts. Sie kommt fertig aus dem ViewModel -
                                     die Zeile rendert nichts selbst. -->
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="3"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource FP.Border.Normal}"
                                        Background="{DynamicResource FP.Bg.Root}"
                                        ClipToBounds="True">
                                    <Panel>
                                        <!-- Die Miniatur FUELLT den Kasten (Uniform, ohne
                                             Zentrierung): mit HorizontalAlignment="Center" nimmt ein
                                             Bild in Avalonia nur seine eigene Punktgroesse ein, und
                                             Uniform skaliert dann innerhalb dieser Groesse, also gar
                                             nicht. Der Kasten wuchs, das Bild darin blieb gleich. -->
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform" Margin="2"
                                               IsVisible="{Binding HasThumbnail}" />
                                        <icons:SvgIcon Source="{Binding IconSource}"
                                                       Width="18" Height="18"
                                                       IsVisible="{Binding !HasThumbnail}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                </Border>
                                <!-- Name: Doppelklick auf die Beschriftung öffnet das Eingabefeld (Enter oder
                                     Verlassen übernimmt, Esc verwirft). Beides teilt sich die Zelle. -->
                                <Panel Grid.Column="2" Margin="9,0,6,0">
                                    <TextBlock Classes="layer-name"
                                               Text="{Binding LayerLabel}"
                                               FontSize="{DynamicResource FP.Font.Small}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsRenaming}"
                                               ToolTip.Tip="Doppelklick zum Umbenennen"
                                               DoubleTapped="OnLayerNameDoubleTapped" />
                                    <TextBox Text="{Binding EditableName, Mode=TwoWay}"
                                             FontSize="{DynamicResource FP.Font.Small}"
                                             Padding="7,4"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             IsVisible="{Binding IsRenaming}"
                                             KeyDown="OnLayerRenameKeyDown"
                                             LostFocus="OnLayerRenameLostFocus" />
                                </Panel>
                                <!-- Merkzeichen der Ebene: Maske und Beschränkung. Beide nur, wenn sie
                                     gelten - sonst stünden zwei blasse Symbole in jeder Zeile. -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <!-- Das Maskensymbol ist ANKLICKBAR: es fuehrt in den
                                         Bearbeitungsmodus der Maske. Wer es sieht, will an die
                                         Maske heran - ein reines Merkzeichen liesse ihn den Weg
                                         ueber das Kontextmenue suchen. -->
                                    <Button Classes="ghost" Padding="1" MinWidth="0"
                                            Background="Transparent" BorderThickness="0"
                                            IsVisible="{Binding HasMask}"
                                            Click="OnLayerMaskIconClick"
                                            ToolTip.Tip="Ebenenmaske bearbeiten">
                                        <Panel>
                                            <!-- Die Maskenminiatur IST der Knopf: hell, wo die Maske
                                                 deckt. Ohne sie war nicht zu sehen, welche Maske wo
                                                 liegt. Fehlt sie (noch nicht gezeichnet), bleibt das
                                                 Symbol stehen. -->
                                            <Border Width="26" Height="26" CornerRadius="2"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource FP.Border.Normal}"
                                                    ClipToBounds="True"
                                                    IsVisible="{Binding HasMaskThumbnail}">
                                                <Image Source="{Binding MaskThumbnail}" Stretch="Uniform" />
                                            </Border>
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/mask.svg"
                                                           Width="13" Height="13" Opacity="0.65"
                                                           IsVisible="{Binding !HasMaskThumbnail}" />
                                        </Panel>
                                    </Button>
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/layers-intersect.svg"
                                                   Width="13" Height="13" Opacity="0.65"
                                                   IsVisible="{Binding IsClipped}"
                                                   ToolTip.Tip="Auf die Ebene darunter beschränkt" />
                                </StackPanel>
                                <!-- Schloss NUR bei gesperrten Zeilen: ein Dauergast neben dem Auge
                                     würde die Zeile zustellen. Klick entsperrt wieder. -->
                                <Button Grid.Column="4" Classes="ghost"
                                        Width="24" Height="24" Padding="0" MinWidth="24"
                                        Background="Transparent" BorderThickness="0"
                                        IsVisible="{Binding IsLocked}"
                                        Click="OnToggleRowLockClick"
                                        ToolTip.Tip="Ebene ist gesperrt - klicken zum Entsperren">
                                    <icons:SvgIcon Source="{Binding LockIconSource}" Width="14" Height="14" />
                                </Button>
                                <ToggleButton Grid.Column="5"
                                              Classes="ghost layer-eye"
                                              Width="24" Height="24" Padding="0"
                                              IsChecked="{Binding IsVisible, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleAnnotationVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="Ebene ein-/ausblenden">
                                    <icons:SvgIcon
                                        Source="avares://FerrumPix/Assets/Icons/outline/eye.svg"
                                        Width="15" Height="15" />
                                </ToggleButton>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Einfüge-Hilfslinie beim Ziehen: markiert die Position zwischen zwei Ebenen. Sie liegt über
                 der Liste, wird per Code-Behind an die Lücke geschoben und fängt keine Zeigereignisse ab. -->
            <Border x:Name="DropIndicator" Height="2" Margin="0"
                    Background="{DynamicResource FP.Accent}"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    IsVisible="False" IsHitTestVisible="False" />
            </Grid>

            <!-- Globale Einstellungsebene: alle nicht maskierten Regler aus Anpassen, Farbe, Details,
                 Effekte und Filter. Fest über dem Arbeitsbild, weil genau dort die Renderpipeline sie
                 anwendet; lokale maskierte Korrekturen stehen als freie Zeilen darüber. -->
            <Border Grid.Row="2" Padding="8,5" MinHeight="46"
                    Classes="global-adjustments-row"
                    Classes.active="{Binding IsGlobalAdjustmentsSelected}"
                    PointerPressed="OnGlobalAdjustmentsPointerPressed"
                    BorderBrush="{DynamicResource FP.Border.Subtle}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource FP.Bg.Dark}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource FP.Border.Normal}"
                            Background="{DynamicResource FP.Bg.Input}">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/adjustments.svg"
                                       Width="16" Height="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="layer-name" Text="Bildanpassungen"
                               FontSize="{DynamicResource FP.Font.Small}"
                               Margin="9,0,6,0" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <icons:SvgIcon Grid.Column="2"
                                   Source="avares://FerrumPix/Assets/Icons/outline/lock.svg"
                                   Width="13" Height="13" Margin="0,0,8,0"
                                   IconBrush="{DynamicResource FP.Text.Muted}"
                                   VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="3"
                                  Classes="ghost layer-eye"
                                  Width="24" Height="24" Padding="0"
                                  IsChecked="{Binding IsGlobalAdjustmentsVisible, Mode=OneWay}"
                                  Command="{Binding ToggleGlobalAdjustmentsVisibilityCommand}"
                                  ToolTip.Tip="Anpassen, Farbe, Details, Effekte und Filter ein-/ausblenden">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/eye.svg"
                            Width="15" Height="15" />
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- Pixel-Ebene: Retusche, Pinsel-/Radiererstriche und gerasterte Ebenen liegen alle in EINEM
                 Arbeitsbild (siehe WorkingImageService) und lassen sich deshalb nur gemeinsam ausblenden.
                 Solange sie aus ist, sind die Mal- und Retuschewerkzeuge gesperrt (CanUsePixelTools). -->
            <Border Grid.Row="3" Padding="8,5" MinHeight="46"
                    PointerPressed="OnFixedLayerPointerPressed"
                    BorderBrush="{DynamicResource FP.Border.Subtle}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource FP.Bg.Dark}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource FP.Border.Normal}"
                            Background="{DynamicResource FP.Bg.Input}">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/brush.svg"
                                       Width="16" Height="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Retusche und Pinsel"
                               FontSize="{DynamicResource FP.Font.Small}"
                               Margin="9,0,6,0" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <icons:SvgIcon Grid.Column="2"
                                   Source="avares://FerrumPix/Assets/Icons/outline/lock.svg"
                                   Width="13" Height="13" Margin="0,0,8,0"
                                   IconBrush="{DynamicResource FP.Text.Muted}"
                                   VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="3"
                                  Classes="ghost layer-eye"
                                  Width="24" Height="24" Padding="0"
                                  IsChecked="{Binding IsPixelLayerVisible, Mode=OneWay}"
                                  Command="{Binding TogglePixelLayerVisibilityCommand}"
                                  ToolTip.Tip="Retusche und Pinsel ein-/ausblenden (ausgeblendet sperrt die Malwerkzeuge)">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/eye.svg"
                            Width="15" Height="15" />
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- Hintergrund-Ebene: das Basisbild, fest am Boden, gesperrt (nicht umsortier-/löschbar). Nur das
                 Auge blendet es aus (transparenter Grund, siehe ImageProcessor.ApplyAnnotations). -->
            <Border Grid.Row="4" Padding="8,5" MinHeight="46"
                    PointerPressed="OnFixedLayerPointerPressed"
                    BorderBrush="{DynamicResource FP.Border.Subtle}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource FP.Bg.Dark}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource FP.Border.Normal}"
                            Background="{DynamicResource FP.Bg.Input}">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/photo.svg"
                                       Width="16" Height="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Hintergrund"
                               FontSize="{DynamicResource FP.Font.Small}"
                               Margin="9,0,6,0" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <icons:SvgIcon Grid.Column="2"
                                   Source="avares://FerrumPix/Assets/Icons/outline/lock.svg"
                                   Width="13" Height="13" Margin="0,0,8,0"
                                   IconBrush="{DynamicResource FP.Text.Muted}"
                                   VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="3"
                                  Classes="ghost layer-eye"
                                  Width="24" Height="24" Padding="0"
                                  IsChecked="{Binding IsBackgroundVisible, Mode=OneWay}"
                                  Command="{Binding ToggleBackgroundVisibilityCommand}"
                                  ToolTip.Tip="Hintergrund ein-/ausblenden">
                        <icons:SvgIcon
                            Source="avares://FerrumPix/Assets/Icons/outline/eye.svg"
                            Width="15" Height="15" />
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- Untere Werkzeugleiste: Aktionen auf der markierten Ebene (wie die Icon-Reihe unten in
                 üblichen Ebenen-Panels). Nur die tatsächlich unterstützten Aktionen, keine Attrappen. -->
            <Border Grid.Row="5" Padding="8,6"
                    BorderBrush="{DynamicResource FP.Border.Subtle}" BorderThickness="0,1,0,0">
                <!-- WAS GERADE MARKIERT IST, entscheidet, welche Knoepfe ueberhaupt dastehen -
                     dieselbe Regel wie im Kontextmenue, und aus derselben Quelle im ViewModel.
                     "Nach vorne", "nach hinten", "duplizieren" und "umbenennen" wirken auf die
                     ANKERebene; bei mehreren markierten Ebenen oder einer markierten Gruppe meinen
                     sie also nicht das, was man sieht, und bleiben weg. Was fuer mehrere gilt
                     (gruppieren, zusammenlegen, sperren, loeschen), steht dann an ihrer Stelle. -->
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding MoveSelectedAnnotationUpCommand}"
                            IsVisible="{Binding IsSingleLayerSelection}"
                            ToolTip.Tip="Ebene nach vorne">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-up.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding MoveSelectedAnnotationDownCommand}"
                            IsVisible="{Binding IsSingleLayerSelection}"
                            ToolTip.Tip="Ebene nach hinten">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-down.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding DuplicateSelectedAnnotationCommand}"
                            IsVisible="{Binding IsSingleLayerSelection}"
                            ToolTip.Tip="Ebene duplizieren (Strg+D)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/copy.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <!-- Mehrere: dasselbe Bild, aber der Befehl fuer die ganze Auswahl. -->
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding DuplicateSelectedAnnotationsCommand}"
                            IsVisible="{Binding IsMultiLayerSelection}"
                            ToolTip.Tip="Markierte Ebenen duplizieren">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/copy.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <!-- Zusammenlegen gibt es nur fuer mehrere - im Kontextmenue stand es laengst,
                         in der Fusszeile fehlte es. -->
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding MergeSelectedAnnotationsCommand}"
                            IsVisible="{Binding CanMergeSelectedAnnotations}"
                            ToolTip.Tip="Ebenen zusammenlegen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/layers-subtract.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding AddAdjustmentWithSameMaskCommand}"
                            IsVisible="{Binding HasSelectedAdjustmentLayer}"
                            IsEnabled="{Binding HasSelectedAdjustmentLayer}"
                            ToolTip.Tip="Neue Korrektur mit kopierter Maske">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/adjustments-plus.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <!-- Ebenenmaske: EIN Knopf, der zwei Dinge tut, je nachdem was die Ebene schon
                         hat - anlegen oder bearbeiten. Zwei Knöpfe nebeneinander, von denen immer
                         einer grau ist, sagen dasselbe und kosten Platz. -->
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Click="OnAnnotationMaskFooterClick"
                            IsVisible="{Binding CanUseAnnotationMaskButton}"
                            ToolTip.Tip="{Binding AnnotationMaskButtonHint}">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/mask.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <!-- Gruppieren/Gruppierung aufheben: der sichtbare Weg zu Gruppen (das Kürzel
                         Strg+G kennt niemand, der es nicht gelesen hat). Aktiv, sobald mehrere Ebenen
                         derselben Art markiert sind bzw. eine markierte Ebene in einer Gruppe liegt. -->
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding GroupSelectedAnnotationsCommand}"
                            IsVisible="{Binding CanGroupSelectedAnnotations}"
                            ToolTip.Tip="Markierte Ebenen gruppieren (Strg+G)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/folder.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <!-- Nur sichtbar, wenn die Auswahl WIRKLICH in einer Gruppe liegt - sonst steht
                         ein Knopf da, der nichts zu tun hat. -->
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding UngroupSelectedAnnotationsCommand}"
                            IsVisible="{Binding CanUngroupSelectedAnnotations}"
                            ToolTip.Tip="Gruppierung aufheben (Strg+Umschalt+G)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/folder-x.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <!-- Sperren gilt fuer ALLES Markierte - eine Ebene, mehrere, eine ganze Gruppe.
                         Der Knopf bleibt deshalb in jeder Auswahl stehen. -->
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Click="OnToggleSelectionLockClick"
                            IsVisible="{Binding HasSelectedPanelLayer}"
                            ToolTip.Tip="Ebene sperren/entsperren - gesperrt sind keine Verschiebungen, Größenänderungen oder Drehungen mehr möglich">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/lock.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding RasterizeSelectedAnnotationCommand}"
                            IsVisible="{Binding CanRasterizeSelectedAnnotation}"
                            ToolTip.Tip="Ebene rastern">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/layers-union.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <!-- Umbenennen gilt fuer die angeklickte ZEILE: eine einzelne Ebene oder eine
                         Gruppe ueber ihre Kopfzeile. Bei mehreren markierten Ebenen waere unklar,
                         welche gemeint ist. -->
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Click="OnRenameSelectedClick"
                            IsVisible="{Binding CanRenameSelectedLayer}"
                            ToolTip.Tip="Ebene umbenennen (F2)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/edit.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding DeleteSelectedAnnotationCommand}"
                            IsVisible="{Binding IsSingleLayerSelection}"
                            ToolTip.Tip="Ebene löschen (Entf)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/trash.svg"
                                       Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon-btn" Width="30" Height="30" Padding="0"
                            Command="{Binding DeleteSelectedAnnotationsCommand}"
                            IsVisible="{Binding IsMultiLayerSelection}"
                            ToolTip.Tip="Markierte Ebenen löschen (Entf)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/trash.svg"
                                       Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
