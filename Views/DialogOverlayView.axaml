<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:views="clr-namespace:FerrumPix.Views"
             x:Class="FerrumPix.Views.DialogOverlayView">

    <Border Background="#B8000000"
            IsVisible="{Binding IsDialogOpen}"
            ZIndex="500">
        <Border Width="{Binding DialogWidth}"
                MaxWidth="{Binding DialogWidth}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource FP.Bg.Panel}"
                BorderBrush="{DynamicResource FP.Border.Strong}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="22">
            <Grid RowDefinitions="*,Auto" Grid.IsSharedSizeScope="True">
                <!-- Der Rumpf scrollt, der Knopfbalken bleibt stehen: mit mehreren
                     aufgeklappten Sektionen (Export-Dialog) wuchs die Karte sonst ueber den
                     Bildschirm hinaus und "Anwenden" war nicht mehr erreichbar. -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Text="{Binding DialogTitle}"
                                   FontSize="{DynamicResource FP.Font.Heading}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding DialogMessage}"
                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   LineHeight="18"/>

                        <views:FileConflictDialogView Grid.Row="2"
                                                      Margin="0,18,0,0"
                                                      IsVisible="{Binding DialogShowsFileConflict}"/>

                        <!-- Einfache Texteingabe -->
                        <TextBox x:Name="DialogInputBox"
                                 Grid.Row="2"
                                 Text="{Binding DialogInputText, Mode=TwoWay}"
                                 IsVisible="{Binding DialogShowsInput}"
                                 Margin="0,18,0,0"
                                 MinHeight="36"/>

                        <views:SearchDialogView Grid.Row="3"
                                                Margin="0,16,0,0"
                                                IsVisible="{Binding DialogShowsSearch}"/>

                        <views:BatchResizeDialogView x:Name="BatchResizeDialog"
                                                     Grid.Row="3"
                                                     Margin="0,16,0,0"
                                                     IsVisible="{Binding DialogShowsBatchResize}"/>

                        <StackPanel Grid.Row="3"
                                    Margin="0,16,0,0"
                                    Spacing="8"
                                    IsVisible="{Binding DialogShowsWatermarkPreset}">
                            <views:WatermarkFormView />
                            <TextBlock Text="{Binding DialogBatchOverwriteUnavailableHint}"
                                       IsVisible="{Binding !IsDialogBatchOverwriteAvailable}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Small}"
                                       TextWrapping="Wrap"/>
                            <CheckBox Content="Originale überschreiben"
                                      IsVisible="{Binding IsDialogBatchOverwriteAvailable}"
                                      IsChecked="{Binding DialogBatchWatermarkOverwrite, Mode=TwoWay}"
                                      ToolTip.Tip="Schreibt das Wasserzeichen direkt in die Bilddateien. Ohne Haken entstehen neue Dateien und die Originale bleiben unangetastet."/>
                        </StackPanel>

                        <views:BatchFilterDialogView Grid.Row="3"
                                                     Margin="0,16,0,0"
                                                     IsVisible="{Binding DialogShowsBatchFilter}"/>

                        <views:ExportToDialogView Grid.Row="3"
                                                  Margin="0,16,0,0"
                                                  IsVisible="{Binding DialogShowsExportTo}"/>

                        <!-- Speichern unter. Eigene Zeile, weil der Stapel-Filter diesen Block ZUSAMMEN mit
                             seiner eigenen Auswahl (Zeile 3) zeigt - alle anderen Dialoge belegen nur eine der
                             beiden Zeilen, und leere Auto-Zeilen fallen auf null Höhe zusammen. -->
                        <StackPanel Grid.Row="4"
                                    Spacing="14"
                                    Margin="0,14,0,0"
                                    IsVisible="{Binding DialogShowsSaveAsOptions}">
                            <!-- Die Labelspalte teilt ihre Breite mit den dialogeigenen Sektionen
                                 (SharedSizeGroup): Eingabefelder beider Bereiche beginnen auf derselben
                                 Linie, egal welches Label das längste ist. -->
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="14"
                                  RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DialogLabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Format"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                                <Button Grid.Column="1"
                                        x:Name="DialogFormatDropDownButton"
                                        Classes="dropdown-btn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Flyout>
                                        <Flyout Opened="OnLocalizedFlyoutOpened" Placement="BottomEdgeAlignedLeft" VerticalOffset="2">
                                            <ItemsControl ItemsSource="{Binding DialogFormatOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="dropdown-item"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Click="OnDialogFormatOptionClick">
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding DialogSelectedFormat}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <icons:SvgIcon Grid.Column="1"
                                                       Source="avares://FerrumPix/Assets/Icons/outline/chevron-down.svg"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <TextBlock Grid.Row="1"
                                           Text="JPG-Qualität"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           IsVisible="{Binding IsDialogJpgQualityVisible}"/>
                                <Grid Grid.Row="1"
                                      Grid.Column="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12"
                                      IsVisible="{Binding IsDialogJpgQualityVisible}">
                                    <!-- Keine feste Breite: in der breiten Spalte sass der Regler
                                         sonst mittig, mit einer Luecke links vom Beschriftungsrand.
                                         Format-Auswahl und Zielordner darueber fuellen die Zeile
                                         ebenfalls ganz aus. -->
                                    <icons:RoundSlider Minimum="1"
                                                       Maximum="100"
                                                       Value="{Binding DialogJpgQuality, Mode=TwoWay}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Stretch"
                                                       Height="28"
                                                       MinHeight="0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DialogJpgQuality, StringFormat={}{0}%}"
                                               MinWidth="42"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource FP.Text.Secondary}"/>
                                </Grid>

                                <!-- Ziel in EINER Zeile. Frueher stand hier nur "Ordner / Immich",
                                     und WELCHER Ordner stand eine Zeile tiefer im Textfeld - die beiden
                                     naheliegenden Ordner waren damit nirgends anklickbar. -->
                                <TextBlock Grid.Row="2" Text="Ziel"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSaveAsTargetRowVisible}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding IsSaveAsTargetRowVisible}">
                                    <!-- Immer sichtbar, ohne Ordner nur ausgegraut: Knoepfe, die je
                                         nach Aufrufweg auftauchen und verschwinden, machen die Zeile
                                         unlesbar (Nutzerwunsch). -->
                                    <Button Classes="segmented"
                                            Classes.active="{Binding IsDialogFolderChoiceCurrentActive}"
                                            IsEnabled="{Binding IsDialogFolderChoiceCurrentEnabled}"
                                            Click="OnDialogSaveTargetClick"
                                            ToolTip.Tip="{Binding DialogFolderChoiceCurrent}"
                                            Tag="Current">Aktueller Ordner</Button>
                                    <Button Classes="segmented"
                                            Classes.active="{Binding IsDialogFolderChoiceLastSavedActive}"
                                            IsEnabled="{Binding IsDialogFolderChoiceLastSavedEnabled}"
                                            Click="OnDialogSaveTargetClick"
                                            ToolTip.Tip="{Binding DialogFolderChoiceLastSaved}"
                                            Tag="LastSaved">Letzter Ordner</Button>
                                    <Button Classes="segmented"
                                            Classes.active="{Binding IsSaveAsTargetImmich}"
                                            IsVisible="{Binding IsSaveAsImmichAvailable}"
                                            Click="OnDialogSaveTargetClick"
                                            Tag="Immich">Immich</Button>
                                </StackPanel>

                                <TextBlock Grid.Row="3"
                                           Text="Zielordner"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSaveAsTargetFolderVisible}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                                <Grid Grid.Row="3"
                                      Grid.Column="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8"
                                      IsVisible="{Binding IsSaveAsTargetFolderVisible}">
                                    <TextBox Text="{Binding DialogSaveAsTargetFolder, Mode=TwoWay}"
                                             MinHeight="36"/>
                                    <Button Grid.Column="1"
                                            Classes="icon-btn"
                                            Width="38"
                                            Height="36"
                                            Click="OnBrowseSaveTargetFolderClick"
                                            ToolTip.Tip="Ordner wählen">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/folder-open.svg"
                                                       Width="18"
                                                       Height="18"/>
                                    </Button>
                                </Grid>
                                <!-- Zieldateinamen-Muster (nur Stapel-Dialoge): dieselben Platzhalter wie
                                     beim Stapel-Umbenennen; leer = Originalname bleibt. -->
                                <TextBlock Grid.Row="4"
                                           Text="Dateiname"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsDialogNamePatternVisible}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                                <TextBox Grid.Row="4"
                                         Grid.Column="1"
                                         Text="{Binding DialogTargetNamePattern, Mode=TwoWay}"
                                         PlaceholderText="{}{name} (leer = Originalname behalten)"
                                         IsVisible="{Binding IsDialogNamePatternVisible}"
                                         ToolTip.Tip="Muster wie beim Stapel-Umbenennen: {name}, ### (Zähler), {date:yyyyMMdd}, {datetaken:yyyyMMdd_HHmmss}, {camera}, {iso}, {aperture}, {focal}, {width}, {height}"
                                         MinHeight="36"/>

                                <!-- Einzeloptionen: welche Katalog-Metadaten die
                                     neue Datei übernimmt - Akzent = aktiv, Klick schaltet um. -->
                                <TextBlock Grid.Row="5"
                                           Text="Übernehmen"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding DialogShowsSaveAsMetaOptions}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                                <Border Grid.Row="5"
                                        Grid.Column="1"
                                        BorderBrush="{DynamicResource FP.Border.Normal}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="8,6"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding DialogShowsSaveAsMetaOptions}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="segmented"
                                                Classes.active="{Binding DialogSaveAsCopyRating}"
                                                Click="OnDialogMetaCopyToggleClick"
                                                Tag="Rating">Bewertung</Button>
                                        <Button Classes="segmented"
                                                Classes.active="{Binding DialogSaveAsCopyFavorite}"
                                                Click="OnDialogMetaCopyToggleClick"
                                                Tag="Favorite">Favorit</Button>
                                        <Button Classes="segmented"
                                                Classes.active="{Binding DialogSaveAsCopyColorLabel}"
                                                Click="OnDialogMetaCopyToggleClick"
                                                Tag="Label">Etikett</Button>
                                        <Button Classes="segmented"
                                                Classes.active="{Binding DialogSaveAsCopyKeywords}"
                                                Click="OnDialogMetaCopyToggleClick"
                                                Tag="Keywords">Stichworte</Button>
                                        <Button Classes="segmented"
                                                Classes.active="{Binding DialogSaveAsPreserveExif}"
                                                Click="OnDialogMetaCopyToggleClick"
                                                ToolTip.Tip="Aufnahmedaten der Quelle (Kamera, Zeit, Objektiv) in die Zieldatei schreiben"
                                                Tag="Exif">EXIF</Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Beim UEBERSCHREIBEN ist der Speichern-unter-Block oben ausgeblendet
                             (Format und Ziel gibt es nicht), neu encodiert wird die Datei trotzdem:
                             die JPG-Qualitaet bekommt hier ihre eigene Zeile, sichtbar nur mit
                             JPG-Quellen im Stapel. Teilt sich die Zeile mit dem Block - es ist
                             immer nur einer von beiden sichtbar. -->
                        <Grid Grid.Row="4"
                              Margin="0,14,0,0"
                              ColumnSpacing="14"
                              IsVisible="{Binding IsDialogOverwriteJpgQualityVisible}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DialogLabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JPG-Qualität"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource FP.Text.Secondary}"/>
                            <Grid Grid.Column="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <icons:RoundSlider Minimum="1"
                                                   Maximum="100"
                                                   Value="{Binding DialogJpgQuality, Mode=TwoWay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   Height="28"
                                                   MinHeight="0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DialogJpgQuality, StringFormat={}{0}%}"
                                           MinWidth="42"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                            </Grid>
                        </Grid>

                        <views:BatchRenameDialogView Grid.Row="3"
                                                     Margin="0,16,0,0"
                                                     IsVisible="{Binding DialogShowsBatchRename}"/>

                    </Grid>
                </ScrollViewer>

                <!-- Aktionsbuttons -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10"
                            Margin="0,22,0,0"
                            IsVisible="{Binding DialogShowsStandardActions}">
                    <Button Classes="ghost"
                            Command="{Binding DialogCancelCommand}"
                            IsVisible="{Binding IsDialogCancelVisible}">
                        <TextBlock Text="{Binding DialogCancelText}"/>
                    </Button>
                    <Button Classes="ghost"
                            Command="{Binding DialogSecondaryCommand}"
                            IsVisible="{Binding IsDialogSecondaryVisible}">
                        <TextBlock Text="{Binding DialogSecondaryText}"/>
                    </Button>
                    <Button Classes="accent"
                            Command="{Binding DialogConfirmCommand}">
                        <TextBlock Text="{Binding DialogConfirmText}"/>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,*,Auto"
                      Margin="0,22,0,0"
                      IsVisible="{Binding DialogShowsFileConflict}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Left">
                        <Button Classes="ghost"
                                Command="{Binding DialogSkipAllCommand}">
                            <TextBlock Text="Alle überspringen"/>
                        </Button>
                        <Button Classes="ghost"
                                Command="{Binding DialogOverwriteAllCommand}">
                            <TextBlock Text="Alle überschreiben"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right">
                        <Button Classes="ghost"
                                Command="{Binding DialogRenameCommand}">
                            <TextBlock Text="Umbenennen"/>
                        </Button>
                        <Button Classes="ghost"
                                Command="{Binding DialogSkipCommand}">
                            <TextBlock Text="Überspringen"/>
                        </Button>
                        <Button Classes="accent"
                                Command="{Binding DialogConfirmCommand}">
                            <TextBlock Text="{Binding DialogConfirmText}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>

</UserControl>
