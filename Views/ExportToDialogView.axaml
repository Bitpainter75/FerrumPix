<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FerrumPix.Views"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Views.ExportToDialogView">
    <!-- „Exportieren nach": jede Bearbeitungsart ist eine ZUSCHALTBARE Sektion. Die Formulare
         darin sind DIESELBEN Controls wie in den Einzeldialogen (FilterFormView, ResizeFormView)
         und binden dieselben ViewModel-Eigenschaften - damit können die Optionen nicht
         auseinanderlaufen. Format, Qualität, Ziel, Dateiname und „Übernehmen" stehen EINMAL
         global im SaveAs-Block darunter (DialogOverlayView, Zeile 4); Originale werden nie
         überschrieben, deshalb gibt es hier keinen Überschreiben-Haken.
         Welche Sektionen aktiv sind, merkt sich die Anwendung (AppSettings.ExportTo*). Die
         automatische Bildverbesserung ist KEINE eigene Sektion, sondern die vierte Quelle im
         Filter-Formular - dort steht sie neben den anderen Looks, statt zweimal im Dialog.

         AUFBAU-REGEL für die linke Kante: jedes Formular steckt gleich tief - Sektionskarte,
         darin eine Inhaltskarte. Das Größen-Formular bringt seine Karten selbst mit, Filter und
         Wasserzeichen bekommen sie hier. Zusammen mit der geteilten Beschriftungsspalte
         („DialogLabelColumn") beginnen dadurch alle Eingabefelder auf derselben Linie. -->
    <StackPanel Spacing="10">

        <Border Classes="adjustment-group">
            <StackPanel Spacing="10">
                <CheckBox IsChecked="{Binding DialogExportUseFilter, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/palette.svg"
                                       Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Anpassungen anwenden" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
                <Border Classes="adjustment-group" IsVisible="{Binding DialogExportUseFilter}">
                    <local:FilterFormView/>
                </Border>
            </StackPanel>
        </Border>

        <Border Classes="adjustment-group">
            <StackPanel Spacing="10">
                <CheckBox IsChecked="{Binding DialogExportUseWatermark, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/drop.svg"
                                       Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Wasserzeichen anwenden" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
                <Border Classes="adjustment-group" IsVisible="{Binding DialogExportUseWatermark}">
                    <local:WatermarkFormView />
                </Border>
            </StackPanel>
        </Border>

        <Border Classes="adjustment-group">
            <StackPanel Spacing="10">
                <CheckBox IsChecked="{Binding DialogExportUseResize, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/resize.svg"
                                       Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Bildgröße ändern" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
                <!-- Bringt seine eigenen Inhaltskarten mit (wie im Einzeldialog). -->
                <local:ResizeFormView IsVisible="{Binding DialogExportUseResize}"/>
            </StackPanel>
        </Border>

        <!-- Entrauschen mit Modell als eigene Gruppe. Der Haken startet bei jedem Oeffnen aus: ein
             Lauf kostet Minuten je Bild, und ein vergessener Haken macht aus einem schnellen Export
             einen stundenlangen. Ohne Modell ist er gesperrt, der Hinweis sagt warum. -->
        <Border Classes="adjustment-group">
            <StackPanel Spacing="10">
                <CheckBox IsChecked="{Binding DialogExportUseDenoise, Mode=TwoWay}"
                          IsEnabled="{Binding IsDialogBatchDenoiseAvailable}"
                          ToolTip.Tip="{Binding DialogExportDenoiseHint}"
                          ToolTip.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/sparkle.svg"
                                       Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Entrauschen" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
                <Border Classes="adjustment-group" IsVisible="{Binding DialogExportUseDenoise}">
                    <local:DenoiseFormView/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Nur da, wenn in der Auswahl wirklich etwas offen ist (siehe
             MainWindowViewModel.PreparePendingBakedOptionAsync). -->
        <Border Classes="adjustment-group" IsVisible="{Binding IsDialogPendingBakedAvailable}">
            <CheckBox Content="{Binding DialogPendingBakedLabel}"
                      IsChecked="{Binding DialogApplyPendingBaked, Mode=TwoWay}"
                      Classes="no-translate"
                      FontSize="{DynamicResource FP.Font.Small}"
                      ToolTip.Tip="Bei RAW- und Photoshop-Dateien liegt Entrauschen, Objektentfernen, Retusche und Pinsel nur als Vermerk neben der Datei. Mit Haken werden sie mitgerechnet, was mehrere Minuten je Bild kostet; ohne Haken kommen die Bilder ohne diese Bearbeitung heraus."/>
        </Border>

    </StackPanel>
</UserControl>
