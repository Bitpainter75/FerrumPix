<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:models="clr-namespace:FerrumPix.Models;assembly=FerrumPix"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:FerrumPix.Views"
             x:Class="FerrumPix.Views.GalleryView"
             Background="{DynamicResource FP.Bg.Root}"
             Focusable="True"
             FocusAdorner="{x:Null}"
             KeyDown="OnKeyDown"
             KeyUp="HandleKeyUp"
             PointerReleased="OnGlobalPointerReleased">

    <UserControl.Resources>
        <!-- Die Kopfzeile einer Gruppe. Sie steht HIER und nicht in der Kachelvorlage, weil sie im
             Raster nie vorkommt: als Teil der Kachel entstand sie in jedem Element, nur um
             unsichtbar zu bleiben. Der ContentControl in der Kachel fuellt sie erst, wenn das
             Element wirklich eine Kopfzeile ist.
             Die Hoehe ist fest und muss mit GalleryViewModel.GroupHeaderRowHeight uebereinstimmen,
             sonst driftet die Scrollrechnung mit der Scrolltiefe. Die Breite ist genau eine volle
             Kachelzeile, damit das WrapPanel die Kopfzeile immer allein in eine Zeile setzt.
             no-translate ist Pflicht: der Uebersetzungsdurchlauf schreibt sonst Text zu und bricht
             die Bindung. -->
        <DataTemplate x:Key="GalleryGroupHeaderTemplate" DataType="{x:Type models:ImageItem}">
            <Border Height="48"
                    Width="{Binding DataContext.GroupHeaderWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Padding="5,0,5,0">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,6" VerticalAlignment="Bottom">
                    <!-- Derselbe Kreis wie auf der Kachel, nur eine Ebene hoeher: er markiert die
                         ganze Gruppe und hebt sie wieder auf. Gefuellt steht er, wenn JEDES Bild
                         der Gruppe markiert ist. -->
                    <Button Grid.Column="0"
                            Classes="selection-badge"
                            Classes.active="{Binding IsSelected}"
                            Width="16" Height="16"
                            Margin="0,0,8,2"
                            VerticalAlignment="Bottom"
                            Click="OnGroupSelectionBadgeClick"
                            ToolTip.Tip="Gruppe auswählen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/check.svg"
                                       Classes="badge-glyph"
                                       Width="14" Height="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Grid.Column="1"
                               Classes="no-translate"
                               Text="{Binding GroupTitle}"
                               FontSize="{DynamicResource FP.Font.Subtitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource FP.Text.Primary}"
                               VerticalAlignment="Bottom"/>
                    <Border Grid.Column="2"
                            Height="1"
                            Margin="12,0,12,5"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource FP.Border.Normal}"/>
                    <TextBlock Grid.Column="3"
                               Classes="no-translate"
                               Text="{Binding GroupCountText}"
                               FontSize="{DynamicResource FP.Font.Small}"
                               Foreground="{DynamicResource FP.Text.Muted}"
                               VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <!-- Personen/Orte klappen per Klick auf die Zeile auf/zu (OpenVirtualNavigationNode); der
             Standard-Chevron läge durch den Einzug-Trick (-34-Margin im Item-Template) mitten im
             Knoten-Icon. Unsichtbar UND nicht klickbar, damit der Klick
             die Zeile trifft - der Platz bleibt erhalten, sonst verschöben sich die Einzüge. -->
        <Style Selector="TreeView#ImmichTreeView TreeViewItem /template/ ToggleButton">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <!-- Die Fusszeile steht in einer Auto-Zeile statt in einer festen 40er: ausgeblendet faellt die
         Zeile damit ganz weg, statt einen leeren Streifen zu hinterlassen. Ihre Hoehe bringt die
         Leiste selbst mit. -->
    <Grid x:Name="GalleryRootGrid" RowDefinitions="52,*,Auto">

        <!-- EIN Kontextmenue fuer Kachel, Zeile und Fusszeile. -->
        <Grid.ContextMenu>
            <ContextMenu x:Name="GalleryContextMenu" ItemsSource="{Binding ContextActions}">
            <!-- Die Zeilen mit Sternen, Herz und Farbkreisen tragen die Klasse "widget" und
                 bleiben von der Vorlage ausgenommen: sie bringen ihren Inhalt selbst mit. Ohne
                 diese Ausnahme ueberschrieb die Vorlage ihn - erst leer, dann nicht bedienbar. -->
            <ContextMenu.Styles>
            <Style Selector="MenuItem:not(.widget)">
            <!-- Schmaler als die Vorgabe des Erscheinungsbilds (208): die Eintraege sind kurz,
                 und ein Menue, das breiter ist als sein laengster Text, wirkt leer.
                 Seit es ein Untermenue gibt, haengt daran noch etwas: der Pfeil sitzt immer am
                 RECHTEN RAND des Menues, nicht hinter seiner Beschriftung. Je breiter das Menue,
                 desto weiter steht er vom Wort weg. -->
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="CommandParameter" Value="{Binding Parameter}"/>
            <Setter Property="ItemsSource" Value="{Binding Children}"/>
            <Setter Property="Header">
            <Template>
            <!-- Das Zeichen fuer ein Untermenue kommt aus UNSEREM Symbolsatz (das der
                 Standardvorlage ist in FerrumPixTheme ausgeblendet) und steht rechts, 20 Punkte
                 vom Rand des Menues: 14 aus der Polsterung der Zeile, 6 aus dem Abstand hier. -->
            <Grid ColumnDefinitions="Auto,*,Auto">
            <icons:SvgIcon Grid.Column="0" Source="{Binding IconSource}" Width="16" Height="16" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <icons:SvgIcon Grid.Column="2"
                           Source="avares://FerrumPix/Assets/Icons/outline/caret-right.svg"
                           Width="18" Height="18" VerticalAlignment="Center"
                           Margin="12,0,6,0"
                           IsVisible="{Binding HasChildren}"/>
            </Grid>
            </Template>
            </Setter>
            </Style>
            </ContextMenu.Styles>
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" MinWidth="220" MaxWidth="520"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
            <!-- Auto statt fester Breite: eingeklappt belegt die Info-Leiste dann gar nichts,
                 und die Kacheln bekommen den Platz zurueck. -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Classes="toolbar" Height="52" Padding="16,0">
            <Grid ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="icon-btn" Width="34" Height="34"
                            Command="{Binding NavigateUpCommand}"
                            IsEnabled="{Binding CanNavigateBack}"
                            ToolTip.Tip="Zurück">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-left.svg"
                               Width="20" Height="20"/>
                    </Button>
                    <Button Classes="icon-btn" Width="34" Height="34"
                            Command="{Binding NavigateForwardCommand}"
                            IsEnabled="{Binding CanNavigateForward}"
                            ToolTip.Tip="Vorwärts">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-right.svg"
                               Width="20" Height="20"/>
                    </Button>
                    <Button Classes="icon-btn" Width="34" Height="34"
                            Command="{Binding NavigateParentCommand}"
                            IsEnabled="{Binding HasBreadcrumbParent}"
                            ToolTip.Tip="Eine Ebene nach oben">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-up.svg"
                               Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="8,0,18,0">
                    <Button Classes="icon-btn"
                            Width="34"
                            Height="34"
                            Command="{Binding NavigatePicturesCommand}"
                            ToolTip.Tip="Zum Bilder-Ordner">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/home.svg"
                                       Width="20" Height="20"/>
                    </Button>
                    <!-- Der Brotkrümelpfad weicht im schmalen Fenster als Erstes: er wächst mit der
                         Ordnertiefe und liefe sonst in die Suchleiste. Die Navigation bleibt über die
                         Pfeil- und Haus-Schalter links davon erreichbar, der Pfad steht in der Fußzeile. -->
                    <!-- Eine Klammer um den ganzen Pfad, damit die beiden Bedingungen sauber
                         bleiben: aussen "ist ueberhaupt Platz", innen "gibt es einen Elternordner".
                         Avalonia kann zwei Bindungen nicht ohne Konverter verunden. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding AreToolbarLabelsVisible}">
                        <!-- Etwas Luft links und rechts: der Knopf bekommt beim Ueberfahren einen
                             Hintergrund, und ohne Innenabstand klebte der direkt an den Buchstaben. -->
                        <Button Classes="ghost"
                                Command="{Binding NavigateParentCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,0"
                                Height="30"
                                VerticalContentAlignment="Center"
                                IsVisible="{Binding HasBreadcrumbParent}">
                            <TextBlock Text="{Binding BreadcrumbParent}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <TextBlock Text="›"
                                   Foreground="{DynamicResource FP.Text.Muted}"
                                   FontSize="{DynamicResource FP.Font.Small}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasBreadcrumbParent}"/>
                        <TextBlock Text="{Binding CurrentFolderName}"
                                   Foreground="{DynamicResource FP.Text.Primary}"
                                   FontSize="{DynamicResource FP.Font.Body}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <!-- LAUFENDE VORGÄNGE STATT SUCHFELD. Katalogindex, beide Gesichtssuchen und
                         eine laufende Suchliste melden sich hier, und zwar an der Stelle des
                         Suchfelds statt in der Fußzeile: dort standen Balken, Text und Abbrechen
                         neben Statuszeile, Sternen und Farbkreisen und drängten den Rest aus dem
                         Bild. Das Suchfeld ist die einzige Fläche der Leiste, die von sich aus
                         mitwächst (Spalte "*"), und der Text wird lang - "Indiziere 12345 von
                         67890".

                         Das Feld ist solange WEG und nicht nur überlagert: ein Eingabefeld, das
                         zwar da ist, aber unter etwas anderem liegt, nimmt trotzdem den Fokus und
                         die Tastatur an. Der Lauf lässt sich hier direkt anhalten, wer also
                         zwischendurch suchen will, kommt in einem Klick an sein Feld.

                         MEHRERE LÄUFE TEILEN SICH DIE BREITE. Das UniformGrid mit einer Zeile gibt
                         jedem Lauf denselben Anteil - ein zweiter Lauf verdeckt den ersten nicht,
                         und jeder behält seinen eigenen Abbrechen-Knopf. Der Text wird dabei
                         beschnitten statt zu drängeln, deshalb hat die Kachel keine Mindestbreite:
                         die käme bei einem schmalen Fenster über die Spalte hinaus. -->
                    <ItemsControl Grid.Column="0"
                                  IsVisible="{Binding HasBackgroundRuns}"
                                  ItemsSource="{Binding BackgroundRuns}"
                                  Margin="0,0,8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource FP.Bg.Input}"
                                        BorderBrush="{DynamicResource FP.Border.Normal}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,0"
                                        Height="34"
                                        Margin="0,0,6,0">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Classes="no-translate"
                                                       Text="{Binding Text}"
                                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                                       FontSize="{DynamicResource FP.Font.Label}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Height="3" Minimum="0" Maximum="100"
                                                         Value="{Binding Percent}"
                                                         IsIndeterminate="{Binding !HasProgress}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                Width="18" Height="18" Padding="0"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding StopCommand}"
                                                ToolTip.Tip="Lauf anhalten, das Gefundene bleibt gespeichert">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                                           Width="12" Height="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.75"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Column="0"
                            IsVisible="{Binding !HasBackgroundRuns}"
                            Background="{DynamicResource FP.Bg.Input}"
                            BorderBrush="{DynamicResource FP.Border.Normal}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            MinWidth="120"
                            Height="34"
                            Margin="0,0,8,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/search.svg"
                                   Width="16" Height="16" VerticalAlignment="Center" Opacity="0.65"/>
                            <TextBox Grid.Column="1"
                                     Name="GallerySearchBox"
                                     Classes="search-input"
                                     BorderThickness="0"
                                     Padding="0"
                                     Height="20"
                                     Margin="10,0,0,2"
                                     Text="{Binding SearchText}"
                                     VerticalContentAlignment="Center"
                                     KeyDown="OnSearchBoxKeyDown"/>
                            <Button Grid.Column="2"
                                    Classes="ghost"
                                    Width="18"
                                    Height="18"
                                    Padding="0"
                                    Margin="4,0,4,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearSearchCommand}"
                                    IsVisible="{Binding SearchText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                    ToolTip.Tip="Suche zurücksetzen">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                               Width="12" Height="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.75"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Personen. Dieselbe Sorte Einschränkung wie die Stichwörter, deshalb daneben
                         und genauso gebaut. Der Knopf ist GANZ WEG, solange die Erkennung nicht
                         eingeschaltet ist oder die Modelle fehlen - nicht ausgegraut, so hält es die
                         Anwendung bei allen Modellfunktionen. Die Erkennung wird unten IM Menü
                         ausgelöst: ohne das wäre der Knopf beim ersten Öffnen leer und tot. -->
                    <Button Grid.Column="1" Height="34" Padding="8,5" Margin="0,0,8,0"
                            Classes="filter-btn"
                            Classes.active="{Binding HasPersonFilter}"
                            IsVisible="{Binding HasPersonFeature}"
                            Click="OnPersonFilterButtonClick"
                            Tag="Person"
                            PointerPressed="OnFilterButtonPointerPressed"
                            ToolTip.Tip="Personen">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    VerticalOffset="2"
                                    Opened="OnLocalizedFlyoutOpened">
                                <!-- KEINE MaxHeight am Panel: ein StackPanel scrollt nicht, es SCHNEIDET AB. Mit
                                     Kopfzeile, Knoepfen, Trennern und Suchfeld kam der Inhalt ueber die
                                     Deckelung, und die letzten Eintraege der Liste waren nicht mehr
                                     erreichbar. Begrenzt wird deshalb die LISTE (der ScrollViewer
                                     darunter), und die kann scrollen. -->
                                <StackPanel Spacing="1" MinWidth="248">
                                    <TextBlock Text="PERSONEN" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               Margin="10,8,10,4"/>

                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding ClearPersonFilterCommand}">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Auswahl aufheben" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding !HasPersonFilter}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>

                                    <Separator Margin="4,6"/>

                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding ScanFacesCommand}"
                                            ToolTip.Tip="Durchsucht die markierten Bilder, sonst die ganze Ansicht">
                                        <TextBlock Text="Gesichter erkennen" VerticalAlignment="Center"/>
                                    </Button>

                                    <Separator Margin="4,6"/>

                                    <!-- Suchfeld: bei einem gewachsenen Bestand hat man schnell
                                         dreistellig viele Gruppen. Eine ausgewählte Person bleibt
                                         beim Tippen sichtbar, sonst ließe sie sich nicht abwählen. -->
                                    <Border Background="{DynamicResource FP.Bg.Input}"
                                             BorderBrush="{DynamicResource FP.Border.Normal}"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="10,6"
                                             Margin="10,0,10,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/search.svg"
                                                           Width="14" Height="14" VerticalAlignment="Center" Opacity="0.65"/>
                                            <TextBox Grid.Column="1"
                                                     Classes="search-input"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     Text="{Binding PersonFilterSearch}"
                                                     PlaceholderText="Person suchen"
                                                     Margin="8,0,0,0"
                                                     VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- ItemsControl erzeugt beim Öffnen JEDE Zeile. Das ist bei tausend
                                         Personen sichtbar langsamer als die Abfrage. ItemsRepeater
                                         virtualisiert die lange Liste im ScrollViewer. -->
                                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater ItemsSource="{Binding PersonFilterOptions}">
                                            <ItemsRepeater.Layout><StackLayout Orientation="Vertical"/></ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:PersonFilterOption}">
                                                    <!-- Click statt Command, gleicher Grund wie bei den
                                                         Stichwörtern: der Inhalt eines Aufklappfensters hängt
                                                         nicht im Baum der Ansicht. -->
                                                    <StackPanel>
                                                        <!-- Zwischenüberschrift vor dem ersten Eintrag je
                                                             Serverquelle. Die Bestände lassen sich nicht
                                                             verunden - ohne die Trennung sähe die Liste aus,
                                                             als ginge das. Der Servername ist ein Eigenname
                                                             und wird nicht übersetzt. -->
                                                        <TextBlock Text="{Binding ServerSource}" Classes="no-translate"
                                                                   IsVisible="{Binding ShowsServerHeader}"
                                                                   Foreground="{DynamicResource FP.Text.Muted}"
                                                                   FontSize="{DynamicResource FP.Font.Small}"
                                                                   Margin="10,8,10,2"/>
                                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                                Click="OnPersonFilterItemClick">
                                                            <Grid ColumnDefinitions="*,20">
                                                                <TextBlock Text="{Binding Label}" Classes="no-translate"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}"
                                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>

                                    <!-- Namenlose Gruppen stehen nicht in dieser Liste, deshalb ist sie
                                         nach einer frischen Erkennung noch leer. Der zweite Satz sagt,
                                         wo es weitergeht. -->
                                    <TextBlock Text="Noch keine Personen benannt"
                                               IsVisible="{Binding !PersonFilterOptions.Count}"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               FontSize="{DynamicResource FP.Font.Small}"
                                               Margin="10,8,10,2"/>
                                    <TextBlock Text="Namen werden in der Info-Leiste am Bild vergeben"
                                               IsVisible="{Binding !PersonFilterOptions.Count}"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               FontSize="{DynamicResource FP.Font.Small}"
                                               TextWrapping="Wrap"
                                               Margin="10,0,10,8"/>

                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/users.svg"
                                           Classes="filter-glyph" Width="20" Height="20"/>
                            <TextBlock Text="Personen" VerticalAlignment="Center"
                                       IsVisible="{Binding AreFilterLabelsVisible}"/>
                        </StackPanel>
                    </Button>

                    <!-- Orte. Neben den Personen, weil beides aus dem Bild selbst kommt und nicht
                         von Hand vergeben wurde. Der Knopf ist ganz WEG, solange die Ortstabelle
                         fehlt oder nicht eingeschaltet ist - wie bei allen Modellfunktionen.
                         Mehrere Orte wirken als ODER: ein Bild hat genau einen Aufnahmeort, ein UND
                         ergäbe immer eine leere Liste. -->
                    <Button Grid.Column="2" Height="34" Padding="8,5" Margin="0,0,8,0"
                            Classes="filter-btn"
                            Classes.active="{Binding HasPlaceFilter}"
                            IsVisible="{Binding HasPlaceFeature}"
                            Click="OnPlaceFilterButtonClick"
                            Tag="Place"
                            PointerPressed="OnFilterButtonPointerPressed"
                            ToolTip.Tip="Orte">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    VerticalOffset="2"
                                    Opened="OnLocalizedFlyoutOpened">
                                <!-- KEINE MaxHeight am Panel: ein StackPanel scrollt nicht, es SCHNEIDET AB. Mit
                                     Kopfzeile, Knoepfen, Trennern und Suchfeld kam der Inhalt ueber die
                                     Deckelung, und die letzten Eintraege der Liste waren nicht mehr
                                     erreichbar. Begrenzt wird deshalb die LISTE (der ScrollViewer
                                     darunter), und die kann scrollen. -->
                                <StackPanel Spacing="1" MinWidth="248">
                                    <TextBlock Text="ORTE" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               Margin="10,8,10,4"/>

                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding ClearPlaceFilterCommand}">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Auswahl aufheben" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding !HasPlaceFilter}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>

                                    <Separator Margin="4,6"/>

                                    <Border Background="{DynamicResource FP.Bg.Input}"
                                             BorderBrush="{DynamicResource FP.Border.Normal}"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="10,6"
                                             Margin="10,0,10,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/search.svg"
                                                           Width="14" Height="14" VerticalAlignment="Center" Opacity="0.65"/>
                                            <TextBox Grid.Column="1"
                                                     Classes="search-input"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     Text="{Binding PlaceFilterSearch}"
                                                     PlaceholderText="Ort suchen"
                                                     Margin="8,0,0,0"
                                                     VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater ItemsSource="{Binding PlaceFilterOptions}">
                                            <ItemsRepeater.Layout><StackLayout Orientation="Vertical"/></ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:PlaceFilterOption}">
                                                    <!-- Click statt Command, gleicher Grund wie bei den
                                                         Stichwörtern und Personen: der Inhalt eines
                                                         Aufklappfensters hängt nicht im Baum der Ansicht. -->
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ServerSource}" Classes="no-translate"
                                                                   IsVisible="{Binding ShowsServerHeader}"
                                                                   Foreground="{DynamicResource FP.Text.Muted}"
                                                                   FontSize="{DynamicResource FP.Font.Small}"
                                                                   Margin="10,8,10,2"/>
                                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                                Click="OnPlaceFilterItemClick">
                                                            <Grid ColumnDefinitions="*,20">
                                                                <TextBlock Text="{Binding Label}" Classes="no-translate"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}"
                                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>

                                    <TextBlock Text="Noch keine Orte bekannt"
                                               IsVisible="{Binding !PlaceFilterOptions.Count}"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               FontSize="{DynamicResource FP.Font.Small}"
                                               Margin="10,8,10,2"/>
                                    <TextBlock Text="Ortsnamen entstehen aus den Koordinaten im Bild"
                                               IsVisible="{Binding !PlaceFilterOptions.Count}"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               FontSize="{DynamicResource FP.Font.Small}"
                                               TextWrapping="Wrap"
                                               Margin="10,0,10,8"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/map-pin.svg"
                                           Classes="filter-glyph" Width="20" Height="20"/>
                            <TextBlock Text="Orte" VerticalAlignment="Center"
                                       IsVisible="{Binding AreFilterLabelsVisible}"/>
                        </StackPanel>
                    </Button>

                    <!-- Stichwörter. Dieselbe Sorte Einschränkung wie Personen, nur über den
                         ganzen Bestand statt über den offenen Ordner. Die Liste entsteht beim
                         Öffnen neu, damit frisch vergebene Stichwörter dabei sind. -->
                    <Button Grid.Column="3" Height="34" Padding="8,5" Margin="0,0,8,0"
                            Classes="filter-btn"
                            Classes.active="{Binding HasTagFilter}"
                            Click="OnTagFilterButtonClick"
                            Tag="Tag"
                            PointerPressed="OnFilterButtonPointerPressed"
                            ToolTip.Tip="Stichwörter">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    VerticalOffset="2"
                                    Opened="OnLocalizedFlyoutOpened">
                                <!-- KEINE MaxHeight am Panel: ein StackPanel scrollt nicht, es SCHNEIDET AB. Mit
                                     Kopfzeile, Knoepfen, Trennern und Suchfeld kam der Inhalt ueber die
                                     Deckelung, und die letzten Eintraege der Liste waren nicht mehr
                                     erreichbar. Begrenzt wird deshalb die LISTE (der ScrollViewer
                                     darunter), und die kann scrollen. -->
                                <StackPanel Spacing="1" MinWidth="248">
                                    <TextBlock Text="STICHWÖRTER" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               Margin="10,8,10,4"/>

                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding ClearTagFilterCommand}">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Auswahl aufheben" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding !HasTagFilter}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>

                                    <Separator Margin="4,6"/>

                                    <!-- Suchfeld wie bei Personen und Orten: ein gewachsener Bestand
                                         hat schnell dreistellig viele Stichwörter. Ein ausgewähltes
                                         bleibt beim Tippen sichtbar, sonst ließe es sich nicht mehr
                                         abwählen. -->
                                    <Border Background="{DynamicResource FP.Bg.Input}"
                                             BorderBrush="{DynamicResource FP.Border.Normal}"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="10,6"
                                             Margin="10,0,10,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/search.svg"
                                                           Width="14" Height="14" VerticalAlignment="Center" Opacity="0.65"/>
                                            <TextBox Grid.Column="1"
                                                     Classes="search-input"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     Text="{Binding TagFilterSearch}"
                                                     PlaceholderText="Stichwort suchen"
                                                     Margin="8,0,0,0"
                                                     VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater ItemsSource="{Binding TagFilterOptions}">
                                            <ItemsRepeater.Layout><StackLayout Orientation="Vertical"/></ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:TagFilterOption}">
                                                    <!-- Click statt Command: der Inhalt eines Aufklappfensters haengt
                                                         NICHT im Baum der Ansicht, eine Bindung ueber den Vorfahren
                                                         findet dort nichts und die Schaltflaeche bleibt tot. -->
                                                    <StackPanel>
                                                        <!-- Zwischenüberschrift vor dem ersten Eintrag einer
                                                             Serverquelle. Der Servername ist ein Eigenname und
                                                             wird nicht übersetzt. -->
                                                        <TextBlock Text="{Binding ServerSource}" Classes="no-translate"
                                                                   IsVisible="{Binding ShowsServerHeader}"
                                                                   Foreground="{DynamicResource FP.Text.Muted}"
                                                                   FontSize="{DynamicResource FP.Font.Small}"
                                                                   Margin="10,8,10,2"/>
                                                        <!-- Zwischenüberschrift vor dem ersten erkannten
                                                             Stichwort. Anders als der Servername ist sie
                                                             übersetzbarer Text. -->
                                                        <TextBlock Text="KI-Stichwörter"
                                                                   IsVisible="{Binding ShowsAiHeader}"
                                                                   Foreground="{DynamicResource FP.Text.Muted}"
                                                                   FontSize="{DynamicResource FP.Font.Small}"
                                                                   Margin="10,8,10,2"/>
                                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                                Click="OnTagFilterItemClick">
                                                            <Grid ColumnDefinitions="*,20">
                                                                <TextBlock Text="{Binding Label}" Classes="no-translate"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}"
                                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>

                                    <TextBlock Text="Keine Stichwörter vergeben"
                                               IsVisible="{Binding !TagFilterOptions.Count}"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               FontSize="{DynamicResource FP.Font.Small}"
                                               Margin="10,8,10,10"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/tag.svg"
                                           Classes="filter-glyph" Width="20" Height="20"/>
                            <TextBlock Text="Stichwörter" VerticalAlignment="Center"
                                       IsVisible="{Binding AreFilterLabelsVisible}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Height="34" Padding="8,5" Margin="0,0,8,0"
                            Classes="filter-btn"
                            Classes.active="{Binding HasActiveFilter}"
                            Tag="Filter"
                            PointerPressed="OnFilterButtonPointerPressed"
                            ToolTip.Tip="Filter">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    VerticalOffset="2"
                                    Opened="OnLocalizedFlyoutOpened">
                                <StackPanel Spacing="1" MinWidth="248">

                                        <!-- FAVORITEN -->
                                        <TextBlock Text="FAVORITEN" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FP.Text.Muted}"
                                                   Margin="10,8,10,4"/>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterFavoriteCommand}" CommandParameter="All">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Alle" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterFavoriteAll}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterFavoriteCommand}" CommandParameter="Only">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Nur Favoriten" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterFavoriteOnly}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>

                                        <Separator Margin="4,6"/>

                                        <!-- BEWERTUNG -->
                                        <TextBlock Text="BEWERTUNG" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FP.Text.Muted}"
                                                   Margin="10,4,10,4"/>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterRatingCommand}" CommandParameter="-1">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Alle" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterRatingAll}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterRatingCommand}" CommandParameter="0">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Nicht bewertet" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterRatingUnrated}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterRatingCommand}" CommandParameter="1">
                                            <Grid ColumnDefinitions="*,20">
                                                <!-- Dieselben Sterne wie auf der Kachel und im Kontextmenue,
                                                     nicht das Schriftzeichen. -->
                                                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterRating1Plus}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterRatingCommand}" CommandParameter="2">
                                            <Grid ColumnDefinitions="*,20">
                                                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterRating2Plus}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterRatingCommand}" CommandParameter="3">
                                            <Grid ColumnDefinitions="*,20">
                                                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterRating3Plus}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterRatingCommand}" CommandParameter="4">
                                            <Grid ColumnDefinitions="*,20">
                                                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterRating4Plus}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterRatingCommand}" CommandParameter="5">
                                            <Grid ColumnDefinitions="*,20">
                                                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                   Classes="rating-star" Width="15" Height="15"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterRating5}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>

                                        <Separator Margin="4,6"/>

                                        <!-- FARBETIKETT -->
                                        <TextBlock Text="ETIKETT" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FP.Text.Muted}"
                                                   Margin="10,4,10,4"/>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterColorLabelCommand}" CommandParameter="">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Alle" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterLabelAll}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <!-- Dieselben Farben wie die Akzentauswahl in den Einstellungen. -->
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="10,4,10,6">
                                            <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Command="{Binding SetFilterColorLabelCommand}" CommandParameter="#F08A1A" ToolTip.Tip="Orange">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="#F08A1A"/>
                                                    <TextBlock Text="✓" IsVisible="{Binding IsFilterLabelOrange}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Command="{Binding SetFilterColorLabelCommand}" CommandParameter="#E74C3C" ToolTip.Tip="Rot">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="#E74C3C"/>
                                                    <TextBlock Text="✓" IsVisible="{Binding IsFilterLabelRed}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Command="{Binding SetFilterColorLabelCommand}" CommandParameter="#F03B88" ToolTip.Tip="Pink">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="#F03B88"/>
                                                    <TextBlock Text="✓" IsVisible="{Binding IsFilterLabelPink}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Command="{Binding SetFilterColorLabelCommand}" CommandParameter="#8B5CF6" ToolTip.Tip="Lila">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="#8B5CF6"/>
                                                    <TextBlock Text="✓" IsVisible="{Binding IsFilterLabelPurple}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Command="{Binding SetFilterColorLabelCommand}" CommandParameter="#3B82F6" ToolTip.Tip="Blau">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="#3B82F6"/>
                                                    <TextBlock Text="✓" IsVisible="{Binding IsFilterLabelBlue}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Command="{Binding SetFilterColorLabelCommand}" CommandParameter="#0891B2" ToolTip.Tip="Cyan">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="#0891B2"/>
                                                    <TextBlock Text="✓" IsVisible="{Binding IsFilterLabelCyan}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Command="{Binding SetFilterColorLabelCommand}" CommandParameter="#0F766E" ToolTip.Tip="Türkis">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="#0F766E"/>
                                                    <TextBlock Text="✓" IsVisible="{Binding IsFilterLabelTeal}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Command="{Binding SetFilterColorLabelCommand}" CommandParameter="#22C55E" ToolTip.Tip="Grün">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="#22C55E"/>
                                                    <TextBlock Text="✓" IsVisible="{Binding IsFilterLabelGreen}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Command="{Binding SetFilterColorLabelCommand}" CommandParameter="#FACC15" ToolTip.Tip="Gelb">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="#FACC15"/>
                                                    <TextBlock Text="✓" IsVisible="{Binding IsFilterLabelYellow}" Foreground="Black"
                                                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>

                                        <Separator Margin="4,6"/>

                                        <!-- DATEITYP -->
                                        <TextBlock Text="DATEITYP" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FP.Text.Muted}"
                                                   Margin="10,4,10,4"/>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterTypeCommand}" CommandParameter="All">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Alle" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterTypeAll}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterTypeCommand}" CommandParameter="Raw">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Nur RAW" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterTypeRaw}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetFilterTypeCommand}" CommandParameter="NonRaw">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Nur Nicht-RAW" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsFilterTypeNonRaw}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>

                                        <!-- Zurücksetzen -->
                                        <Separator Margin="4,6" IsVisible="{Binding HasActiveFilter}"/>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="10,8"
                                                IsVisible="{Binding HasActiveFilter}"
                                                Command="{Binding ClearFiltersCommand}">
                                            <TextBlock Text="Alle Filter zurücksetzen"
                                                       Foreground="{DynamicResource FP.Text.Secondary}"/>
                                        </Button>

                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/filter.svg"
                                   Classes="filter-glyph" Width="20" Height="20"/>
                            <TextBlock Text="{Binding FilterLabel}"
                                       IsVisible="{Binding AreFilterLabelsVisible}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="5"
                            Height="34" Padding="8,5" Margin="0,0,8,0"
                            Tag="Sort"
                            PointerPressed="OnFilterButtonPointerPressed"
                            ToolTip.Tip="Sortieren">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft"
                                    VerticalOffset="2"
                                    Opened="OnLocalizedFlyoutOpened">
                                <StackPanel Spacing="1" MinWidth="188">
                                    <TextBlock Text="SORTIEREN NACH" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               Margin="10,8,10,4"/>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Name">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Name" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortName}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Size">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Dateigröße" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortSize}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Type">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Dateityp" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortType}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>

                                    <Separator Margin="4,6"/>
                                    <TextBlock Text="DATUM" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               Margin="10,4,10,4"/>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="FileCreatedAt">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Erstellt (Datei)" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortFileCreatedAt}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="FileModifiedAt">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Geändert (Datei)" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortFileModifiedAt}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="ExifDateTaken">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Aufgenommen (EXIF)" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortExifDateTaken}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="ExifDateModified">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Geändert (EXIF)" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortExifDateModified}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>

                                    <Separator Margin="4,6"/>
                                    <TextBlock Text="BILD" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               Margin="10,4,10,4"/>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Width">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Bildbreite" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortWidth}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Height">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Bildhöhe" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortHeight}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Camera">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Kamera" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortCamera}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Iso">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="ISO" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortIso}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Aperture">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Blende" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortAperture}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>

                                    <Separator Margin="4,6"/>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Rating">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Bewertung" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortRating}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortCommand}" CommandParameter="Favorite">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Favorit" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortFavorite}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>

                                    <Separator Margin="4,6"/>

                                    <TextBlock Text="REIHENFOLGE" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FP.Text.Muted}"
                                               Margin="10,4,10,4"/>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortDirectionCommand}" CommandParameter="Ascending">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Aufsteigend" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortAscending}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding SetSortDirectionCommand}" CommandParameter="Descending">
                                        <Grid ColumnDefinitions="*,20">
                                            <TextBlock Text="Absteigend" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSortDescending}"
                                                       Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Button>

                                    <!-- Nur in der Gruppenansicht und nur bei einer Datumssortierung:
                                         sonst gibt es keinen Tag, den man vergroebern koennte. -->
                                    <StackPanel IsVisible="{Binding IsGroupDateStepVisible}">
                                        <Separator Margin="4,6"/>
                                        <TextBlock Text="GRUPPEN" FontSize="{DynamicResource FP.Font.Caption}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FP.Text.Muted}"
                                                   Margin="10,4,10,4"/>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetGroupDateStepCommand}" CommandParameter="Day">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Nach Tag" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsGroupStepDay}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetGroupDateStepCommand}" CommandParameter="Month">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Nach Monat" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsGroupStepMonth}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="10,8"
                                                Command="{Binding SetGroupDateStepCommand}" CommandParameter="Year">
                                            <Grid ColumnDefinitions="*,20">
                                                <TextBlock Text="Nach Jahr" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsGroupStepYear}"
                                                           Foreground="{DynamicResource FP.Accent}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Das Symbol links IST die Richtungsangabe: statt des allgemeinen
                                 Sortierzeichens steht dort der Pfeil der aktuellen Richtung. Der
                                 Wortlaut "aufsteigend" am Ende der Beschriftung entfaellt dadurch -
                                 er wurde bei den laengeren Sortierarten ohnehin abgeschnitten.
                                 Zwei Symbole mit Sichtbarkeit statt eines gebundenen Pfades: so
                                 bleibt die Quelle eine feste Angabe ohne Umrechner. Genommen sind
                                 dieselben beiden Pfeile, die die Leiste sonst auch fuehrt. -->
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-up.svg"
                                   Width="20" Height="20"
                                   IsVisible="{Binding IsSortAscending}"/>
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-down.svg"
                                   Width="20" Height="20"
                                   IsVisible="{Binding IsSortDescending}"/>
                            <TextBlock Text="{Binding SortLabel}"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" Margin="0,0,0,0">
                        <Button Classes="icon-btn" Width="34" Height="34"
                                Classes.active="{Binding IsListView}"
                                Command="{Binding SetViewModeCommand}" CommandParameter="List"
                                ToolTip.Tip="Listenansicht">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/list.svg"
                                   Width="20" Height="20" Opacity="0.78"/>
                        </Button>
                        <Button Classes="icon-btn" Width="34" Height="34"
                                Classes.active="{Binding IsGridView}"
                                Command="{Binding SetViewModeCommand}" CommandParameter="Grid"
                                ToolTip.Tip="Rasteransicht">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/layout-grid.svg"
                                   Width="20" Height="20"/>
                        </Button>
                        <Button Classes="icon-btn" Width="34" Height="34"
                                Classes.active="{Binding IsGroupView}"
                                Command="{Binding SetViewModeCommand}" CommandParameter="Group"
                                ToolTip.Tip="Gruppenansicht">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/layout-rows.svg"
                                   Width="20" Height="20"/>
                        </Button>
                        <Button Classes="icon-btn" Width="34" Height="34"
                                Classes.active="{Binding IsInfoSidebarVisible}"
                                Command="{Binding ToggleInfoSidebarCommand}"
                                ToolTip.Tip="Info">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/info-circle.svg"
                                   Width="20" Height="20"/>
                        </Button>
                        <!-- Ein Punkt näher - dieselbe gemessene Ursache wie in Betrachter und
                             Editor: das Vollbild-Zeichen lässt in seinem 24er-Raster 3 Einheiten
                             Luft je Seite, das Info-Zeichen davor nur 2. -->
                        <Button Classes="icon-btn" Width="34" Height="34"
                                Margin="-1,0,0,0"
                                Click="OnFullscreenClick"
                                ToolTip.Tip="Vollbild">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/maximize.svg"
                                   Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Classes="sidebar">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Navigations-Tabs: Ordner / Immich / Favoriten. Der Immich-Tab existiert nur,
                     wenn Immich hinterlegt ist (HasImmich); faellt die Konfiguration weg, springt die
                     Auswahl im ViewModel auf Ordner zurueck (SyncSidebarTabWithImmich). Jeder Tab traegt
                     seine EIGENEN Suchlisten - eine Dateisystem-Suche gehoert nicht neben Immich-Alben. -->
                <!-- Reiter LINKSBUENDIG in einer Reihe statt in gleich breiten Spalten. Mit Spalten
                     hielt eine ausgeblendete Quelle ihren Platz: fehlte Immich oder Nextcloud, klaffte
                     eine Luecke und "Favoriten" stand weit rechts. Die Reihe schiebt zusammen. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14"
                            HorizontalAlignment="Left" Margin="24,22,24,4">
                    <Button Classes="sidebar-tab"
                            Command="{Binding SetSidebarTabCommand}" CommandParameter="Favorites"
                            Classes.active="{Binding IsFavoritesTab}">
                        <TextBlock Text="Favoriten" FontSize="{DynamicResource FP.Font.Body}"/>
                    </Button>
                    <Button Classes="sidebar-tab"
                            Command="{Binding SetSidebarTabCommand}" CommandParameter="Folders"
                            Classes.active="{Binding IsFoldersTab}">
                        <TextBlock Text="Ordner" FontSize="{DynamicResource FP.Font.Body}"/>
                    </Button>
                    <Button Classes="sidebar-tab"
                            IsVisible="{Binding HasImmich}"
                            Command="{Binding SetSidebarTabCommand}" CommandParameter="Immich"
                            Classes.active="{Binding IsImmichTab}">
                        <TextBlock Text="Immich" FontSize="{DynamicResource FP.Font.Body}"/>
                    </Button>
                    <Button Classes="sidebar-tab"
                            IsVisible="{Binding HasNextcloud}"
                            Command="{Binding SetSidebarTabCommand}" CommandParameter="Nextcloud"
                            Classes.active="{Binding IsNextcloudTab}">
                        <TextBlock Text="Nextcloud" FontSize="{DynamicResource FP.Font.Body}"/>
                    </Button>
                </StackPanel>

                <!-- ORDNER-TAB: eigene Suchlisten oben, Ordnerbaum darunter. Die Suchliste waechst
                     mit ihren Eintraegen, aber nur bis 260 px und scrollt danach intern - der Baum
                     darunter darf nie aus dem sichtbaren Bereich gedraengt werden. -->
                <Grid Grid.Row="1" Margin="24,8,12,0" RowDefinitions="Auto,Auto,Auto,*"
                      ClipToBounds="True" IsVisible="{Binding IsFoldersTab}">
                    <TextBlock Grid.Row="0" Text="Suchen" Margin="0,0,14,8"
                               FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" MaxHeight="260">
                        <TreeView Name="SearchTreeView"
                                        ItemsSource="{Binding SearchTree}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectionChanged="OnVirtualTreeSelectionChanged">
                                  <TreeView.ItemTemplate>
                                      <TreeDataTemplate ItemsSource="{Binding Children}">
                                          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                Classes="baumzeile"
                                                ContextRequested="OnSearchNodeContextRequested">
                                              <Grid.ContextMenu>
                                                  <ContextMenu Opened="OnLocalizedMenuOpened">
                                                      <MenuItem Header="Zu Favoriten hinzufügen"
                                                                IsVisible="{Binding CanBecomeFavorite}"
                                                                Click="OnAddNodeFavoriteClick"/>
                                                      <MenuItem Header="Bearbeiten"
                                                                IsVisible="{Binding IsRemovable}"
                                                                Click="OnEditVirtualSearchClick"/>
                                                      <MenuItem Header="Entfernen"
                                                                IsVisible="{Binding IsRemovable}"
                                                                Click="OnRemoveVirtualSearchClick"/>
                                                  </ContextMenu>
                                              </Grid.ContextMenu>
                                              <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/search.svg"
                                                             Margin="0" Width="17" Height="17" VerticalAlignment="Center" Opacity="0.85"/>
                                              <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                                         VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Body}"
                                                         TextTrimming="CharacterEllipsis"/>
                                              <Button Grid.Column="2"
                                                      Classes="ghost"
                                                      Width="18"
                                                      Height="18"
                                                      Padding="0"
                                                      Margin="4,0,4,0"
                                                      HorizontalAlignment="Right"
                                                      IsVisible="{Binding IsRemovable}"
                                                      Click="OnRemoveVirtualSearchClick"
                                                      ToolTip.Tip="Suche entfernen">
                                                  <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                                                 Width="12" Height="12"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Opacity="0.75"/>
                                              </Button>
                                          </Grid>
                                      </TreeDataTemplate>
                                  </TreeView.ItemTemplate>
                              </TreeView>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="Ordner" Margin="0,26,14,8"
                               FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TreeView Name="FolderTreeView"
                                        ItemsSource="{Binding FolderTree}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutoScrollToSelectedItem="False"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ContextRequested="OnFolderTreeContextRequested"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnFolderTreeDragOver"
                                        DragDrop.Drop="OnFolderTreeDrop"
                                        DragDrop.DragLeave="OnTreeDragLeave"
                                        SelectionChanged="OnFolderTreeSelectionChanged">
                                  <TreeView.Styles>
                                      <!-- Das Element unter dem Zeiger ist der Border/ContentPresenter des
                                           TreeViewItem-Templates, nicht unsere Zeilenvorlage - es spannt die ganze
                                           Zeilenbreite darueber. Der Mauszeiger richtet sich nach diesem Element,
                                           deshalb muss AllowDrop dort sitzen und nicht nur am TreeView
                                           (gemessen: quelle=Border/ContentPresenter, nie Grid). -->
                                      <Style Selector="TreeViewItem">
                                          <Setter Property="DragDrop.AllowDrop" Value="True"/>
                                      </Style>
                                      <!-- Eigene Ablege-Rueckmeldung: Avalonia stellt unter X11 bei internem Ziehen
                                           keine effektabhaengigen Mauszeiger dar (siehe HighlightDropRow). -->
                                      <Style Selector="TreeViewItem.drop-target /template/ Border#PART_LayoutRoot">
                                          <!-- NUR Farbe, KEINE Randstaerke: eine geaenderte BorderThickness
                                               vermisst die Zeile neu, das Element unter dem Zeiger wechselt,
                                               die Hervorhebung wandert - und der naechste Zeigerbericht
                                               beginnt von vorn. Farbe allein loest keinen Layoutlauf aus. -->
                                          <Setter Property="Background" Value="{DynamicResource FP.Accent.Dim}"/>
                                          <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
                                      </Style>
                                  </TreeView.Styles>
                                  <TreeView.ContextMenu>
                                      <ContextMenu Opened="OnLocalizedMenuOpened" MaxHeight="1000">
                                          <MenuItem Header="Zu Favoriten hinzufügen" Click="OnAddFolderFavoriteClick"/>
                                          <Separator/>
                                          <MenuItem Name="FolderTreeCreateFolderMenuItem" Header="Neuer Ordner" Click="OnContextCreateFolder"/>
                                          <Separator/>
                                          <MenuItem Name="FolderTreeRenameMenuItem" Header="Umbenennen" Click="OnContextRenameFolder"/>
                                          <MenuItem Name="FolderTreeCopyMenuItem" Header="Kopieren" Click="OnContextCopyFolder"/>
                                          <MenuItem Name="FolderTreeCutMenuItem" Header="Ausschneiden" Click="OnContextCutFolder"/>
                                          <MenuItem Name="FolderTreePasteMenuItem" Header="Einfügen" Click="OnContextPasteFolder"/>
                                          <MenuItem Header="Pfad kopieren" Click="OnContextCopyFolderPath"/>
                                          <Separator/>
                                          <MenuItem Name="FolderTreeDeleteMenuItem" Header="Löschen" Click="OnContextDeleteFolder"/>
                                      </ContextMenu>
                                  </TreeView.ContextMenu>
                                  <TreeView.ItemTemplate>
                                      <TreeDataTemplate ItemsSource="{Binding Children}">
                                          <!-- Background="Transparent" macht die ganze Zeile hittestbar (sonst treffen
                                               nur Symbol und Beschriftung), DragDrop.AllowDrop meldet sie als Drop-Ziel
                                               an - siehe Kommentar am Immich-Baum. -->
                                          <Grid ColumnDefinitions="Auto,*"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="Transparent"
                                                DragDrop.AllowDrop="True"
                                                Margin="4,4">
                                              <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/folder.svg"
                                                     Width="17" Height="17" VerticalAlignment="Center" Opacity="0.85"/>
                                              <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Stretch"
                                                         FontSize="{DynamicResource FP.Font.Body}"
                                                         TextTrimming="CharacterEllipsis"
                                                         ToolTip.Tip="{Binding FullPath}"/>
                                          </Grid>
                                      </TreeDataTemplate>
                                      </TreeView.ItemTemplate>
                              </TreeView>
                    </ScrollViewer>
                </Grid>

                <!-- IMMICH-TAB: Immich-Suchlisten oben, Immich-Baum (Alle Fotos/Alben/Personen/Orte) darunter. -->
                <Grid Grid.Row="1" Margin="24,8,12,0" RowDefinitions="Auto,Auto,Auto,*"
                      ClipToBounds="True" IsVisible="{Binding IsImmichTab}">
                    <TextBlock Grid.Row="0" Text="Suchen" Margin="0,0,14,8"
                               FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" MaxHeight="260">
                        <TreeView Name="ImmichSearchTreeView"
                                        ItemsSource="{Binding ImmichSearchTree}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectionChanged="OnVirtualTreeSelectionChanged">
                                  <TreeView.ItemTemplate>
                                      <TreeDataTemplate ItemsSource="{Binding Children}">
                                          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                Classes="baumzeile"
                                                ContextRequested="OnSearchNodeContextRequested">
                                              <Grid.ContextMenu>
                                                  <ContextMenu Opened="OnLocalizedMenuOpened">
                                                      <MenuItem Header="Zu Favoriten hinzufügen"
                                                                IsVisible="{Binding CanBecomeFavorite}"
                                                                Click="OnAddNodeFavoriteClick"/>
                                                      <MenuItem Header="Bearbeiten"
                                                                IsVisible="{Binding IsRemovable}"
                                                                Click="OnEditVirtualSearchClick"/>
                                                      <MenuItem Header="Entfernen"
                                                                IsVisible="{Binding IsRemovable}"
                                                                Click="OnRemoveVirtualSearchClick"/>
                                                  </ContextMenu>
                                              </Grid.ContextMenu>
                                              <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/search.svg"
                                                             Margin="0" Width="17" Height="17" VerticalAlignment="Center" Opacity="0.85"/>
                                              <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                                         VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Body}"
                                                         TextTrimming="CharacterEllipsis"/>
                                              <Button Grid.Column="2"
                                                      Classes="ghost"
                                                      Width="18"
                                                      Height="18"
                                                      Padding="0"
                                                      Margin="4,0,4,0"
                                                      HorizontalAlignment="Right"
                                                      IsVisible="{Binding IsRemovable}"
                                                      Click="OnRemoveVirtualSearchClick"
                                                      ToolTip.Tip="Suche entfernen">
                                                  <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                                                 Width="12" Height="12"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Opacity="0.75"/>
                                              </Button>
                                          </Grid>
                                      </TreeDataTemplate>
                                  </TreeView.ItemTemplate>
                              </TreeView>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="Immich" Margin="0,26,14,8"
                               FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TreeView Name="ImmichTreeView"
                                        ItemsSource="{Binding ImmichTree}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnImmichTreeDragOver"
                                        DragDrop.Drop="OnImmichTreeDrop"
                                        DragDrop.DragLeave="OnTreeDragLeave"
                                        SelectionChanged="OnVirtualTreeSelectionChanged">
                                  <TreeView.Styles>
                                      <!-- Das Element unter dem Zeiger ist der Border/ContentPresenter des
                                           TreeViewItem-Templates, nicht unsere Zeilenvorlage - es spannt die ganze
                                           Zeilenbreite darueber. Der Mauszeiger richtet sich nach diesem Element,
                                           deshalb muss AllowDrop dort sitzen und nicht nur am TreeView
                                           (gemessen: quelle=Border/ContentPresenter, nie Grid). -->
                                      <Style Selector="TreeViewItem">
                                          <Setter Property="DragDrop.AllowDrop" Value="True"/>
                                      </Style>
                                      <!-- Eigene Ablege-Rueckmeldung: Avalonia stellt unter X11 bei internem Ziehen
                                           keine effektabhaengigen Mauszeiger dar (siehe HighlightDropRow). -->
                                      <Style Selector="TreeViewItem /template/ ToggleButton">
                                          <!-- KEIN Aufklapp-Pfeil in diesem Baum: seine Flaeche liegt genau
                                               dort, wo die Zeilenvorlage ihren Inhalt hinzieht, und er stand
                                               deshalb mitten im Symbol. Aufgeklappt wird hier per Klick auf
                                               die Zeile (siehe OpenVirtualNavigationNode). Im ORDNERBAUM
                                               bleibt er - dort navigiert ein Klick, und ohne Pfeil kaeme man
                                               an die Unterordner nicht heran.
                                               UNSICHTBAR, ABER MIT PLATZ: IsVisible nimmt dem Pfeil auch
                                               seine Flaeche, und dann ruecken genau die Zeilen MIT Kindern
                                               um diese Breite nach links - sie stuenden aus der Reihe. -->
                                          <Setter Property="Opacity" Value="0"/>
                                          <Setter Property="IsHitTestVisible" Value="False"/>
                                      </Style>
                                      <Style Selector="TreeViewItem.drop-target /template/ Border#PART_LayoutRoot">
                                          <!-- NUR Farbe, KEINE Randstaerke: eine geaenderte BorderThickness
                                               vermisst die Zeile neu, das Element unter dem Zeiger wechselt,
                                               die Hervorhebung wandert - und der naechste Zeigerbericht
                                               beginnt von vorn. Farbe allein loest keinen Layoutlauf aus. -->
                                          <Setter Property="Background" Value="{DynamicResource FP.Accent.Dim}"/>
                                          <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
                                      </Style>
                                  </TreeView.Styles>
                                  <TreeView.ItemTemplate>
                                      <TreeDataTemplate ItemsSource="{Binding Children}">
                                          <!-- AllowDrop auch auf der Zeile selbst: die Ereignisse blubbern zwar zum
                                               TreeView hoch, aber der Mauszeiger richtet sich nach dem Element UNTER dem
                                               Zeiger - ohne die Angabe gilt die Zeile nicht als Ziel und es erscheint das
                                               Verbotszeichen, obwohl der Drop laeuft (Messung). Die Kacheln in
                                               der Galerie machen es genauso. -->
                                          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch" Background="Transparent"
                                              Classes="baumzeile"
                                                DragDrop.AllowDrop="True"
                                                PointerPressed="OnImmichNodePointerPressed">
                                              <Grid.ContextMenu>
                                                  <ContextMenu Opened="OnLocalizedMenuOpened">
                                                      <MenuItem Header="Zu Favoriten hinzufügen"
                                                                IsVisible="{Binding CanBecomeFavorite}"
                                                                Click="OnAddNodeFavoriteClick"/>
                                                      <Separator IsVisible="{Binding !IsTrashNode}"/>
                                                      <!-- Am PAPIERKORB gibt es nichts hochzuladen und nichts umzubenennen;
                                                           er trägt genau einen eigenen Eintrag. -->
                                                      <MenuItem Header="Bilder hochladen…" IsVisible="{Binding IsImmichNode}" Click="OnImmichUploadClick"/>
                                                      <MenuItem Header="Einfügen (nach Immich)" IsVisible="{Binding IsImmichNode}" Click="OnImmichPasteClick"/>
                                                      <MenuItem Header="Album umbenennen" IsVisible="{Binding IsImmichAlbumNode}" Click="OnImmichRenameAlbumClick"/>
                                                      <MenuItem Header="Album löschen" IsVisible="{Binding CanDeleteImmichAlbum}" Click="OnImmichDeleteAlbumClick"/>
                                                      <MenuItem Header="Papierkorb leeren" IsVisible="{Binding IsTrashNode}" Click="OnEmptyTrashClick"/>
                                                      <Separator IsVisible="{Binding !IsTrashNode}"/>
                                                      <MenuItem Header="Neues Album…" IsVisible="{Binding !IsTrashNode}" Click="OnImmichNewAlbumClick"/>
                                                  </ContextMenu>
                                              </Grid.ContextMenu>
                                              <icons:SvgIcon Source="{Binding ImmichIconSource}"
                                                             Margin="0" Width="17" Height="17" VerticalAlignment="Center" Opacity="0.85"/>
                                              <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                                         VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Body}"
                                                         TextTrimming="CharacterEllipsis"/>
                                          </Grid>
                                      </TreeDataTemplate>
                                  </TreeView.ItemTemplate>
                              </TreeView>
                    </ScrollViewer>
                </Grid>

                <!-- NEXTCLOUD-TAB: Suchlisten oben, darunter Zeitachse, Alben, Personen, Orte,
                     Stichwörter und Papierkorb. Aufbau wie im Immich-Tab. Eine Suchliste fragt NICHT
                     Memories (das kennt keine Textsuche), sondern die gemeinsame Suche von Nextcloud
                     selbst - siehe NextcloudService. -->
                <Grid Grid.Row="1" Margin="24,8,12,0" RowDefinitions="Auto,Auto,Auto,*"
                      ClipToBounds="True" IsVisible="{Binding IsNextcloudTab}">
                    <TextBlock Grid.Row="0" Text="Suchen" Margin="0,0,14,8"
                               FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" MaxHeight="260">
                        <TreeView Name="NextcloudSearchTreeView"
                                  ItemsSource="{Binding NextcloudSearchTree}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="OnVirtualTreeSelectionChanged">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                          Classes="baumzeile"
                                          ContextRequested="OnSearchNodeContextRequested">
                                        <Grid.ContextMenu>
                                            <ContextMenu Opened="OnLocalizedMenuOpened">
                                                <MenuItem Header="Zu Favoriten hinzufügen"
                                                          IsVisible="{Binding CanBecomeFavorite}"
                                                          Click="OnAddNodeFavoriteClick"/>
                                                <MenuItem Header="Bearbeiten"
                                                          IsVisible="{Binding IsRemovable}"
                                                          Click="OnEditVirtualSearchClick"/>
                                                <MenuItem Header="Entfernen"
                                                          IsVisible="{Binding IsRemovable}"
                                                          Click="OnRemoveVirtualSearchClick"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/search.svg"
                                                       Margin="0" Width="17" Height="17" VerticalAlignment="Center" Opacity="0.85"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Body}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2"
                                                Classes="ghost"
                                                Width="18"
                                                Height="18"
                                                Padding="0"
                                                Margin="4,0,4,0"
                                                HorizontalAlignment="Right"
                                                IsVisible="{Binding IsRemovable}"
                                                Click="OnRemoveVirtualSearchClick"
                                                ToolTip.Tip="Suche entfernen">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                                           Width="12" Height="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.75"/>
                                        </Button>
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="Nextcloud" Margin="0,26,14,8"
                               FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>

                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TreeView Name="NextcloudTreeView"
                                  ItemsSource="{Binding NextcloudTree}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  DragDrop.AllowDrop="True"
                                  DragDrop.DragOver="OnNextcloudTreeDragOver"
                                  DragDrop.Drop="OnNextcloudTreeDrop"
                                  DragDrop.DragLeave="OnTreeDragLeave"
                                  SelectionChanged="OnVirtualTreeSelectionChanged">
                            <TreeView.Styles>
                                <!-- Wie im Immich-Baum: das Element unter dem Zeiger ist der Border des
                                     TreeViewItem-Templates, dort muss AllowDrop sitzen. -->
                                <Style Selector="TreeViewItem">
                                    <Setter Property="DragDrop.AllowDrop" Value="True"/>
                                </Style>
                                <Style Selector="TreeViewItem /template/ ToggleButton">
                                    <!-- Kein Aufklapp-Pfeil, aber seine Flaeche bleibt - siehe Immich-Baum. -->
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </Style>
                                <Style Selector="TreeViewItem.drop-target /template/ Border#PART_LayoutRoot">
                                    <!-- Nur Farbe, keine Randstaerke - siehe Ordnerbaum. -->
                                    <Setter Property="Background" Value="{DynamicResource FP.Accent.Dim}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch" Background="Transparent"
                                              Classes="baumzeile"
                                          DragDrop.AllowDrop="True"
                                          PointerPressed="OnNextcloudNodePointerPressed">
                                        <Grid.ContextMenu>
                                            <ContextMenu Opened="OnLocalizedMenuOpened">
                                                <MenuItem Header="Zu Favoriten hinzufügen"
                                                          IsVisible="{Binding CanBecomeFavorite}"
                                                          Click="OnAddNodeFavoriteClick"/>
                                                <Separator IsVisible="{Binding !IsTrashNode}"/>
                                                <MenuItem Header="Bilder hochladen…" IsVisible="{Binding IsNextcloudNode}" Click="OnNextcloudUploadClick"/>
                                                <MenuItem Header="Einfügen" IsVisible="{Binding IsNextcloudNode}" Click="OnNextcloudPasteClick"/>
                                                <MenuItem Header="Album umbenennen" IsVisible="{Binding IsNextcloudAlbumNode}" Click="OnNextcloudRenameAlbumClick"/>
                                                <MenuItem Header="Album löschen" IsVisible="{Binding IsNextcloudAlbumNode}" Click="OnNextcloudDeleteAlbumClick"/>
                                                <MenuItem Header="Papierkorb leeren" IsVisible="{Binding IsTrashNode}" Click="OnEmptyTrashClick"/>
                                                <Separator IsVisible="{Binding !IsTrashNode}"/>
                                                <MenuItem Header="Neues Album…" IsVisible="{Binding !IsTrashNode}" Click="OnNextcloudNewAlbumClick"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <icons:SvgIcon Source="{Binding NextcloudIconSource}"
                                                       Margin="0" Width="17" Height="17" VerticalAlignment="Center" Opacity="0.85"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Body}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                </Grid>

                <!-- FAVORITEN-TAB: gemischte Liste aus Ordnern, Immich-Zielen und Suchlisten. -->
                <Grid Grid.Row="1" Margin="24,8,12,0" RowDefinitions="Auto,*"
                      ClipToBounds="True" IsVisible="{Binding IsFavoritesTab}">
                    <TextBlock Grid.Row="0" Text="Favoriten" Margin="0,0,14,8"
                               FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                    <Panel Grid.Row="1">
                        <TextBlock Text="Noch keine Favoriten. Ordner, Immich-Einträge und Suchlisten lassen sich per Rechtsklick als Favorit ablegen."
                                   TextWrapping="Wrap" Margin="0,4,14,0"
                                   Foreground="{DynamicResource FP.Text.Muted}"
                                   FontSize="{DynamicResource FP.Font.Caption}"
                                   IsVisible="{Binding !HasFavorites}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding HasFavorites}">
                            <TreeView Name="FavoritesTreeView"
                                  ItemsSource="{Binding FavoritesTree}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="OnVirtualTreeSelectionChanged">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                Classes="baumzeile"
                                          Background="Transparent">
                                        <!-- Die Favoriten fuehren die Kontextmenues ihrer Ziele mit: je nach
                                             Art des Favoriten erscheinen die Ordner-, Immich- oder Such-Eintraege
                                            . Sie rufen dieselben Handler wie in den
                                             Herkunftsbaeumen - "Aus Favoriten entfernen" steht bewusst getrennt
                                             darunter, damit es nicht mit "Loeschen" verwechselt wird. -->
                                        <Grid.ContextMenu>
                                            <ContextMenu Opened="OnLocalizedMenuOpened">
                                                <MenuItem Header="Neuer Ordner" IsVisible="{Binding IsFolderFavorite}"
                                                          Click="OnFavoriteCreateFolderClick"/>
                                                <MenuItem Header="Umbenennen" IsVisible="{Binding IsFolderFavorite}"
                                                          Click="OnFavoriteRenameFolderClick"/>
                                                <MenuItem Header="Kopieren" IsVisible="{Binding IsFolderFavorite}"
                                                          Click="OnFavoriteCopyFolderClick"/>
                                                <MenuItem Header="Ausschneiden" IsVisible="{Binding IsFolderFavorite}"
                                                          Click="OnFavoriteCutFolderClick"/>
                                                <MenuItem Header="Einfügen" IsVisible="{Binding IsFolderFavorite}"
                                                          Click="OnFavoritePasteFolderClick"/>
                                                <MenuItem Header="Pfad kopieren" IsVisible="{Binding IsFolderFavorite}"
                                                          Click="OnFavoriteCopyFolderPathClick"/>
                                                <MenuItem Header="Löschen" IsVisible="{Binding IsFolderFavorite}"
                                                          Click="OnFavoriteDeleteFolderClick"/>

                                                <MenuItem Header="Bearbeiten" IsVisible="{Binding IsSavedSearchNode}"
                                                          Click="OnEditVirtualSearchClick"/>
                                                <MenuItem Header="Suche entfernen" IsVisible="{Binding IsSavedSearchNode}"
                                                          Click="OnRemoveVirtualSearchClick"/>

                                                <MenuItem Header="Bilder hochladen…" IsVisible="{Binding IsImmichNode}"
                                                          Click="OnImmichUploadClick"/>
                                                <MenuItem Header="Einfügen (nach Immich)" IsVisible="{Binding IsImmichNode}"
                                                          Click="OnImmichPasteClick"/>
                                                <MenuItem Header="Album umbenennen" IsVisible="{Binding IsImmichAlbumNode}"
                                                          Click="OnImmichRenameAlbumClick"/>
                                                <MenuItem Header="Album löschen" IsVisible="{Binding CanDeleteImmichAlbum}"
                                                          Click="OnImmichDeleteAlbumClick"/>

                                                <!-- Dieselben Einträge für die zweite Serverquelle. Sie hängen
                                                     an ihren eigenen Bedingungen, ein Favorit zeigt also immer
                                                     nur das Menü SEINER Herkunft. -->
                                                <MenuItem Header="Bilder hochladen…" IsVisible="{Binding IsNextcloudNode}"
                                                          Click="OnNextcloudUploadClick"/>
                                                <MenuItem Header="Einfügen" IsVisible="{Binding IsNextcloudNode}"
                                                          Click="OnNextcloudPasteClick"/>
                                                <MenuItem Header="Album umbenennen" IsVisible="{Binding IsNextcloudAlbumNode}"
                                                          Click="OnNextcloudRenameAlbumClick"/>
                                                <MenuItem Header="Album löschen" IsVisible="{Binding IsNextcloudAlbumNode}"
                                                          Click="OnNextcloudDeleteAlbumClick"/>

                                                <Separator/>
                                                <MenuItem Header="Aus Favoriten entfernen" Click="OnRemoveFavoriteClick"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <icons:SvgIcon Source="{Binding FavoriteIconSource}"
                                                       Margin="0" Width="17" Height="17" VerticalAlignment="Center" Opacity="0.85"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontSize="{DynamicResource FP.Font.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding RootFolder}"/>
                                        <Button Grid.Column="2"
                                                Classes="ghost"
                                                HorizontalAlignment="Right"
                                                Width="18" Height="18" Padding="0" Margin="4,0,4,0"
                                                Click="OnRemoveFavoriteClick"
                                                ToolTip.Tip="Aus Favoriten entfernen">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                                           Width="12" Height="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.75"/>
                                        </Button>
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        </ScrollViewer>
                    </Panel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="24,18,24,21" Spacing="9">
                    <!-- Personen verwalten steht ÜBER den Einstellungen, weil es keine Einstellung
                         ist: hier arbeitet man am Bestand, so wie beim Ordnen und Bewerten. Der
                         Knopf erscheint nur mit eingeschalteter Erkennung - ohne sie führte er in
                         einen leeren Bereich. -->
                    <Button Classes="ghost"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,7"
                            IsVisible="{Binding HasPersonFeature}"
                            Click="OnManagePeopleClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/users.svg"
                                           Width="20" Height="20"/>
                            <TextBlock Text="Personen verwalten"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,7"
                            Click="OnSettingsClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/settings.svg"
                                           Width="20" Height="20"/>
                            <TextBlock Text="Einstellungen"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Eine Stufe groesser als die uebrigen Nebentexte (Small statt Caption): die
                         Zeile steht am unteren Rand der Leiste, in gedaempfter Farbe, und war in
                         Caption kaum zu lesen. Weiter ueber die Ressource und nicht als feste
                         Zahl, damit sie mit dem eingestellten Schriftgrad mitwaechst. -->
                    <TextBlock Text="{Binding StorageFreeText}"
                               Foreground="{DynamicResource FP.Text.Muted}"
                               FontSize="{DynamicResource FP.Font.Small}"/>
                    <ProgressBar Value="{Binding StorageFillPercent}"
                                 Minimum="0" Maximum="100"
                                 Height="4"
                                 CornerRadius="2"
                                 Foreground="{DynamicResource FP.Accent}"
                                 Background="#1B232B"/>
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="0"
                      Grid.RowSpan="3"
                      Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      Cursor="SizeWestEast"/>

        <!-- Dieselbe Info-Leiste wie in Betrachter und Editor. Ihren Zustand traegt hier ein
             eigenes ViewModel, das dem markierten Bild folgt. -->
        <!-- IsVisible MUSS hier stehen, nicht nur innen: die Info-Leiste blendet intern nur ihren
             Rahmen aus, das Steuerelement selbst blieb 320 Punkte breit und hielt die Spalte
             besetzt. Erst so gibt der eingeklappte Zustand den Platz an die Kacheln zurueck. -->
        <!-- Sichtbarkeit ueber den Vorfahren, nicht ueber den eigenen Datenkontext: der Zustand
             gehoert der Galerie und wird beim Start aus den Einstellungen gelesen. -->
        <views:InfoSidebarView Grid.Row="1" Grid.Column="3" Width="320"
                               IsVisible="{Binding DataContext.IsInfoSidebarVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               DataContext="{Binding InfoPanel}"/>

        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource FP.Bg.Root}" ClipToBounds="True">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                            IsVisible="{Binding CurrentFolder, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="Kein Ordner geöffnet" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Subtitle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Wähle einen Ordner in der Sidebar" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- DIE GRUPPENANSICHT BLEIBT EIN WrapPanel. Sie schiebt Kopfzeilen mit voller
                     Sonderbreite zwischen die Kacheln, und diese gemischten Breiten virtualisiert
                     WrapLayout im ItemsRepeater nicht zuverlaessig - es verlor beim Rollen seine
                     Zeilenhoehe. Das reine Raster hat dieses Problem nicht und laeuft deshalb
                     ueber einen eigenen Repeater darunter; die Kachel selbst teilen sich beide
                     (GalleryTileTemplate). -->
                <ScrollViewer x:Name="GalleryGroupScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PointerPressed="OnGalleryAreaPointerPressed"
                              IsVisible="{Binding IsGroupView}"
                              DragDrop.AllowDrop="True"
                              DragDrop.DragOver="OnGalleryAreaDragOver"
                              DragDrop.Drop="OnGalleryAreaDrop"
                              Margin="0,0,8,0">
                    <!-- VerticalAlignment=Top ist Pflicht: mit EXPLIZITER Höhe (ContentHeight-Virtualisierung)
                         zentriert das Standard-Alignment (Stretch) das Panel im größeren Viewport - bei
                         wenigen Bildern rutschte das ganze Raster in die vertikale Mitte. -->
                    <StackPanel Margin="12,12,18,20"
                                VerticalAlignment="Top"
                                Height="{Binding ContentHeight}">
                        <Border Height="{Binding TopSpacerHeight}"/>
                        <ItemsControl ItemsSource="{Binding DisplayItems}">
                            <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ImageItem}">
                              <!-- Zwei Gestalten in EINER Vorlage: eine Kachel oder, in der
                                   Gruppenansicht, die Kopfzeile einer Gruppe. Immer genau eine davon
                                   ist sichtbar; die unsichtbare wird nicht vermessen, das Panel ist
                                   damit so breit wie die sichtbare. Im Raster kommt eine Kopfzeile
                                   nie vor - dort stehen im Anzeigefenster nur echte Elemente. -->
                              <Panel>
                                <!-- Kopfzeile einer Gruppe. Die Hoehe ist fest und muss mit
                                     GalleryViewModel.GroupHeaderRowHeight uebereinstimmen, sonst
                                     driftet die Scrollrechnung mit der Scrolltiefe. Die Breite ist
                                     genau eine volle Kachelzeile, damit das WrapPanel die Kopfzeile
                                     immer allein in eine Zeile setzt.
                                     no-translate ist Pflicht: der Uebersetzungsdurchlauf schreibt
                                     sonst Text zu und bricht die Bindung. -->
                                <!-- WEIL SIE IM RASTER NIE VORKOMMT, wird sie dort auch nicht mehr
                                     gebaut: der ContentControl bekommt seinen Inhalt nur, wenn das
                                     Element wirklich eine Kopfzeile ist (GroupHeaderContent gibt
                                     sich selbst zurueck, sonst Nothing). Vorher entstanden ihre
                                     sieben Steuerelemente in JEDER Kachel, nur um unsichtbar zu
                                     bleiben - bei vierzig sichtbaren Kacheln also 280 Stueck, die
                                     bei jedem Rollschritt mit erzeugt und vermessen wurden. -->
                                <ContentControl Content="{Binding GroupHeaderContent}"
                                                ContentTemplate="{StaticResource GalleryGroupHeaderTemplate}"/>
                                <!-- Und dasselbe umgekehrt: eine Gruppenkopfzeile baut keine Kachel
                                     mehr auf. Das sind rund fuenfzig Steuerelemente je Kopfzeile,
                                     die vorher nur entstanden, um ausgeblendet zu werden. -->
                                <ContentControl Content="{Binding TileContent}"
                                                ContentTemplate="{StaticResource GalleryTileTemplate}"/>
                              </Panel>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="{Binding BottomSpacerHeight}"/>
                    </StackPanel>
                </ScrollViewer>
                <!-- DIE KACHEL STEHT EINMAL, und beide Ansichten holen sie sich von hier: das
                     Raster als ItemTemplate seines Repeaters, die Gruppenansicht als
                     ContentTemplate in ihrer Kopfzeilen-Weiche. Eine zweite Kopie waere nach drei
                     Aenderungen auseinandergelaufen.

                     REIHENFOLGE BEACHTEN: StaticResource laeuft den Elternstapel ab und loest zur
                     KONSTRUKTIONSZEIT auf (Avalonia.Markup.Xaml StaticResourceExtension). Wer den
                     Schluessel ausserhalb einer DataTemplate benutzt, muss deshalb UNTER diesem
                     Block stehen - beim Rasterpfad direkt darunter ist das der Fall. Die
                     Gruppenansicht darueber benutzt ihn nur INNERHALB ihrer DataTemplate, und deren
                     Inhalt entsteht erst, wenn eine Kachel gebraucht wird; da steht die Ressource
                     laengst. Ein neuer Nutzer oberhalb dieses Blocks, der nicht in einer
                     DataTemplate steckt, faende den Schluessel nicht. -->
                <Grid.Resources>
                  <DataTemplate x:Key="GalleryTileTemplate" DataType="{x:Type models:ImageItem}">
                                <Border Name="ThumbBorder"
                                        Classes="thumb-card"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.navigation-selected="{Binding IsNavigationSelected}"
                                        AttachedToVisualTree="OnGalleryItemAttachedToVisualTree"
                                        Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Cursor="Hand"
                                        PointerPressed="OnThumbnailPointerPressed"
                                        PointerMoved="OnThumbnailPointerMoved"
                                        DoubleTapped="OnThumbnailDoubleTapped"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnItemDragOver"
                                        DragDrop.Drop="OnItemDrop">
                                    <!-- Beschriftungszeile: AUTO, damit der Streifen exakt so hoch ist wie sein Inhalt.
                                         Eine feste Höhe hinterließ unter dem Text einen sichtbaren Leerstreifen und
                                         würde bei größerer Schrift klemmen. -->
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource FP.Bg.Input}"
                                                Height="{Binding DataContext.ThumbnailImageHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ClipToBounds="True"
                                                CornerRadius="8,8,0,0">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       IsVisible="{Binding IsImage}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="MediumQuality"/>
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/folder.svg"
                                                               IsVisible="{Binding IsFolder}"
                                                               Width="54" Height="54"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IconBrush="{DynamicResource FP.Accent}"/>
                                                <Button IsVisible="{Binding IsVideoFile}"
                                                        Classes="video-play-badge"
                                                        Width="46" Height="46"
                                                        CornerRadius="23"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Click="OnVideoPlayBadgeClick"
                                                        ToolTip.Tip="Abspielen">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/player-play.svg"
                                                                   Width="22" Height="22"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   IconBrush="White"/>
                                                </Button>
                                                <Button Classes="selection-badge"
                                                        Width="16"
                                                        Height="16"
                                                        IsVisible="{Binding IsSelectableEntry}"
                                                        Classes.active="{Binding IsSelected}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Click="OnSelectionBadgeClick"
                                                        ToolTip.Tip="Auswählen">
                                                    <!-- Ohne den Kreis aus circle-check: der Knopf selbst ist schon rund. -->
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/check.svg"
                                                                   Width="14"
                                                                   Height="14"
                                                                   Classes="badge-glyph"
                                                                   IsVisible="{Binding IsSelected}"/>
                                                </Button>
                                                <!-- DIE AUFSAETZE DER KACHEL stehen bewusst FEST in
                                                     der Vorlage und werden ueber Opacity versteckt.
                                                     Sie erst beim Ueberfahren zu bauen war am
                                                     2026-08-28 kurz eingebaut und ist wieder
                                                     draussen: gemessen brachte es nichts (die Zeit
                                                     steckte im zu grossen Anzeigefenster, nicht in
                                                     der Zahl der Steuerelemente), und beim Rollen
                                                     mit dem Mausrad wanderten die Kacheln unter dem
                                                     Zeiger durch - jede baute dabei ihre
                                                     fuenfunddreissig Aufsaetze auf und gleich wieder
                                                     ab. Das Rollen wurde dadurch traeger, nicht
                                                     schneller. -->
                                                <StackPanel Classes="gallery-hover-actions"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="8"
                                                            Spacing="5">
                                                    <Button Classes="gallery-overlay-btn"
                                                            Width="30"
                                                            Height="30"
                                                            Padding="0"
                                                            IsVisible="{Binding IsImage}"
                                                            Click="OnHoverOpenViewerClick"
                                                            ToolTip.Tip="Anzeigen">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eye.svg"
                                                                       Width="17"
                                                                       Height="17"
                                                                       IconBrush="White"/>
                                                    </Button>
                                                    <Button Classes="gallery-overlay-btn"
                                                            Width="30"
                                                            Height="30"
                                                            Padding="0"
                                                            IsVisible="{Binding CanEditFile}"
                                                            Click="OnHoverOpenEditorClick"
                                                            ToolTip.Tip="Anpassen">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/exposure.svg"
                                                                       Width="17"
                                                                       Height="17"
                                                                       IconBrush="White"/>
                                                    </Button>
                                                    <Button Classes="gallery-overlay-btn danger"
                                                            Width="30"
                                                            Height="30"
                                                            Padding="0"
                                                            IsVisible="{Binding CanFileOperationDelete}"
                                                            Click="OnHoverDeleteClick"
                                                            ToolTip.Tip="Löschen">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/trash.svg"
                                                                       Width="18"
                                                                       Height="18"
                                                                       IconBrush="White"/>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Classes="gallery-rating-actions gallery-toggle-badge"
                                                            Classes.badge-always="{Binding DataContext.RatingBadgesAlwaysVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            Margin="8,0,0,8"
                                                            Spacing="1"
                                                            IsVisible="{Binding IsImage}">
                                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=1}"
                                                            Tag="1"
                                                            Click="OnHoverSetRatingClick">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                       Classes="rating-star"
                                                                       Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=2}"
                                                            Tag="2"
                                                            Click="OnHoverSetRatingClick">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                       Classes="rating-star"
                                                                       Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=3}"
                                                            Tag="3"
                                                            Click="OnHoverSetRatingClick">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                       Classes="rating-star"
                                                                       Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=4}"
                                                            Tag="4"
                                                            Click="OnHoverSetRatingClick">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                       Classes="rating-star"
                                                                       Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=5}"
                                                            Tag="5"
                                                            Click="OnHoverSetRatingClick">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                                       Classes="rating-star"
                                                                       Width="16" Height="16" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom">
                                                    <StackPanel Classes="gallery-meta-badges gallery-toggle-badge"
                                                            Classes.badge-always="{Binding DataContext.MetadataBadgesAlwaysVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            IsVisible="{Binding DataContext.TileHasRoomForDetails, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="0,0,20,4"
                                                            Spacing="0">
                                                        <Border Width="32" Height="32"
                                                                Background="Transparent"
                                                                IsVisible="{Binding HasExifMetadata}"
                                                                Tag="Exif"
                                                                PointerEntered="OnMetadataBadgePointerEntered"
                                                                PointerExited="OnMetadataBadgePointerExited"
                                                                ToolTip.Tip="EXIF vorhanden">
                                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/EXIF.svg"
                                                                       Classes="gallery-meta-icon"
                                                                       Width="26"
                                                                       Height="26"
                                                                       IconBrush="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Bottom"
                                                                       IsHitTestVisible="False">
                                                                <icons:SvgIcon.Effect>
                                                                    <DropShadowEffect BlurRadius="6"
                                                                                      OffsetX="0"
                                                                                      OffsetY="1"
                                                                                      Color="#B0000000"/>
                                                                </icons:SvgIcon.Effect>
                                                            </icons:SvgIcon>
                                                        </Border>
                                                        <Border Width="32" Height="32"
                                                                Background="Transparent"
                                                                IsVisible="{Binding HasIptcMetadata}"
                                                                Tag="Iptc"
                                                                PointerEntered="OnMetadataBadgePointerEntered"
                                                                PointerExited="OnMetadataBadgePointerExited"
                                                                ToolTip.Tip="IPTC vorhanden">
                                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/IPTC.svg"
                                                                       Classes="gallery-meta-icon"
                                                                       Width="26"
                                                                       Height="26"
                                                                       IconBrush="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Bottom"
                                                                       IsHitTestVisible="False">
                                                                <icons:SvgIcon.Effect>
                                                                    <DropShadowEffect BlurRadius="6"
                                                                                      OffsetX="0"
                                                                                      OffsetY="1"
                                                                                      Color="#B0000000"/>
                                                                </icons:SvgIcon.Effect>
                                                            </icons:SvgIcon>
                                                        </Border>
                                                        <Border Width="32" Height="32"
                                                                Background="Transparent"
                                                                IsVisible="{Binding HasXmpMetadata}"
                                                                Tag="Xmp"
                                                                PointerEntered="OnMetadataBadgePointerEntered"
                                                                PointerExited="OnMetadataBadgePointerExited"
                                                                ToolTip.Tip="XMP vorhanden">
                                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/XMP.svg"
                                                                       Classes="gallery-meta-icon"
                                                                       Width="26"
                                                                       Height="26"
                                                                       IconBrush="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Bottom"
                                                                       IsHitTestVisible="False">
                                                                <icons:SvgIcon.Effect>
                                                                    <DropShadowEffect BlurRadius="6"
                                                                                      OffsetX="0"
                                                                                      OffsetY="1"
                                                                                      Color="#B0000000"/>
                                                                </icons:SvgIcon.Effect>
                                                            </icons:SvgIcon>
                                                        </Border>
                                                        <Border Width="32" Height="32"
                                                                Background="Transparent"
                                                                IsVisible="{Binding HasIccProfile}"
                                                                Tag="Icc"
                                                                PointerEntered="OnMetadataBadgePointerEntered"
                                                                PointerExited="OnMetadataBadgePointerExited"
                                                                ToolTip.Tip="ICC-Farbprofil vorhanden">
                                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/ICC.svg"
                                                                       Classes="gallery-meta-icon"
                                                                       Width="26"
                                                                       Height="26"
                                                                       IconBrush="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Bottom"
                                                                       IsHitTestVisible="False">
                                                                <icons:SvgIcon.Effect>
                                                                    <DropShadowEffect BlurRadius="6"
                                                                                      OffsetX="0"
                                                                                      OffsetY="1"
                                                                                      Color="#B0000000"/>
                                                                </icons:SvgIcon.Effect>
                                                            </icons:SvgIcon>
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Classes="favorite-btn image-favorite-btn gallery-toggle-badge"
                                                        Classes.badge-always="{Binding DataContext.FavoriteBadgeAlwaysVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,4,4"
                                                        IsVisible="{Binding IsImage}"
                                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Favorit">
                                                        <Grid>
                                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                                           Width="20" Height="20"
                                                                           Classes="fav-heart"
                                                                           IsVisible="{Binding !IsFavorite}"/>
                                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                                           Width="20" Height="20"
                                                                           Classes="fav-heart active"
                                                                           IsVisible="{Binding IsFavorite}"/>
                                                        </Grid>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" Background="{DynamicResource FP.Bg.Content}" CornerRadius="0,0,8,8" Padding="14,9">
                                            <StackPanel Spacing="7">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Fill="{Binding ColorLabelBrush}"
                                                             IsVisible="{Binding HasColorLabel}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                               FontSize="{DynamicResource FP.Font.ItemTitle}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <!-- Datum und Maße stehen zusammen LINKS in einer Zeile,
                                                     die Dateigröße rechts. Als drei feste Grid-Spalten
                                                     hing die Bildgröße an der Dateigröße, sobald das
                                                     Datum auf schmalen Kacheln wegfiel. -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DateText}"
                                                                   IsVisible="{Binding DataContext.TileHasRoomForDetails, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                                                   FontSize="{DynamicResource FP.Font.Body}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DimensionsText}"
                                                                   IsVisible="{Binding DimensionsText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                                                   FontSize="{DynamicResource FP.Font.Body}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FileSizeText}"
                                                               Foreground="{DynamicResource FP.Text.Secondary}"
                                                               FontSize="{DynamicResource FP.Font.Body}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                  </DataTemplate>
                </Grid.Resources>

                <!-- DAS REINE RASTER. Hier gibt es keine Kopfzeilen, also sind alle Kacheln gleich
                     gross - und genau das braucht UniformGridLayout, um im ItemsRepeater zu
                     virtualisieren. Der Repeater behaelt beim Rollen seine Kacheln und setzt ihnen
                     neue Daten, statt sie neu zu bauen; im nicht virtualisierenden WrapPanel war
                     jede einzelne Aenderung an DisplayItems ein Layoutlauf ueber alle Kacheln
                     (gemessen bis 350 ms je Rollschritt, Nutzerprotokoll 2026-08-27).
                     Die Kachelmasse kommen aus der Kachel selbst (Breite ThumbnailSize plus das
                     Aussenmass 5 der thumb-card, also GridColumnPitch); dieselbe Rechnung stellt
                     GetGridLayoutMetrics im Code dahinter an, damit Scrollrechnung und Layout
                     nicht auseinanderlaufen. -->
                <ScrollViewer x:Name="GalleryGridScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PointerPressed="OnGalleryAreaPointerPressed"
                              IsVisible="{Binding IsGridView}"
                              DragDrop.AllowDrop="True"
                              DragDrop.DragOver="OnGalleryAreaDragOver"
                              DragDrop.Drop="OnGalleryAreaDrop"
                              Margin="0,0,8,0">
                    <!-- KEIN HANDFENSTER MEHR. Der Repeater haengt direkt an Items und traegt den
                         Rollbereich selbst; Platzhalter, ContentHeight und SetDisplayWindow gibt es
                         hier nicht. Zwei Gruende:

                         Erstens war es doppelt gemoppelt - DisplayItems hielt rund 120 Eintraege,
                         und der Repeater virtualisierte darin ein zweites Mal. Der Gewinn kam vom
                         Wiederverwenden der Kacheln, nicht von dieser zweiten Schicht.

                         Zweitens erzeugte die Kombination eine Klemme: in einem StackPanel mit
                         fester Hoehe ist ein leer gestarteter Repeater null hoch, hat damit ein
                         leeres Sichtfenster, realisiert nichts - und bleibt null hoch. Alles, was
                         seinen Inhalt ERST NACH dem Aufbau bekam, blieb leer (Ordner ohne
                         Katalogdaten, Suchlisten, Immich, Nextcloud). Als eigener Inhalt des
                         ScrollViewers bekommt er sein Sichtfenster von diesem und kann gar nicht
                         mehr hineingeraten.

                         MinItemWidth/MinItemHeight werden BEWUSST NICHT gesetzt. Sie sind kein
                         Mindestmass, sondern eine Ansage: UniformGridLayoutState.SetSize nimmt den
                         angegebenen Wert unveraendert und vergleicht ihn NICHT mit der gemessenen
                         Kachel. Aus GridItemSlotHeight - einem Schaetzwert fuer die Scrollrechnung -
                         wurde damit eine zu kurze Zeile, und der Akzentrahmen unten war
                         abgeschnitten (Nutzerbefund 2026-08-28).
                         Ungesetzt stehen beide auf NaN, und dann misst das Layout Element 0 (es
                         erzeugt es notfalls eigens dafuer, siehe EnsureElementSize). Es kennt die
                         Kachelmasse also immer - auch bevor irgendetwas realisiert ist. -->
                    <ItemsRepeater ItemsSource="{Binding Items}"
                                   Margin="12,12,18,20"
                                   VerticalAlignment="Top"
                                   ItemTemplate="{StaticResource GalleryTileTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal"
                                               ItemsStretch="None"
                                               ItemsJustification="Start"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <ScrollViewer x:Name="GalleryListScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PointerPressed="OnGalleryAreaPointerPressed"
                              IsVisible="{Binding IsListView}"
                              DragDrop.AllowDrop="True"
                              DragDrop.DragOver="OnGalleryAreaDragOver"
                              DragDrop.Drop="OnGalleryAreaDrop"
                              Margin="0,0,8,0">
                    <!-- VerticalAlignment=Top: siehe Kommentar an der Raster-Ansicht (explizite Höhe
                         + Stretch-Default = vertikal zentriert bei kurzem Inhalt). -->
                    <StackPanel Margin="12,12,18,20"
                                VerticalAlignment="Top"
                                Height="{Binding ContentHeight}">
                        <Border Height="{Binding TopSpacerHeight}"/>
                        <!-- Der Repeater behaelt beim Rollen die bereits aufgebauten Zeilen und
                             verwendet sie fuer neue Eintraege wieder. DisplayItems bleibt hier
                             vorerst als Sicherheitsfenster bestehen; so bleibt die gleiche
                             Scroll-Geometrie wie im bewährten Rasterpfad erhalten. -->
                        <!-- MinHeight wie im Raster - dieselbe Klemme, siehe
                             GalleryViewModel.DisplayWindowHeight. -->
                        <ItemsRepeater ItemsSource="{Binding DisplayItems}"
                                       MinHeight="{Binding DisplayWindowHeight}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ImageItem}">
                            <Border Name="ListItemBorder"
                                        Classes="thumb-card list-row"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.navigation-selected="{Binding IsNavigationSelected}"
                                        AttachedToVisualTree="OnGalleryItemAttachedToVisualTree"
                                        Cursor="Hand"
                                        PointerPressed="OnThumbnailPointerPressed"
                                        PointerMoved="OnThumbnailPointerMoved"
                                        DoubleTapped="OnThumbnailDoubleTapped"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnItemDragOver"
                                        DragDrop.Drop="OnItemDrop">
                                    <Grid ColumnDefinitions="76,*,150,90,90,Auto,Auto,28" Height="72">
                                        <Border Grid.Column="0"
                                                Width="56"
                                                Height="56"
                                                Background="{DynamicResource FP.Bg.Input}"
                                                ClipToBounds="True"
                                                CornerRadius="6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       IsVisible="{Binding IsImage}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="MediumQuality"/>
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/folder.svg"
                                                               IsVisible="{Binding IsFolder}"
                                                               Width="28" Height="28"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IconBrush="{DynamicResource FP.Accent}"/>
                                                <Button IsVisible="{Binding IsVideoFile}"
                                                        Classes="video-play-badge"
                                                        Width="26" Height="26"
                                                        CornerRadius="13"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Click="OnVideoPlayBadgeClick"
                                                        ToolTip.Tip="Abspielen">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/player-play.svg"
                                                                   Width="13" Height="13"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   IconBrush="White"/>
                                                </Button>
                                                <Button Classes="selection-badge compact"
                                                        Width="14"
                                                        Height="14"
                                                        IsVisible="{Binding IsSelectableEntry}"
                                                        Classes.active="{Binding IsSelected}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Click="OnSelectionBadgeClick"
                                                        ToolTip.Tip="Auswählen">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/check.svg"
                                                                   Width="12"
                                                                   Height="12"
                                                                   Classes="badge-glyph"
                                                                   IsVisible="{Binding IsSelected}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="5"
                                                    Margin="4,0,14,0">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{Binding ColorLabelBrush}"
                                                         IsVisible="{Binding HasColorLabel}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                           FontSize="{DynamicResource FP.Font.ItemTitle}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="2"
                                                            Classes="gallery-toggle-badge"
                                                            Classes.badge-always="{Binding DataContext.MetadataBadgesAlwaysVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Orientation="Horizontal"
                                                            Spacing="4"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,24,0"
                                                            HorizontalAlignment="Right">
                                                    <!-- JEDES ZEICHEN STECKT IN EINEM EIGENEN KAESTCHEN, genau wie in der
                                                         Rasteransicht: die Vorschau haengt an PointerEntered, und ein
                                                         Symbol allein wird nur auf seinen GEZEICHNETEN Pixeln getroffen -
                                                         zwischen den Strichen liefe der Zeiger daran vorbei. Der
                                                         durchsichtige Hintergrund macht daraus eine geschlossene
                                                         Trefferflaeche, das Symbol selbst nimmt keine Ereignisse mehr an.
                                                         Die Kennung im Tag sagt dem Ereignis, welcher Block gemeint ist. -->
                                                    <Border Width="26" Height="26"
                                                            Background="Transparent"
                                                            IsVisible="{Binding HasExifMetadata}"
                                                            Tag="Exif"
                                                            PointerEntered="OnMetadataBadgePointerEntered"
                                                            PointerExited="OnMetadataBadgePointerExited"
                                                            ToolTip.Tip="EXIF vorhanden">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/EXIF.svg"
                                                                       Classes="gallery-meta-icon compact"
                                                                       Width="26"
                                                                       Height="26"
                                                                       IconBrush="White"
                                                                       IsHitTestVisible="False">
                                                            <icons:SvgIcon.Effect>
                                                                <DropShadowEffect BlurRadius="6"
                                                                                  OffsetX="0"
                                                                                  OffsetY="1"
                                                                                  Color="#B0000000"/>
                                                            </icons:SvgIcon.Effect>
                                                        </icons:SvgIcon>
                                                    </Border>
                                                    <Border Width="26" Height="26"
                                                            Background="Transparent"
                                                            IsVisible="{Binding HasIptcMetadata}"
                                                            Tag="Iptc"
                                                            PointerEntered="OnMetadataBadgePointerEntered"
                                                            PointerExited="OnMetadataBadgePointerExited"
                                                            ToolTip.Tip="IPTC vorhanden">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/IPTC.svg"
                                                                       Classes="gallery-meta-icon compact"
                                                                       Width="26"
                                                                       Height="26"
                                                                       IconBrush="White"
                                                                       IsHitTestVisible="False">
                                                            <icons:SvgIcon.Effect>
                                                                <DropShadowEffect BlurRadius="6"
                                                                                  OffsetX="0"
                                                                                  OffsetY="1"
                                                                                  Color="#B0000000"/>
                                                            </icons:SvgIcon.Effect>
                                                        </icons:SvgIcon>
                                                    </Border>
                                                    <Border Width="26" Height="26"
                                                            Background="Transparent"
                                                            IsVisible="{Binding HasXmpMetadata}"
                                                            Tag="Xmp"
                                                            PointerEntered="OnMetadataBadgePointerEntered"
                                                            PointerExited="OnMetadataBadgePointerExited"
                                                            ToolTip.Tip="XMP vorhanden">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/XMP.svg"
                                                                       Classes="gallery-meta-icon compact"
                                                                       Width="26"
                                                                       Height="26"
                                                                       IconBrush="White"
                                                                       IsHitTestVisible="False">
                                                            <icons:SvgIcon.Effect>
                                                                <DropShadowEffect BlurRadius="6"
                                                                                  OffsetX="0"
                                                                                  OffsetY="1"
                                                                                  Color="#B0000000"/>
                                                            </icons:SvgIcon.Effect>
                                                        </icons:SvgIcon>
                                                    </Border>
                                                    <Border Width="26" Height="26"
                                                            Background="Transparent"
                                                            IsVisible="{Binding HasIccProfile}"
                                                            Tag="Icc"
                                                            PointerEntered="OnMetadataBadgePointerEntered"
                                                            PointerExited="OnMetadataBadgePointerExited"
                                                            ToolTip.Tip="ICC-Farbprofil vorhanden">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/ICC.svg"
                                                                       Classes="gallery-meta-icon compact"
                                                                       Width="26"
                                                                       Height="26"
                                                                       IconBrush="White"
                                                                       IsHitTestVisible="False">
                                                            <icons:SvgIcon.Effect>
                                                                <DropShadowEffect BlurRadius="6"
                                                                                  OffsetX="0"
                                                                                  OffsetY="1"
                                                                                  Color="#B0000000"/>
                                                            </icons:SvgIcon.Effect>
                                                        </icons:SvgIcon>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding FilePath}"
                                                       Foreground="{DynamicResource FP.Text.Muted}"
                                                       FontSize="{DynamicResource FP.Font.Small}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DateText}"
                                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DimensionsText}"
                                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding FileSizeText}"
                                                   Foreground="{DynamicResource FP.Text.Secondary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,14,0"/>
                                        <StackPanel Grid.Column="5"
                                                    Classes="gallery-hover-actions"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0"
                                                    Spacing="5">
                                            <Button Classes="gallery-overlay-btn"
                                                    Width="26" Height="26" Padding="0"
                                                    IsVisible="{Binding IsImage}"
                                                    Click="OnHoverOpenViewerClick"
                                                    ToolTip.Tip="Anzeigen">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eye.svg"
                                                               Width="15" Height="15" IconBrush="White"/>
                                            </Button>
                                            <Button Classes="gallery-overlay-btn"
                                                    Width="26" Height="26" Padding="0"
                                                    IsVisible="{Binding CanEditFile}"
                                                    Click="OnHoverOpenEditorClick"
                                                    ToolTip.Tip="Anpassen">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/exposure.svg"
                                                               Width="15" Height="15" IconBrush="White"/>
                                            </Button>
                                            <Button Classes="gallery-overlay-btn danger"
                                                    Width="26" Height="26" Padding="0"
                                                    IsVisible="{Binding CanFileOperationDelete}"
                                                    Click="OnHoverDeleteClick"
                                                    ToolTip.Tip="Löschen">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/trash.svg"
                                                               Width="16" Height="16" IconBrush="White"/>
                                            </Button>
                                        </StackPanel>
                                        <!-- Sterne und Aktionen liegen in der LISTE in der Zeile, nicht auf dem Bild: auf 56 px
                                             Kantenlaenge verdecken sie das Motiv fast vollstaendig. Auf dem Bild bleibt nur der
                                             Auswahlkreis. Sichtbarkeit wie gehabt ueber gallery-toggle-badge (versteckt / bei
                                             Zeilen-Mausover / dauerhaft) - die Regeln haengen an Border.thumb-card, das die
                                             Listenzeile ebenfalls traegt. -->
                                        <StackPanel Grid.Column="6"
                                                    Classes="gallery-rating-actions compact gallery-toggle-badge"
                                                    Classes.badge-always="{Binding DataContext.RatingBadgesAlwaysVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0"
                                                    Spacing="0"
                                                    IsVisible="{Binding IsImage}">
                                            <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=1}"
                                                    Tag="1"
                                                    Click="OnHoverSetRatingClick">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                               Classes="rating-star"
                                                               Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=2}"
                                                    Tag="2"
                                                    Click="OnHoverSetRatingClick">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                               Classes="rating-star"
                                                               Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=3}"
                                                    Tag="3"
                                                    Click="OnHoverSetRatingClick">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                               Classes="rating-star"
                                                               Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=4}"
                                                    Tag="4"
                                                    Click="OnHoverSetRatingClick">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                               Classes="rating-star"
                                                               Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=5}"
                                                    Tag="5"
                                                    Click="OnHoverSetRatingClick">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                               Classes="rating-star"
                                                               Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                        <Button Grid.Column="7"
                                                Classes="favorite-btn gallery-toggle-badge"
                                                Classes.badge-always="{Binding DataContext.FavoriteBadgeAlwaysVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0,2,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsImage}"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Favorit">
                                            <Grid>
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                               Width="20" Height="20"
                                                               Classes="fav-heart"
                                                               IsVisible="{Binding !IsFavorite}"/>
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                               Width="20" Height="20"
                                                               Classes="fav-heart active"
                                                               IsVisible="{Binding IsFavorite}"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Border Height="{Binding BottomSpacerHeight}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Zeitleiste am rechten Rand (wie Immich): Grob-Marker der aktuellen Sortierung
                     (Jahre bzw. Anfangsbuchstaben), Positions-Band und Sprechblase beim Ziehen.
                     Ein Control für beide Ansichten - Daten/Scroll-Zustand und Sichtbarkeit
                     verdrahtet der Code-Behind (UpdateTimelineScrubber). -->
                <icons:GalleryTimelineScrubber x:Name="GalleryTimelineScrubber"
                                               HorizontalAlignment="Right"
                                               Width="64"
                                               Margin="0,12,10,12"
                                               ZIndex="40"
                                               IsVisible="False"
                                               LabelBrush="{DynamicResource FP.Text.Muted}"
                                               AccentBrush="{DynamicResource FP.Accent}"
                                               BubbleBackground="{DynamicResource FP.Bg.Panel}"
                                               BubbleForeground="{DynamicResource FP.Text.Primary}"/>

                <Border Classes="gallery-metadata-overlay"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,32,64,0"
                        MaxWidth="340"
                        ZIndex="50"
                        IsHitTestVisible="False"
                        IsVisible="{Binding HoveredMetadataTitle, Converter={StaticResource StringNotEmptyToBoolConverter}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding HoveredMetadataTitle}"
                                   FontSize="{DynamicResource FP.Font.ItemTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding HoveredMetadataText}"
                                   FontSize="{DynamicResource FP.Font.Small}"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Höhe wie die Fußzeilen von Editor und Betrachter: dort ergibt sich 40 aus 6 Rand,
             28 Knopfhöhe, 6 Rand. Eine Fußzeile, die je nach Ansicht anders hoch ist, springt beim
             Umschalten. -->
        <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Classes="statusbar window-drag" Height="40" Padding="20,6"
                IsVisible="{Binding ShowFooter}">
            <!-- EINE SPALTE, drei Ausrichtungen. Mit "*,Auto,*" sass die Mitte NICHT in der Mitte:
                 eine Sternspalte wird nie schmaler als ihr Inhalt, und die breitere Seite schob die
                 mittlere Gruppe weg. Mittig heisst hier mittig zur LEISTE - die beginnt rechts der
                 Ordnerspalte, und weiter links waere die Mitte halb unter der Seitenleiste. -->
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Zeigt dasselbe Menü wie ein Rechtsklick auf ein Bild: dort stecken inzwischen die
                         meisten Stapelfunktionen, und ein Rechtsklick ist nicht auf jedem Gerät bequem.
                         Die Einträge tragen keine IsVisible-Bindungen - OnGalleryMenuButtonClick setzt
                         jede Sichtbarkeit über UpdateGalleryItemContextMenu selbst. -->
                    <!-- Immer bedienbar, auch ohne Auswahl: es bleiben Aktionen, die kein Bild
                         brauchen - neuer Ordner, einfügen, neues Bild, Vollbild. Der Bauplan
                         entscheidet, was davon erscheint. -->
                    <Button Classes="icon-btn" Width="28" Height="28"
                            Margin="-7,0,0,0"
                            Click="OnGalleryMenuButtonClick"
                            ToolTip.Tip="Menü">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/menu-2.svg"
                                       Width="18" Height="18"/>
                    </Button>
                    <Button Classes="icon-btn" Width="28" Height="28"
                            Command="{Binding SelectAllCommand}"
                            ToolTip.Tip="Alle auswählen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/check.svg"
                                       Width="18" Height="18"/>
                    </Button>
                    <Button Classes="icon-btn" Width="28" Height="28"
                            Command="{Binding ClearSelectionCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="Alle abwählen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/deselect.svg"
                                       Width="18" Height="18"/>
                    </Button>
                    <TextBlock
                               Text="{Binding FooterStatusText}"
                               Foreground="{DynamicResource FP.Text.Secondary}"
                               FontSize="{DynamicResource FP.Font.Body}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                    <!-- Was im Hintergrund noch laeuft: Vorschaubilder und Metadaten. Die Zeile
                         steht nur da, solange wirklich etwas laeuft, und traegt einen kleinen
                         Punkt davor - ohne ihn saehe die Zahl aus wie ein Teil der Angabe links.
                         Der Text kommt aus dem ViewModel und ist dort schon uebersetzt. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasBackgroundWork}">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{DynamicResource FP.Accent}"/>
                        <TextBlock Text="{Binding BackgroundWorkText}"
                                   Classes="no-translate"
                                   Foreground="{DynamicResource FP.Text.Muted}"
                                   FontSize="{DynamicResource FP.Font.Body}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Classes="ghost" Height="20" Padding="4,0,4,2" VerticalContentAlignment="Center" Focusable="False"
                            Command="{Binding DecreaseThumbnailSizeCommand}" ToolTip.Tip="Verkleinern">
                        <TextBlock Text="−" FontSize="{DynamicResource FP.Glyph.Large}" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center"/>
                    </Button>
                    <icons:RoundSlider Width="136"
                                       Minimum="140"
                                       Maximum="520"
                                       DefaultValue="260"
                                       Value="{Binding ThumbnailSize}"
                                       VerticalAlignment="Center"/>
                    <Button Classes="ghost" Height="20" Padding="4,0,4,2" VerticalContentAlignment="Center" Focusable="False"
                            Command="{Binding IncreaseThumbnailSizeCommand}" ToolTip.Tip="Vergrößern">
                        <TextBlock Text="+" FontSize="{DynamicResource FP.Glyph.Large}" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                
                <StackPanel Spacing="12" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Die Gesichtssuche über die Ansicht meldete sich früher hier mit eigenem
                         Balken. Sie zeigt jetzt oben an der Stelle des Suchfelds, zusammen mit den
                         übrigen Läufen - hier unten stand sie zwischen Statuszeile, Sternen und
                         Farbkreisen und drängte den Rest aus dem Bild. -->
                    <TextBlock
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource FP.Text.Muted}"
                           VerticalAlignment="Center"/>
                    <StackPanel  Orientation="Horizontal" Spacing="1" VerticalAlignment="Center"
                                 IsVisible="{Binding HasSelectedImage}">
                        <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="1"
                                Classes.active="{Binding SelectedRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=1}"
                                Command="{Binding SetSelectedRatingCommand}" CommandParameter="1">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                           Classes="rating-star"
                                           Width="18" Height="18"/>
                        </Button>
                        <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="1"
                                Classes.active="{Binding SelectedRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=2}"
                                Command="{Binding SetSelectedRatingCommand}" CommandParameter="2">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                           Classes="rating-star"
                                           Width="18" Height="18"/>
                        </Button>
                        <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="1"
                                Classes.active="{Binding SelectedRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=3}"
                                Command="{Binding SetSelectedRatingCommand}" CommandParameter="3">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                           Classes="rating-star"
                                           Width="18" Height="18"/>
                        </Button>
                        <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="1"
                                Classes.active="{Binding SelectedRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=4}"
                                Command="{Binding SetSelectedRatingCommand}" CommandParameter="4">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                           Classes="rating-star"
                                           Width="18" Height="18"/>
                        </Button>
                        <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="1"
                                Classes.active="{Binding SelectedRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=5}"
                                Command="{Binding SetSelectedRatingCommand}" CommandParameter="5">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                           Classes="rating-star"
                                           Width="18" Height="18"/>
                        </Button>
                        <Button Classes="icon-btn"
                                Width="24" Height="24" VerticalAlignment="Center" Margin="6,0,0,0"
                                Command="{Binding ToggleSelectedFavoriteCommand}"
                                ToolTip.Tip="Favorit">
                            <Grid Width="20" Height="20">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                               Width="20" Height="20"
                                               Classes="fav-heart"
                                               IsVisible="{Binding !SelectedIsFavorite}"/>
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                               Width="20" Height="20"
                                               Classes="fav-heart active"
                                               IsVisible="{Binding SelectedIsFavorite}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <views:CollageDialogOverlayView Grid.Row="0"
                                        Grid.RowSpan="3"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        ZIndex="180"/>

        <!-- Schnellvorschau-Overlay (Mausrad-Klick). ColumnSpan 4: die Info-Leiste in Spalte 3
             gehoert mit abgedeckt. -->
        <Panel x:Name="PreviewOverlay"
               Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="4"
               IsVisible="False"
               Background="#D9000000"
               ZIndex="200">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="60"/>
        </Panel>

    </Grid>
</UserControl>
