<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Views.AdjustmentPresetSaveDialogView">

    <!-- Anpassung speichern: der Name, darunter je Reglergruppe des Editors eine Zeile mit Haken,
         Zaehler und Pfeil zum Aufklappen; aufgeklappt steht jeder Regler der Gruppe mit eigenem
         Haken. Der Haken der Gruppe waehlt alle ihre Regler und zeigt den Zwischenstand, wenn nur
         ein Teil gewaehlt ist. Gruppen- und Reglernamen kommen uebersetzt aus dem ViewModel
         (AdjustmentPresetSaveDialogViewModel), deshalb no-translate. -->
    <StackPanel Spacing="10">
        <!-- Name und Ordner nur beim Speichern; "Einfügen mit Auswahl" zeigt denselben Dialog
             ohne beides. Die Ordner kommen fertig beschriftet aus dem ViewModel. -->
        <TextBox x:Name="PresetNameBox"
                 Text="{Binding Name, Mode=TwoWay}"
                 PlaceholderText="Name"
                 IsVisible="{Binding ShowsName}"
                 MinHeight="36"/>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding ShowsFolder}">
            <TextBlock Text="Ordner" VerticalAlignment="Center"
                       Foreground="{DynamicResource FP.Text.Secondary}"/>
            <ComboBox Grid.Column="1" Classes="no-translate"
                      ItemsSource="{Binding Folders}"
                      SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                      MinHeight="36"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="In diesen Ordner wird die Anpassung gespeichert. Ordner legt die Verwaltung an.">
                <!-- Aufgeklappt ein eingerueckter Baum mit dem Namen je Ordner, im geschlossenen
                     Feld der ganze Pfad. -->
                <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate>
                        <TextBlock Classes="no-translate" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Classes="no-translate" Text="{Binding Name}" Margin="{Binding Indent}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Padding="12,5" Command="{Binding SelectAllCommand}"
                    ToolTip.Tip="Alle Regler in die Anpassung aufnehmen">
                <TextBlock Text="Alle"/>
            </Button>
            <Button Classes="ghost" Padding="12,5" Command="{Binding SelectNoneCommand}"
                    ToolTip.Tip="Alle Haken entfernen">
                <TextBlock Text="Keine"/>
            </Button>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MinHeight="32">
                            <CheckBox Classes="no-translate"
                                      IsThreeState="False"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsEnabled="{Binding IsAvailable}"
                                      Content="{Binding Label}"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="no-translate"
                                       Text="{Binding Summary}"
                                       IsVisible="{Binding CanExpand}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Small}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Classes="icon-btn" Width="28" Height="28" Padding="0"
                                    Command="{Binding ToggleExpandedCommand}"
                                    IsVisible="{Binding CanExpand}"
                                    ToolTip.Tip="Regler einzeln wählen">
                                <Panel>
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/caret-right.svg"
                                                   Width="16" Height="16"
                                                   IsVisible="{Binding !IsExpanded}"/>
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/caret-down.svg"
                                                   Width="16" Height="16"
                                                   IsVisible="{Binding IsExpanded}"/>
                                </Panel>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Entries}"
                                      IsVisible="{Binding IsExpanded}"
                                      Margin="28,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Was das Ziel nicht tragen kann, ist ausgegraut und ohne
                                         Haken; der Kurzhinweis sagt warum (BlockReason). -->
                                    <CheckBox Classes="no-translate"
                                              IsChecked="{Binding ShownChecked, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAvailable}"
                                              ToolTip.Tip="{Binding BlockReason}"
                                              ToolTip.ShowOnDisabled="True"
                                              Content="{Binding Label}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Nur beim Einfuegen: welche Teile der Geometrie aus der Ablage mitkommen. Ab Werk
             keiner, vorbelegt mit der letzten Wahl (GeometryTransfer). Eine Vorlage nimmt keine
             Geometrie mit, deshalb fehlt der Block beim Speichern. -->
        <StackPanel Spacing="4" IsVisible="{Binding ShowsGeometryChoice}">
            <TextBlock Text="Geometrie" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <CheckBox IsChecked="{Binding PasteStraighten, Mode=TwoWay}"
                      Content="Ausrichten, Drehen und Spiegeln"/>
            <CheckBox IsChecked="{Binding PastePerspective, Mode=TwoWay}"
                      Content="Perspektive"/>
            <CheckBox IsChecked="{Binding PasteCrop, Mode=TwoWay}"
                      Content="Zuschnitt"/>
            <TextBlock Text="Ein Haken ersetzt diesen Teil der Geometrie durch den des kopierten Bildes. Steht ein Bild hoch, wo das kopierte quer stand, oder umgekehrt, bleibt sein Zuschnitt, wie er ist."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource FP.Text.Secondary}"
                       FontSize="{DynamicResource FP.Font.Small}"/>
        </StackPanel>

        <!-- Das Ziel kommt zuletzt: erst steht die Auswahl der Regler, dann graut das Ziel aus,
             was es nicht tragen kann. XMP und LUT gehen in eine Datei an einem frei gewaehlten
             Ort; die Ziele und der Hinweis kommen uebersetzt aus dem ViewModel. -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowsTargetChoice}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="Speichern als" VerticalAlignment="Center"
                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                <ComboBox Grid.Column="1" Classes="no-translate"
                          ItemsSource="{Binding Targets}"
                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                          MinHeight="36"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Classes="no-translate" Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" IsVisible="{Binding ShowsGridSize}">
                <TextBlock Text="Gitterpunkte je Achse" VerticalAlignment="Center"
                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                <ComboBox Grid.Column="1" Classes="no-translate"
                          ItemsSource="{Binding LutGridSizes}"
                          SelectedItem="{Binding SelectedGridSize, Mode=TwoWay}"
                          MinHeight="36" MinWidth="90"
                          ToolTip.Tip="Mehr Punkte geben feinere Übergänge und eine größere Datei."/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding ShowsFile}">
                <TextBlock Text="Datei" VerticalAlignment="Center"
                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                <TextBox Grid.Column="1" Classes="no-translate"
                         Text="{Binding TargetFilePath, Mode=TwoWay}" MinHeight="36"/>
                <Button Grid.Column="2"
                        Classes="icon-btn"
                        Width="38" Height="36"
                        Click="OnBrowseTargetFileClick"
                        ToolTip.Tip="Datei wählen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/folder-open.svg" Width="18" Height="18"/>
                </Button>
            </Grid>
            <TextBlock Classes="no-translate"
                       Text="{Binding TargetHint}"
                       IsVisible="{Binding ShowsTargetHint}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource FP.Text.Secondary}"
                       FontSize="{DynamicResource FP.Font.Small}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
