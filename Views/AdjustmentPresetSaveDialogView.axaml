<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Views.AdjustmentPresetSaveDialogView">

    <!-- Anpassung speichern: der Name, darunter je Reglergruppe des Editors eine Zeile mit Haken,
         Zaehler und Pfeil zum Aufklappen; aufgeklappt steht jeder Regler der Gruppe mit eigenem
         Haken. Der Haken der Gruppe waehlt alle ihre Regler und zeigt den Zwischenstand, wenn nur
         ein Teil gewaehlt ist. Gruppen- und Reglernamen kommen uebersetzt aus dem ViewModel
         (AdjustmentPresetSaveDialogViewModel), deshalb no-translate. -->
    <StackPanel Spacing="10">
        <!-- Name und Ordner nur beim Speichern; "Einfügen mit Auswahl" zeigt denselben Dialog
             ohne beides. Die Ordner kommen fertig beschriftet aus dem ViewModel. -->
        <TextBox x:Name="PresetNameBox"
                 Text="{Binding Name, Mode=TwoWay}"
                 PlaceholderText="Name"
                 IsVisible="{Binding ShowsName}"
                 MinHeight="36"/>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding ShowsFolder}">
            <TextBlock Text="Ordner" VerticalAlignment="Center"
                       Foreground="{DynamicResource FP.Text.Secondary}"/>
            <ComboBox Grid.Column="1" Classes="no-translate"
                      ItemsSource="{Binding Folders}"
                      SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                      MinHeight="36"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="In diesen Ordner wird die Anpassung gespeichert. Ordner legt die Verwaltung an."/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Padding="12,5" Command="{Binding SelectAllCommand}"
                    ToolTip.Tip="Alle Regler in die Anpassung aufnehmen">
                <TextBlock Text="Alle"/>
            </Button>
            <Button Classes="ghost" Padding="12,5" Command="{Binding SelectNoneCommand}"
                    ToolTip.Tip="Alle Haken entfernen">
                <TextBlock Text="Keine"/>
            </Button>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MinHeight="32">
                            <CheckBox Classes="no-translate"
                                      IsThreeState="False"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Label}"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="no-translate"
                                       Text="{Binding Summary}"
                                       IsVisible="{Binding CanExpand}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Small}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Classes="icon-btn" Width="28" Height="28" Padding="0"
                                    Command="{Binding ToggleExpandedCommand}"
                                    IsVisible="{Binding CanExpand}"
                                    ToolTip.Tip="Regler einzeln wählen">
                                <Panel>
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/caret-right.svg"
                                                   Width="16" Height="16"
                                                   IsVisible="{Binding !IsExpanded}"/>
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/caret-down.svg"
                                                   Width="16" Height="16"
                                                   IsVisible="{Binding IsExpanded}"/>
                                </Panel>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Entries}"
                                      IsVisible="{Binding IsExpanded}"
                                      Margin="28,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Classes="no-translate"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Content="{Binding Label}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
