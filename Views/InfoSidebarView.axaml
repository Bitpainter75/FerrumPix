<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:services="clr-namespace:FerrumPix.Services"
             x:Class="FerrumPix.Views.InfoSidebarView">

    <!-- Gemeinsame Info-Seitenleiste (Allgemein/EXIF/IPTC/XMP) für Viewer, Editor und Galerie -
         alle drei stellen dieselben Property-/Command-Namen bereit (ExifInfo, Tags, ScopeImage,
         IsInfoTab*, ToggleFavoriteCommand, SetRatingCommand, SetColorLabelCommand, AddTagCommand,
         RemoveTagCommand, Rating, IsFavorite, ColorLabel/IsColorLabel*, IsInfoSidebarVisible),
         daher genügt ein einziges, DataContext-loses UserControl statt der zuvor doppelt
         gepflegten Markup-Kopie in ViewerView/EditorView. Viewer und Editor tragen den Zustand
         selbst, die Galerie reicht ihn über InfoPanelViewModel herein. -->
    <UserControl.Styles>
        <!-- Der Rahmen eines Flyouts ist ab Werk auf gut 450 Punkte gedeckelt und bringt eigenes
             Innenmass mit; das 600 Punkte breite Analysebild wurde dadurch rechts abgeschnitten.
             Hier bekommt genau dieses eine Flyout seinen eigenen Rahmen: Deckel hoch, kein
             Mindestmass, schmales Innenmass. -->
        <Style Selector="FlyoutPresenter.scope-flyout">
            <Setter Property="MaxWidth" Value="720"/>
            <Setter Property="MaxHeight" Value="420"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="InfoSidebarBorder" Classes="panel-right" Padding="14,14"
            IsVisible="{Binding IsInfoSidebarVisible}">
        <!-- Ohne Bild zeigt die Leiste NUR einen Hinweis in der Mitte. Reiter und Felder
             abgeblendet stehen zu lassen sah aus wie ein Fehler; leer wäre es ein Rätsel.
             Der Panel darum ist noetig, weil ein Rahmen nur EIN Kind aufnimmt. -->
        <Panel>
        <TextBlock Text="{Binding InfoPlaceholderText}"
                   IsVisible="{Binding !HasInfoContent}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Margin="16,0"
                   Classes="no-translate"
                   Foreground="{DynamicResource FP.Text.Muted}"
                   FontSize="{DynamicResource FP.Font.Body}"/>
        <Grid RowDefinitions="Auto,*" RowSpacing="14" IsVisible="{Binding HasInfoContent}">
            <StackPanel Spacing="0">
                <!-- Ohne Ueberschrift: die Leiste steht in einer eigenen Spalte, "Info" sagte
                     nichts, was der Inhalt nicht schon zeigt, und kostete eine Zeile Hoehe. -->
                <!-- Bei mehreren Bildern gibt es nur die Übersicht: EXIF, IPTC, XMP und ICC
                     beschreiben genau eine Datei, und eine von zwölf zu zeigen wäre falsch. -->
                <!-- Spacing knapper als sonst: fünf Reiter müssen in die 320px breite Seitenleiste passen,
                     auch bei längeren Übersetzungen von "Allgemein". -->
                <StackPanel Orientation="Horizontal" Spacing="9"
                            IsVisible="{Binding IsSingleImage}">
                    <Button Classes="info-tab" Command="{Binding SetInfoTabCommand}" CommandParameter="General" Classes.active="{Binding IsInfoTabGeneral}">
                        <TextBlock Text="Allgemein"/>
                    </Button>
                    <!-- Nur da, wenn auf dem Bild jemand erkannt wurde. Ein Reiter, hinter dem nie
                         etwas steht, wäre bei jedem Landschaftsfoto ein leeres Versprechen. -->
                    <Button Classes="info-tab" Command="{Binding SetInfoTabCommand}" CommandParameter="People"
                            Classes.active="{Binding IsInfoTabPeople}" IsVisible="{Binding HasPeople}">
                        <TextBlock Text="Personen"/>
                    </Button>
                    <Button Classes="info-tab" Command="{Binding SetInfoTabCommand}" CommandParameter="Exif" Classes.active="{Binding IsInfoTabExif}">
                        <TextBlock Text="EXIF"/>
                    </Button>
                    <Button Classes="info-tab" Command="{Binding SetInfoTabCommand}" CommandParameter="Iptc" Classes.active="{Binding IsInfoTabIptc}">
                        <TextBlock Text="IPTC"/>
                    </Button>
                    <Button Classes="info-tab" Command="{Binding SetInfoTabCommand}" CommandParameter="Xmp" Classes.active="{Binding IsInfoTabXmp}">
                        <TextBlock Text="XMP"/>
                    </Button>
                    <Button Classes="info-tab" Command="{Binding SetInfoTabCommand}" CommandParameter="Icc" Classes.active="{Binding IsInfoTabIcc}">
                        <TextBlock Text="ICC"/>
                    </Button>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource FP.Border.Normal}" Margin="0,7,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" FocusAdorner="{x:Null}">
                <StackPanel Spacing="18">
                    <!-- Übersicht über mehrere Bilder. Gleiche Namen/Wert-Darstellung wie die
                         EXIF-Zeilen, damit die Leiste in beiden Fällen gleich aussieht. -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsSummary}" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" Classes="no-translate"
                                   FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding SummaryFacts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:ExifTag}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" Classes="no-translate"
                                                   Foreground="{DynamicResource FP.Text.Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="no-translate"
                                                   HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="18" IsVisible="{Binding IsInfoTabGeneral}" Margin="0,0,12,0">
                        <StackPanel Spacing="10" IsVisible="{Binding IsSingleImage}">
                            <!-- Dateiname ohne Beschriftung über die volle Breite: er ist die
                                 Überschrift des Blocks, keine Wertzeile - und lange Namen haben so
                                 die ganze Spaltenbreite zum Umbrechen statt der halben. Darunter
                                 eine Leerzeile Abstand zu den Wertzeilen.
                                 Eine Ueberschrift "Bild" stand hier frueher darueber; sie sagte
                                 nichts, was der Dateiname nicht schon zeigt, und kostete eine
                                 Zeile Hoehe. -->
<!-- Name und Ordner stehen ENG beieinander: sie gehoeren zusammen und bilden
                                 zusammen den Pfad. Der Abstand nach unten sitzt deshalb am Block,
                                 nicht zwischen den beiden Zeilen - sonst waeren es drei Abstaende
                                 hintereinander und die Angaben rutschten weit nach unten. -->
                            <StackPanel Spacing="2" Margin="0,0,0,10">
                                <TextBlock Text="{Binding ExifInfo.FileName}" TextWrapping="Wrap"/>
                                <!-- Der Ordner. Fehlt er - bei einem Bild vom Server gibt es keinen
                                     Dateipfad -, faellt die Zeile weg. -->
                                <TextBlock Text="{Binding ExifInfo.FolderPath}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource FP.Text.Muted}"
                                           FontSize="{DynamicResource FP.Font.Small}"
                                           IsVisible="{Binding ShowFolderPathRow}"/>
                            </StackPanel>
                            <!-- WELCHE dieser Zeilen erscheinen, waehlt der Benutzer in den
                                 Einstellungen unter "Infopanel". Jede haengt an einer eigenen
                                 Eigenschaft des Panels, und die verundet zwei Bedingungen: die Zeile
                                 ist angehakt UND das Bild hat den Wert. Beschriftung und Wert tragen
                                 dieselbe Bindung - blieb eine von beiden stehen, saehe man eine
                                 Beschriftung ohne Wert oder eine Zahl ohne Namen.
                                 Die Aufnahmedaten stehen OBEN: beim Sichten zaehlen Kamera, Objektiv
                                 und Belichtung, die technischen Angaben zur Datei kommen danach
                                 (Nutzerrueckmeldung 2026-08-27). -->
                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10">
                                <!-- Das EXIF-Aufnahmedatum, nicht das Dateidatum weiter unten. -->
                                <TextBlock Text="Aufnahmedatum" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowDateTakenRow}"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                           Text="{Binding ExifInfo.DateTaken, Converter={StaticResource ExifDateConverter}}"
                                           IsVisible="{Binding ShowDateTakenRow}"/>
                                <!-- Kamera, Objektiv und die Belichtungsangaben stehen nicht
                                     rechtsbuendig umbrochen, sondern duerfen umbrechen: ein
                                     Objektivname ist ein Satz, keine Zahl. -->
                                <TextBlock Grid.Row="1" Text="Kamera" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowCameraRow}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExifInfo.Camera}"
                                           Classes="no-translate"
                                           HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                                           IsVisible="{Binding ShowCameraRow}"/>
                                <TextBlock Grid.Row="2" Text="Objektiv" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowLensRow}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExifInfo.Lens}"
                                           Classes="no-translate"
                                           HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                                           IsVisible="{Binding ShowLensRow}"/>
                                <TextBlock Grid.Row="3" Text="Blende" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowApertureRow}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExifInfo.Aperture}"
                                           Classes="no-translate" HorizontalAlignment="Right"
                                           IsVisible="{Binding ShowApertureRow}"/>
                                <TextBlock Grid.Row="4" Text="Belichtungszeit" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowShutterSpeedRow}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExifInfo.ShutterSpeed}"
                                           Classes="no-translate" HorizontalAlignment="Right"
                                           IsVisible="{Binding ShowShutterSpeedRow}"/>
                                <TextBlock Grid.Row="5" Text="ISO" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowIsoRow}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ExifInfo.ISO}"
                                           Classes="no-translate" HorizontalAlignment="Right"
                                           IsVisible="{Binding ShowIsoRow}"/>
                                <TextBlock Grid.Row="6" Text="Brennweite" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowFocalLengthRow}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ExifInfo.FocalLength}"
                                           Classes="no-translate" HorizontalAlignment="Right"
                                           IsVisible="{Binding ShowFocalLengthRow}"/>
                                <TextBlock Grid.Row="7" Text="Abmessungen" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowDimensionsRow}"/>
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Right"
                                            IsVisible="{Binding ShowDimensionsRow}">
                                    <TextBlock Text="{Binding ExifInfo.ImageWidth}"/>
                                    <TextBlock Text="x" Foreground="{DynamicResource FP.Text.Secondary}"/>
                                    <TextBlock Text="{Binding ExifInfo.ImageHeight}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="8" Text="Megapixel" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowMegapixelsRow}"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ExifInfo.Megapixels}" HorizontalAlignment="Right"
                                           IsVisible="{Binding ShowMegapixelsRow}"/>
                                <TextBlock Grid.Row="9" Text="Seitenverhältnis" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowAspectRatioRow}"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ExifInfo.AspectRatio}" HorizontalAlignment="Right"
                                           IsVisible="{Binding ShowAspectRatioRow}"/>
                                <TextBlock Grid.Row="10" Text="Farbraum" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowColorSpaceRow}"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ExifInfo.ColorSpace}" HorizontalAlignment="Right"
                                           IsVisible="{Binding ShowColorSpaceRow}"/>
                                <TextBlock Grid.Row="11" Text="Dateigröße" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowFileSizeRow}"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding ExifInfo.FileSize}" HorizontalAlignment="Right"
                                           IsVisible="{Binding ShowFileSizeRow}"/>
                                <!-- Dateidatum, nicht EXIF-Aufnahmedatum. Beide Zeilen fallen auch
                                     dort weg, wo es keinen Zeitstempel gibt (Server, Dateisystem
                                     ohne Geburtszeit) - das steckt in der Panel-Eigenschaft mit drin. -->
                                <TextBlock Grid.Row="12" Text="Erstellt" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowFileCreatedRow}"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" HorizontalAlignment="Right"
                                           Text="{Binding ExifInfo.FileCreated, Converter={StaticResource ExifDateConverter}}"
                                           IsVisible="{Binding ShowFileCreatedRow}"/>
                                <TextBlock Grid.Row="13" Text="Geändert" Foreground="{DynamicResource FP.Text.Muted}"
                                           IsVisible="{Binding ShowFileModifiedRow}"/>
                                <TextBlock Grid.Row="13" Grid.Column="1" HorizontalAlignment="Right"
                                           Text="{Binding ExifInfo.FileModified, Converter={StaticResource ExifDateConverter}}"
                                           IsVisible="{Binding ShowFileModifiedRow}"/>
                                <!-- Der Ort steht als Zeile HIER und nicht mehr als eigener Block mit
                                     Ueberschrift und Trennlinie: er ist eine Angabe wie Abmessungen oder
                                     Dateigroesse und braucht dafuer keine drei Zeilen Hoehe.
                                     OHNE Beschriftung und ueber BEIDE Spalten: die Nadel sagt schon, was
                                     es ist, und lange Ortsnamen ("Sant Feliu de Guixols, Katalonien,
                                     Spanien") haben so die ganze Breite zum Umbrechen statt der halben.
                                     Der Abstand oben trennt ihn von den Datumszeilen darueber. -->
                                <StackPanel Grid.Row="14" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                                            Margin="0,12,0,0" IsVisible="{Binding ShowPlaceRow}">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/map-pin.svg"
                                                   Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0.75"/>
                                    <TextBlock Text="{Binding PlaceText}" Classes="no-translate"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Der Urheberrechtshinweis erscheint NUR, wenn einer im Bild steht.
                                     Er ist eine Angabe zur Datei wie die daruber, aber ueber beide
                                     Spalten und ohne rechtsbuendig: er ist ein Satz, keine Zahl, und
                                     rechts an einer schmalen Spalte umbrochen waere er unlesbar.
                                     Kein Uebersetzungsdurchlauf darauf - der Text gehoert dem Bild. -->
                                <StackPanel Grid.Row="15" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                                            Margin="0,12,0,0"
                                            IsVisible="{Binding ShowCopyrightRow}">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/copyright.svg"
                                                   Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0.75"/>
                                    <TextBlock Text="{Binding ExifInfo.Copyright}" Classes="no-translate"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Die Trennlinien gehoeren zu den Bloecken, die sie abgrenzen: sonst
                             stehen bei ausgeblendetem Histogramm zwei uebereinander. -->
                        <Border Height="1" Background="{DynamicResource FP.Border.Normal}"
                                IsVisible="{Binding HasScope}"/>

                        <StackPanel Spacing="10" IsVisible="{Binding HasScope}">
                            <!-- Ueberschrift und Umschalter in einer Zeile: die drei Darstellungen
                                 beantworten verschiedene Fragen (Verteilung, Lage im Bild, Stich je
                                 Kanal), und der Wechsel soll dort sitzen, wo man hinsieht. Die
                                 Ueberschrift wandert mit, sonst stuende ueber einer Waveform
                                 "Histogramm". -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                <!-- Der aktive Knopf traegt die Akzentklasse und bleibt klickbar.
                                     Ihn stattdessen abzuschalten sah aus, als sei die Darstellung
                                     nicht verfuegbar. -->
                                <Button Grid.Column="0" Classes="ghost" Classes.accent="{Binding Scope.IsHistogram}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="4,3" FontSize="{DynamicResource FP.Font.Small}"
                                        Content="Histogramm"
                                        Command="{Binding Scope.SetModeCommand}" CommandParameter="Histogram"/>
                                <Button Grid.Column="1" Classes="ghost" Classes.accent="{Binding Scope.IsWaveform}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="4,3" FontSize="{DynamicResource FP.Font.Small}"
                                        Content="Waveform"
                                        Command="{Binding Scope.SetModeCommand}" CommandParameter="Waveform"/>
                                <Button Grid.Column="2" Classes="ghost" Classes.accent="{Binding Scope.IsParade}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="4,3" FontSize="{DynamicResource FP.Font.Small}"
                                        Content="RGB-Parade"
                                        Command="{Binding Scope.SetModeCommand}" CommandParameter="Parade"/>
                            </Grid>
                            <!-- Solange nichts da ist, steht der Hinweis im leeren Kasten: bei einem
                                 RAW dauert der Volldecode spuerbar, und ein leerer Rahmen sieht in der
                                 Zeit aus wie ein Fehler statt wie Arbeit. -->
                            <!-- 150 statt der frueheren 92: senkrecht liegen 256 Helligkeitsstufen,
                                 und bei Waveform und Parade ist genau das die tragende Achse. Auf
                                 92 Punkten fielen je drei Stufen auf einen Bildpunkt.
                                 Gerechnet wird 600 mal 300, also doppelt so fein wie der Kasten -
                                 aus genau diesem Vorrat lebt die grosse Ansicht unten, die dadurch
                                 scharf ist statt hochskaliert. -->
                            <Panel Height="150">
                                <!-- Ein Klick auf das Diagramm klappt es gross auf. Der Knopf
                                     traegt keine eigene Optik: er ist nur die Klickflaeche um das
                                     Bild, das schon vorher da war. -->
                                <Button Padding="0" BorderThickness="0" Background="Transparent"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        IsEnabled="{Binding ScopeImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Button.Flyout>
                                        <Flyout Placement="Left" ShowMode="Standard"
                                                FlyoutPresenterClasses="scope-flyout">
                                            <Border Background="{DynamicResource FP.Bg.Input}" CornerRadius="6"
                                                    ClipToBounds="True">
                                                <!-- Native Groesse des gerechneten Bildes: kein
                                                     Strecken, keine Interpolation, jede Spur so
                                                     duenn wie sie ist. -->
                                                <Image Source="{Binding ScopeImage}" Width="600" Height="300"/>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Border Background="{DynamicResource FP.Bg.Input}" CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding ScopeImage}"
                                               Stretch="Fill"
                                               RenderOptions.BitmapInterpolationMode="LowQuality"/>
                                    </Border>
                                </Button>
                                <TextBlock Text="wird berechnet"
                                           IsVisible="{Binding ScopeImage, Converter={x:Static ObjectConverters.IsNull}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FP.Text.Muted}"
                                           FontSize="{DynamicResource FP.Font.Small}"/>
                            </Panel>
                        </StackPanel>

                        <!-- Unter dem Analysebild steht keine Trennlinie: der dunkle Kasten des
                             Diagramms grenzt sich selbst deutlich genug ab, und eine Linie dicht
                             darunter wirkte wie ein zweiter Rahmen. -->

                        <!-- Bewertung, Favorit und Farbetikett direkt am Bild pflegen - dieselben
                             Sterne wie in der Werkzeugleiste, dieselben Akzentfarben-Punkte wie im
                             Galerie-Kontextmenü (gleiche Farbe erneut = Etikett entfernen). -->
                        <!-- Bewertung und Etikett sind EINZELN abwaehlbar, teilen sich aber einen
                             Block: zwei Ueberschriften uebereinander kosteten Hoehe, die die Leiste
                             nicht hat. Deshalb drei Ueberschriften, von denen hoechstens eine steht -
                             als ein Text mit wechselndem Inhalt waere sie nicht uebersetzbar. -->
                        <StackPanel Spacing="10" IsVisible="{Binding ShowRatingOrColorLabelSection}">
                            <TextBlock Text="Bewertung &amp; Etikett" FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"
                                       IsVisible="{Binding ShowRatingAndColorLabelHeading}"/>
                            <TextBlock Text="Bewertung" FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"
                                       IsVisible="{Binding ShowRatingOnlyHeading}"/>
                            <TextBlock Text="Etikett" FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"
                                       IsVisible="{Binding ShowColorLabelOnlyHeading}"/>
                            <StackPanel Orientation="Horizontal" Spacing="1" IsVisible="{Binding ShowRatingSection}">
                                <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                        Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=1}"
                                        Command="{Binding SetRatingCommand}" CommandParameter="1">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg" Classes="rating-star"
                                                   Width="18" Height="18" VerticalAlignment="Center"/>
                                </Button>
                                <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                        Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=2}"
                                        Command="{Binding SetRatingCommand}" CommandParameter="2">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg" Classes="rating-star"
                                                   Width="18" Height="18" VerticalAlignment="Center"/>
                                </Button>
                                <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                        Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=3}"
                                        Command="{Binding SetRatingCommand}" CommandParameter="3">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg" Classes="rating-star"
                                                   Width="18" Height="18" VerticalAlignment="Center"/>
                                </Button>
                                <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                        Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=4}"
                                        Command="{Binding SetRatingCommand}" CommandParameter="4">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg" Classes="rating-star"
                                                   Width="18" Height="18" VerticalAlignment="Center"/>
                                </Button>
                                <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                        Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=5}"
                                        Command="{Binding SetRatingCommand}" CommandParameter="5">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg" Classes="rating-star"
                                                   Width="18" Height="18" VerticalAlignment="Center"/>
                                </Button>
                                <Button Classes="icon-btn" Width="24" Height="24" VerticalAlignment="Center"
                                        Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="Favorit" Margin="8,0,0,0">
                                    <Grid Width="20" Height="20">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                       Width="20" Height="20" Classes="fav-heart" IsVisible="{Binding !IsFavorite}"/>
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                       Width="20" Height="20" Classes="fav-heart active" IsVisible="{Binding IsFavorite}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowColorLabelSection}">
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="#F08A1A" ToolTip.Tip="Orange">
                                    <Grid>
                                        <Ellipse Width="16" Height="16" Fill="#F08A1A"/>
                                        <TextBlock Text="✓" IsVisible="{Binding IsColorLabelOrange}" Foreground="White"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="#E74C3C" ToolTip.Tip="Rot">
                                    <Grid>
                                        <Ellipse Width="16" Height="16" Fill="#E74C3C"/>
                                        <TextBlock Text="✓" IsVisible="{Binding IsColorLabelRed}" Foreground="White"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="#F03B88" ToolTip.Tip="Pink">
                                    <Grid>
                                        <Ellipse Width="16" Height="16" Fill="#F03B88"/>
                                        <TextBlock Text="✓" IsVisible="{Binding IsColorLabelPink}" Foreground="White"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="#8B5CF6" ToolTip.Tip="Lila">
                                    <Grid>
                                        <Ellipse Width="16" Height="16" Fill="#8B5CF6"/>
                                        <TextBlock Text="✓" IsVisible="{Binding IsColorLabelPurple}" Foreground="White"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="#3B82F6" ToolTip.Tip="Blau">
                                    <Grid>
                                        <Ellipse Width="16" Height="16" Fill="#3B82F6"/>
                                        <TextBlock Text="✓" IsVisible="{Binding IsColorLabelBlue}" Foreground="White"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="#0891B2" ToolTip.Tip="Cyan">
                                    <Grid>
                                        <Ellipse Width="16" Height="16" Fill="#0891B2"/>
                                        <TextBlock Text="✓" IsVisible="{Binding IsColorLabelCyan}" Foreground="White"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="#0F766E" ToolTip.Tip="Türkis">
                                    <Grid>
                                        <Ellipse Width="16" Height="16" Fill="#0F766E"/>
                                        <TextBlock Text="✓" IsVisible="{Binding IsColorLabelTeal}" Foreground="White"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="#22C55E" ToolTip.Tip="Grün">
                                    <Grid>
                                        <Ellipse Width="16" Height="16" Fill="#22C55E"/>
                                        <TextBlock Text="✓" IsVisible="{Binding IsColorLabelGreen}" Foreground="White"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="#FACC15" ToolTip.Tip="Gelb">
                                    <Grid>
                                        <Ellipse Width="16" Height="16" Fill="#FACC15"/>
                                        <TextBlock Text="✓" IsVisible="{Binding IsColorLabelYellow}" Foreground="Black"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <!-- Aufbau wie der gleichnamige Knopf im Kontextmenue
                                     (MenuWidgets.ClearButton): dasselbe Zeichen, dieselbe
                                     Schriftgroesse und AUSDRUECKLICH keine eigene Vordergrundfarbe.
                                     Die stand hier vorher auf der gedaempften Textfarbe, wodurch
                                     dasselbe Kreuz an zwei Stellen verschieden aussah. -->
                                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Command="{Binding SetColorLabelCommand}" CommandParameter="" ToolTip.Tip="Kein Etikett">
                                    <TextBlock Text="×" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource FP.Border.Normal}"
                                IsVisible="{Binding ShowTagsSeparator}"/>

                        <StackPanel Spacing="10" IsVisible="{Binding ShowTagsSection}">
                            <TextBlock Text="Stichwörter" FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Aufbau wie die Preset-Kaertchen im Editor (LUT und XMP):
                                             derselbe Rahmen, dasselbe Raster aus zwei Spalten und das
                                             Kreuz als Ghost-Knopf mit knappem linken Abstand. Die
                                             frueher hier benutzte Pille trug beidseitig 10 Punkt
                                             Innenabstand, dadurch stand das Kreuz weit vom Rand ab. -->
                                        <!-- Die Polsterung sitzt in den SCHALTFLAECHEN, nicht am Rahmen.
                                             Lag sie aussen, war nur der Text selbst anklickbar und ein
                                             Treffer knapp darueber oder darunter tat nichts. -->
                                        <Border CornerRadius="12"
                                                Background="{DynamicResource FP.Bg.Input}"
                                                BorderBrush="{DynamicResource FP.Border.Normal}"
                                                BorderThickness="1"
                                                Margin="0,0,6,6"
                                                Padding="0">
                                            <Grid ColumnDefinitions="Auto,Auto">
                                                <!-- Das Stichwort selbst ist eine Schaltflaeche: ein Klick zeigt
                                                     alle Bilder mit diesem Stichwort. Das Kreuz daneben entfernt
                                                     es - deshalb liegen beide getrennt und nicht ineinander. -->
                                                <Button Grid.Column="0"
                                                        Classes="ghost"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8,4,4,4"
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.OpenTagSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Alle Bilder mit diesem Stichwort zeigen">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{DynamicResource FP.Text.Secondary}"
                                                               VerticalAlignment="Center"
                                                               FontSize="{DynamicResource FP.Font.Small}"/>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Classes="ghost"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0,4,8,4"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Stichwort entfernen">
                                                    <TextBlock Text="×" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FP.Text.Muted}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto">
                                <AutoCompleteBox Text="{Binding NewTagText, Mode=TwoWay}"
                                                 ItemsSource="{Binding TagSuggestions}"
                                                 PlaceholderText="Stichwort hinzufügen…"
                                                 FilterMode="Contains"
                                                 MinimumPrefixLength="0"
                                                 FontSize="{DynamicResource FP.Font.Small}"
                                                 Padding="8,5"/>
                                <Button Grid.Column="1" Classes="ghost" Padding="10,5" Margin="6,0,0,0"
                                        Command="{Binding AddTagCommand}">
                                    <TextBlock Text="+ Hinzufügen" FontSize="{DynamicResource FP.Font.Small}"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                    </StackPanel>

                    <!-- PERSONEN als eigener Reiter. Sie sind das einzige in dieser Leiste, was
                         der Benutzer BEARBEITET - alles andere ist Anzeige. Als Abschnitt unter den
                         Aufnahmedaten schob eine Gruppenaufnahme mit zwanzig Gesichtern alles andere
                         aus der Leiste; hier hat die Liste die ganze Höhe für sich. Der Reiter
                         erscheint nur, wenn jemand erkannt wurde. -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsInfoTabPeople}" Margin="0,0,12,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Name eintragen benennt die ganze Gruppe."
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"/>
                            <TextBlock Text="Ein Name, den es schon gibt, verschiebt nur dieses eine Gesicht dorthin."
                                       Foreground="{DynamicResource FP.Text.Secondary}"
                                       FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding People}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Das GESICHT gehört neben das Feld. Fünf leere Felder
                                         untereinander sagen niemandem, welches zu wem gehört - mit
                                         dem Ausschnitt daneben ist es offensichtlich. Der Knopf
                                         rechts meint NUR dieses Gesicht: er löst es aus der Gruppe,
                                         wenn die Erkennung jemanden verwechselt hat. -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                                        <Border Width="44" Height="44" CornerRadius="4"
                                                ClipToBounds="True"
                                                Background="{DynamicResource FP.Bg.Elevated}"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <!-- MIT VORSCHLAGSLISTE, wie beim Stichwort: einen schon
                                             vergebenen Namen von Hand nachzutippen ist die Stelle,
                                             an der aus einer Person zwei werden - „Anna" und „anna"
                                             sind für die Bibliothek zwei Menschen. Aus der Liste
                                             gewählt trifft er zeichengenau, und genau daran hängt,
                                             ob dieses Gesicht zur vorhandenen Person wandert. -->
                                        <AutoCompleteBox Grid.Column="1"
                                                         Text="{Binding Name, Mode=OneWay}"
                                                         ItemsSource="{Binding DataContext.PersonNameSuggestions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         FilterMode="Contains"
                                                         MinimumPrefixLength="0"
                                                         PlaceholderText="Name eingeben"
                                                         Classes="no-translate"
                                                         VerticalAlignment="Center"
                                                         LostFocus="OnPersonNameCommitted"
                                                         KeyDown="OnPersonNameKeyDown"
                                                         Tag="{Binding Id}"/>
                                        <Button Grid.Column="2"
                                                Classes="ghost"
                                                Width="28" Height="28" Padding="0"
                                                VerticalAlignment="Center"
                                                Click="OnDetachFaceClick"
                                                Tag="{Binding FaceId}"
                                                ToolTip.Tip="Nicht diese Person">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/user-x.svg"
                                                           Width="16" Height="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.75"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding IsInfoTabExif}" Margin="0,0,12,0">
                        <TextBlock Text="EXIF" FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ExifInfo.ExifTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:ExifTag}">
                                    <Border BorderBrush="{DynamicResource FP.Border.Normal}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid ColumnDefinitions="170,*">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FP.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding IsInfoTabIptc}" Margin="0,0,12,0">
                        <TextBlock Text="IPTC" FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ExifInfo.IptcTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:ExifTag}">
                                    <Border BorderBrush="{DynamicResource FP.Border.Normal}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid ColumnDefinitions="170,*">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FP.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding IsInfoTabXmp}" Margin="0,0,12,0">
                        <TextBlock Text="XMP" FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ExifInfo.XmpTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:ExifTag}">
                                    <Border BorderBrush="{DynamicResource FP.Border.Normal}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid ColumnDefinitions="170,*">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FP.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding IsInfoTabIcc}" Margin="0,0,12,0">
                        <TextBlock Text="ICC-Farbprofil" FontSize="{DynamicResource FP.Font.Subtitle}" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ExifInfo.IccTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:ExifTag}">
                                    <Border BorderBrush="{DynamicResource FP.Border.Normal}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid ColumnDefinitions="170,*">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FP.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Panel>
    </Border>
</UserControl>
