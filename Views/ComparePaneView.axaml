<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="FerrumPix.Views.ComparePaneView">
    <!-- EINE FLAECHE DES BILDVERGLEICHS. Der Betrachter stellt zwei oder vier davon auf die Buehne
         (ViewerView, CompareStage); der Datenkontext ist je eine ComparePaneViewModel. Die Flaeche
         traegt ihr Bild im Rollbereich, darueber deckungsgleich das Fokus-Peaking, daneben die
         Ebene der Fokusfelder, und AUF dem Bild die Marken (Anpassen, Loeschen, Sterne, Herz,
         Behalten, Verwerfen, Farbetikett) und den Dateinamen.

         Zoom, Ziehen, Fokus und das Spiegeln des Ausschnitts gehoeren allen Flaechen gemeinsam
         und stehen deshalb in ViewerView: sie haengt ihre Zeiger-Handler an PaneScroll. -->
    <UserControl.Styles>
        <!-- Solange das Bild des Eintrags noch laedt, steht das vorige gedimmt da. -->
        <Style Selector="Image.pane-image.loading">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Eine leere Flaeche (das vierte Feld bei drei Bildern): gedimmt, ohne Marken. -->
        <Border Background="{DynamicResource FP.Bg.Panel}" Opacity="0.35" CornerRadius="3"
                IsVisible="{Binding IsEmpty}" IsHitTestVisible="False"/>
        <TextBlock Text="Kein Bild in diesem Feld"
                   IsVisible="{Binding IsEmpty}" IsHitTestVisible="False"
                   Foreground="{DynamicResource FP.Text.Muted}"
                   FontSize="{DynamicResource FP.Font.Small}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Die Kachel aus dem Filmstreifen, solange die Flaeche noch gar kein Bild hat. -->
        <Image Source="{Binding TileImage}"
               IsVisible="{Binding TileImage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
               IsHitTestVisible="False" Opacity="0.45" Stretch="Uniform" Margin="24"
               RenderOptions.BitmapInterpolationMode="MediumQuality"/>

        <ScrollViewer Name="PaneScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <!-- Das Panel fuellt die Flaeche und ist treffbar: ein Klick neben das Bild waehlt
                 die Flaeche trotzdem. Bild und Peaking bekommen dieselben Masse (ViewerView,
                 ApplyCompareFitMode) und liegen deckungsgleich; die Ebene der Fokusfelder liegt
                 daneben, damit kein Strich mit dem Zoom dicker wird. -->
            <Panel Background="Transparent">
                <Image Name="PaneImage"
                       Classes="pane-image"
                       Classes.loading="{Binding IsLoading}"
                       Source="{Binding Image, Converter={x:Static icons:ColorManagedBitmapConverter.Instance}}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <Image Name="PanePeakingImage"
                       Source="{Binding FocusPeakingImage}"
                       IsHitTestVisible="False"
                       Stretch="Fill"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="MediumQuality"/>
                <Canvas Name="PaneMarkCanvas" IsHitTestVisible="False"/>
            </Panel>
        </ScrollViewer>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    IsVisible="{Binding IsLoading}" IsHitTestVisible="False">
            <ProgressBar Width="160" Height="4" IsIndeterminate="True"/>
            <TextBlock Text="Bild wird geladen und gerendert…"
                       Foreground="{DynamicResource FP.Text.Muted}"
                       FontSize="{DynamicResource FP.Font.Small}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Die aktive Flaeche traegt den Akzentrahmen. -->
        <Border BorderThickness="2" CornerRadius="3"
                BorderBrush="{DynamicResource FP.Accent}"
                IsVisible="{Binding IsFocused}"
                IsHitTestVisible="False"/>

        <!-- Marken der Flaeche. Dauerhaft sichtbar und AUF dem Bild: nur so ist ablesbar, welches
             der Bilder ein Knopf meint. Eine leere Flaeche hat keine. -->
        <Grid IsVisible="{Binding HasEntry}">
            <StackPanel Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
                <Button Classes="gallery-overlay-btn" Width="30" Height="30" Padding="0"
                        Click="OnEditClick" ToolTip.Tip="Anpassen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/plus-minus.svg"
                                   Width="18" Height="18" IconBrush="White"/>
                </Button>
                <Button Classes="gallery-overlay-btn danger" Width="30" Height="30" Padding="0"
                        Click="OnDeleteClick" ToolTip.Tip="Löschen">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/trash.svg"
                                   Width="18" Height="18" IconBrush="White"/>
                </Button>
            </StackPanel>

            <!-- Der Dateiname: bei vier Feldern sagt die Fusszeile nur den der aktiven Flaeche. -->
            <Border Background="#CC1A1D24" CornerRadius="4" Padding="6,3"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="92,12,10,0"
                    IsHitTestVisible="False">
                <!-- no-translate: der Text kommt aus einer Bindung; die Uebersetzung wuerde sie durch
                     einen festen Wert ersetzen (LocalizationService.KeineUebersetzung). -->
                <TextBlock Text="{Binding FileName}" Classes="no-translate"
                           Foreground="White" FontSize="{DynamicResource FP.Font.Small}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom"
                        HorizontalAlignment="Left" Margin="10,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=1}"
                            Tag="1" Click="OnStarClick">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/star.svg"
                                       Classes="rating-star" Width="18" Height="18"/>
                    </Button>
                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=2}"
                            Tag="2" Click="OnStarClick">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/star.svg"
                                       Classes="rating-star" Width="18" Height="18"/>
                    </Button>
                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=3}"
                            Tag="3" Click="OnStarClick">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/star.svg"
                                       Classes="rating-star" Width="18" Height="18"/>
                    </Button>
                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=4}"
                            Tag="4" Click="OnStarClick">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/star.svg"
                                       Classes="rating-star" Width="18" Height="18"/>
                    </Button>
                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                            Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=5}"
                            Tag="5" Click="OnStarClick">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/star.svg"
                                       Classes="rating-star" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
                <Button Classes="favorite-btn image-favorite-btn" Width="30" Height="30" Padding="0"
                        Click="OnFavoriteClick" ToolTip.Tip="Favorit">
                    <Grid>
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/heart.svg"
                                       Width="20" Height="20" Classes="fav-heart"
                                       IsVisible="{Binding !IsFavorite}"/>
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/heart.svg"
                                       Width="20" Height="20" Classes="fav-heart active"
                                       IsVisible="{Binding IsFavorite}"/>
                    </Grid>
                </Button>
                <Button Classes="icon-btn pick-btn pick-keep on-image" Width="30" Height="30" Padding="0"
                        Classes.active="{Binding IsPicked}"
                        Tag="1" Click="OnPickClick"
                        ToolTip.Tip="Als behalten markieren (erneut nimmt es zurück)">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/thumbs-up.svg" Width="18" Height="18"/>
                </Button>
                <Button Classes="icon-btn pick-btn pick-reject on-image" Width="30" Height="30" Padding="0"
                        Classes.active="{Binding IsRejected}"
                        Tag="-1" Click="OnPickClick"
                        ToolTip.Tip="Als verworfen markieren (erneut nimmt es zurück)">
                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/thumbs-down.svg" Width="18" Height="18"/>
                </Button>
            </StackPanel>
            <!-- Farbetiketten, wie im Infopanel. -->
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10">
                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Tag="#F08A1A" Click="OnColorLabelClick" ToolTip.Tip="Orange"><Grid><Ellipse Width="16" Height="16" Fill="#F08A1A"/><Ellipse Width="22" Height="22" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2" IsVisible="{Binding IsColorLabelOrange}"/></Grid></Button>
                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Tag="#E74C3C" Click="OnColorLabelClick" ToolTip.Tip="Rot"><Grid><Ellipse Width="16" Height="16" Fill="#E74C3C"/><Ellipse Width="22" Height="22" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2" IsVisible="{Binding IsColorLabelRed}"/></Grid></Button>
                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Tag="#F03B88" Click="OnColorLabelClick" ToolTip.Tip="Pink"><Grid><Ellipse Width="16" Height="16" Fill="#F03B88"/><Ellipse Width="22" Height="22" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2" IsVisible="{Binding IsColorLabelPink}"/></Grid></Button>
                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Tag="#8B5CF6" Click="OnColorLabelClick" ToolTip.Tip="Lila"><Grid><Ellipse Width="16" Height="16" Fill="#8B5CF6"/><Ellipse Width="22" Height="22" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2" IsVisible="{Binding IsColorLabelPurple}"/></Grid></Button>
                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Tag="#3B82F6" Click="OnColorLabelClick" ToolTip.Tip="Blau"><Grid><Ellipse Width="16" Height="16" Fill="#3B82F6"/><Ellipse Width="22" Height="22" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2" IsVisible="{Binding IsColorLabelBlue}"/></Grid></Button>
                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Tag="#0891B2" Click="OnColorLabelClick" ToolTip.Tip="Cyan"><Grid><Ellipse Width="16" Height="16" Fill="#0891B2"/><Ellipse Width="22" Height="22" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2" IsVisible="{Binding IsColorLabelCyan}"/></Grid></Button>
                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Tag="#0F766E" Click="OnColorLabelClick" ToolTip.Tip="Türkis"><Grid><Ellipse Width="16" Height="16" Fill="#0F766E"/><Ellipse Width="22" Height="22" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2" IsVisible="{Binding IsColorLabelTeal}"/></Grid></Button>
                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Tag="#22C55E" Click="OnColorLabelClick" ToolTip.Tip="Grün"><Grid><Ellipse Width="16" Height="16" Fill="#22C55E"/><Ellipse Width="22" Height="22" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2" IsVisible="{Binding IsColorLabelGreen}"/></Grid></Button>
                <Button Classes="ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Tag="#FACC15" Click="OnColorLabelClick" ToolTip.Tip="Gelb"><Grid><Ellipse Width="16" Height="16" Fill="#FACC15"/><Ellipse Width="22" Height="22" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2" IsVisible="{Binding IsColorLabelYellow}"/></Grid></Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
