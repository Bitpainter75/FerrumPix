<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FerrumPix.Views.DiagnosticLogDialogView">

    <!-- Protokoll anzeigen (MainWindowViewModelDiagnosticLog): das Ende der Protokolldatei in
         einem schreibgeschuetzten Textfeld, markierbar und kopierbar, dazu zwei Knoepfe fuer das
         Ganze und den Ordner. Ohne Umbruch: eine Protokollzeile bleibt eine Zeile. Keine eigene
         Schrift, die Anwendung haengt an keiner Systemschrift. -->
    <StackPanel Spacing="10">
        <TextBox Classes="no-translate"
                 Text="{Binding DialogLogText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 HorizontalContentAlignment="Left"
                 Height="440"
                 FontSize="{DynamicResource FP.Font.Small}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 x:Name="LogText"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Padding="12,7" Click="OnCopyClick">
                <TextBlock Text="In die Zwischenablage kopieren" FontSize="{DynamicResource FP.Font.Small}"/>
            </Button>
            <Button Classes="ghost" Padding="12,7" Command="{Binding OpenLogFolderCommand}">
                <TextBlock Text="Ordner öffnen" FontSize="{DynamicResource FP.Font.Small}"/>
            </Button>
            <!-- Leert beide Dateien, etwa bevor ein Fehler fuer ein Protokoll nachgestellt wird. -->
            <Button Classes="ghost" Padding="12,7" Command="{Binding ClearLogCommand}">
                <TextBlock Text="Protokoll leeren" FontSize="{DynamicResource FP.Font.Small}"/>
            </Button>
            <TextBlock x:Name="CopiedNote" Text="Kopiert" IsVisible="False" VerticalAlignment="Center"
                       Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}"/>
        </StackPanel>
    </StackPanel>

</UserControl>
