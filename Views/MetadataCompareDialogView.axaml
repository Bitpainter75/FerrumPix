<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Views.MetadataCompareDialogView">

    <!-- Metadaten vergleichen: links, was an der Datei steht (Datei und Beistelldatei zusammen,
         so wie andere Programme es sehen), rechts der Katalog. Jede Angabe ist eine eigene Karte;
         weichen Datei und Katalog ab, traegt sie links eine Akzentkante, und erst dann stehen die
         Pfeile zum Kopieren da. Die Kreuze zum Loeschen sind blass und werden beim Ueberfahren der
         Karte deutlich: sie sollen auffindbar sein, aber nicht das Bild beherrschen. Vorgemerkte
         Zellen sind hinterlegt; geschrieben wird erst mit dem Bestaetigungsknopf. -->
    <UserControl.Styles>
        <Style Selector="Border.rowcard">
            <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="Border.rowcard.differs">
            <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        </Style>
        <Style Selector="Border.cell">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.cell.pending">
            <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        </Style>
        <Style Selector="TextBlock.value.empty">
            <Setter Property="Foreground" Value="{DynamicResource FP.Text.Muted}"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style Selector="Button.reveal">
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style Selector="Border.rowcard:pointerover Button.reveal">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.mini">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="9,2,3,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.chip.only">
            <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        </Style>
        <Style Selector="icons|SvgIcon.star">
            <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Muted}"/>
        </Style>
        <Style Selector="icons|SvgIcon.star.on">
            <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
        </Style>
        <Style Selector="icons|SvgIcon.accent">
            <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="12">

        <!-- Kopf: welche Datei, und wohin "Datei" schreibt. -->
        <Border Background="{DynamicResource FP.Bg.Input}"
                BorderBrush="{DynamicResource FP.Border.Subtle}"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/file-image.svg"
                               Classes="accent" Width="28" Height="28" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Classes="no-translate" FontWeight="SemiBold"
                               FontSize="{DynamicResource FP.Font.Subtitle}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TargetNote}" Classes="no-translate" TextWrapping="Wrap"
                               FontSize="{DynamicResource FP.Font.Small}"
                               Foreground="{DynamicResource FP.Text.Secondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Spaltenkoepfe, in denselben Breiten wie die Karten darunter (13 = Rand und Kante). -->
        <Grid ColumnDefinitions="150,*,84,*" Margin="13,0,16,0">
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/file.svg" Width="16" Height="16"
                               VerticalAlignment="Center"/>
                <TextBlock Text="Datei" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/database.svg" Width="16" Height="16"
                               VerticalAlignment="Center"/>
                <TextBlock Text="Katalog" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Panel AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree">
                            <!-- Abschnitt: Symbol, Titel und eine Linie bis zum Rand. -->
                            <Grid IsVisible="{Binding IsSection}" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"
                                  Margin="2,14,0,8">
                                <icons:SvgIcon Source="{Binding IconSource}" Classes="accent" Width="16" Height="16"
                                               VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="no-translate"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FP.Text.Accent}"/>
                                <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                                        Background="{DynamicResource FP.Border.Subtle}"/>
                            </Grid>

                            <!-- Angabe als Karte -->
                            <Border IsVisible="{Binding IsValue}" Classes="rowcard" Classes.differs="{Binding Differs}">
                                <Grid ColumnDefinitions="150,*,84,*" ColumnSpacing="6">
                                    <TextBlock Text="{Binding Label}" Classes="no-translate" VerticalAlignment="Top" Margin="0,4,0,0"
                                               FontSize="{DynamicResource FP.Font.Small}"
                                               Foreground="{DynamicResource FP.Text.Secondary}"/>

                                    <!-- Datei -->
                                    <Border Grid.Column="1" Classes="cell" Classes.pending="{Binding FilePending}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Classes="icon-btn mini reveal" Command="{Binding DeleteFileCommand}"
                                                    IsVisible="{Binding CanDeleteFile}" ToolTip.Tip="An der Datei entfernen">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/trash.svg" Width="12" Height="12"/>
                                            </Button>
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPlainText}">
                                                    <Border Width="11" Height="11" CornerRadius="6" VerticalAlignment="Center"
                                                            Background="{Binding FileSwatch}" IsVisible="{Binding HasFileSwatch}"/>
                                                    <TextBlock Text="{Binding FileDisplay}" Classes="value no-translate"
                                                               Classes.empty="{Binding FileIsEmpty}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding FileStars}" IsVisible="{Binding IsRating}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <icons:SvgIcon Source="{Binding Source}" Classes="star" Classes.on="{Binding IsOn}"
                                                                           Width="15" Height="15"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding FileDisplay}" Classes="value empty no-translate"
                                                           IsVisible="{Binding ShowFileKeywordPlaceholder}"/>
                                                <ItemsControl ItemsSource="{Binding FileChips}" IsVisible="{Binding IsKeywords}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="chip" Classes.only="{Binding OnlyHere}" AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <TextBlock Text="{Binding Text}" Classes="no-translate" VerticalAlignment="Center"/>
                                                                    <Button Classes="icon-btn mini" Command="{Binding CopyCommand}"
                                                                            IsVisible="{Binding CanCopy}" ToolTip.Tip="{Binding CopyTip}"
                                                                            VerticalAlignment="Center">
                                                                        <icons:SvgIcon Source="{Binding CopyIconSource}" Classes="accent" Width="12" Height="12"/>
                                                                    </Button>
                                                                    <Button Classes="icon-btn mini" Command="{Binding RemoveCommand}" ToolTip.Tip="Entfernen"
                                                                            VerticalAlignment="Center">
                                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/trash.svg" Width="11" Height="11"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding FileOnlyText}" IsVisible="{Binding HasFileOnly}" Classes="no-translate"
                                                           FontSize="{DynamicResource FP.Font.Small}" Foreground="{DynamicResource FP.Text.Muted}"
                                                           TextWrapping="Wrap"/>
                                                <Border IsVisible="{Binding HasConflict}" CornerRadius="4" Padding="6,4" Margin="0,2,0,0"
                                                        Background="{DynamicResource FP.Bg.Elevated}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/warning.svg"
                                                                       Classes="accent" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ConflictText}" Classes="no-translate" TextWrapping="Wrap"
                                                                   FontSize="{DynamicResource FP.Font.Small}" Foreground="{DynamicResource FP.Text.Secondary}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Kopieren: bei jeder kopierbaren Angabe, ausgegraut bei gleichen Werten. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center"
                                                VerticalAlignment="Top" Margin="0,1,0,0" IsVisible="{Binding ShowCopy}">
                                        <Button Classes="icon-btn mini" Command="{Binding CopyToFileCommand}" ToolTip.Tip="Katalogwert in die Datei"
                                                IsEnabled="{Binding Differs}">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-square-left.svg" Width="15" Height="15"/>
                                        </Button>
                                        <Button Classes="icon-btn mini" Command="{Binding CopyToCatalogCommand}" ToolTip.Tip="Dateiwert in den Katalog"
                                                IsEnabled="{Binding Differs}">
                                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-square-right.svg" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Katalog -->
                                    <Border Grid.Column="3" Classes="cell" Classes.pending="{Binding CatalogPending}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Classes="icon-btn mini reveal" Command="{Binding DeleteCatalogCommand}"
                                                    IsVisible="{Binding CanDeleteCatalog}" ToolTip.Tip="Im Katalog entfernen">
                                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/trash.svg" Width="12" Height="12"/>
                                            </Button>
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPlainText}">
                                                    <Border Width="11" Height="11" CornerRadius="6" VerticalAlignment="Center"
                                                            Background="{Binding CatalogSwatch}" IsVisible="{Binding HasCatalogSwatch}"/>
                                                    <TextBlock Text="{Binding CatalogDisplay}" Classes="value no-translate"
                                                               Classes.empty="{Binding CatalogIsEmpty}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding CatalogStars}" IsVisible="{Binding IsRating}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <icons:SvgIcon Source="{Binding Source}" Classes="star" Classes.on="{Binding IsOn}"
                                                                           Width="15" Height="15"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding CatalogDisplay}" Classes="value empty no-translate"
                                                           IsVisible="{Binding ShowCatalogKeywordPlaceholder}"/>
                                                <ItemsControl ItemsSource="{Binding CatalogChips}" IsVisible="{Binding IsKeywords}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="chip" Classes.only="{Binding OnlyHere}" AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <TextBlock Text="{Binding Text}" Classes="no-translate" VerticalAlignment="Center"/>
                                                                    <Button Classes="icon-btn mini" Command="{Binding CopyCommand}"
                                                                            IsVisible="{Binding CanCopy}" ToolTip.Tip="{Binding CopyTip}"
                                                                            VerticalAlignment="Center">
                                                                        <icons:SvgIcon Source="{Binding CopyIconSource}" Classes="accent" Width="12" Height="12"/>
                                                                    </Button>
                                                                    <Button Classes="icon-btn mini" Command="{Binding RemoveCommand}" ToolTip.Tip="Entfernen"
                                                                            VerticalAlignment="Center">
                                                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/trash.svg" Width="11" Height="11"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding CatalogOnlyText}" IsVisible="{Binding HasCatalogOnly}" Classes="no-translate"
                                                           FontSize="{DynamicResource FP.Font.Small}" Foreground="{DynamicResource FP.Text.Muted}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Fuss: Legende links, Sammelaktionen und Zaehler rechts. Bricht um, statt sich zu
             ueberlappen, wenn das Fenster schmaler ist als der Dialog. -->
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,8">
                <Border Width="3" Height="16" CornerRadius="2" Background="{DynamicResource FP.Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Datei und Katalog weichen ab" VerticalAlignment="Center"
                           FontSize="{DynamicResource FP.Font.Small}" Foreground="{DynamicResource FP.Text.Secondary}"/>
            </StackPanel>
            <WrapPanel DockPanel.Dock="Right" ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
                <Border IsVisible="{Binding HasPending}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center"
                        Background="{DynamicResource FP.Sel.Bg}">
                    <TextBlock Text="{Binding PendingText}" Classes="no-translate" FontSize="{DynamicResource FP.Font.Small}"/>
                </Border>
                <Button Classes="ghost" Command="{Binding CopyAllToFileCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-square-left.svg" Width="14" Height="14"/>
                        <TextBlock Text="Alles in die Datei"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding CopyAllToCatalogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Alles in den Katalog"/>
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/arrow-square-right.svg" Width="14" Height="14"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
