<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:FerrumPix.Controls"
        xmlns:views="clr-namespace:FerrumPix.Views"
        x:Class="FerrumPix.Views.MainWindow"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="600"
        CanResize="True"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="TextBlock.window-title">
            <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        </Style>
        <Style Selector="TextBlock.window-title.raw-developed">
            <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        </Style>
    </Window.Styles>

    <Border x:Name="WindowFrame"
            CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource FP.Bg.Root}">
        <Grid>
            <Grid x:Name="TitleBar"
                  RowDefinitions="Auto,*"
                  IsHitTestVisible="{Binding IsAppContentHitTestVisible}">
                <!-- window-drag: hier (und nur in den Fusszeilen der Modus-Views) laesst sich das
                     Fenster verschieben - siehe MainWindow.IsInWindowDragArea. -->
                <Border x:Name="TopWindowDragArea"
                        Grid.Row="0"
                        Classes="toolbar window-drag"
                        Height="46"
                        IsVisible="{Binding IsWindowChromeVisible}">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <StackPanel x:Name="WindowLogoPanel"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0"
                                    IsHitTestVisible="False">
                            <Image Source="avares://FerrumPix/Assets/FerrumPix_TopBarDark.png"
                                   Width="140"
                                   Height="32"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   IsVisible="{Binding IsDarkLogoVisible}"/>
                            <Image Source="avares://FerrumPix/Assets/FerrumPix_TopBarLight.png"
                                   Width="140"
                                   Height="32"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   IsVisible="{Binding IsLightLogoVisible}"/>
                        </StackPanel>

                        <!-- Dateiname und Farbetikett des offenen Bildes als Fenstertitel. Sie
                             standen vorher links in der Fusszeile von Betrachter und Editor, wo
                             sie mit den mittig zentrierten Zoom-Bedienelementen um Platz stritten.
                             Hier ist der Platz frei und die Angabe steht in beiden Modi an
                             derselben Stelle. In der Galerie bleibt sie leer - dort gibt es kein
                             einzelnes Bild. -->
                        <!-- Ueber ALLE Spalten und darin zentriert. In Spalte 1 zentriert sass der
                             Titel nicht in der Fenstermitte: die Spalte beginnt erst hinter dem
                             Logo, und die dritte Spalte ist leer - ihre Mitte liegt also um die
                             halbe Logobreite nach rechts versetzt. -->
                        <StackPanel Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding WindowTitleColorLabelBrush}"
                                     IsVisible="{Binding HasWindowTitleColorLabel}"
                                     VerticalAlignment="Center"/>
                            <!-- Akzentfarbe = entwickeltes RAW. Wird bei einem RAW nur die
                                 eingebettete JPEG-Vorschau bearbeitet, bleibt der Name gedaempft
                                 wie bei jedem anderen Bild. -->
                            <TextBlock Text="{Binding WindowTitleFileName}"
                                       Classes="window-title"
                                       Classes.raw-developed="{Binding IsWindowTitleRawDeveloped}"
                                       VerticalAlignment="Center"
                                       MaxWidth="420"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource FP.Font.Body}"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <ContentControl x:Name="MainContentHost" Grid.Row="1" Content="{Binding CurrentContent}"/>
            </Grid>

            <!-- EIN BILD WIRD GEOEFFNET. Der Editor wechselt den Modus erst, wenn das Bild offen
                 ist; bei einem RAW dauert das Sekunden, und ohne Anzeige haelt man den Klick fuer
                 danebengegangen. Erscheint erst nach einer Viertelsekunde - ein JPEG ist vorher da.
                 Faengt die Maus ab, damit der zweite Klick gar nicht erst irgendwo landet.
                 UNTER den Dialogen: eine Rueckfrage muss davor liegen. -->
            <Border ZIndex="498"
                    IsVisible="{Binding ShowsDocumentOpen}"
                    Background="#66000000"
                    IsHitTestVisible="True">
                <Border Background="{DynamicResource FP.Bg.Elevated}"
                        BorderBrush="{DynamicResource FP.Border.Strong}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                                     VerticalAlignment="Center" />
                        <TextBlock Classes="no-translate"
                                   Text="{Binding DocumentOpenText}"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FP.Font.Body}" />
                        <!-- ABBRECHEN. Nur bei einem Stapellauf da; ein Bild zu oeffnen dauert
                             Sekunden und braucht keinen Knopf. -->
                        <Button Classes="icon-btn"
                                Width="26" Height="26" Padding="0"
                                IsVisible="{Binding CanCancelBusyOverlay}"
                                Command="{Binding CancelBusyOverlayCommand}"
                                ToolTip.Tip="Abbrechen. Der Stapel endet nach dem Bild, an dem er gerade rechnet; dieses Bild wird nicht geschrieben.">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                           Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <views:DialogOverlayView x:Name="DialogOverlay" ZIndex="500"/>

            <!-- Der Druckdialog liegt hier und nicht in einer der Modus-Views, weil er aus
                 Galerie, Betrachter und Editor gleichermaßen geöffnet wird. UNTER dem
                 Standard-Dialog-Overlay (500), damit Meldungen wie "Drucken fehlgeschlagen"
                 immer davor liegen statt dahinter zu verschwinden. -->
            <views:PrintDialogOverlayView x:Name="PrintDialogOverlay" ZIndex="499"/>

            <Border x:Name="CustomWindowControlsHost"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0">
                <StackPanel x:Name="CustomWindowControls"
                            Orientation="Horizontal"
                            Spacing="7"
                            IsHitTestVisible="{Binding IsAppContentHitTestVisible}"
                            IsVisible="{Binding IsWindowChromeVisible}">
                    <Button Classes="wnd-btn" x:Name="MinimizeButton" ToolTip.Tip="Minimieren">
                        <TextBlock Text="−" FontSize="{DynamicResource FP.Glyph.Medium}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="wnd-btn" x:Name="MaximizeButton" ToolTip.Tip="Maximieren">
                        <TextBlock x:Name="MaximizeGlyph" Text="□" FontSize="{DynamicResource FP.Glyph.Small}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="wnd-close" x:Name="CloseButton" ToolTip.Tip="Schließen">
                        <TextBlock Text="×" FontSize="{DynamicResource FP.Glyph.XLarge}" Margin="0,-2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="ResizeTop" Height="5" Background="Transparent"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                    Cursor="TopSide"/>
            <Border x:Name="ResizeBottom" Height="5" Background="Transparent"
                    HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    Cursor="BottomSide"/>
            <Border x:Name="ResizeLeft" Width="5" Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Cursor="LeftSide"/>
            <Border x:Name="ResizeRight" Width="3" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Cursor="RightSide"/>
            <Border x:Name="ResizeTopLeft" Width="14" Height="14" Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Cursor="TopLeftCorner"/>
            <Border x:Name="ResizeTopRight" Width="14" Height="14" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Cursor="TopRightCorner"/>
            <Border x:Name="ResizeBottomLeft" Width="14" Height="14" Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Cursor="BottomLeftCorner"/>
            <Border x:Name="ResizeBottomRight" Width="14" Height="14" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Cursor="BottomRightCorner"/>
        </Grid>
    </Border>
</Window>
