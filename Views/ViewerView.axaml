<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:vm="clr-namespace:FerrumPix.ViewModels"
             xmlns:models="clr-namespace:FerrumPix.Models"
             xmlns:services="clr-namespace:FerrumPix.Services"
             xmlns:views="clr-namespace:FerrumPix.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="FerrumPix.Views.ViewerView"
             Background="{DynamicResource FP.Bg.Root}"
             Focusable="True"
             FocusAdorner="{x:Null}"
             KeyDown="OnKeyDown"
             PointerReleased="OnGlobalPointerReleased">

    <Grid x:Name="ViewerRootGrid" RowDefinitions="60,*,Auto" ColumnDefinitions="*,320">

        <!-- EIN Kontextmenue fuer Buehne, Filmstreifen und Fusszeile. Welcher Ort gemeint ist
             und welche Elemente, entscheidet OnContextRequested. -->
        <Grid.ContextMenu>
            <ContextMenu x:Name="ViewerKontextMenu" Opened="OnFooterMenuOpened" ItemsSource="{Binding ContextActions}">
            <!-- Eine Vorlage fuer alle Eintraege. Symbol und Text liegen zusammen im
            Header statt in MenuItem.Icon: die eingebaute Symbolspalte ist breiter
            als 16 Punkte und schob das Zeichen sichtbar nach links weg. So bestimmt
            der Abstand hier die Lage, und zwar fuer jeden Eintrag gleich.

            Die Zeilen mit Sternen, Herz und Farbkreisen tragen die Klasse "widget" und
            bleiben ausgenommen: sie bringen ihren Inhalt selbst mit. Ohne diese Ausnahme
            ueberschrieb die Vorlage ihn - erst waren sie leer, dann nicht bedienbar. -->
            <ContextMenu.Styles>
            <Style Selector="MenuItem:not(.widget)">
            <!-- Schmaler als die Vorgabe des Erscheinungsbilds (208): die Eintraege sind kurz,
                 und ein Menue, das breiter ist als sein laengster Text, wirkt leer. -->
            <Setter Property="MinWidth" Value="178"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="CommandParameter" Value="{Binding Parameter}"/>
            <Setter Property="ItemsSource" Value="{Binding Children}"/>
            <Setter Property="Header">
            <Template>
            <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:SvgIcon Source="{Binding IconSource}"
            Width="16" Height="16"
            VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
            </StackPanel>
            </Template>
            </Setter>
            </Style>
            </ContextMenu.Styles>
            </ContextMenu>
        </Grid.ContextMenu>


        <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="toolbar" Height="60" Padding="24,0">
            <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding BackToGalleryCommand}"
                            ToolTip.Tip="Zurück zur Galerie">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/home.svg"
                                       Width="20" Height="20"/>
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding PreviousCommand}"
                            ToolTip.Tip="Vorheriges Bild">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-left.svg"
                               Width="20" Height="20"/>
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding NextCommand}"
                            ToolTip.Tip="Nächstes Bild">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrow-right.svg"
                               Width="20" Height="20"/>
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding PrintCommand}"
                            ToolTip.Tip="Drucken (Strg+P)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/printer.svg"
                               Width="20" Height="20"/>
                    </Button>

                    <!-- Anheften: das aktuelle Bild festhalten, das naechste kommt daneben. Der
                         bequeme Weg in den Vergleich, ohne den Umweg ueber die Galerie. -->
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Classes.active="{Binding IsImagePinned}"
                            IsEnabled="{Binding CanPinForCompare}"
                            Click="OnTogglePinClick"
                            ToolTip.Tip="Bild anheften – das nächste Bild wird daneben zum Vergleich gezeigt">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/pin.svg"
                               Width="20" Height="20"/>
                    </Button>

                    <!-- Ausschnitt koppeln. Bewusst ein EIGENER Schalter und keine dritte Stufe am
                         Anheften: das Anheften beantwortet "welches Bild halte ich fest", dieser
                         "wie bewegen sich die Flaechen". Nur im Vergleich sichtbar, weil er sonst
                         nichts bedeutet. -->
                    <Button Classes="icon-btn" Width="38" Height="38"
                            IsVisible="{Binding IsCompareMode}"
                            Classes.active="{Binding IsCompareViewportLinked}"
                            Click="OnToggleCompareViewportLinkClick"
                            ToolTip.Tip="Ausschnitt beider Bilder koppeln - ausgeschaltet lässt sich jede Seite für sich verschieben">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/link.svg"
                               Width="20" Height="20"/>
                    </Button>


                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding RotateLeftCommand}"
                            IsEnabled="{Binding IsSingleImageMode}"
                            ToolTip.Tip="Bild nach links drehen (Strg+Pfeil links)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/rotate-2.svg"
                               Width="20" Height="20"/>
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding RotateRightCommand}"
                            IsEnabled="{Binding IsSingleImageMode}"
                            ToolTip.Tip="Bild nach rechts drehen (Strg+Pfeil rechts)">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/rotate-clockwise-2.svg"
                               Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="-110,0,0,0">
                    <Button Classes="ghost" Height="38"
                            Command="{Binding ToggleSlideshowCommand}"
                            ToolTip.Tip="Diashow starten">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/player-play.svg" Width="20" Height="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Diashow starten" IsVisible="{Binding AreToolbarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Height="38" Command="{Binding EditCommand}" ToolTip.Tip="Anpassen"
                            IsEnabled="{Binding CanEdit}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/exposure.svg" Width="20" Height="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Anpassen" IsVisible="{Binding AreToolbarLabelsVisible}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right" >
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Command="{Binding DeleteCurrentCommand}"
                            IsEnabled="{Binding CanDeleteCurrent}"
                            ToolTip.Tip="Löschen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/trash.svg"
                                       Width="18" Height="18"/>
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Click="OnToggleFilmstripClick"
                            Classes.active="{Binding ShowFilmstrip}"
                            ToolTip.Tip="Filmstreifen ein- oder ausblenden">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/eye.svg"
                                       Width="18" Height="18"/>
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Classes.active="{Binding IsInfoSidebarVisible}"
                            Command="{Binding ToggleInfoSidebarCommand}"
                            ToolTip.Tip="Info">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/info-circle.svg"
                                       Width="20" Height="20"/>
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Click="OnSettingsClick"
                            ToolTip.Tip="Einstellungen">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/settings.svg"
                                       Width="18" Height="18"/>
                    </Button>
                    <Button Classes="icon-btn" Width="38" Height="38"
                            Click="OnToggleFullscreenClick"
                            ToolTip.Tip="Vollbild">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/maximize.svg"
                               Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Background="{DynamicResource FP.Bg.Root}">
            <Border Margin="88,0,80,0" ClipToBounds="True">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                IsVisible="{Binding HasNoMedia}">
                        <TextBlock Text="Kein Bild geöffnet" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Subtitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Wähle ein Bild aus der Galerie" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                IsVisible="{Binding ShowBitmapLoading}">
                        <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                        <TextBlock Text="Bild wird geladen und gerendert…"
                                   Foreground="{DynamicResource FP.Text.Muted}"
                                   FontSize="{DynamicResource FP.Font.Small}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                IsVisible="{Binding ShowVideoUnavailableNotice}">
                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/video.svg" Width="40" Height="40" HorizontalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="Videowiedergabe nicht verfügbar" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Subtitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="mpv ist auf diesem System nicht installiert" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Name="ImageScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  SizeChanged="OnImageViewportSizeChanged"
                                  IsVisible="{Binding IsSingleImageVisible}">
                        <!-- Die Zieh-Ereignisse haengen am PANEL, nicht am Bild: der Zuschneide-Rahmen
                             soll wie im Editor auch AUSSERHALB des Bildes auf der Buehne angesetzt
                             werden koennen (die Rechnung klemmt die Punkte ohnehin auf das Bild).
                             Dafuer braucht das Panel einen transparenten Hintergrund - ohne ihn ist
                             die freie Flaeche nicht treffbar. Doppelklick und Verlassen bleiben am
                             Bild: ein Doppelklick ins Leere soll nicht den Editor oeffnen. -->
                        <!-- Auch der Doppelklick haengt am PANEL: der Zuschneide-Zug faengt den Zeiger
                             dort, und ein am Bild angemeldeter DoubleTapped kam dadurch nie mehr an
                             (Befund: Doppelklick oeffnete den Editor nicht mehr). Ob der Klick das
                             BILD traf, prueft der Handler geometrisch - ins Leere oeffnet weiter nichts. -->
                        <Panel Background="Transparent"
                               PointerPressed="OnImagePointerPressed"
                               PointerMoved="OnImagePointerMoved"
                               PointerReleased="OnImagePointerReleased"
                               PointerCaptureLost="OnImagePointerCaptureLost"
                               DoubleTapped="OnImageDoubleTapped">
                            <Border Name="MainImageBackgroundBorder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding TransparencyBackgroundBrush}">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding ScaleX}" ScaleY="1"/>
                                        <RotateTransform Angle="{Binding RotationAngle}"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Image Name="MainImage"
                                       Source="{Binding CurrentImage}"
                                       Stretch="Uniform"
                                       Margin="-1"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       PointerExited="OnImagePointerExited" />
                            </Border>
                            <Canvas Name="CropSelectionCanvas" IsHitTestVisible="False">
                                <Border Name="CropSelectionRect"
                                        IsVisible="False"
                                        IsHitTestVisible="False"
                                        Background="#33F08A1A"
                                        BorderBrush="{DynamicResource FP.Accent}"
                                        BorderThickness="1.5">
                                    <Border Background="#CC1A1D24"
                                            CornerRadius="4"
                                            Padding="6,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="6,6,0,0">
                                        <TextBlock Name="CropSelectionSizeBadgeText"
                                                   Text=""
                                                   Foreground="White"
                                                   FontSize="{DynamicResource FP.Font.Small}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Border>
                            </Canvas>
                        </Panel>
                    </ScrollViewer>

                    <!-- Vergleichsbuehne: zwei Flaechen, EIN Zoom (beide rechnen mit vm.ZoomLevel),
                         Ausschnitt gespiegelt (Code-behind). Die fokussierte Flaeche traegt den
                         Akzentrahmen, und das Infopanel zeigt ihre Daten. -->
                    <Grid Name="CompareStage" ColumnDefinitions="*,6,*" IsVisible="{Binding IsCompareMode}">
                        <Border Grid.Column="0" BorderThickness="2" CornerRadius="3"
                                BorderBrush="{DynamicResource FP.Accent}"
                                IsVisible="{Binding IsCompareLeftFocused}" ZIndex="1"
                                IsHitTestVisible="False" />
                        <ScrollViewer Grid.Column="0" Name="CompareLeftScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      SizeChanged="OnCompareViewportSizeChanged"
                                      PointerPressed="OnComparePanePressed" Tag="0"
                                      DoubleTapped="OnComparePaneDoubleTapped"
                                      PointerMoved="OnComparePaneMoved"
                                      PointerReleased="OnComparePaneReleased"
                                      PointerCaptureLost="OnComparePaneReleased">
                            <Image Name="CompareLeftImage" Source="{Binding CompareLeftImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </ScrollViewer>

                        <!-- Marken der linken Flaeche. Dauerhaft sichtbar und AUF dem Bild: nur so ist
                             ablesbar, welches der beiden Bilder ein Knopf meint. Alles am linken Rand,
                             damit der Blick beim Vergleichen nur eine Kante absuchen muss. -->
                        <Grid Grid.Column="0" ZIndex="2" IsVisible="{Binding IsCompareMode}">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
                                <Button Classes="gallery-overlay-btn" Width="30" Height="30" Padding="0"
                                        Tag="0" Click="OnCompareEditClick" ToolTip.Tip="Anpassen">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/exposure.svg"
                                                   Width="17" Height="17" IconBrush="White"/>
                                </Button>
                                <Button Classes="gallery-overlay-btn danger" Width="30" Height="30" Padding="0"
                                        Tag="0" Click="OnCompareDeleteClick" ToolTip.Tip="Löschen">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/trash.svg"
                                                   Width="18" Height="18" IconBrush="White"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Left" Margin="10,0,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareLeftRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=1}"
                                            Tag="0:1" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareLeftRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=2}"
                                            Tag="0:2" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareLeftRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=3}"
                                            Tag="0:3" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareLeftRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=4}"
                                            Tag="0:4" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareLeftRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=5}"
                                            Tag="0:5" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                </StackPanel>
                                <Button Classes="favorite-btn image-favorite-btn" Width="30" Height="30" Padding="0"
                                        Tag="0" Click="OnCompareFavoriteClick" ToolTip.Tip="Favorit">
                                    <Grid>
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                       Width="20" Height="20" Classes="fav-heart"
                                                       IsVisible="{Binding !CompareLeftIsFavorite}"/>
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                       Width="20" Height="20" Classes="fav-heart active"
                                                       IsVisible="{Binding CompareLeftIsFavorite}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="2" BorderThickness="2" CornerRadius="3"
                                BorderBrush="{DynamicResource FP.Accent}"
                                IsVisible="{Binding IsCompareRightFocused}" ZIndex="1"
                                IsHitTestVisible="False" />
                        <ScrollViewer Grid.Column="2" Name="CompareRightScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PointerPressed="OnComparePanePressed" Tag="1"
                                      DoubleTapped="OnComparePaneDoubleTapped"
                                      PointerMoved="OnComparePaneMoved"
                                      PointerReleased="OnComparePaneReleased"
                                      PointerCaptureLost="OnComparePaneReleased">
                            <Image Name="CompareRightImage" Source="{Binding CompareRightImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </ScrollViewer>

                        <!-- Marken der rechten Flaeche. Dauerhaft sichtbar und AUF dem Bild: nur so ist
                             ablesbar, welches der beiden Bilder ein Knopf meint. Alles am linken Rand,
                             damit der Blick beim Vergleichen nur eine Kante absuchen muss. -->
                        <Grid Grid.Column="2" ZIndex="2" IsVisible="{Binding IsCompareMode}">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
                                <Button Classes="gallery-overlay-btn" Width="30" Height="30" Padding="0"
                                        Tag="1" Click="OnCompareEditClick" ToolTip.Tip="Anpassen">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/exposure.svg"
                                                   Width="17" Height="17" IconBrush="White"/>
                                </Button>
                                <Button Classes="gallery-overlay-btn danger" Width="30" Height="30" Padding="0"
                                        Tag="1" Click="OnCompareDeleteClick" ToolTip.Tip="Löschen">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/trash.svg"
                                                   Width="18" Height="18" IconBrush="White"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Left" Margin="10,0,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareRightRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=1}"
                                            Tag="1:1" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareRightRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=2}"
                                            Tag="1:2" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareRightRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=3}"
                                            Tag="1:3" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareRightRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=4}"
                                            Tag="1:4" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                    <Button Classes="star-btn compact" Background="Transparent" BorderThickness="0" Padding="1,0"
                                            Classes.active="{Binding CompareRightRating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=5}"
                                            Tag="1:5" Click="OnCompareStarClick">
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                                       Classes="rating-star" Width="17" Height="17"/>
                                    </Button>
                                </StackPanel>
                                <Button Classes="favorite-btn image-favorite-btn" Width="30" Height="30" Padding="0"
                                        Tag="1" Click="OnCompareFavoriteClick" ToolTip.Tip="Favorit">
                                    <Grid>
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                       Width="20" Height="20" Classes="fav-heart"
                                                       IsVisible="{Binding !CompareRightIsFavorite}"/>
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                       Width="20" Height="20" Classes="fav-heart active"
                                                       IsVisible="{Binding CompareRightIsFavorite}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>


                        <!-- Tauschen sitzt zwischen den Flaechen: es gehoert zu BEIDEN, nicht zu
                             einer. Rund, damit es sich von den eckigen Marken der Flaechen
                             unterscheidet und nicht als deren dritter Knopf gelesen wird. -->
                        <Button Grid.Column="0" Grid.ColumnSpan="3" ZIndex="3"
                                Classes="video-play-badge"
                                Width="46" Height="46" CornerRadius="23"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsEnabled="{Binding CanSwapComparePanes}"
                                Click="OnSwapComparePanesClick"
                                ToolTip.Tip="Seiten tauschen - das rechte Bild wird das neue angeheftete">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/arrows-exchange.svg"
                                           Width="22" Height="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IconBrush="White"/>
                        </Button>

                    </Grid>

                </Grid>
            </Border>

            <Button Classes="ghost"
                    Width="54" Height="54"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="26,0"
                    Command="{Binding PreviousCommand}"
                    CornerRadius="27"
                    Background="#8010161B"
                    BorderBrush="{DynamicResource FP.Border.Normal}">
                <Canvas Width="20" Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Path Stroke="{DynamicResource FP.Text.Primary}"
                          StrokeThickness="2.6"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Data="M 13 4 L 7 10 L 13 16"/>
                </Canvas>
            </Button>
            <Button Classes="ghost"
                    Width="54" Height="54"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="26,0"
                    Command="{Binding NextCommand}"
                    CornerRadius="27"
                    Background="#8010161B"
                    BorderBrush="{DynamicResource FP.Border.Normal}">
                <Canvas Width="20" Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Path Stroke="{DynamicResource FP.Text.Primary}"
                          StrokeThickness="2.6"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Data="M 7 4 L 13 10 L 7 16"/>
                </Canvas>
            </Button>
        </Grid>

        <views:InfoSidebarView Grid.Row="1" Grid.Column="1" Width="320"/>

        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Classes="window-drag"
                Background="{DynamicResource FP.Bg.Dark}"
                BorderBrush="{DynamicResource FP.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="24,8,24,8"
                >
            <!-- Dasselbe Menue wie hinter der Schaltflaeche, hier als Rechtsklick auf die
                 Fussleiste. Bewusst NICHT auf der Bildflaeche: dort ist die rechte Taste
                 bereits belegt (im Betrachter zoomt sie, im Editor hebt sie die Auswahl auf). -->
            <Grid RowDefinitions="Auto,28">
                <ListBox Name="FilmstripListBox"
                         Classes="filmstrip-list"
                         Height="110"
                         IsVisible="{Binding ShowFilmstrip}"
                         ItemsSource="{Binding FilmstripItems}"
                         SelectedIndex="{Binding CurrentFilmstripIndex, Mode=OneWay}"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" Margin="0,0,0,8"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ImageItem}">
                            <Border Width="148" Height="100"
                                    Classes="thumb-card"
                                    Classes.selected="{Binding IsSelected}"
                                    ClipToBounds="True"
                                    PointerPressed="OnFilmstripItemPressed">
                                <Border CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="LowQuality"/>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <!-- Farbetikett steht jetzt als Fenstertitel oben in der Mitte, neben dem
                             Dateinamen - wie im Editor. -->
                        <!-- Dasselbe Fussmenue wie in der Galerie, aber nur mit dem, was fuer EIN
                             angezeigtes Bild sinnvoll ist. Alles haengt an vorhandenen Kommandos des
                             Betrachters, es gibt also keinen zweiten Satz Behandler. -->
                        <Button Classes="icon-btn" Width="34" Height="34"
                                Margin="-14,0,0,0"
                                ToolTip.Tip="Menü für dieses Bild"
                                Click="OnFooterMenuButtonClick">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/menu-2.svg"
                                           Width="20" Height="20"/>
                        </Button>
                        <!-- Dateiname steht jetzt als Fenstertitel oben in der Mitte. -->
                        <TextBlock Text="{Binding StatusInfo}" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="ghost" Height="20" Padding="4,0,4,2" VerticalContentAlignment="Center" Focusable="False"
                                Command="{Binding ZoomOutCommand}" ToolTip.Tip="Verkleinern">
                            <TextBlock Text="−" FontSize="{DynamicResource FP.Glyph.Large}" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center"/>
                        </Button>
                        <icons:RoundSlider Width="110" Height="26" MinHeight="0" Minimum="0" Maximum="100"
                                            Value="{Binding ZoomSliderValue, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <Button Classes="ghost" Height="20" Padding="4,0,4,2" VerticalContentAlignment="Center" Focusable="False"
                                Command="{Binding ZoomInCommand}" ToolTip.Tip="Vergrößern">
                            <TextBlock Text="+" FontSize="{DynamicResource FP.Glyph.Large}" Foreground="{DynamicResource FP.Text.Secondary}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="ghost" Height="26" Padding="8,2" Margin="12,0,0,0" Focusable="False"
                                Classes.active="{Binding IsZoomActualActive}"
                                Command="{Binding ZoomActualCommand}" ToolTip.Tip="Auf 100 Prozent springen">
                            <TextBlock Text="{Binding ZoomText}" Foreground="{DynamicResource FP.Text.Primary}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="ghost" Height="26" Padding="8,2" Margin="8,0,0,0" Focusable="False"
                                Classes.active="{Binding IsZoomFitActive}"
                                Command="{Binding ZoomFitCommand}" ToolTip.Tip="Bild vollständig in die Vorschau einpassen">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/aspect-ratio.svg" Width="20" Height="20"/>
                                <TextBlock Text="Einpassen" VerticalAlignment="Center" IsVisible="{Binding AreToolbarLabelsVisible}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MousePositionText}" Margin="0,0,20,0"
                                       IsVisible="{Binding MousePositionText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Body}" VerticalAlignment="Center"/>
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center" 
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=1}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="1">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=2}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="2">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=3}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="3">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=4}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="4">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="star-btn" Background="Transparent" BorderThickness="0" Padding="2,0,2,2" VerticalAlignment="Center"
                                    Classes.active="{Binding Rating, Converter={StaticResource RatingThresholdConverter}, ConverterParameter=5}"
                                    Command="{Binding SetRatingCommand}" CommandParameter="5">
                                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/star.svg"
                                               Classes="rating-star"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="icon-btn"
                                    Width="24" Height="24" VerticalAlignment="Center"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    ToolTip.Tip="Favorit" Margin="6,0,0,0">
                                <Grid Width="20" Height="20">
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                   Width="20" Height="20"
                                                   Classes="fav-heart"
                                                   IsVisible="{Binding !IsFavorite}" />
                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/heart.svg"
                                                   Width="20" Height="20"
                                                   Classes="fav-heart active"
                                                   IsVisible="{Binding IsFavorite}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Schnellvorschau-Overlay (Mausrad-Klick auf Filmstrip) -->
        <Panel Name="FilmstripPreviewOverlay"
               Grid.RowSpan="3" Grid.ColumnSpan="2"
               IsVisible="False"
               Background="#D9000000"
               ZIndex="100">
            <Image Name="FilmstripPreviewImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="60"/>
        </Panel>

        <Grid Name="FullscreenViewport"
              Grid.RowSpan="3" Grid.ColumnSpan="2"
              Background="Black"
              SizeChanged="OnFullscreenViewportSizeChanged"
              IsVisible="{Binding IsFullscreenMode}">
            <Border Name="FullscreenImageBackgroundBorder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{Binding TransparencyBackgroundBrush}">
                <Image Name="FullscreenImage"
                       Source="{Binding CurrentImage}"
                       Margin="-1"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
            </Border>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                        IsVisible="{Binding ShowVideoUnavailableNotice}">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/video.svg" Width="40" Height="40" HorizontalAlignment="Center" Opacity="0.6"/>
                <TextBlock Text="Videowiedergabe nicht verfügbar" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Subtitle}" HorizontalAlignment="Center"/>
                <TextBlock Text="mpv ist auf diesem System nicht installiert" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}" HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <!-- Einziges, dauerhaft angehängtes MpvVideoView für Fenster- UND Vollbildmodus - wird per
             Grid.Row/Column/RowSpan/ColumnSpan/Margin im Code-behind (ApplyVideoLayout) zwischen
             beiden Zuständen umgeschaltet, statt zwei separate VideoViews mit eigenem
             Anhängen/Abhängen-Zyklus zu verwenden. Letzteres führte dazu, dass das native
             Fenster-Handle beim Wechsel nicht zuverlässig rechtzeitig bereitstand (kein Bild,
             oder mpv erzeugte mangels Ziel kurzzeitig ein eigenes Fenster).
        -->
        <Grid Name="VideoOverlay"
              Grid.Row="1" Grid.Column="0"
              Margin="88,0,80,0"
              Background="Black"
              ClipToBounds="True"
              IsVisible="{Binding IsVideoFile}"
              RowDefinitions="*,Auto">
            <icons:MpvVideoView Name="TheVideoView" Grid.Row="0"
                             IsVisible="{Binding ShowVideoSurface}"
                             Tapped="OnVideoViewTapped"/>
            <Border Grid.Row="0"
                    Background="Transparent"
                    PointerMoved="OnGlobalPointerActivity"
                    PointerPressed="OnVideoInputPointerPressed"
                    Tapped="OnVideoViewTapped"/>
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                        IsVisible="{Binding ShowVideoUnavailableNotice}">
                <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/video.svg" Width="40" Height="40" HorizontalAlignment="Center" Opacity="0.6"/>
                <TextBlock Text="Videowiedergabe nicht verfügbar" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Subtitle}" HorizontalAlignment="Center"/>
                <TextBlock Text="mpv ist auf diesem System nicht installiert" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}" HorizontalAlignment="Center"/>
            </StackPanel>
            <Border Name="VideoPlaybackBar"
                    Grid.Row="1"
                    Background="#CC1A1D24"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                    <Button Grid.Column="0" Classes="icon-btn" Width="32" Height="32"
                            Command="{Binding PlayPauseVideoCommand}"
                            ToolTip.Tip="Play/Pause">
                        <Panel>
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/player-play.svg" Width="16" Height="16" IsVisible="{Binding !IsVideoPlaying}"/>
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/player-pause.svg" Width="16" Height="16" IsVisible="{Binding IsVideoPlaying}"/>
                        </Panel>
                    </Button>
                    <icons:RoundSlider Grid.Column="1" Name="VideoSeekSlider" Margin="10,0"
                                       Minimum="0" Maximum="{Binding VideoDurationSeconds}"
                                       Value="{Binding VideoPositionSeconds, Mode=OneWay}"/>
                    <TextBlock Grid.Column="2" Text="{Binding VideoTimeText}" Foreground="White" FontSize="{DynamicResource FP.Font.Small}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Grid.Column="3" Classes="icon-btn" Width="32" Height="32"
                            Command="{Binding ToggleVideoMuteCommand}"
                            ToolTip.Tip="Stumm">
                        <Panel Width="16" Height="16">
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/volume.svg" Width="16" Height="16" IconBrush="White"/>
                            <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/outline/x.svg"
                                           Width="9" Height="9"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           IconBrush="White"
                                           IsVisible="{Binding IsVideoMuted}"/>
                        </Panel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
