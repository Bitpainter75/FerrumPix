<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             x:Class="FerrumPix.Views.Settings.ExtensionsSectionView">
    <StackPanel Spacing="14">
        <StackPanel Spacing="2">
            <TextBlock Text="Erweiterungen" Foreground="{DynamicResource FP.Text.Accent}" FontSize="{DynamicResource FP.Font.Heading}" FontWeight="SemiBold"/>
            <TextBlock Text="Eine Erweiterung ist eine Datei, die ein Werkzeug mit eigenen Reglern beschreibt. Ist eine geladen, steht im Editor das Werkzeug Erweiterungen in der Gruppe Anpassungen."
                       Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap" MaxWidth="660" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- Der Index der Erweiterungen im Repository; mitgeliefert wird keine. -->
            <Button Classes="accent" Padding="12,7" Command="{Binding DownloadExtensionsCommand}">
                <TextBlock Text="Erweiterungen herunterladen" FontSize="{DynamicResource FP.Font.Small}"/>
            </Button>
            <Button Classes="ghost" Padding="12,7" Click="OnInstallExtensionClick">
                <TextBlock Text="Erweiterung laden" FontSize="{DynamicResource FP.Font.Small}"/>
            </Button>
            <Button Classes="ghost" Padding="12,7" Command="{Binding ReloadExtensionsCommand}">
                <TextBlock Text="Neu einlesen" FontSize="{DynamicResource FP.Font.Small}"/>
            </Button>
        </StackPanel>
        <TextBlock Classes="no-translate" Text="{Binding ExtensionMessage}" IsVisible="{Binding HasExtensionMessage}"
                   TextWrapping="Wrap" FontSize="{DynamicResource FP.Font.Small}" MaxWidth="660" HorizontalAlignment="Left"/>
        <TextBlock Text="Keine Erweiterung geladen." IsVisible="{Binding !HasExtensionRows}"
                   Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}"/>
        <ItemsControl ItemsSource="{Binding ExtensionRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="adjustment-group" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="no-translate" Text="{Binding Name}" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Classes="no-translate" Text="{Binding Details}" IsVisible="{Binding HasDetails}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}"/>
                                <TextBlock Classes="no-translate" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FP.Accent}" FontSize="{DynamicResource FP.Font.Small}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- Die Beschreibung der Erweiterung im Browser; der Tooltip zeigt das Ziel
                                     vor dem Klick. Nur https, siehe ExtensionService.IsSafeWebAddress. -->
                                <Button Classes="ghost" Padding="12,7" VerticalAlignment="Center"
                                        IsVisible="{Binding HasUrl}" ToolTip.Tip="{Binding Url}"
                                        Command="{Binding $parent[ItemsControl].DataContext.OpenExtensionUrlCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Classes="no-translate" Text="{Binding UrlText}" FontSize="{DynamicResource FP.Font.Small}"/>
                                </Button>
                                <Button Classes="ghost" Padding="12,7" VerticalAlignment="Center"
                                        IsVisible="{Binding CanRemove}"
                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveExtensionCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Classes="no-translate" Text="{Binding RemoveText}" FontSize="{DynamicResource FP.Font.Small}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Reihenfolge der Gruppen im Werkzeug, aufgebaut wie die Reihenfolge im kompakten
             Anpassungsmodus (EditorSectionView). Sie gilt nur der Anzeige. -->
        <StackPanel Spacing="8" IsVisible="{Binding HasExtensionOrderItems}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                    <TextBlock Text="Reihenfolge im Werkzeug Erweiterungen" FontSize="{DynamicResource FP.Font.Body}"/>
                    <TextBlock Text="Legt fest, in welcher Reihenfolge die Erweiterungen im Editor stehen. Die Bilder ändern sich dadurch nicht."
                               Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Padding="10,4" VerticalAlignment="Center"
                        Command="{Binding ResetExtensionOrderCommand}">Zurücksetzen</Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding ExtensionOrderItems}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource FP.Bg.Input}"
                                BorderBrush="{DynamicResource FP.Border.Normal}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,6"
                                AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Classes="no-translate" Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,24,0"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FP.Font.Body}"/>
                                <!-- Das Auge blendet die Erweiterung im Werkzeug aus oder ein, mit
                                     Akzent = sichtbar, wie bei den Gruppen des Kompaktmodus. -->
                                <Button Grid.Column="1"
                                        Classes="ghost"
                                        Classes.active="{Binding IsShown}"
                                        Padding="8,4"
                                        Margin="0,0,8,0"
                                        ToolTip.Tip="Im Editor zeigen oder ausblenden"
                                        Command="{Binding DataContext.ToggleExtensionVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Panel>
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/eye.svg" Width="18" Height="18"
                                                       IsVisible="{Binding IsShown}"/>
                                        <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/eye-closed.svg" Width="18" Height="18"
                                                       IsVisible="{Binding !IsShown}"/>
                                    </Panel>
                                </Button>
                                <Button Grid.Column="2"
                                        Classes="ghost"
                                        Padding="10,4"
                                        Margin="0,0,4,0"
                                        ToolTip.Tip="Nach oben"
                                        IsEnabled="{Binding CanMoveUp}"
                                        Command="{Binding DataContext.MoveExtensionUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">▲</Button>
                                <Button Grid.Column="3"
                                        Classes="ghost"
                                        Padding="10,4"
                                        ToolTip.Tip="Nach unten"
                                        IsEnabled="{Binding CanMoveDown}"
                                        Command="{Binding DataContext.MoveExtensionDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">▼</Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <TextBlock Classes="no-translate" Text="{Binding ExtensionFolder}" Foreground="{DynamicResource FP.Text.Muted}"
                   FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
