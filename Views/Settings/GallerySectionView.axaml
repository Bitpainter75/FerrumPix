<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:models="clr-namespace:FerrumPix.Models"
             xmlns:vm="clr-namespace:FerrumPix.ViewModels"
             xmlns:views="clr-namespace:FerrumPix.Views"
             x:Class="FerrumPix.Views.Settings.GallerySectionView">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Galerie" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Einstellungen für die Ordner- und Dateiansicht im Seitenbereich." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Versteckte Ordner anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt Ordner an, deren Name mit einem Punkt beginnt (z. B. .config, .local)." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHiddenFolders}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bild aus der Galerie öffnen mit" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gilt für den Doppelklick auf ein Bild und für die Eingabetaste. Videos werden immer im Viewer geöffnet." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryOpenViewer}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryOpenTargetCommand}"
                                        CommandParameter="Viewer">Viewer</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryOpenEditor}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryOpenTargetCommand}"
                                        CommandParameter="Editor">Editor</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Fußzeile in der Galerie" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt unten die Leiste mit Menü, Auswahl und Anzahl. Ausgeschaltet bleibt mehr Platz für die Bilder; die Aktionen der Leiste stehen weiterhin im Menü mit der rechten Maustaste." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryShowFooter}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Verweisen aus dem persönlichen Ordner folgen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Erlaubt Kopieren, Verschieben, Umbenennen und Löschen auch dann, wenn ein Ordner nur ein Verweis auf einen Ort außerhalb des persönlichen Ordners ist, etwa auf eine zweite Festplatte. Ausgeschaltet bleibt die Dateiarbeit auf den persönlichen Ordner beschränkt. Ansehen und Bearbeiten sind nie eingeschränkt." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding FollowLinkedFolders}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Dateioperationen außerhalb des persönlichen Ordners erlauben" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Erlaubt Kopieren, Verschieben, Umbenennen und Löschen auch auf anderen Laufwerken, eingehängten Datenträgern und Netzordnern. Systemordner, die Wurzel eines Laufwerks und Sammelordner wie /home oder /media bleiben immer gesperrt." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowFileOperationsOutsideHome}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Ordner in der Galerie anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt Unterordner neben Bildern an; Doppelklick öffnet den Ordner." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryShowFolders}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Übergeordnete Ordner anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Blendet in der Galerie zusätzlich einen Eintrag für den übergeordneten Ordner ein." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryShowParentFolder}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Serien und RAW+JPEG stapeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Fasst Aufnahmen kurz hintereinander und das Kamera-JPEG neben einem RAW zu einer Kachel zusammen. Ein Klick auf eine Serie zeigt nur sie, mit der schärfsten Aufnahme vorn." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryStacks}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bewertungssterne immer anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt die Sterne auf der Kachel dauerhaft an statt erst beim Überfahren mit der Maus." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryRatingBadgesAlwaysVisible}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Favoriten-Herz immer anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt das Favoriten-Herz auf der Kachel dauerhaft an statt erst beim Überfahren mit der Maus." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryFavoriteBadgeAlwaysVisible}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Metadaten-Symbole immer anzeigen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt die Metadaten-Symbole (EXIF, IPTC, XMP, ICC) auf der Kachel dauerhaft an statt erst beim Überfahren mit der Maus." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryMetadataBadgesAlwaysVisible}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bearbeitete Bilder kennzeichnen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt oben auf der Kachel ein Symbol, wenn das Bild bearbeitet wurde, neben dem für verworfene Bilder. In der Fotowand erscheint es nur, solange die Maus über der Kachel steht." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryEditedBadge}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Symbole der Fotowand nur beim Überfahren" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Blendet in der Fotowand Sterne, Herz, Metadaten-Symbole, Auswahlkreis und Abspielknopf aus, bis die Maus über der Kachel steht. Gilt auch für Symbole, die oben auf immer anzeigen stehen." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryWallBadgesOnHover}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Ansicht" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Legt fest, ob die Galerie als Raster, als Liste, in Gruppen oder als Fotowand angezeigt wird. Die Fotowand zeigt jedes Bild in seinem eigenen Seitenverhältnis, ohne Beschriftung und mit schmalem Abstand." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryViewModeGrid}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryViewModeCommand}"
                                        CommandParameter="Grid">Raster</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryViewModeList}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryViewModeCommand}"
                                        CommandParameter="List">Liste</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryViewModeGroup}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryViewModeCommand}"
                                        CommandParameter="Group">Gruppen</Button>
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsGalleryViewModeWall}"
                                        Padding="10,6"
                                        Command="{Binding SetGalleryViewModeCommand}"
                                        CommandParameter="Wall">Fotowand</Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Abstand zwischen den Kacheln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gilt für alle Kachelansichten der Galerie; enger als vier Bildpunkte wird es nicht. Die Liste bleibt unberührt." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="4"
                                                   Maximum="24"
                                                   DefaultValue="10"
                                                   Value="{Binding GalleryTileGap}"/>
                                <TextBlock Text="{Binding GalleryTileGap, StringFormat={}{0} px}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="44"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Runde Ecken und Rahmen an den Kacheln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Ausgeschaltet stehen die Kacheln in allen Ansichten der Galerie eckig und ohne sichtbaren Rahmen da. Der Rahmen um ausgewählte Bilder bleibt, er wird nur eckig." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding GalleryTileFrame}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Ganzes Bild in der Rasteransicht" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt das Bild in der Kachel ganz, hochkant oder quer, statt es auf die Kachel zuzuschneiden. Die Kacheln bleiben gleich groß." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding GalleryTilesKeepAspect}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Die Angaben unter dem Dateinamen einer Kachel und in der Liste: bis zu
                             drei Zeilen, je eine Auswahl links und rechts, angeordnet wie unter der
                             Kachel. Eine Zeile ohne Angabe gibt es dort nicht. -->
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660">
                                <TextBlock Text="Angaben unter den Kacheln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Wählt, was unter dem Dateinamen steht: bis zu drei Zeilen mit je einer Angabe am linken und am rechten Rand. Eine Zeile ohne Angabe entfällt. Dieselben Angaben stehen auch in der Liste. Die Werte kommen aus dem Katalog; hat ein Bild kein Aufnahmedatum, steht dort das Änderungsdatum der Datei." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left">
                                <Grid ColumnDefinitions="*,*">
                                    <TextBlock Text="Links" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Grid.Column="1" Text="Rechts" HorizontalAlignment="Right" Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding TileCaptionRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <ComboBox DataContext="{Binding Left}"
                                                          ItemsSource="{Binding Options}"
                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                          MinWidth="170"
                                                          HorizontalAlignment="Left"
                                                          FontSize="{DynamicResource FP.Font.Body}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Classes="no-translate" Text="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Grid.Column="1"
                                                          DataContext="{Binding Right}"
                                                          ItemsSource="{Binding Options}"
                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                          MinWidth="170"
                                                          HorizontalAlignment="Right"
                                                          FontSize="{DynamicResource FP.Font.Body}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Classes="no-translate" Text="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Zeitleiste am rechten Rand" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt Jahre bzw. Anfangsbuchstaben passend zur Sortierung; Klick oder Ziehen springt an die Stelle." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GalleryTimelineEnabled}"
                                          OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Startordner der Galerie" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Bestimmt, welcher Ordner beim Start der Anwendung geöffnet wird." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupPicturesFolder}"
                                            Padding="10,6"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Pictures">Bilder-Ordner</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupLastFolder}"
                                            Padding="10,6"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Last">Letzter Ordner</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupCustomFolder}"
                                            Padding="10,6"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Custom">Benutzerdefiniert</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupImmich}"
                                            Padding="10,6"
                                            IsVisible="{Binding IsGalleryStartupImmichAvailable}"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Immich"
                                            ToolTip.Tip="Startet in Immich „Alle Fotos“; ohne Verbindung greift der Bilder-Ordner">Immich (Alle Fotos)</Button>
                                    <Button Classes="ghost"
                                            Classes.active="{Binding IsGalleryStartupNextcloud}"
                                            Padding="10,6"
                                            IsVisible="{Binding IsGalleryStartupNextcloudAvailable}"
                                            Command="{Binding SetGalleryStartupFolderModeCommand}"
                                            CommandParameter="Nextcloud"
                                            ToolTip.Tip="Startet in Nextcloud mit der Zeitachse; ohne Verbindung greift der Bilder-Ordner">Nextcloud (Alle Fotos)</Button>
                                </StackPanel>
                                <Grid ColumnDefinitions="260,Auto" ColumnSpacing="6" IsVisible="{Binding IsGalleryStartupCustomFolder}">
                                    <TextBox Text="{Binding GalleryStartupCustomFolder, Mode=TwoWay}"
                                             PlaceholderText="Ordner auswählen"
                                             IsReadOnly="True"/>
                                    <Button Grid.Column="1"
                                            Classes="ghost"
                                            Padding="10,6"
                                            Click="OnBrowseGalleryStartupFolderClick">Auswählen</Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- ZIELORDNER ZUM EINLESEN: der Dialog bietet sie neben dem aktuellen Ordner
                             zur Auswahl an (MainWindowViewModelImport). -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                    <TextBlock Text="Zielordner für den Import" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="Ziele, die der Import neben dem aktuellen Ordner anbietet. Platzhalter: {pictures} Bilder-Ordner, {home} persönlicher Ordner, {camera} Kamera, {datetaken:FORMAT} Aufnahmedatum. Im Format stehen yyyy für das Jahr, MM für den Monat als Zahl, MMMM für den Monatsnamen, dd für den Tag und dddd für den Wochentag; Namen kommen in der Sprache der Region. Beispiel: {pictures}/{datetaken:yyyy}/{datetaken:MM MMMM} legt Ordner wie 2026/10 Oktober an."
                                               Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{}{make} setzt den Hersteller ein, {model} das Modell, {camera} beides ohne doppelten Hersteller. Fehlt die Angabe, steht dort Ohne Kamera, bei einem Video Video."
                                               Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Padding="12,7"
                                        VerticalAlignment="Center"
                                        Command="{Binding AddImportTargetCommand}">Ziel hinzufügen</Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ImportTargetRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Margin="0,0,0,6"
                                                    AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree">
                                            <Grid ColumnDefinitions="170,*,Auto,Auto" ColumnSpacing="6">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         PlaceholderText="Name"/>
                                                <TextBox Grid.Column="1"
                                                         Classes="no-translate"
                                                         Text="{Binding Template, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         PlaceholderText="Zielordner"/>
                                                <Button Grid.Column="2" Classes="ghost" Padding="10,6"
                                                        Click="OnBrowseImportTargetClick">Auswählen</Button>
                                                <Button Grid.Column="3" Classes="ghost"
                                                        Width="30" Height="30" Padding="0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip.Tip="Entfernen">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/trash.svg"
                                                                   Width="18" Height="18"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="{Binding PreviewText}"
                                                       Classes="no-translate"
                                                       Margin="176,0,0,0"
                                                       Foreground="{DynamicResource FP.Text.Muted}"
                                                       FontSize="{DynamicResource FP.Font.Small}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- DATEINAMEN ZUM EINLESEN: wie die Zielordner; der Dialog bietet sie neben
                             dem Namen der Quelle zur Auswahl an (MainWindowViewModelImport). -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                    <TextBlock Text="Dateinamen für den Import" FontSize="{DynamicResource FP.Font.Body}"/>
                                    <TextBlock Text="Muster für Dateinamen, die der Import neben dem Namen der Quelle anbietet. Gewählt wird im Import-Dialog."
                                               Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{}{job} setzt den Auftrag ein, in Ziel und Dateiname. Für den Dateinamen gibt es dazu {name} für den Namen der Quelle und ### als Zähler; die Endung bleibt. Beispiel: {datetaken:yyyy-MM-dd}_{job}_###."
                                               Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Padding="12,7"
                                        VerticalAlignment="Center"
                                        Command="{Binding AddImportNameCommand}">Muster hinzufügen</Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ImportNameRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Margin="0,0,0,6"
                                                    AttachedToVisualTree="OnLocalizedItemAttachedToVisualTree">
                                            <Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="6">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         PlaceholderText="Name"/>
                                                <TextBox Grid.Column="1"
                                                         Classes="no-translate"
                                                         Text="{Binding Template, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         PlaceholderText="Dateiname"/>
                                                <Button Grid.Column="2" Classes="ghost"
                                                        Width="30" Height="30" Padding="0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip.Tip="Entfernen">
                                                    <icons:SvgIcon Source="avares://FerrumPix/Assets/Icons/phosphor/regular/trash.svg"
                                                                   Width="18" Height="18"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="{Binding PreviewText}"
                                                       Classes="no-translate"
                                                       Margin="176,0,0,0"
                                                       Foreground="{DynamicResource FP.Text.Muted}"
                                                       FontSize="{DynamicResource FP.Font.Small}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
</UserControl>
