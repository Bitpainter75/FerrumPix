<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:models="clr-namespace:FerrumPix.Models"
             xmlns:vm="clr-namespace:FerrumPix.ViewModels"
             xmlns:views="clr-namespace:FerrumPix.Views"
             x:Class="FerrumPix.Views.Settings.RawSectionView">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="RAW-Entwicklung" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="Wie RAW-Dateien entwickelt und in Galerie, Viewer und Editor angezeigt werden." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bearbeitete RAWs als Thumbnail entwickeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt in der Galerie das entwickelte RAW mit deiner Bearbeitung – aber nur, wenn dafür eine .fpxmp existiert. Unbearbeitete RAWs bleiben beim schnellen eingebetteten JPG." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding DevelopRawThumbnails}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Bearbeitete RAWs im Viewer entwickeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Zeigt auch im Viewer das entwickelte, bearbeitete RAW statt der eingebetteten Vorschau – nur bei vorhandener .fpxmp." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding DevelopRawInViewer}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Auch unbearbeitete RAWs im Viewer entwickeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Entwickelt im Viewer und im Vollbild jedes RAW, auch ohne vorhandene .fpxmp. Das Bild zeigt dann die eigene Entwicklung statt der Kameravorschau. Der Bildaufbau dauert dadurch spürbar länger." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding DevelopRawInViewerWithoutRecipe}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="RAWs im Vergleich in voller Auflösung entwickeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Ausgeschaltet entwickelt der Bildvergleich RAWs in halber Auflösung. Das geht um ein Vielfaches schneller und reicht für die Ansicht im Fenster. Eingeschaltet bleibt beim Hineinzoomen die volle Schärfe erhalten, dafür dauert jedes Bild deutlich länger." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding CompareRawFullResolution}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="RAWs im Viewer in voller Auflösung entwickeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gilt, wenn der Viewer RAWs selbst entwickelt. Ausgeschaltet geschieht das in halber Auflösung, um ein Vielfaches schneller und für die Ansicht im Fenster ausreichend. Eingeschaltet bleibt beim Hineinzoomen die volle Schärfe erhalten, und der Editor öffnet das Bild danach ohne erneutes Entwickeln." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ViewerRawFullResolution}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="RAWs ohne Bearbeitung im Stapel entwickeln" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Stapelfunktionen wie Bildgröße ändern oder Exportieren nach entwickeln RAWs in voller Sensorauflösung. Ausgeschaltet nehmen sie für unbearbeitete RAWs die eingebettete Vorschau – schneller, aber kleiner. RAWs MIT Bearbeitung (.fpxmp) werden unabhängig davon immer entwickelt und mit ihrem Rezept geschrieben." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding DevelopRawInBatch}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Grundhelligkeit an das Kameramodell anpassen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="RAW-Dateien verschiedener Kameras kommen unterschiedlich hell aus dem Sensor. Eingeschaltet gleicht FerrumPix das anhand von Referenzwerten je Kameramodell an, damit dieselbe Aufnahme mit verschiedenen Kameras gleich hell entwickelt wird." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding UseCameraBaselineTable}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Die Farbe hat einen EIGENEN Schalter neben der Helligkeit: wer gleich
                             helle Kameras will, will nicht zwingend eine andere Farbwiedergabe.
                             Der Bezug der Werte bleibt in der Beschreibung ohne Namen. -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Farben an das Kameramodell anpassen" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="RAW-Dateien verschiedener Kameras geben Farben unterschiedlich wieder. Eingeschaltet stellt FerrumPix beim Öffnen einer unbearbeiteten RAW die Regler unter Kalibrierung so ein, dass die Farben einer verbreiteten RAW-Entwicklung nahekommen, für einige Kameramodelle eigens abgestimmt. Die Werte stehen sichtbar in den Reglern und lassen sich dort ändern; bereits bearbeitete Bilder bleiben unverändert." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding UseCameraColorTable}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Objektivfehler korrigieren" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Gleicht Verzeichnung, Farbsäume an den Bildecken und Randabdunklung anhand von Messwerten für das verwendete Objektiv aus. Objektiv und Kamera werden aus den Aufnahmedaten erkannt; liegen für das Objektiv keine Messwerte vor, bleibt das Bild unverändert. Diese Vorgabe lässt sich pro Bild im Werkzeug übersteuern." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LensDatabaseInfo}" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding LensCorrectionEnabled}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Startwerte von Schaerfe und Rauschen fuer eine RAW ohne Rezept
                             (ImageAdjustments.ForUneditedRaw), wie die Farbrausch-Startwerte darunter. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Schärfen bei unbearbeiteten RAWs" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Startwert des Reglers Stärke beim Schärfen, wenn ein RAW ohne Bearbeitung geöffnet wird. Bereits bearbeitete Bilder behalten ihre Werte. 0 schaltet ihn ab." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="0"
                                                   Maximum="150"
                                                   DefaultValue="40"
                                                   Value="{Binding UneditedRawSharpness}"/>
                                <TextBlock Text="{Binding UneditedRawSharpness}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="52"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Luminanz-Rauschreduzierung bei unbearbeiteten RAWs" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Startwert des Reglers Luminanz in der Rauschreduzierung, wenn ein RAW ohne Bearbeitung geöffnet wird. Glättet das Helligkeitsrauschen und braucht bei jedem Bildwechsel Rechenzeit. Bereits bearbeitete Bilder behalten ihre Werte. 0 schaltet ihn ab." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="0"
                                                   Maximum="100"
                                                   DefaultValue="0"
                                                   Value="{Binding UneditedRawNoiseReduction}"/>
                                <TextBlock Text="{Binding UneditedRawNoiseReduction}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="52"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Der Farbrausch-Startwert fuer eine RAW ohne Rezept (ImageAdjustments.ForUneditedRaw).
                             Namen wie in der Rauschreduzierung des Editors, 0 = aus. Ab Werk 0. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Farb-Rauschreduzierung bei unbearbeiteten RAWs" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Startwert des Reglers Farbe in der Rauschreduzierung, wenn ein RAW ohne Bearbeitung geöffnet wird. Nimmt das Farbrauschen, das im Bild gemessen wird, und lässt echte Farbe stehen. Braucht bei jedem Bildwechsel Rechenzeit. 0 schaltet ihn ab." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <icons:RoundSlider Width="150"
                                                   Minimum="0"
                                                   Maximum="100"
                                                   DefaultValue="0"
                                                   Value="{Binding UneditedRawColorNoise}"/>
                                <TextBlock Text="{Binding UneditedRawColorNoise}"
                                           Foreground="{DynamicResource FP.Text.Secondary}"
                                           FontSize="{DynamicResource FP.Font.Body}"
                                           Width="52"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- DER SCHALTER "Lichter unbeschnitten aus den Sensordaten lesen" IST
                             HIER AUSGEBAUT, die Einstellung RawHighlightUnclip steht weiter auf
                             ihrer Vorgabe True. Er war der Rueckweg fuer einen Feldbericht ueber zu
                             helle Aufnahmen, und der Bericht sagt inzwischen, dass Umlegen nichts
                             aendert: die Datei ist eine DNG, und DNG-Dateien liefen bis 0.9.48 als
                             fertiges RGB an der Basisstufe vorbei (siehe RawDecodeService.
                             IsFinishedRgb). Der Helligkeitssprung kommt also von dort und nicht vom
                             unbeschnittenen Lesen. Ein Schalter, der das nicht heilt, verwirrt nur.
                             Der Wortlaut liegt in den Ressourcendateien bereit, falls er
                             zurueckkommt. -->
                        <!-- Die Abkuerzungen bleiben unuebersetzt (Klasse no-translate): AHD, DCB
                             und PPG sind die Namen der Verfahren, nicht Beschreibungen. Was sie
                             bedeuten, steht in der Zeile darunter. -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <StackPanel Spacing="2" HorizontalAlignment="Left" MaxWidth="660" Margin="0,0,40,0">
                                <TextBlock Text="Verfahren zum Entwickeln der Sensordaten" FontSize="{DynamicResource FP.Font.Body}"/>
                                <TextBlock Text="Ein Sensor misst je Bildpunkt nur eine Farbe; das Verfahren rechnet daraus das vollständige Bild. Vorschaubilder werden nach einer Änderung neu erzeugt." Foreground="{DynamicResource FP.Text.Secondary}" FontSize="{DynamicResource FP.Font.Body}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RawDemosaicDescription}" Foreground="{DynamicResource FP.Text.Muted}" FontSize="{DynamicResource FP.Font.Small}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RawDemosaicOptions}"
                                      SelectedItem="{Binding SelectedRawDemosaic, Mode=TwoWay}"
                                      MinWidth="140"
                                      VerticalAlignment="Center"
                                      FontSize="{DynamicResource FP.Font.Body}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="no-translate" Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
</UserControl>
