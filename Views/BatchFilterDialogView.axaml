<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPix.Controls"
             xmlns:local="clr-namespace:FerrumPix.Views"
             x:Class="FerrumPix.Views.BatchFilterDialogView">
    <StackPanel Spacing="14">
        <local:FilterFormView/>

        <TextBlock Text="{Binding DialogBatchOverwriteUnavailableHint}"
                   IsVisible="{Binding !IsDialogBatchOverwriteAvailable}"
                   Foreground="{DynamicResource FP.Text.Secondary}"
                   FontSize="{DynamicResource FP.Font.Small}"
                   TextWrapping="Wrap"/>
        <CheckBox Content="Originale überschreiben"
                  IsVisible="{Binding IsDialogBatchOverwriteAvailable}"
                  IsChecked="{Binding DialogBatchFilterOverwrite, Mode=TwoWay}"
                  ToolTip.Tip="Schreibt den Filter direkt in die Bilddateien. Ohne Haken entstehen neue Dateien und die Originale bleiben unangetastet."/>

        <CheckBox Content="Namen der Vorgabe an den Dateinamen anhängen"
                  IsChecked="{Binding DialogBatchFilterAppendName, Mode=TwoWay}"
                  IsVisible="{Binding IsDialogFilterAppendNameVisible}"
                  ToolTip.Tip="foto.jpg wird zu foto_Vintage.jpg"/>

        <!-- Nur da, wenn in der Auswahl wirklich etwas offen ist (siehe
             MainWindowViewModel.PreparePendingBakedOptionAsync). -->
        <CheckBox Content="{Binding DialogPendingBakedLabel}"
                  IsChecked="{Binding DialogApplyPendingBaked, Mode=TwoWay}"
                  IsVisible="{Binding IsDialogPendingBakedAvailable}"
                  Classes="no-translate"
                  FontSize="{DynamicResource FP.Font.Small}"
                  ToolTip.Tip="Bei RAW- und Photoshop-Dateien liegt Entrauschen, Objektentfernen, Retusche und Pinsel nur als Vermerk neben der Datei. Mit Haken werden sie mitgerechnet, was mehrere Minuten je Bild kostet; ohne Haken kommen die Bilder ohne diese Bearbeitung heraus."/>
    </StackPanel>
</UserControl>
